use core::ops::{WrappingAdd, WrappingMul, WrappingSub}
use std::evm::crypto::{addmod, mulmod}
use std::io::{Write, host, write, write_char, writeln}
use std::native::{Arg, Args}

const MAX_CODE: usize = 4096
const MEMORY_LIMIT: usize = 8192
const RETURN_LIMIT: usize = 4096
const STACK_LIMIT: usize = 1024

pub const OK: i32 = 0
const ERR_USAGE: i32 = 2
const ERR_BAD_HEX: i32 = 3
const ERR_ODD_HEX: i32 = 4
const ERR_CODE_TOO_LONG: i32 = 5
const ERR_STACK_UNDERFLOW: i32 = 10
const ERR_STACK_OVERFLOW: i32 = 11
const ERR_TRUNCATED_PUSH: i32 = 12
const ERR_UNSUPPORTED_OPCODE: i32 = 13
const ERR_TODO_OPCODE: i32 = 14
const ERR_MEMORY_LIMIT: i32 = 15
const ERR_INVALID_JUMP: i32 = 16
const ERR_INVALID_OPCODE: i32 = 17
const ERR_RETURN_DATA_OOB: i32 = 18
pub const ERR_REVERT: i32 = 19

const I256_MIN: i256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968

pub struct Program {
    pub bytes: [u8; MAX_CODE],
    pub len: usize,
    pub status: i32,
}

pub struct ByteBuffer {
    pub bytes: [u8; RETURN_LIMIT],
    pub len: usize,
    pub status: i32,
}

pub struct CallEnv {
    pub address: u256,
    pub caller: u256,
    pub origin: u256,
    pub callvalue: u256,
    pub gasprice: u256,
    pub gas: u256,
    pub selfbalance: u256,
}

pub struct BlockEnv {
    pub coinbase: u256,
    pub timestamp: u256,
    pub number: u256,
    pub prevrandao: u256,
    pub gaslimit: u256,
    pub chainid: u256,
    pub basefee: u256,
    pub blobbasefee: u256,
}

pub struct ExecutionResult {
    pub status: i32,
    pub output: ByteBuffer,
    pub output_valid: bool,
    pub stack_top: u256,
    pub stack_len: usize,
    pub unsupported_opcode: i32,
}

struct Vm {
    memory: [u8; MEMORY_LIMIT],
    memory_size: usize,
    output: [u8; RETURN_LIMIT],
    output_len: usize,
    output_valid: bool,
    stack: [u256; STACK_LIMIT],
    sp: usize,
    pc: usize,
    status: i32,
    halted: bool,
    unsupported_opcode: i32,
}

fn hex_digit(_ value: u8) -> i32 {
    if value < 10 {
        (value as i32) + 48
    } else {
        (value as i32) + 87
    }
}

fn write_hex_u256(_ value: u256)
uses (w: mut Write)
{
    write("0x")
    let mut i: usize = 0
    while i < 64 {
        let shift = ((63 - i) as u256) * 4
        let nibble: u8 = ((value >> shift) & 15).downcast_unchecked()
        write_char(hex_digit(nibble))
        i += 1
    }
    write_char(10)
}

fn write_hex_byte(_ value: i32)
uses (w: mut Write)
{
    let hi: u8 = (value / 16).downcast_unchecked()
    let lo: u8 = (value % 16).downcast_unchecked()
    write_char(hex_digit(hi))
    write_char(hex_digit(lo))
}

fn write_hex_bytes(_ bytes: [u8; RETURN_LIMIT], _ len: usize)
uses (w: mut Write)
{
    write("0x")
    let mut i: usize = 0
    while i < len {
        write_hex_byte(bytes[i] as i32)
        i += 1
    }
    write_char(10)
}

fn write_opcode_name(_ op: i32)
uses (w: mut Write)
{
    match op {
        0x00 => write("STOP"),
        0x01 => write("ADD"),
        0x02 => write("MUL"),
        0x03 => write("SUB"),
        0x04 => write("DIV"),
        0x05 => write("SDIV"),
        0x06 => write("MOD"),
        0x07 => write("SMOD"),
        0x08 => write("ADDMOD"),
        0x09 => write("MULMOD"),
        0x0a => write("EXP"),
        0x0b => write("SIGNEXTEND"),
        0x10 => write("LT"),
        0x11 => write("GT"),
        0x12 => write("SLT"),
        0x13 => write("SGT"),
        0x14 => write("EQ"),
        0x15 => write("ISZERO"),
        0x16 => write("AND"),
        0x17 => write("OR"),
        0x18 => write("XOR"),
        0x19 => write("NOT"),
        0x1a => write("BYTE"),
        0x1b => write("SHL"),
        0x1c => write("SHR"),
        0x1d => write("SAR"),
        0x20 => write("SHA3"),
        0x30 => write("ADDRESS"),
        0x31 => write("BALANCE"),
        0x32 => write("ORIGIN"),
        0x33 => write("CALLER"),
        0x34 => write("CALLVALUE"),
        0x35 => write("CALLDATALOAD"),
        0x36 => write("CALLDATASIZE"),
        0x37 => write("CALLDATACOPY"),
        0x38 => write("CODESIZE"),
        0x39 => write("CODECOPY"),
        0x3a => write("GASPRICE"),
        0x3b => write("EXTCODESIZE"),
        0x3c => write("EXTCODECOPY"),
        0x3d => write("RETURNDATASIZE"),
        0x3e => write("RETURNDATACOPY"),
        0x3f => write("EXTCODEHASH"),
        0x40 => write("BLOCKHASH"),
        0x41 => write("COINBASE"),
        0x42 => write("TIMESTAMP"),
        0x43 => write("NUMBER"),
        0x44 => write("PREVRANDAO"),
        0x45 => write("GASLIMIT"),
        0x46 => write("CHAINID"),
        0x47 => write("SELFBALANCE"),
        0x48 => write("BASEFEE"),
        0x49 => write("BLOBHASH"),
        0x4a => write("BLOBBASEFEE"),
        0x50 => write("POP"),
        0x51 => write("MLOAD"),
        0x52 => write("MSTORE"),
        0x53 => write("MSTORE8"),
        0x56 => write("JUMP"),
        0x57 => write("JUMPI"),
        0x58 => write("PC"),
        0x59 => write("MSIZE"),
        0x5a => write("GAS"),
        0x5b => write("JUMPDEST"),
        0x5c => write("TLOAD"),
        0x5d => write("TSTORE"),
        0x5e => write("MCOPY"),
        0x5f => write("PUSH0"),
        0xfe => write("INVALID"),
        0xff => write("SELFDESTRUCT"),
        _ => {
            if op >= 0x60 && op <= 0x7f {
                write("PUSH")
            } else {
                if op >= 0x80 && op <= 0x8f {
                    write("DUP")
                } else {
                    if op >= 0x90 && op <= 0x9f {
                        write("SWAP")
                    } else {
                        if op >= 0xa0 && op <= 0xa4 {
                            write("LOG")
                        } else {
                            if op == 0xf0 {
                                write("CREATE")
                            } else if op == 0xf1 {
                                write("CALL")
                            } else if op == 0xf2 {
                                write("CALLCODE")
                            } else if op == 0xf3 {
                                write("RETURN")
                            } else if op == 0xf4 {
                                write("DELEGATECALL")
                            } else if op == 0xf5 {
                                write("CREATE2")
                            } else if op == 0xfa {
                                write("STATICCALL")
                            } else if op == 0xfd {
                                write("REVERT")
                            } else {
                                write("UNKNOWN")
                            }
                        }
                    }
                }
            }
        },
    }
}

fn is_prefixed_hex(_ arg: Arg) -> bool {
    arg.len() >= 2 && arg.byte_at(0) == 48 && (arg.byte_at(1) == 120 || arg.byte_at(1) == 88)
}

fn hex_value(_ byte: u8) -> i32 {
    if byte >= 48 && byte <= 57 {
        return (byte as i32) - 48
    }
    if byte >= 65 && byte <= 70 {
        return (byte as i32) - 55
    }
    if byte >= 97 && byte <= 102 {
        return (byte as i32) - 87
    }
    0 - 1
}

pub fn parse_hex_program(_ arg: Arg) -> Program {
    let mut bytes: [u8; MAX_CODE] = [0; MAX_CODE]
    let len = arg.len()
    let mut i: usize = 0
    if is_prefixed_hex(arg) {
        i = 2
    }

    if (len - i) % 2 != 0 {
        return Program { bytes: bytes, len: 0, status: ERR_ODD_HEX }
    }

    let mut out_len: usize = 0
    while i < len {
        if out_len >= MAX_CODE {
            return Program { bytes: bytes, len: out_len, status: ERR_CODE_TOO_LONG }
        }

        let hi = hex_value(arg.byte_at(i))
        let lo = hex_value(arg.byte_at(i + 1))
        if hi < 0 || lo < 0 {
            return Program { bytes: bytes, len: out_len, status: ERR_BAD_HEX }
        }

        bytes[out_len] = ((hi * 16) + lo).downcast_unchecked()
        out_len += 1
        i += 2
    }

    Program { bytes: bytes, len: out_len, status: OK }
}

pub fn empty_bytes() -> ByteBuffer {
    ByteBuffer { bytes: [0; RETURN_LIMIT], len: 0, status: OK }
}

fn parse_hex_bytes(_ arg: Arg) -> ByteBuffer {
    let mut bytes: [u8; RETURN_LIMIT] = [0; RETURN_LIMIT]
    let len = arg.len()
    let mut i: usize = 0
    if is_prefixed_hex(arg) {
        i = 2
    }

    if (len - i) % 2 != 0 {
        return ByteBuffer { bytes: bytes, len: 0, status: ERR_ODD_HEX }
    }

    let mut out_len: usize = 0
    while i < len {
        if out_len >= RETURN_LIMIT {
            return ByteBuffer { bytes: bytes, len: out_len, status: ERR_CODE_TOO_LONG }
        }

        let hi = hex_value(arg.byte_at(i))
        let lo = hex_value(arg.byte_at(i + 1))
        if hi < 0 || lo < 0 {
            return ByteBuffer { bytes: bytes, len: out_len, status: ERR_BAD_HEX }
        }

        bytes[out_len] = ((hi * 16) + lo).downcast_unchecked()
        out_len += 1
        i += 2
    }

    ByteBuffer { bytes: bytes, len: out_len, status: OK }
}

pub fn default_call_env() -> CallEnv {
    CallEnv {
        address: 0,
        caller: 0,
        origin: 0,
        callvalue: 0,
        gasprice: 0,
        gas: 0,
        selfbalance: 0,
    }
}

pub fn default_block_env() -> BlockEnv {
    BlockEnv {
        coinbase: 0,
        timestamp: 0,
        number: 0,
        prevrandao: 0,
        gaslimit: 0,
        chainid: 0,
        basefee: 0,
        blobbasefee: 0,
    }
}

impl Vm {
    fn new() -> Self {
        Vm {
            memory: [0; MEMORY_LIMIT],
            memory_size: 0,
            output: [0; RETURN_LIMIT],
            output_len: 0,
            output_valid: false,
            stack: [0; STACK_LIMIT],
            sp: 0,
            pc: 0,
            status: OK,
            halted: false,
            unsupported_opcode: 0,
        }
    }

    fn ok(self) -> bool {
        self.status == OK
    }

    fn fault(mut self, _ status: i32) {
        if self.status == OK {
            self.status = status
        }
    }

    fn push(mut self, _ value: u256) {
        if self.sp >= STACK_LIMIT {
            self.fault(ERR_STACK_OVERFLOW)
            return
        }

        self.stack[self.sp] = value
        self.sp += 1
    }

    fn pop(mut self) -> u256 {
        if self.sp == 0 {
            self.fault(ERR_STACK_UNDERFLOW)
            return 0
        }

        self.sp -= 1
        self.stack[self.sp]
    }

    fn push_bool(mut self, _ value: bool) {
        if value {
            self.push(1)
        } else {
            self.push(0)
        }
    }

    fn ensure_memory(mut self, _ offset: u256, _ len: usize) -> usize {
        if len == 0 {
            return 0
        }

        if offset > MEMORY_LIMIT as u256 {
            self.fault(ERR_MEMORY_LIMIT)
            return 0
        }

        let start: usize = offset.downcast_unchecked()
        let end = start + len
        if end > MEMORY_LIMIT {
            self.fault(ERR_MEMORY_LIMIT)
            return 0
        }

        if end > self.memory_size {
            self.memory_size = end
        }
        start
    }

    fn mload(mut self) {
        let offset = self.pop()
        if !self.ok() {
            return
        }

        let start = self.ensure_memory(offset, 32)
        if !self.ok() {
            return
        }

        let mut value: u256 = 0
        let mut i: usize = 0
        while i < 32 {
            value = (value << 8) | (self.memory[start + i] as u256)
            i += 1
        }
        self.push(value)
    }

    fn mstore(mut self) {
        let offset = self.pop()
        let value = self.pop()
        if !self.ok() {
            return
        }

        let start = self.ensure_memory(offset, 32)
        if !self.ok() {
            return
        }

        let mut i: usize = 0
        while i < 32 {
            let shift = ((31 - i) as u256) * 8
            self.memory[start + i] = ((value >> shift) & 255).downcast_unchecked()
            i += 1
        }
    }

    fn mstore8(mut self) {
        let offset = self.pop()
        let value = self.pop()
        if !self.ok() {
            return
        }

        let start = self.ensure_memory(offset, 1)
        if self.ok() {
            self.memory[start] = (value & 255).downcast_unchecked()
        }
    }

    fn codecopy(mut self, _ program: Program) {
        let mem_offset = self.pop()
        let code_offset = self.pop()
        let len = self.pop()
        if !self.ok() {
            return
        }

        if len > MEMORY_LIMIT as u256 || code_offset > MAX_CODE as u256 {
            self.fault(ERR_MEMORY_LIMIT)
            return
        }

        let copy_len: usize = len.downcast_unchecked()
        let dst = self.ensure_memory(mem_offset, copy_len)
        if !self.ok() {
            return
        }

        let src: usize = code_offset.downcast_unchecked()
        let mut i: usize = 0
        while i < copy_len {
            let index = src + i
            if index < program.len {
                self.memory[dst + i] = program.bytes[index]
            } else {
                self.memory[dst + i] = 0
            }
            i += 1
        }
    }

    fn mcopy(mut self) {
        let dst_offset = self.pop()
        let src_offset = self.pop()
        let len = self.pop()
        if !self.ok() {
            return
        }

        if len > MEMORY_LIMIT as u256 {
            self.fault(ERR_MEMORY_LIMIT)
            return
        }

        let copy_len: usize = len.downcast_unchecked()
        let dst = self.ensure_memory(dst_offset, copy_len)
        let src = self.ensure_memory(src_offset, copy_len)
        if !self.ok() {
            return
        }

        if dst < src {
            let mut i: usize = 0
            while i < copy_len {
                self.memory[dst + i] = self.memory[src + i]
                i += 1
            }
        } else {
            let mut i: usize = copy_len
            while i > 0 {
                i -= 1
                self.memory[dst + i] = self.memory[src + i]
            }
        }
    }

    fn calldataload(mut self, _ calldata: ByteBuffer) {
        let offset = self.pop()
        if !self.ok() {
            return
        }

        let mut value: u256 = 0
        let mut i: usize = 0
        while i < 32 {
            value = value << 8
            let index_value = offset + (i as u256)
            if index_value < calldata.len as u256 {
                let index: usize = index_value.downcast_unchecked()
                value = value | (calldata.bytes[index] as u256)
            }
            i += 1
        }
        self.push(value)
    }

    fn calldatacopy(mut self, _ calldata: ByteBuffer) {
        let mem_offset = self.pop()
        let data_offset = self.pop()
        let len = self.pop()
        if !self.ok() {
            return
        }

        if len > MEMORY_LIMIT as u256 {
            self.fault(ERR_MEMORY_LIMIT)
            return
        }

        let copy_len: usize = len.downcast_unchecked()
        let dst = self.ensure_memory(mem_offset, copy_len)
        if !self.ok() {
            return
        }

        let mut i: usize = 0
        while i < copy_len {
            let index_value = data_offset + (i as u256)
            if index_value < calldata.len as u256 {
                let index: usize = index_value.downcast_unchecked()
                self.memory[dst + i] = calldata.bytes[index]
            } else {
                self.memory[dst + i] = 0
            }
            i += 1
        }
    }

    fn returndatacopy(mut self) {
        let mem_offset = self.pop()
        let data_offset = self.pop()
        let len = self.pop()
        if !self.ok() {
            return
        }

        if data_offset != 0 || len != 0 {
            self.fault(ERR_RETURN_DATA_OOB)
            return
        }

        let copy_len: usize = len.downcast_unchecked()
        let _ = self.ensure_memory(mem_offset, copy_len)
    }

    fn finish_from_memory(mut self, _ status: i32) {
        let offset = self.pop()
        let len = self.pop()
        if !self.ok() {
            return
        }

        if len > RETURN_LIMIT as u256 {
            self.fault(ERR_MEMORY_LIMIT)
            return
        }

        let copy_len: usize = len.downcast_unchecked()
        let start = self.ensure_memory(offset, copy_len)
        if !self.ok() {
            return
        }

        let mut i: usize = 0
        while i < copy_len {
            self.output[i] = self.memory[start + i]
            i += 1
        }
        self.output_len = copy_len
        self.output_valid = true
        self.status = status
        self.halted = true
    }

    fn exp(mut self, _ base: u256, _ exponent: u256) {
        let mut result: u256 = 1
        let mut factor = base
        let mut power = exponent
        while power != 0 {
            if power & 1 == 1 {
                result = result.wrapping_mul(factor)
            }
            factor = factor.wrapping_mul(factor)
            power = power >> 1
        }
        self.push(result)
    }

    fn signextend(mut self, _ byte_index: u256, _ value: u256) {
        if byte_index >= 31 {
            self.push(value)
            return
        }

        let bit_index = (byte_index * 8) + 7
        let mask = (1 << (bit_index + 1)) - 1
        if ((value >> bit_index) & 1) == 1 {
            self.push(value | !mask)
        } else {
            self.push(value & mask)
        }
    }

    fn byte(mut self, _ index: u256, _ value: u256) {
        if index >= 32 {
            self.push(0)
            return
        }

        self.push((value >> ((31 - index) * 8)) & 255)
    }

    fn sar(mut self, _ shift: u256, _ value: u256) {
        let signed = ((value >> 255) & 1) == 1
        if shift == 0 {
            self.push(value)
        } else {
            if shift >= 256 {
                if signed {
                    self.push(!(0 as u256))
                } else {
                    self.push(0)
                }
            } else {
                let shifted = value >> shift
                if signed {
                    self.push(shifted | !((1 << (256 - shift)) - 1))
                } else {
                    self.push(shifted)
                }
            }
        }
    }

    fn binary_arith(mut self, _ op: i32) {
        let rhs = self.pop()
        let lhs = self.pop()
        if !self.ok() {
            return
        }

        match op {
            0x01 => self.push(lhs.wrapping_add(rhs)),
            0x02 => self.push(lhs.wrapping_mul(rhs)),
            0x03 => self.push(lhs.wrapping_sub(rhs)),
            0x04 => if rhs == 0 { self.push(0) } else { self.push(lhs / rhs) },
            0x05 => {
                if rhs == 0 {
                    self.push(0)
                } else {
                    let lhs_signed: i256 = lhs.downcast_unchecked()
                    let rhs_signed: i256 = rhs.downcast_unchecked()
                    if lhs_signed == I256_MIN && rhs_signed == -1 {
                        self.push(lhs)
                    } else {
                        let result: u256 = (lhs_signed / rhs_signed).downcast_unchecked()
                        self.push(result)
                    }
                }
            },
            0x06 => if rhs == 0 { self.push(0) } else { self.push(lhs % rhs) },
            0x07 => {
                if rhs == 0 {
                    self.push(0)
                } else {
                    let lhs_signed: i256 = lhs.downcast_unchecked()
                    let rhs_signed: i256 = rhs.downcast_unchecked()
                    if rhs_signed == -1 {
                        self.push(0)
                    } else {
                        let result: u256 = (lhs_signed % rhs_signed).downcast_unchecked()
                        self.push(result)
                    }
                }
            },
            0x08 => {
                let modulus = rhs
                let b = lhs
                let a = self.pop()
                if self.ok() {
                    self.push(addmod(a, b, modulus))
                }
            },
            0x09 => {
                let modulus = rhs
                let b = lhs
                let a = self.pop()
                if self.ok() {
                    self.push(mulmod(a, b, modulus))
                }
            },
            0x0a => self.exp(lhs, rhs),
            0x0b => self.signextend(rhs, lhs),
            0x10 => self.push_bool(lhs < rhs),
            0x11 => self.push_bool(lhs > rhs),
            0x12 => {
                let lhs_signed: i256 = lhs.downcast_unchecked()
                let rhs_signed: i256 = rhs.downcast_unchecked()
                self.push_bool(lhs_signed < rhs_signed)
            },
            0x13 => {
                let lhs_signed: i256 = lhs.downcast_unchecked()
                let rhs_signed: i256 = rhs.downcast_unchecked()
                self.push_bool(lhs_signed > rhs_signed)
            },
            0x14 => self.push_bool(lhs == rhs),
            0x16 => self.push(lhs & rhs),
            0x17 => self.push(lhs | rhs),
            0x18 => self.push(lhs ^ rhs),
            0x1a => self.byte(rhs, lhs),
            0x1b => if rhs >= 256 { self.push(0) } else { self.push(lhs << rhs) },
            0x1c => if rhs >= 256 { self.push(0) } else { self.push(lhs >> rhs) },
            0x1d => self.sar(rhs, lhs),
            _ => self.fault(ERR_UNSUPPORTED_OPCODE),
        }
    }

    fn unary(mut self, _ op: i32) {
        let value = self.pop()
        if !self.ok() {
            return
        }

        match op {
            0x15 => self.push_bool(value == 0),
            0x19 => self.push(!value),
            _ => self.fault(ERR_UNSUPPORTED_OPCODE),
        }
    }

    fn dup(mut self, _ index: usize) {
        if self.sp < index {
            self.fault(ERR_STACK_UNDERFLOW)
            return
        }

        self.push(self.stack[self.sp - index])
    }

    fn swap(mut self, _ index: usize) {
        if self.sp <= index {
            self.fault(ERR_STACK_UNDERFLOW)
            return
        }

        let top = self.sp - 1
        let other = top - index
        let tmp = self.stack[top]
        self.stack[top] = self.stack[other]
        self.stack[other] = tmp
    }

    fn unsupported(mut self, _ op: i32) {
        self.unsupported_opcode = op
        self.fault(ERR_UNSUPPORTED_OPCODE)
    }

    fn todo(mut self, _ op: i32) {
        self.unsupported_opcode = op
        self.fault(ERR_TODO_OPCODE)
    }

    fn invalid(mut self, _ op: i32) {
        self.unsupported_opcode = op
        self.fault(ERR_INVALID_OPCODE)
    }

    fn jump(mut self, _ dest: u256, _ program: Program) {
        if dest >= program.len as u256 {
            self.fault(ERR_INVALID_JUMP)
            return
        }

        let pc: usize = dest.downcast_unchecked()
        if program.bytes[pc] != 0x5b {
            self.fault(ERR_INVALID_JUMP)
            return
        }

        self.pc = pc
    }

    fn step(mut self, _ op: i32, _ program: Program, _ calldata: ByteBuffer, _ call: CallEnv, _ block: BlockEnv) {
        if op == 0x50 {
            let _ = self.pop()
            return
        }

        if (op >= 0x01 && op <= 0x0b) || (op >= 0x10 && op <= 0x1d) {
            if op == 0x15 || op == 0x19 {
                self.unary(op)
            } else {
                self.binary_arith(op)
            }
            return
        }

        if op == 0x20 {
            self.todo(op)
            return
        }

        if op == 0x30 {
            self.push(call.address)
            return
        }

        if op == 0x32 {
            self.push(call.origin)
            return
        }

        if op == 0x33 {
            self.push(call.caller)
            return
        }

        if op == 0x34 {
            self.push(call.callvalue)
            return
        }

        if op == 0x35 {
            self.calldataload(calldata)
            return
        }

        if op == 0x36 {
            self.push(calldata.len as u256)
            return
        }

        if op == 0x37 {
            self.calldatacopy(calldata)
            return
        }

        if op == 0x38 {
            self.push(program.len as u256)
            return
        }

        if op == 0x39 {
            self.codecopy(program)
            return
        }

        if op == 0x3a {
            self.push(call.gasprice)
            return
        }

        if op == 0x3d {
            self.push(0)
            return
        }

        if op == 0x3e {
            self.returndatacopy()
            return
        }

        if op == 0x41 {
            self.push(block.coinbase)
            return
        }

        if op == 0x42 {
            self.push(block.timestamp)
            return
        }

        if op == 0x43 {
            self.push(block.number)
            return
        }

        if op == 0x44 {
            self.push(block.prevrandao)
            return
        }

        if op == 0x45 {
            self.push(block.gaslimit)
            return
        }

        if op == 0x46 {
            self.push(block.chainid)
            return
        }

        if op == 0x47 {
            self.push(call.selfbalance)
            return
        }

        if op == 0x48 {
            self.push(block.basefee)
            return
        }

        if op == 0x4a {
            self.push(block.blobbasefee)
            return
        }

        if op == 0x51 {
            self.mload()
            return
        }

        if op == 0x52 {
            self.mstore()
            return
        }

        if op == 0x53 {
            self.mstore8()
            return
        }

        if op == 0x56 {
            let dest = self.pop()
            if self.ok() {
                self.jump(dest, program)
            }
            return
        }

        if op == 0x57 {
            let dest = self.pop()
            let condition = self.pop()
            if self.ok() && condition != 0 {
                self.jump(dest, program)
            }
            return
        }

        if op == 0x58 {
            self.push((self.pc - 1) as u256)
            return
        }

        if op == 0x59 {
            self.push(self.memory_size as u256)
            return
        }

        if op == 0x5a {
            self.push(call.gas)
            return
        }

        if op == 0x5b {
            return
        }

        if op == 0x5e {
            self.mcopy()
            return
        }

        if op >= 0x80 && op <= 0x8f {
            self.dup((op - 0x7f).downcast_unchecked())
            return
        }

        if op >= 0x90 && op <= 0x9f {
            self.swap((op - 0x8f).downcast_unchecked())
            return
        }

        if op == 0xf3 {
            self.finish_from_memory(OK)
            return
        }

        if op == 0xfd {
            self.finish_from_memory(ERR_REVERT)
            return
        }

        if is_todo_opcode(op) {
            self.todo(op)
        } else {
            if op == 0xfe {
                self.invalid(op)
            } else {
                self.unsupported(op)
            }
        }
    }
}

fn is_todo_opcode(_ op: i32) -> bool {
    if op == 0x20 {
        return true
    }
    if op == 0x31 {
        return true
    }
    if op == 0x3b || op == 0x3c || op == 0x3f {
        return true
    }
    if op == 0x40 || op == 0x49 {
        return true
    }
    if op >= 0x5c && op <= 0x5d {
        return true
    }
    if op >= 0xa0 && op <= 0xa4 {
        return true
    }
    if op == 0xf0 || op == 0xf1 || op == 0xf2 || op == 0xf4 || op == 0xf5 {
        return true
    }
    op == 0xfa || op == 0xff
}

fn read_push_value(_ vm: mut Vm, _ program: Program, _ len: usize) -> u256 {
    if vm.pc + len > program.len {
        vm.fault(ERR_TRUNCATED_PUSH)
        return 0
    }

    let mut value: u256 = 0
    let mut i: usize = 0
    while i < len {
        value = (value << 8) | (program.bytes[vm.pc] as u256)
        vm.pc += 1
        i += 1
    }
    value
}

fn execute_vm(_ program: Program, _ calldata: ByteBuffer, _ call: CallEnv, _ block: BlockEnv) -> Vm {
    let mut vm = Vm::new()
    while vm.pc < program.len && vm.ok() && !vm.halted {
        let op = program.bytes[vm.pc] as i32
        vm.pc += 1

        if op == 0x00 {
            vm.halted = true
            return vm
        }

        if op == 0x5f {
            vm.push(0)
        } else {
            if op >= 0x60 && op <= 0x7f {
                let len: usize = (op - 0x5f).downcast_unchecked()
                let value = read_push_value(mut vm, program, len)
                if vm.ok() {
                    vm.push(value)
                }
            } else {
                vm.step(op, program, calldata, call, block)
            }
        }
    }
    vm
}

fn vm_result(_ vm: Vm) -> ExecutionResult {
    let stack_top: u256 = if vm.sp == 0 { 0 } else { vm.stack[vm.sp - 1] }
    ExecutionResult {
        status: vm.status,
        output: ByteBuffer { bytes: vm.output, len: vm.output_len, status: OK },
        output_valid: vm.output_valid,
        stack_top: stack_top,
        stack_len: vm.sp,
        unsupported_opcode: vm.unsupported_opcode,
    }
}

pub fn execute(_ program: Program, _ calldata: ByteBuffer, _ call: CallEnv, _ block: BlockEnv) -> ExecutionResult {
    vm_result(execute_vm(program, calldata, call, block))
}

fn usage() -> i32
uses (w: mut Write)
{
    writeln("usage: fevm <hex-bytecode> [hex-calldata]")
    ERR_USAGE
}

fn write_parse_error(_ status: i32)
uses (w: mut Write)
{
    match status {
        ERR_BAD_HEX => writeln("invalid hex bytecode"),
        ERR_ODD_HEX => writeln("hex bytecode has an odd number of digits"),
        ERR_CODE_TOO_LONG => writeln("bytecode is too large"),
        _ => writeln("failed to parse bytecode"),
    }
}

fn write_vm_error(_ vm: Vm)
uses (w: mut Write)
{
    match vm.status {
        ERR_STACK_UNDERFLOW => writeln("stack underflow"),
        ERR_STACK_OVERFLOW => writeln("stack overflow"),
        ERR_TRUNCATED_PUSH => writeln("truncated push data"),
        ERR_TODO_OPCODE => {
            write("todo opcode 0x")
            write_hex_byte(vm.unsupported_opcode)
            write(" ")
            write_opcode_name(vm.unsupported_opcode)
            write_char(10)
        },
        ERR_MEMORY_LIMIT => writeln("memory limit exceeded"),
        ERR_INVALID_JUMP => writeln("invalid jump destination"),
        ERR_INVALID_OPCODE => writeln("invalid opcode"),
        ERR_RETURN_DATA_OOB => writeln("return data out of bounds"),
        ERR_REVERT => {
            write("revert ")
            write_hex_bytes(vm.output, vm.output_len)
        },
        ERR_UNSUPPORTED_OPCODE => {
            write("unsupported opcode 0x")
            write_hex_byte(vm.unsupported_opcode)
            write(" ")
            write_opcode_name(vm.unsupported_opcode)
            write_char(10)
        },
        _ => writeln("execution failed"),
    }
}

fn write_result(_ vm: Vm)
uses (w: mut Write)
{
    if vm.output_valid {
        write_hex_bytes(vm.output, vm.output_len)
    } else {
        if vm.sp == 0 {
            writeln("empty")
        } else {
            write_hex_u256(vm.stack[vm.sp - 1])
        }
    }
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    let args = Args::new(argc, argv)
    with (Write = host()) {
        if args.len() != 2 && args.len() != 3 {
            return usage()
        }

        let program = parse_hex_program(args.get(1))
        if program.status != OK {
            write_parse_error(program.status)
            return program.status
        }

        let mut calldata = empty_bytes()
        if args.len() == 3 {
            calldata = parse_hex_bytes(args.get(2))
            if calldata.status != OK {
                write_parse_error(calldata.status)
                return calldata.status
            }
        }

        let vm = execute_vm(program, calldata, default_call_env(), default_block_env())
        if vm.status != OK {
            write_vm_error(vm)
            return vm.status
        }

        write_result(vm)
        OK
    }
}
