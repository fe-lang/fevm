use core::MemBuffer
use std::text::decode_hex
use fevm::{Config, WorldState}
use fevm::status::{INVALID_CHAIN_ID, OK}
use ingot::chain::{Chain, Import, InvalidBlock}
use ingot::header::{Header, HeaderError}
use ingot::schedule::Schedule
use ingot::transaction::TxError
use ingot::trie::state_root

// tests@v21.0.2 blockchain test for_osaka/prague/eip6110_deposits/
// modified_contract/extra_logs.json, test_extra_logs[fork_Osaka-
// blockchain_test-include_deposit_event_False-extra_event_type_no_topics]:
// one block, with one legacy transaction to a deposit contract that logs
// without topics. Values are the fixture's.
const GENESIS_HASH: u256 = 0x61979677223ceeb59138bb828d0e33e39ddeea85b97c23e40f3947b4efcc4a07
pub const GENESIS_STATE_ROOT: u256 = 0x2ebebbe1694cc72a21e11e3de347718483bc8a5a869c56b64b60dd20465f190a
const BLOCK_HASH: u256 = 0xe43ff24c24407cf8dd078e3b28ec0dca10e84ba8df974b914f24f43171be874b
pub const BLOCK_STATE_ROOT: u256 = 0x6b5d84825a86e8cdd9f50caf3beac633d810ef47100437c5fd63d9d0e105d50d
const BLOCK_GAS_USED: u64 = 0x5488

// Where the block's state root, receipts root, difficulty and its
// transaction's s begin in its RLP.
const STATE_ROOT_AT: usize = 94
const RECEIPTS_ROOT_AT: usize = 160
const DIFFICULTY_AT: usize = 451
const SIGNATURE_S_AT: usize = 675

// The fixture's `pre`.
pub fn genesis_world() -> WorldState {
    var world = WorldState::empty()
    let history = decode_hex("0x3373fffffffffffffffffffffffffffffffffffffffe14604657602036036042575f35600143038111604257611fff81430311604257611fff9006545f5260205ff35b5f5ffd5b5f35611fff60014303065500").unwrap()
    let consolidations = decode_hex("").unwrap()
    let withdrawals = decode_hex("").unwrap()
    let deposits = decode_hex("0x60206000a000").unwrap()
    let beacon_roots = decode_hex("0x3373fffffffffffffffffffffffffffffffffffffffe14604d57602036146024575f5ffd5b5f35801560495762001fff810690815414603c575f5ffd5b62001fff01545f5260205ff35b5f5ffd5b62001fff42064281555f359062001fff015500").unwrap()
    let contracts: [u256; 5] = [
        0x0000f90827f1c53a10cb7a02335b175320002935, 0x0000bbddc7ce488642fb579f8b00f3a590007251,
        0x00000961ef480eb55e80d19ad83579a64c007002, 0x00000000219ab540356cbb839cbe05303d7705fa,
        0x000f3df6d732807ef1319fb7b8bb8522d0beac02,
    ]
    let codes = [history, consolidations, withdrawals, deposits, beacon_roots]
    for index in 0..5 {
        core::assert(world.set_nonce(contracts[index], 1))
        core::assert(world.set_code(address: contracts[index], code: codes[index].span()) == OK)
    }
    // The deposit contract's slots 0x22 to 0x40.
    let slots: [u256; 31] = [
        0xf5a5fd42d16a20302798ef6ed309979b43003d2320d9f0e8ea9831a92759fb4b, 0xdb56114e00fdd4c1f85c892bf35ac9a89289aaecb1ebd0a96cde606a748b5d71,
        0xc78009fdf07fc56a11f122370658a353aaa542ed63e44c4bc15ff4cd105ab33c, 0x536d98837f2dd165a55d5eeae91485954472d56f246df256bf3cae19352a123c,
        0x9efde052aa15429fae05bad4d0b1d7c64da64d03d7a1854a588c2cb8430c0d30, 0xd88ddfeed400a8755596b21942c1497e114c302e6118290f91e6772976041fa1,
        0x87eb0ddba57e35f6d286673802a4af5975e22506c7cf4c64bb6be5ee11527f2c, 0x26846476fd5fc54a5d43385167c95144f2643f533cc85bb9d16b782f8d7db193,
        0x506d86582d252405b840018792cad2bf1259f1ef5aa5f887e13cb2f0094f51e1, 0xffff0ad7e659772f9534c195c815efc4014ef1e1daed4404c06385d11192e92b,
        0x6cf04127db05441cd833107a52be852868890e4317e6a02ab47683aa75964220, 0xb7d05f875f140027ef5118a2247bbb84ce8f2f0f1123623085daf7960c329f5f,
        0xdf6af5f5bbdb6be9ef8aa618e4bf8073960867171e29676f8b284dea6a08a85e, 0xb58d900f5e182e3c50ef74969ea16c7726c549757cc23523c369587da7293784,
        0xd49a7502ffcfb0340b1d7885688500ca308161a7f96b62df9d083b71fcc8f2bb, 0x8fe6b1689256c0d385f42f5bbe2027a22c1996e110ba97c171d3e5948de92beb,
        0x8d0d63c39ebade8509e0ae3c9c3876fb5fa112be18f905ecacfecb92057603ab, 0x95eec8b2e541cad4e91de38385f2e046619f54496c2382cb6cacd5b98c26f5a4,
        0xf893e908917775b62bff23294dbbe3a1cd8e6cc1c35b4801887b646a6f81f17f, 0xcddba7b592e3133393c16194fac7431abf2f5485ed711db282183c819e08ebaa,
        0x8a8d7fe3af8caa085a7639a832001457dfb9128a8061142ad0335629ff23ff9c, 0xfeb3c337d7a51a6fbf00b9e34c52e1c9195c969bd4e7a0bfd51d5c5bed9c1167,
        0xe71f0aa83cc32edfbefa9f4d3e0174ca85182eec9f3a09f6a6c0df6377a510d7, 0x31206fa80a50bb6abe29085058f16212212a60eec8f049fecb92d8c8e0a84bc0,
        0x21352bfecbeddde993839f614c3dac0a3ee37543f9b412b16199dc158e23b544, 0x619e312724bb6d7c3153ed9de791d764a366b389af13c58bf8a8d90481a46765,
        0x7cdd2986268250628d0c10e385c58c6191e6fbe05191bcc04f133f2cea72c1c4, 0x848930bd7ba8cac54661072113fb278869e07bb8587f91392933374d017bcbe1,
        0x8869ff2c22b28cc10510d9853292803328be4fb0e80495e8bb8d271f5b889636, 0xb5fe28e79f1b850f8658246ce9b6a1e7b49fc06db7143e8fe0b4f2b0c5523a5c,
        0x985e929f70af28d0bdd1a90a808f977f597c7c778c489e98d3bd8910d31ac0f7,
    ]
    for index in 0..31 { core::assert(world.storage_store(contracts[3], 0x22 + index as u256, slots[index])) }
    core::assert(world.set_balance(0xf6c3a9edc1afa0ad5b720e4d42e1437c43d3b3ff, 0x033b2e3c9fd0803ce8000000))
    world
}

// The fixture's chain at genesis, on chain `chain_id`; its own is 1.
pub fn genesis(chain_id: u256) -> Chain {
    // The first item of the fixture's `genesisRLP`.
    let header = decode_hex("").unwrap()
    let genesis = Header::decode(header.span()).unwrap()
    Chain::new(genesis_world(), Schedule::new(Config::osaka()), chain_id, genesis)
}

// The fixture's block, with the byte at `at` set to `byte` unless `at` is
// past its end.
fn block(at: usize, byte: u8) -> MemBuffer {
    var rlp = MemBuffer::from_span(decode_hex("").unwrap().span())
    if at < rlp.len() { rlp[at] = byte }
    rlp
}

pub fn valid() -> MemBuffer { block(at: usize::max(), byte: 0) }

// Whether `chain` is still at genesis, with the genesis state.
fn at_genesis(_ chain: Chain) -> bool {
    var world = chain.world().try_clone().unwrap()
    chain.head().hash == GENESIS_HASH && state_root(mut world).unwrap() == GENESIS_STATE_ROOT
}

// Whether importing `rlp` into the chain at genesis is invalid for
// `reason`, leaves the chain at genesis, and the valid block can follow.
fn rejects(_ rlp: MemBuffer, _ reason: InvalidBlock) -> bool {
    var chain = genesis(chain_id: 1)
    core::assert(at_genesis(chain))
    var tracer = ()
    let rejected = match (chain.import(rlp.span(), mut tracer), reason) {
        (Import::Invalid(InvalidBlock::StateRoot), InvalidBlock::StateRoot) => true,
        (Import::Invalid(InvalidBlock::ReceiptsRoot), InvalidBlock::ReceiptsRoot) => true,
        (Import::Invalid(InvalidBlock::Header(HeaderError::Difficulty)),
         InvalidBlock::Header(HeaderError::Difficulty)) => true,
        (Import::Invalid(InvalidBlock::Undecodable(0, TxError::InvalidSignature)),
         InvalidBlock::Undecodable(0, TxError::InvalidSignature)) => true,
        (Import::Invalid(InvalidBlock::Undecodable(0, TxError::Malformed)),
         InvalidBlock::Undecodable(0, TxError::Malformed)) => true,
        _ => false,
    }
    if !rejected || !at_genesis(chain) { return false }
    match chain.import(valid().span(), mut tracer) {
        Import::Valid(_) => chain.head().hash == BLOCK_HASH,
        _ => false,
    }
}

#[test]
fn chain_imports_a_valid_block() {
    var chain = genesis(chain_id: 1)
    core::assert(at_genesis(chain))
    var tracer = ()
    match chain.import(valid().span(), mut tracer) {
        Import::Valid(imported) => {
            core::assert(imported.output.gas_used == BLOCK_GAS_USED && imported.receipts.len() == 1)
            let receipt = ref imported.receipts[0]
            core::assert(receipt.status == OK && receipt.cumulative_gas_used == BLOCK_GAS_USED)
            core::assert(imported.receipts[0].logs.len() == 1)
        },
        _ => core::assert(false),
    }
    var world = chain.world().try_clone().unwrap()
    core::assert(chain.head().hash == BLOCK_HASH && chain.head().number == 1)
    core::assert(state_root(mut world).unwrap() == BLOCK_STATE_ROOT)
    // The head's child must be block 2: the block again is not.
    match chain.import(valid().span(), mut tracer) {
        Import::Invalid(InvalidBlock::Header(_)) => {},
        _ => core::assert(false),
    }
    core::assert(chain.head().hash == BLOCK_HASH)
}

#[test]
fn chain_rejects_a_wrong_state_root() {
    core::assert(rejects(block(at: STATE_ROOT_AT, byte: 0x6c), InvalidBlock::StateRoot))
}

#[test]
fn chain_rejects_a_wrong_receipts_root() {
    core::assert(rejects(block(at: RECEIPTS_ROOT_AT, byte: 0x72), InvalidBlock::ReceiptsRoot))
}

#[test]
fn chain_rejects_a_header_fault() {
    // A difficulty of 1, which proof of stake's must not be.
    core::assert(rejects(block(at: DIFFICULTY_AT, byte: 0x01), InvalidBlock::Header(HeaderError::Difficulty)))
}

#[test]
fn chain_rejects_an_undecodable_transaction() {
    // An s above half the curve order (EIP-2).
    let high_s = block(at: SIGNATURE_S_AT, byte: 0xff)
    core::assert(rejects(high_s, InvalidBlock::Undecodable(0, TxError::InvalidSignature)))
}

#[test]
fn chain_rejects_a_legacy_transaction_in_a_string() {
    // The block with its transaction's list as a string, b862 and the list.
    let wrapped = decode_hex("").unwrap()
    core::assert(rejects(MemBuffer::from_span(wrapped.span()), InvalidBlock::Undecodable(0, TxError::Malformed)))
}

#[test]
fn chain_rejects_an_invalid_transaction() {
    // On chain 2, the transaction signed for chain 1 is invalid, after the
    // block's system calls have written the beacon root.
    var chain = genesis(chain_id: 2)
    var tracer = ()
    match chain.import(valid().span(), mut tracer) {
        Import::Invalid(InvalidBlock::Transaction(0, invalid)) => core::assert(invalid == INVALID_CHAIN_ID),
        _ => core::assert(false),
    }
    core::assert(at_genesis(chain))
}
