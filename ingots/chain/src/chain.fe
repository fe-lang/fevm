// A chain of blocks on one world: importing a block from its RLP, and the
// steps of it that validating one from a witness shares.
use core::{MemSpan, MemVec, Option, Result}
use fevm::{
    Block, BlockChanges, BlockEnv, BlockError, BlockOutput, Config, Evm, Receipt, StateSource, Withdrawal, WorldState,
}
use fevm::status::{ERR_HOST_ALLOCATION, VALID, is_evm_outcome}
use fevm::trace::Tracer
use fevm_rlp::Decoder
use ingot::header::{Header, HeaderError}
use ingot::receipt::encode_receipt
use ingot::schedule::Schedule
use ingot::state_trie::{Nodes, StateTrie, world_account}
use ingot::transaction::{TxError, decode_transaction}
use ingot::trie::Trie

// EIP-7934: the longest block RLP, 10 MiB less a 2 MiB margin.
const MAX_RLP_BLOCK_SIZE: usize = 8_388_608

pub(ingot) const ALLOCATION: HostFailure = HostFailure::Status(ERR_HOST_ALLOCATION)

/// Why a block is invalid: the first rule it breaks, in the order the
/// specification checks them (`execute_block`).
pub enum InvalidBlock {
    /// EIP-7934: its RLP is longer than 8,388,608 bytes.
    TooLarge,
    /// Its RLP is not `[header, transactions, ommers, withdrawals]`, or its
    /// header or a withdrawal does not decode.
    Malformed,
    /// The header is not a valid child of the head. Never `Allocation`.
    Header(HeaderError),
    /// It has ommers.
    Ommers,
    /// The transaction at an index does not decode. Never `Allocation`.
    Undecodable(usize, TxError),
    /// The transaction at an index is invalid, with its validity code.
    Transaction(usize, i32),
    /// A request contract is missing or failed, a deposit is malformed, or
    /// the access list is too large. Never `Host`.
    Execution(BlockError),
    /// A value the header commits to is not the block's.
    GasUsed,
    TransactionsRoot,
    StateRoot,
    ReceiptsRoot,
    LogsBloom,
    WithdrawalsRoot,
    BlobGasUsed,
    RequestsHash,
    AccessListHash,
}

impl Copy for InvalidBlock {}

/// Why a block could not be judged, which is no verdict on it.
pub enum HostFailure {
    /// A host status, such as an allocation failure or a balance past 2^256.
    Status(i32),
    /// The blob base fee is past what `blob_base_fee` computes.
    BlobBaseFee,
}

impl Copy for HostFailure {}

/// A valid block's receipts and output.
pub struct Imported { pub receipts: MemVec<Receipt>, pub output: BlockOutput }

/// What importing a block gives. Only a valid block changes the chain.
pub enum Import {
    Valid(Imported),
    Invalid(InvalidBlock),
    Failed(HostFailure),
}

/// A chain from Osaka on: the world after its head block, which only a
/// valid child of the head replaces, and the state trie of that world. It
/// keeps one head and no side branches.
pub struct Chain { evm: Evm, trie: StateTrie, schedule: Schedule, chain_id: u256, head: Header }

// The next transaction as a block carries it: a legacy one's list, or a
// typed one's string, without its header, of its type and payload.
fn next_transaction(_ transactions: mut Decoder) -> ref MemSpan uses (rlp: MemSpan) {
    if transactions.is_list() { return transactions.raw() }
    transactions.bytes()
}

// The first value the header commits to that is not what the block gives, in
// the specification's order (`execute_block`); none if all are.
pub(ingot) fn mismatch(_ header: Header, _ output: BlockOutput, transactions_root: u256, state_root: u256,
                       receipts_root: u256, withdrawals_root: u256) -> Option<InvalidBlock> {
    let access_list_hash = match output.access_list {
        Option::Some(ref list) => Option::Some(list.hash),
        Option::None => Option::None,
    }
    if output.gas_used != header.gas_used { return Option::Some(InvalidBlock::GasUsed) }
    if transactions_root != header.transactions_root { return Option::Some(InvalidBlock::TransactionsRoot) }
    if state_root != header.state_root { return Option::Some(InvalidBlock::StateRoot) }
    if receipts_root != header.receipt_root { return Option::Some(InvalidBlock::ReceiptsRoot) }
    if output.logs_bloom.words != header.bloom.words { return Option::Some(InvalidBlock::LogsBloom) }
    if withdrawals_root != header.withdrawals_root { return Option::Some(InvalidBlock::WithdrawalsRoot) }
    if output.blob_gas_used != header.blob_gas_used { return Option::Some(InvalidBlock::BlobGasUsed) }
    if output.requests_hash != header.requests_hash { return Option::Some(InvalidBlock::RequestsHash) }
    if access_list_hash != header.block_access_list_hash { return Option::Some(InvalidBlock::AccessListHash) }
    Option::None
}

// A block's RLP, past EIP-7934's size limit and decoded but for its
// transactions, which decode as they run: its header, its withdrawals with
// their trie, and whether it has ommers; or why it is invalid, or an
// allocation failure. Never `Valid`.
pub(ingot) fn decode_block(_ rlp: MemSpan) -> Result<Import, (Header, MemVec<Withdrawal>, Trie, bool)> {
    if rlp.len() > MAX_RLP_BLOCK_SIZE { return Result::Err(Import::Invalid(InvalidBlock::TooLarge)) }
    with (rlp) {
        var items = Decoder::new()
        let body = mut items.list()
        let decoded = Header::decode(body.raw())
        // Transactions decode as they run, after the header is checked.
        let transactions = mut body.list()
        while !transactions.is_empty() { let _ = transactions.raw() }
        // Any ommer makes the block invalid, so they are not decoded.
        let ommers = mut body.list()
        let has_ommers = !ommers.is_empty()
        while !ommers.is_empty() { let _ = ommers.raw() }
        var withdrawals: MemVec<Withdrawal> = MemVec::new()
        var withdrawals_trie = Trie::new()
        var malformed = false
        var allocated = true
        let list = mut body.list()
        while !list.is_empty() {
            let item = list.raw()
            withdrawals_trie.item().raw(item)
            with (item) {
                // [index, validator index, address, amount in gwei]
                var fields = Decoder::new()
                let withdrawal = mut fields.list()
                withdrawal.u64()
                withdrawal.u64()
                let address = withdrawal.fixed(20)
                let amount = withdrawal.u64()
                malformed = malformed || !fields.finish()
                allocated = allocated && withdrawals.try_push(Withdrawal { address, amount }).is_ok()
            }
        }
        if !items.finish() || malformed { return Result::Err(Import::Invalid(InvalidBlock::Malformed)) }
        let header = match decoded {
            Result::Ok(header) => header,
            Result::Err(HeaderError::Allocation) => return Result::Err(Import::Failed(ALLOCATION)),
            Result::Err(_) => return Result::Err(Import::Invalid(InvalidBlock::Malformed)),
        }
        if !allocated { return Result::Err(Import::Failed(ALLOCATION)) }
        Result::Ok((header, withdrawals, withdrawals_trie, has_ommers))
    }
}

// The values for executing the block `header` heads, which has `ommers` or
// none, on chain `chain_id` by `config`, the rules in force at its
// timestamp, once its header is checked against `parent` and it is checked
// to have no ommers; or why it is invalid, or that its blob base fee is past
// computing. Never `Valid`.
pub(ingot) fn checked_env(_ header: Header, _ parent: Header, _ config: Config, ommers: bool, chain_id: u256)
    -> Result<Import, BlockEnv> {
    if let Result::Err(error) = header.validate(parent, config) {
        return Result::Err(Import::Invalid(InvalidBlock::Header(error)))
    }
    if ommers { return Result::Err(Import::Invalid(InvalidBlock::Ommers)) }
    match header.block_env(chain_id, config) {
        Option::Some(env) => Result::Ok(env),
        Option::None => Result::Err(Import::Failed(HostFailure::BlobBaseFee)),
    }
}

/// What a block's body gives once run: its receipts and output, and the
/// roots of its transactions, receipts and withdrawals, none if an
/// allocation failed.
pub(ingot) struct Ran {
    pub(ingot) receipts: MemVec<Receipt>,
    pub(ingot) output: BlockOutput,
    pub(ingot) roots: Option<(u256, u256, u256)>,
}

// Runs the body of the block `header` heads, whose transactions are the
// second item of `rlp`, through `Block` on `evm`'s world, over any source:
// its system calls, then its transactions, decoding each and recovering its
// sender as it comes to it (`tracer` sees them run), then its withdrawals and
// requests. A host failure as the block begins stops it before its
// transactions. Gives the `Evm` back with what the body gives; or, having
// undone the block, why it is invalid or could not be run, never `Valid`.
pub(ingot) fn run<S: StateSource, T: Tracer>(_ evm: own Evm<S>, _ header: Header, _ env: BlockEnv,
                                            _ withdrawals: own MemVec<Withdrawal>, _ withdrawals_trie: own Trie,
                                            _ tracer: mut T) -> (Evm<S>, Result<Import, Ran>) uses (rlp: MemSpan) {
    var block = Block<S>::begin(evm, env, parent_hash: header.parent_hash,
                                parent_beacon_block_root: header.parent_beacon_block_root)
    var transactions_trie = Trie::new()
    var receipts_trie = Trie::new()
    var receipts: MemVec<Receipt> = MemVec::new()
    var fault: Option<Import> = match block.failure() {
        Option::Some(BlockError::Host(status)) => Option::Some(Import::Failed(HostFailure::Status(status))),
        _ => Option::None,
    }
    var items = Decoder::new()
    let body = mut items.list()
    let _ = body.raw()
    let transactions = mut body.list()
    var index: usize = 0
    while fault.is_none() && !transactions.is_empty() {
        // A string that holds a list, a legacy transaction wrapped as a
        // typed one, is malformed in every fork: EELS's Amsterdam
        // `decode_transaction` takes it, but it makes block bodies
        // malleable, and clients reject it.
        let typed = !transactions.is_list()
        let tx = next_transaction(mut transactions)
        transactions_trie.item().raw(tx)
        let decoded = if typed && tx.len() != 0 && tx[0] >= 0xc0 { Result::Err(TxError::Malformed) }
            else { decode_transaction(tx) }
        fault = match decoded {
            Result::Err(TxError::Allocation) => Option::Some(Import::Failed(ALLOCATION)),
            Result::Err(error) => Option::Some(Import::Invalid(InvalidBlock::Undecodable(index, error))),
            Result::Ok((request, _)) => {
                let receipt = block.transact(request, mut tracer)
                if receipt.invalid != VALID {
                    Option::Some(Import::Invalid(InvalidBlock::Transaction(index, receipt.invalid)))
                } else if !is_evm_outcome(receipt.status) {
                    Option::Some(Import::Failed(HostFailure::Status(receipt.status)))
                } else {
                    encode_receipt(mut receipts_trie.item(), receipt, kind: request.env.kind)
                    if receipts.try_push(receipt).is_ok() { Option::None }
                        else { Option::Some(Import::Failed(ALLOCATION)) }
                }
            },
        }
        index += 1
    }
    if let Option::Some(fault) = fault {
        // A host failure as the block began, or in an earlier
        // transaction's deposits, came first.
        let failure = block.failure()
        let evm = block.abandon()
        return (evm, Result::Err(match failure {
            Option::Some(BlockError::Host(status)) => Import::Failed(HostFailure::Status(status)),
            _ => fault,
        }))
    }
    let (evm, finished) = block.finish(withdrawals)
    let output = match finished {
        Result::Ok(output) => output,
        Result::Err(BlockError::Host(status)) => return (evm, Result::Err(Import::Failed(HostFailure::Status(status)))),
        Result::Err(error) => return (evm, Result::Err(Import::Invalid(InvalidBlock::Execution(error)))),
    }
    let roots = match (transactions_trie.root(), receipts_trie.root(), withdrawals_trie.root()) {
        (Option::Some(transactions), Option::Some(receipts), Option::Some(withdrawals)) => {
            Option::Some((transactions, receipts, withdrawals))
        },
        _ => Option::None,
    }
    (evm, Result::Ok(Ran { receipts, output, roots }))
}

impl Chain {
    /// A chain at `genesis`, whose state is `world`, whose nonces are under
    /// 2^64, with the forks of `schedule`.
    pub fn new(_ world: own WorldState, _ schedule: own Schedule, chain_id: u256, genesis: own Header) -> Self {
        var evm = Evm::new(world, schedule.config_at(genesis.timestamp))
        let trie = StateTrie::new(mut evm.world_mut())
        Chain { evm, trie, schedule, chain_id, head: genesis }
    }

    pub fn head(self) -> ref Header { ref self.head }
    pub fn world(self) -> ref WorldState { self.evm.world() }
    pub fn schedule(self) -> ref Schedule { ref self.schedule }
    pub fn chain_id(self) -> u256 { self.chain_id }

    /// The state root of the head's world, from its trie. A trie that an
    /// allocation failed is rebuilt from the world here; none if that fails
    /// too.
    pub fn state_root(mut self) -> Option<u256> {
        if let Result::Ok(root) = self.trie.root() { return Option::Some(root) }
        // The failed trie goes before its replacement is built.
        var none = WorldState::empty()
        self.trie = StateTrie::new(mut none)
        self.trie = StateTrie::new(mut self.evm.world_mut())
        self.trie.root().ok()
    }

    /// Adds to `nodes` each node of the head's state trie that is reached by
    /// its hash: a witness of the whole state. False if an allocation fails.
    pub fn write_nodes(mut self, _ nodes: mut Nodes) -> bool {
        self.state_root().is_some() && self.trie.write_nodes(mut nodes)
    }

    /// Imports the block `rlp` encodes as the head's child, by the rules of
    /// the fork in force at its timestamp: checks its size and decoding, its
    /// header against the head, runs its transactions, which `tracer` sees,
    /// and its withdrawals, and compares what they give with its header. An
    /// invalid block, or one a host failure stops, leaves the chain as it was.
    pub fn import<T: Tracer>(mut self, _ rlp: MemSpan, _ tracer: mut T) -> Import {
        let (header, withdrawals, withdrawals_trie, ommers) = match decode_block(rlp) {
            Result::Ok(block) => block,
            Result::Err(rejected) => return rejected,
        }
        let config = self.schedule.config_at(header.timestamp)
        let env = match checked_env(header, self.head, config, ommers, chain_id: self.chain_id) {
            Result::Ok(env) => env,
            Result::Err(rejected) => return rejected,
        }
        // The trie, rebuilt if it failed, holds the world the block begins on.
        if self.state_root().is_none() { return Import::Failed(ALLOCATION) }
        self.evm.set_config(config)
        let verdict = with (rlp) { self.execute(header, env, withdrawals, withdrawals_trie, mut tracer) }
        if let Import::Valid(_) = verdict { self.head = header }
        verdict
    }

    // Runs the block `header` heads, whose transactions are the second item
    // of `rlp`, on the head's world, and compares what it gives with the
    // header; undoes it unless it is valid. `run` holds the `Evm` until it
    // gives it back: `self.evm` is a hole until then.
    fn execute<T: Tracer>(mut self, _ header: Header, _ env: BlockEnv, _ withdrawals: own MemVec<Withdrawal>,
                          _ withdrawals_trie: own Trie, _ tracer: mut T) -> Import uses (rlp: MemSpan) {
        let (evm, ran) = run(self.evm, header, env, withdrawals, withdrawals_trie, mut tracer)
        self.evm = evm
        let ran = match ran {
            Result::Ok(ran) => ran,
            Result::Err(rejected) => return rejected,
        }
        write_changes(mut self.trie, mut self.evm.world_mut(), ran.output.changes)
        let (Option::Some((transactions_root, receipts_root, withdrawals_root)), Result::Ok(state)) =
            (ran.roots, self.trie.root()) else {
            self.undo(ran.output.changes)
            return Import::Failed(ALLOCATION)
        }
        match mismatch(header, ran.output, transactions_root, state_root: state, receipts_root, withdrawals_root) {
            Option::Some(reason) => {
                self.undo(ran.output.changes)
                Import::Invalid(reason)
            },
            Option::None => Import::Valid(Imported { receipts: ran.receipts, output: ran.output }),
        }
    }

    // Puts the world back as it was before the block of `changes`, and the
    // trie with it.
    fn undo(mut self, _ changes: BlockChanges) {
        changes.undo(mut self.evm.world_mut())
        write_changes(mut self.trie, mut self.evm.world_mut(), changes)
    }
}

// Sets in `trie` each account and slot `changes` names as `world` holds it:
// the accounts that exist at the end, then the removals of those that do
// not, whose slots go with them and then change nothing; then the slots that
// hold a value at the end, then the removals of those that do not. An
// account settlement deleted that exists in `world` has its storage cleared
// first, since its slots need not all be named: removing its leaf and
// adding it again could collapse a branch the state still has, onto a
// sibling a partial trie may not hold.
//
// Sets go before removals so that what the trie reads does not depend on
// the order the block made its changes in. Once every set is done, the
// children of any branch can only shrink, so a branch that is left with one
// child during the removals either ends with that child, and then every
// implementation must read it and a witness holds it, or loses it to a
// later removal, and then a touched key lies under it and a witness holds
// it. In the other order a branch can pass through one child and end with
// two, and that read is this trie's alone.
pub(ingot) fn write_changes(_ trie: mut StateTrie, _ world: mut WorldState, _ changes: BlockChanges) {
    for removing in [false, true] {
        for account in changes.accounts() {
            if world.exists(account.address) == removing { continue }
            if account.cleared && !removing { trie.clear_storage(account.address) }
            trie.set_account(account.address, world_account(mut world, account.address))
        }
    }
    for removing in [false, true] {
        for slot in changes.slots() {
            let value = world.storage_load(slot.address, slot.slot)
            if (value == 0) == removing { trie.set_slot(address: slot.address, slot: slot.slot, value) }
        }
    }
}
