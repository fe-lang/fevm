// A chain of blocks on one world: importing a block from its RLP.
use core::{MemSpan, MemVec, Option, Result}
use fevm::{Block, BlockEnv, BlockError, BlockOutput, Evm, Receipt, Withdrawal, WorldState}
use fevm::status::{ERR_HOST_ALLOCATION, VALID, is_evm_outcome}
use fevm::trace::Tracer
use fevm_rlp::Decoder
use ingot::header::{Header, HeaderError}
use ingot::receipt::encode_receipt
use ingot::schedule::Schedule
use ingot::transaction::{TxError, decode_transaction}
use ingot::trie::{Trie, state_root}

// EIP-7934: the longest block RLP, 10 MiB less a 2 MiB margin.
const MAX_RLP_BLOCK_SIZE: usize = 8_388_608

const ALLOCATION: HostFailure = HostFailure::Status(ERR_HOST_ALLOCATION)

/// Why a block is invalid: the first rule it breaks, in the order the
/// specification checks them (`execute_block`).
pub enum InvalidBlock {
    /// EIP-7934: its RLP is longer than 8,388,608 bytes.
    TooLarge,
    /// Its RLP is not `[header, transactions, ommers, withdrawals]`, or its
    /// header or a withdrawal does not decode.
    Malformed,
    /// The header is not a valid child of the head. Never `Allocation`.
    Header(HeaderError),
    /// It has ommers.
    Ommers,
    /// The transaction at an index does not decode. Never `Allocation`.
    Undecodable(usize, TxError),
    /// The transaction at an index is invalid, with its validity code.
    Transaction(usize, i32),
    /// A request contract is missing or failed, a deposit is malformed, or
    /// the access list is too large. Never `Host`.
    Execution(BlockError),
    /// A value the header commits to is not the block's.
    GasUsed,
    TransactionsRoot,
    StateRoot,
    ReceiptsRoot,
    LogsBloom,
    WithdrawalsRoot,
    BlobGasUsed,
    RequestsHash,
    AccessListHash,
}

impl Copy for InvalidBlock {}

/// Why a block could not be judged, which is no verdict on it.
pub enum HostFailure {
    /// A host status, such as an allocation failure or a balance past 2^256.
    Status(i32),
    /// The blob base fee is past what `blob_base_fee` computes.
    BlobBaseFee,
}

impl Copy for HostFailure {}

/// A valid block's receipts and output.
pub struct Imported { pub receipts: MemVec<Receipt>, pub output: BlockOutput }

/// What importing a block gives. Only a valid block changes the chain.
pub enum Import {
    Valid(Imported),
    Invalid(InvalidBlock),
    Failed(HostFailure),
}

/// A chain from Osaka on: the world after its head block, which only a
/// valid child of the head replaces. It keeps one head and no side branches.
pub struct Chain { evm: Evm, schedule: Schedule, chain_id: u256, head: Header }

// The next transaction as a block carries it: a legacy one's list, or a
// typed one's string, without its header, of its type and payload.
fn next_transaction(_ transactions: mut Decoder) -> ref MemSpan uses (rlp: MemSpan) {
    if transactions.is_list() { return transactions.raw() }
    transactions.bytes()
}

// The first value the header commits to that is not what the block gives, in
// the specification's order (`execute_block`); none if all are.
fn mismatch(_ header: Header, _ output: BlockOutput, transactions_root: u256, state_root: u256, receipts_root: u256,
            withdrawals_root: u256) -> Option<InvalidBlock> {
    let access_list_hash = match output.access_list {
        Option::Some(ref list) => Option::Some(list.hash),
        Option::None => Option::None,
    }
    if output.gas_used != header.gas_used { return Option::Some(InvalidBlock::GasUsed) }
    if transactions_root != header.transactions_root { return Option::Some(InvalidBlock::TransactionsRoot) }
    if state_root != header.state_root { return Option::Some(InvalidBlock::StateRoot) }
    if receipts_root != header.receipt_root { return Option::Some(InvalidBlock::ReceiptsRoot) }
    if output.logs_bloom.words != header.bloom.words { return Option::Some(InvalidBlock::LogsBloom) }
    if withdrawals_root != header.withdrawals_root { return Option::Some(InvalidBlock::WithdrawalsRoot) }
    if output.blob_gas_used != header.blob_gas_used { return Option::Some(InvalidBlock::BlobGasUsed) }
    if output.requests_hash != header.requests_hash { return Option::Some(InvalidBlock::RequestsHash) }
    if access_list_hash != header.block_access_list_hash { return Option::Some(InvalidBlock::AccessListHash) }
    Option::None
}

impl Chain {
    /// A chain at `genesis`, whose state is `world`, with the forks of
    /// `schedule`.
    pub fn new(_ world: own WorldState, _ schedule: own Schedule, chain_id: u256, genesis: own Header) -> Self {
        let evm = Evm::new(world, schedule.config_at(genesis.timestamp))
        Chain { evm, schedule, chain_id, head: genesis }
    }

    pub fn head(self) -> ref Header { ref self.head }
    pub fn world(self) -> ref WorldState { self.evm.world() }

    /// Imports the block `rlp` encodes as the head's child, by the rules of
    /// the fork in force at its timestamp: checks its size and decoding, its
    /// header against the head, runs its transactions, which `tracer` sees,
    /// and its withdrawals, and compares what they give with its header. An
    /// invalid block, or one a host failure stops, leaves the chain as it was.
    pub fn import<T: Tracer>(mut self, _ rlp: MemSpan, _ tracer: mut T) -> Import {
        if rlp.len() > MAX_RLP_BLOCK_SIZE { return Import::Invalid(InvalidBlock::TooLarge) }
        with (rlp) {
            var items = Decoder::new()
            let body = mut items.list()
            let decoded = Header::decode(body.raw())
            // Transactions decode as they run, after the header is checked.
            let transactions = mut body.list()
            while !transactions.is_empty() { let _ = transactions.raw() }
            // Any ommer makes the block invalid, so they are not decoded.
            let ommers = mut body.list()
            let has_ommers = !ommers.is_empty()
            while !ommers.is_empty() { let _ = ommers.raw() }
            var withdrawals: MemVec<Withdrawal> = MemVec::new()
            var withdrawals_trie = Trie::new()
            var malformed = false
            var allocated = true
            let list = mut body.list()
            while !list.is_empty() {
                let item = list.raw()
                withdrawals_trie.item().raw(item)
                with (item) {
                    // [index, validator index, address, amount in gwei]
                    var fields = Decoder::new()
                    let withdrawal = mut fields.list()
                    withdrawal.u64()
                    withdrawal.u64()
                    let address = withdrawal.fixed(20)
                    let amount = withdrawal.u64()
                    malformed = malformed || !fields.finish()
                    allocated = allocated && withdrawals.try_push(Withdrawal { address, amount }).is_ok()
                }
            }
            if !items.finish() || malformed { return Import::Invalid(InvalidBlock::Malformed) }
            let header = match decoded {
                Result::Ok(header) => header,
                Result::Err(HeaderError::Allocation) => return Import::Failed(ALLOCATION),
                Result::Err(_) => return Import::Invalid(InvalidBlock::Malformed),
            }
            if !allocated { return Import::Failed(ALLOCATION) }
            let config = self.schedule.config_at(header.timestamp)
            if let Result::Err(error) = header.validate(self.head, config) {
                return Import::Invalid(InvalidBlock::Header(error))
            }
            if has_ommers { return Import::Invalid(InvalidBlock::Ommers) }
            let Option::Some(env) = header.block_env(chain_id: self.chain_id, config) else {
                return Import::Failed(HostFailure::BlobBaseFee)
            }
            self.evm.set_config(config)
            let verdict = self.execute(header, env, withdrawals, withdrawals_trie, mut tracer)
            if let Import::Valid(_) = verdict { self.head = header }
            verdict
        }
    }

    // Runs the block `header` heads, whose transactions are the second item
    // of `rlp`, on the head's world, and compares what it gives with the
    // header; undoes it unless it is valid. The block holds the `Evm` until
    // finishing it or abandoning it gives it back: `self.evm` is a hole
    // until then, which every path fills.
    fn execute<T: Tracer>(mut self, _ header: Header, _ env: BlockEnv, _ withdrawals: own MemVec<Withdrawal>,
                          _ withdrawals_trie: own Trie, _ tracer: mut T) -> Import uses (rlp: MemSpan) {
        var block = Block::begin(self.evm, env, parent_hash: header.parent_hash,
                                 parent_beacon_block_root: header.parent_beacon_block_root)
        var transactions_trie = Trie::new()
        var receipts_trie = Trie::new()
        var receipts: MemVec<Receipt> = MemVec::new()
        var fault: Option<Import> = Option::None
        var items = Decoder::new()
        let body = mut items.list()
        let _ = body.raw()
        let transactions = mut body.list()
        var index: usize = 0
        while fault.is_none() && !transactions.is_empty() {
            // A string that holds a list, a legacy transaction wrapped as a
            // typed one, is malformed in every fork: EELS's Amsterdam
            // `decode_transaction` takes it, but it makes block bodies
            // malleable, and clients reject it.
            let typed = !transactions.is_list()
            let tx = next_transaction(mut transactions)
            transactions_trie.item().raw(tx)
            let decoded = if typed && tx.len() != 0 && tx[0] >= 0xc0 { Result::Err(TxError::Malformed) }
                else { decode_transaction(tx) }
            fault = match decoded {
                Result::Err(TxError::Allocation) => Option::Some(Import::Failed(ALLOCATION)),
                Result::Err(error) => Option::Some(Import::Invalid(InvalidBlock::Undecodable(index, error))),
                Result::Ok((request, _)) => {
                    let receipt = block.transact(request, mut tracer)
                    if receipt.invalid != VALID {
                        Option::Some(Import::Invalid(InvalidBlock::Transaction(index, receipt.invalid)))
                    } else if !is_evm_outcome(receipt.status) {
                        Option::Some(Import::Failed(HostFailure::Status(receipt.status)))
                    } else {
                        encode_receipt(mut receipts_trie.item(), receipt, kind: request.env.kind)
                        if receipts.try_push(receipt).is_ok() { Option::None }
                            else { Option::Some(Import::Failed(ALLOCATION)) }
                    }
                },
            }
            index += 1
        }
        if let Option::Some(fault) = fault {
            // A host failure as the block began, or in an earlier
            // transaction's deposits, came first.
            let failure = block.failure()
            self.evm = block.abandon()
            return match failure {
                Option::Some(BlockError::Host(status)) => Import::Failed(HostFailure::Status(status)),
                _ => fault,
            }
        }
        let (evm, finished) = block.finish(withdrawals)
        self.evm = evm
        let output = match finished {
            Result::Ok(output) => output,
            Result::Err(BlockError::Host(status)) => return Import::Failed(HostFailure::Status(status)),
            Result::Err(error) => return Import::Invalid(InvalidBlock::Execution(error)),
        }
        let roots = (transactions_trie.root(), state_root(mut self.evm.world_mut()), receipts_trie.root(),
                     withdrawals_trie.root())
        let (Option::Some(transactions_root), Option::Some(state), Option::Some(receipts_root),
             Option::Some(withdrawals_root)) = roots else {
            output.changes.undo(mut self.evm.world_mut())
            return Import::Failed(ALLOCATION)
        }
        match mismatch(header, output, transactions_root, state_root: state, receipts_root, withdrawals_root) {
            Option::Some(reason) => {
                output.changes.undo(mut self.evm.world_mut())
                Import::Invalid(reason)
            },
            Option::None => Import::Valid(Imported { receipts, output }),
        }
    }
}
