#[test]
fn header_gives_the_block_env() {
    // The Osaka block above: its blob base fee at Osaka's update fraction,
    // from EIP-4844's fake_exponential(1, 0x360000, 5007716) = 2.
    let block = osaka_reserve_block().block_env(chain_id: 1, Config::osaka()).unwrap()
    core::assert(block.coinbase == 0x2adc25665018aa1fe0e6bc666dac8fc2697ff9ba && block.timestamp == 0x0c)
    core::assert(block.number == 1 && block.prevrandao == 0 && block.gaslimit == 0x07270e00 && block.chainid == 1)
    core::assert(block.basefee == 0x2a && block.blobbasefee == 2 && block.slot_number == 0)
    // At BPO1's, fake_exponential(1, 0x360000, 8346193) = 1.
    core::assert(osaka_reserve_block().block_env(chain_id: 1, bpo1()).unwrap().blobbasefee == 1)
}

#[test]
fn header_computes_the_blob_base_fee() {
    // Values of EIP-4844's fake_exponential, as the specification's
    // taylor_exponential computes them in Python.
    core::assert(blob_base_fee(0, update_fraction: 11684671).unwrap() == 1)
    core::assert(blob_base_fee(0xb40000, update_fraction: 8346193).unwrap() == 4)
    core::assert(blob_base_fee(564002816, update_fraction: 11684671).unwrap() == 917889803665253723156)
    // The largest excess at Osaka's update fraction whose sum fits 256 bits,
    // and the next.
    core::assert(blob_base_fee(811346078, update_fraction: 5007716).unwrap()
                 == 23122731310863404894767667853216786155496149131481411450294192322523943)
    core::assert(blob_base_fee(811346079, update_fraction: 5007716).is_none())
    core::assert(blob_base_fee(0xffffffffffffffff, update_fraction: 5007716).is_none())
}
