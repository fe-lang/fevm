use core::{MemBuffer, Result}
use core::text::Text
use std::text::decode_hex
use fevm::{BlobSchedule, Config}
use ingot::header::{Header, HeaderError, blob_base_fee}

fn header<T: Text>(_ hex: T) -> Header { Header::decode(decode_hex(hex).unwrap().span()).unwrap() }

// Each error's place in `HeaderError`, and 0 for a valid header.
fn verdict(_ result: Result<HeaderError, ()>) -> u8 {
    match result {
        Result::Ok(()) => 0,
        Result::Err(HeaderError::Malformed) => 1,
        Result::Err(HeaderError::Allocation) => 2,
        Result::Err(HeaderError::MissingAccessListHash) => 3,
        Result::Err(HeaderError::UnexpectedAccessListHash) => 4,
        Result::Err(HeaderError::MissingSlotNumber) => 5,
        Result::Err(HeaderError::UnexpectedSlotNumber) => 6,
        Result::Err(HeaderError::Number) => 7,
        Result::Err(HeaderError::ExcessBlobGas) => 8,
        Result::Err(HeaderError::GasUsed) => 9,
        Result::Err(HeaderError::GasLimit) => 10,
        Result::Err(HeaderError::BaseFee) => 11,
        Result::Err(HeaderError::Timestamp) => 12,
        Result::Err(HeaderError::ExtraData) => 13,
        Result::Err(HeaderError::Difficulty) => 14,
        Result::Err(HeaderError::Nonce) => 15,
        Result::Err(HeaderError::OmmersHash) => 16,
        Result::Err(HeaderError::ParentHash) => 17,
    }
}

fn valid(_ child: Header, _ parent: Header, _ config: Config) -> bool { verdict(child.validate(parent, config)) == 0 }

fn rejected(_ child: Header, _ parent: Header, _ config: Config, _ error: HeaderError) -> bool {
    verdict(child.validate(parent, config)) == verdict(Result::Err(error))
}

fn malformed<T: Text>(_ hex: T) -> bool {
    match Header::decode(decode_hex(hex).unwrap().span()) {
        Result::Err(HeaderError::Malformed) => true,
        _ => false,
    }
}

// The fixture's BPO1 schedule.
fn bpo1() -> Config {
    var config = Config::osaka()
    config.blob_schedule = BlobSchedule { target: 10, max: 15, update_fraction: 8346193 }
    config
}

// Headers and their expected values are the fixtures' (tests@v21.0.2
// blockchain tests): each header is the first item of a block's `rlp`, and
// its hash the block header's `hash`.

// osaka/eip7918_blob_reserve_price/reserve_price_boundary,
// parent_excess_blobs_27-block_base_fee_per_gas_delta_16: the parent's blob
// base fee is below its reserve price.
fn osaka_reserve_genesis() -> Header { header("") }
fn osaka_reserve_block() -> Header { header("") }

// cancun/eip4844_blobs/blobhash_opcode_contexts_tx_types, Osaka tx_type_0.
fn osaka_genesis() -> Header { header("") }
fn osaka_block() -> Header { header("") }

#[test]
fn header_decodes_osaka_headers() {
    let parent = osaka_reserve_genesis()
    core::assert(parent.hash == 0x3edcb4704a3583f1623d1349103ef78af1b53c329d728799446a38245f5e9b21)
    core::assert(parent.number == 0 && parent.base_fee_per_gas == 0x30 && parent.excess_blob_gas == 0x360000)
    let block = osaka_reserve_block()
    core::assert(block.hash == 0xe122cc6c4e2182d9b26879d0645ffb985d1cbd021c9015be09646d876ab19f9f)
    core::assert(block.parent_hash == parent.hash && block.coinbase == 0x2adc25665018aa1fe0e6bc666dac8fc2697ff9ba)
    core::assert(block.ommers_hash == 0x1dcc4de8dec75d7aab85b567b6ccd41ad312451b948a7413f0a142fd40d49347)
    core::assert(block.state_root == 0x07fb20126b308716a71da619b3221e1ff8055ecb8efd6122bd4c2c0ba6f96826)
    core::assert(block.transactions_root == 0x66d4f6d2ebb07b8781c419a5020b936bb22888b25a438ea9c879e5c68159d656)
    core::assert(block.receipt_root == 0xc117ad0158b04d4277c8a0d1b440360bf3f011ad7caccf8740df472c96e8f5cc)
    core::assert(block.difficulty == 0 && block.number == 1 && block.gas_limit == 0x07270e00)
    core::assert(block.gas_used == 0xa861)
    core::assert(block.timestamp == 0x0c && block.extra_data.len() == 0 && block.prev_randao == 0 && block.nonce == 0)
    core::assert(block.base_fee_per_gas == 0x2a && block.blob_gas_used == 0x020000 && block.excess_blob_gas == 0x360000)
    core::assert(block.withdrawals_root == 0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421)
    core::assert(block.parent_beacon_block_root == 0)
    core::assert(block.requests_hash == 0xe3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855)
    core::assert(block.block_access_list_hash.is_none() && block.slot_number.is_none())
    // The genesis's extra data is the byte 00.
    core::assert(parent.extra_data.len() == 1 && parent.extra_data[0] == 0)
}

// amsterdam/eip8037/block_2d_gas_accounting/
// base_fee_per_gas_follows_dominant_dimension, single_tx-dominant_dimension_execution:
// the base fee falls, then rises.
#[test]
fn header_decodes_and_validates_amsterdam_headers() {
    let genesis = header("")
    let first = header("")
    let second = header("")
    core::assert(genesis.hash == 0xdb08651b3e5d609d02bf61001ea4595b9ede79c304f7a60226e9ad22647afd92)
    core::assert(first.hash == 0xc553e41b2c85a3d93343db4a2a88f45367136fbb7c3a4ed0aa44c52f69020462)
    core::assert(second.hash == 0x6756b97f362febc1ec2f46adc07c16dfb9babdc7cfddc42759cf2b98c3d3b2f1)
    let hash = first.block_access_list_hash.unwrap()
    core::assert(hash == 0x4b3a008c6c585f23972aab0243cdbf64bd020e0e9fdcace8965c6cac17115cda)
    core::assert(first.slot_number.unwrap() == 0 && second.slot_number.unwrap() == 1)
    core::assert(first.base_fee_per_gas == 0x342770c0 && second.base_fee_per_gas == 0x3427722c)
    core::assert(valid(first, genesis, Config::amsterdam()) && valid(second, first, Config::amsterdam()))
    // An Osaka header may have neither field.
    core::assert(rejected(first, genesis, Config::osaka(), HeaderError::UnexpectedAccessListHash))
}

#[test]
fn header_validates_osaka_headers() {
    // The excess stays, as the parent's blob base fee is below its reserve
    // price, and the base fee falls.
    core::assert(valid(osaka_reserve_block(), osaka_reserve_genesis(), Config::osaka()))
    // The excess falls by the target, and so does the base fee.
    let parent = osaka_genesis()
    let block = osaka_block()
    core::assert(parent.excess_blob_gas == 0x200000 && block.excess_blob_gas == 0x140000)
    core::assert(parent.base_fee_per_gas == 8 && block.base_fee_per_gas == 7)
    core::assert(block.hash == 0x87bf7caa64a1517f8c6e7518402a350d81fbb73b4f1e11e41b9fd426ba15a897)
    core::assert(valid(block, parent, Config::osaka()))
}

#[test]
fn header_validates_across_blob_schedule_changes() {
    // OsakaToBPO1AtTime15k: osaka/eip7918/blob_base_fee_with_bpo_transition,
    // block_base_fee_per_gas_17-parent_excess_blobs_27. The first BPO1 block
    // keeps its Osaka parent's excess: at BPO1's update fraction the parent's
    // blob base fee is below its reserve price. Osaka's rules would lower
    // the excess by Osaka's target.
    let parent = header("")
    let block = header("")
    core::assert(block.timestamp == 15000 && block.excess_blob_gas == parent.excess_blob_gas)
    core::assert(valid(block, parent, bpo1()))
    core::assert(rejected(block, parent, Config::osaka(), HeaderError::ExcessBlobGas))
    // osaka/eip7918/reserve_price_at_transition,
    // below_reserve_base_fee_threshold-parent_excess_blobs_100-parent_blobs_0:
    // an Osaka block, then a BPO1 block at 15,000 whose excess falls by
    // BPO1's target and whose base fee rises.
    let genesis = header("")
    let first = header("")
    let second = header("")
    core::assert(first.timestamp == 14999 && second.timestamp == 15000)
    core::assert(second.base_fee_per_gas > first.base_fee_per_gas)
    core::assert(valid(first, genesis, Config::osaka()) && valid(second, first, bpo1()))
    core::assert(rejected(second, first, Config::osaka(), HeaderError::ExcessBlobGas))
    // BPO2ToAmsterdamAtTime15k:
    // amsterdam/eip8037/reservoir_available_after_transition. The first
    // Amsterdam header has the fields its Osaka-format parent lacks.
    let genesis = header("")
    let block = header("")
    core::assert(block.hash == 0x2dfdadd1939a7edc3f2c2e7241f5ab08507a7d3e1b2c912ab5b16eb127168985)
    core::assert(genesis.slot_number.is_none() && block.slot_number.unwrap() == 0)
    core::assert(valid(block, genesis, Config::amsterdam()))
}

#[test]
fn header_rejects_fixtures_invalid_headers() {
    // frontier/validation/block_gas_limit_below_minimum, minimum_minus_one:
    // INVALID_GASLIMIT.
    core::assert(rejected(header(""), header(""),
                          Config::osaka(), HeaderError::GasLimit))
    // london/validation/invalid_header, field_base_fee_per_gas:
    // INVALID_BASEFEE_PER_GAS.
    core::assert(rejected(header(""), header(""), Config::osaka(),
                          HeaderError::BaseFee))
    // cancun/eip4844_blobs/invalid_negative_excess_blob_gas: an excess of
    // 2^64 - 786,432, INCORRECT_EXCESS_BLOB_GAS.
    let block = header("")
    core::assert(block.excess_blob_gas == 18446744073708765184)
    core::assert(rejected(block, header(""), Config::osaka(), HeaderError::ExcessBlobGas))
    // BPO2ToAmsterdamAtTime15k, amsterdam/eip7843_slotnum and
    // eip7928_block_level_access_lists fork_transition: a BPO2 block with a
    // slot number in the access list hash's place, INCORRECT_BLOCK_FORMAT;
    // an Amsterdam block without the slot number, INCORRECT_BLOCK_FORMAT; a
    // BPO2 block with an access list hash, INVALID_BLOCK_HASH; an Amsterdam
    // block with a slot number but no access list hash, INVALID_BAL_HASH.
    let genesis = header("")
    var bpo2 = Config::osaka()
    bpo2.blob_schedule = Config::amsterdam().blob_schedule
    let block = header("")
    core::assert(block.timestamp == 14999 && block.slot_number.unwrap() == 0)
    core::assert(rejected(block, genesis, bpo2, HeaderError::UnexpectedSlotNumber))
    let block = header("")
    core::assert(block.timestamp == 15000)
    core::assert(rejected(block, genesis, Config::amsterdam(), HeaderError::MissingSlotNumber))
    let block = header("")
    core::assert(block.timestamp == 14999)
    core::assert(rejected(block, genesis, bpo2, HeaderError::UnexpectedAccessListHash))
    let block = header("")
    core::assert(block.timestamp == 15000)
    core::assert(rejected(block, genesis, Config::amsterdam(), HeaderError::MissingAccessListHash))
}

#[test]
fn header_rejects_each_rule() {
    // The valid Osaka block above with one field changed.
    let parent = osaka_genesis()
    let osaka = Config::osaka()
    var block = osaka_block()
    block.number = 0
    core::assert(rejected(block, parent, osaka, HeaderError::Number))
    block = osaka_block()
    block.number = 2
    core::assert(rejected(block, parent, osaka, HeaderError::Number))
    block = osaka_block()
    block.excess_blob_gas += 1
    core::assert(rejected(block, parent, osaka, HeaderError::ExcessBlobGas))
    block = osaka_block()
    block.gas_used = block.gas_limit + 1
    core::assert(rejected(block, parent, osaka, HeaderError::GasUsed))
    // The gas limit moves by less than 1/1024 of the parent's.
    let step = parent.gas_limit / 1024
    block = osaka_block()
    block.gas_limit = parent.gas_limit + step - 1
    core::assert(valid(block, parent, osaka))
    block.gas_limit = parent.gas_limit + step
    core::assert(rejected(block, parent, osaka, HeaderError::GasLimit))
    block.gas_limit = parent.gas_limit - step + 1
    core::assert(valid(block, parent, osaka))
    block.gas_limit = parent.gas_limit - step
    core::assert(rejected(block, parent, osaka, HeaderError::GasLimit))
    block = osaka_block()
    block.base_fee_per_gas += 1
    core::assert(rejected(block, parent, osaka, HeaderError::BaseFee))
    block = osaka_block()
    block.timestamp = parent.timestamp
    core::assert(rejected(block, parent, osaka, HeaderError::Timestamp))
    block = osaka_block()
    block.extra_data = MemBuffer::new(32)
    core::assert(valid(block, parent, osaka))
    block.extra_data = MemBuffer::new(33)
    core::assert(rejected(block, parent, osaka, HeaderError::ExtraData))
    block = osaka_block()
    block.difficulty = 1
    core::assert(rejected(block, parent, osaka, HeaderError::Difficulty))
    block = osaka_block()
    block.nonce = 1
    core::assert(rejected(block, parent, osaka, HeaderError::Nonce))
    block = osaka_block()
    block.ommers_hash = 0
    core::assert(rejected(block, parent, osaka, HeaderError::OmmersHash))
    block = osaka_block()
    block.parent_hash = 0
    core::assert(rejected(block, parent, osaka, HeaderError::ParentHash))
}

