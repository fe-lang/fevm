// The state trie held in memory with each node's hash, so that changing a
// few accounts and slots rehashes only their paths. A partial trie holds
// only what it has read of the nodes of a source, such as a witness's.
use core::{MemBuffer, MemSpan, MemVec, Option, Result}
use core::num::leading_zeros
use core::ops::Index
use fevm::{AccountState, WorldState}
use fevm::state::{EMPTY_CODE_HASH, EMPTY_ROOT}
use fevm_rlp::{Decoder, Encoder}
use keccak::keccak256_word
use swisstable::SwissTable
use ingot::trie::{hash, nibble, put_path}

// A node as its parent holds it: its kind and its position in that kind's
// arena. `Hash` is a stub, a subtree known only by its hash.
enum Child { Empty, Leaf(u32), Account(u32), Extension(u32), Branch(u32), Hash(u32) }
impl Copy for Child {}

impl Child {
    fn is_empty(self) -> bool {
        match self {
            Child::Empty => true,
            _ => false,
        }
    }
}

// Each node keeps its reference in its parent, `len` bytes: its hash, or
// under 32 bytes its RLP, in the low bytes of `reference`. `len` is zero
// while the node is stale. A stub's reference is its hash, never stale.

// A slot: its key, keccak256 of the slot, and its value.
struct Leaf { key: u256, value: u256, reference: u256, len: u8 }
impl Copy for Leaf {}

// An account: keccak256 of its address, its fields, with `EMPTY_CODE_HASH`
// for an empty account's code, and the root node of its storage trie.
struct Account {
    key: u256,
    nonce: u64,
    balance: u256,
    code_hash: u256,
    reference: u256,
    storage: Child,
    len: u8,
}
impl Copy for Account {}

// An extension: the nibbles of `key` from its depth to `end`, over a
// branch. Every key under it has all the nibbles of `key` before `end`.
struct Extension { key: u256, reference: u256, child: Child, end: u8, len: u8 }
impl Copy for Extension {}

// A branch: a child for each nibble at its depth, two or more of them not
// empty. Its value is always empty, since keys are prefix-free.
struct Branch { children: [Child; 16], reference: u256, len: u8 }
impl Copy for Branch {}

// Nodes of one kind, each at a position that stays its own until it is
// released, which reuses it.
struct Arena<T> { items: MemVec<T>, free: MemVec<u32> }

impl<T> Arena<T> {
    fn new() -> Self { Arena { items: MemVec::new(), free: MemVec::new() } }

    // The position of `item`, added; none if an allocation fails.
    fn add(mut self, _ item: own T) -> Option<u32> {
        if let Option::Some(at) = self.free.pop() {
            self.items.set(at as usize, item)
            return Option::Some(at)
        }
        let at = self.items.len()
        // `free` has room for every position, so releasing never allocates.
        if at == u32::max() as usize || !self.free.try_reserve(at + 1) || self.items.try_push(item).is_err() {
            return Option::None
        }
        Option::Some(at.downcast_truncate())
    }

    fn release(mut self, _ at: u32) { self.free.push(at) }

    // The positions in use.
    fn len(self) -> usize { self.items.len() - self.free.len() }
}

impl<T> Index<u32> for Arena<T> {
    type Output = T

    fn index(mut? self, _ index: u32) -> mut? T { mut? self.items[index as usize] }
}

// The count of leading nibbles `a` and `b` share.
fn shared(_ a: u256, _ b: u256) -> usize { (leading_zeros(a ^ b) / 4).downcast_truncate() }

// The first `depth` nibbles of `key`, and the others zero.
fn above(_ key: u256, _ depth: usize) -> u256 {
    if depth == 0 { 0 } else { key & u256::max() << ((64 - depth) * 4) as u256 }
}

/// Why a trie has no root: an allocation failed, or the node of a hash it
/// had to read is missing or malformed, or its source failed to read it, for
/// a reason the source keeps.
pub enum TrieFault { Allocation, Missing(u256), Malformed(u256), Source(u256) }

impl Copy for TrieFault {}

/// Where a node stands in the state trie: in the storage trie of the
/// account whose key is `owner`, or for none in the account trie, `depth`
/// nibbles below that trie's root, under the first `depth` nibbles of
/// `path`, counted from its most significant; its other nibbles are zero.
pub struct NodePath { pub owner: Option<u256>, pub depth: u8, pub path: u256 }

impl Copy for NodePath {}

/// Why a source gives no node: it holds none there of the hash asked for,
/// or it failed to read, for a reason it keeps.
pub enum NodeError { Missing, Failed }

impl Copy for NodeError {}

/// Where a partial trie reads each node it holds only as a hash, when it
/// first reaches it. The trie asks once for each node, by where the node
/// stands and its hash, so a source can keep nodes by either.
pub trait NodeSource {
    /// The RLP of the node at `at` whose keccak256 is `hash`. The source
    /// checks the hash: the trie decodes what it is given and does not hash
    /// it again. A source that holds another node at `at` does not hold the
    /// state the trie is of, and gives `Failed`.
    fn read(mut self, _ at: NodePath, hash: u256) -> Result<NodeError, ref MemSpan>
}

/// The source of a complete trie, which has no stubs and never asks.
impl NodeSource for () {
    fn read(mut self, _ at: NodePath, hash: u256) -> Result<NodeError, ref MemSpan> {
        Result::Err(NodeError::Missing)
    }
}

// A node of `Nodes`: where its RLP is in the buffer, and whether it has been
// read.
struct Entry { offset: usize, len: usize, used: bool }
impl Copy for Entry {}

/// Trie nodes by keccak256 of their RLP, such as a witness's, each held
/// once in one buffer and marked used when a trie reads it. A witness holds
/// its codes and headers by their keccak256 in the same way.
pub struct Nodes { bytes: MemBuffer, entries: MemVec<Entry>, index: SwissTable<u256, usize> }

impl Nodes {
    pub fn new() -> Self {
        Nodes { bytes: MemBuffer::empty(), entries: MemVec::new(), index: SwissTable<u256, usize>::empty() }
    }

    /// Adds `node`, unless one of the same hash is held; false if an
    /// allocation fails.
    pub fn add(mut self, _ node: MemSpan) -> bool {
        let hash = keccak256_word(node)
        if self.index.contains(hash) { return true }
        let entry = Entry { offset: self.bytes.len(), len: node.len(), used: false }
        if !self.bytes.try_reserve(node.len()) || !self.index.try_insert(hash, self.entries.len()) { return false }
        if self.entries.try_push(entry).is_err() {
            let _ = self.index.remove(hash)
            return false
        }
        self.bytes.extend_from(node)
        true
    }

    /// The count of nodes, each at a position from zero.
    pub fn len(self) -> usize { self.entries.len() }

    /// The RLP of the node at `at`.
    pub fn node(self, _ at: usize) -> ref MemSpan {
        let entry = self.entries[at]
        self.bytes.slice(offset: entry.offset, len: entry.len)
    }

    /// Whether the node at `at` has been read.
    pub fn used(self, _ at: usize) -> bool { self.entries[at].used }

    /// The position of the node of `hash`, marked used; none if none is held.
    pub(ingot) fn find(mut self, _ hash: u256) -> Option<usize> {
        let lookup = self.index.get(hash)
        if !lookup.found { return Option::None }
        self.entries[lookup.value].used = true
        Option::Some(lookup.value)
    }
}

/// Nodes by their hash, wherever they stand. A node's hash is its key, made
/// as it is added, so a read checks nothing more.
impl NodeSource for Nodes {
    fn read(mut self, _ at: NodePath, hash: u256) -> Result<NodeError, ref MemSpan> {
        match self.find(hash) {
            Option::Some(position) => Result::Ok(self.node(position)),
            Option::None => Result::Err(NodeError::Missing),
        }
    }
}

/// The account of `address` in `world` as a trie holds it, for
/// `StateTrie::set_account`: its storage root zero, which the trie does not
/// take; none if it does not exist. Mutable for the code hash the world
/// computes on first use. The world's nonce must be under 2^64, as a world a
/// block ran on has it (EIP-2681).
pub fn world_account(_ world: mut WorldState, _ address: u256) -> Option<AccountState> {
    if !world.exists(address) { return Option::None }
    // Zero for an empty account, which has no code.
    let code_hash = world.code_hash(address)
    Option::Some(AccountState {
        // A world's nonce is under 2^64 (EIP-2681).
        nonce: world.nonce(address).downcast().unwrap(), balance: world.balance(address),
        code_hash: if code_hash == 0 { EMPTY_CODE_HASH } else { code_hash }, storage_root: 0,
    })
}

/// The state trie: the trie of the accounts, keyed by keccak256 of the
/// address, of `rlp([nonce, balance, storage_root, code_hash])`, and for each
/// account the trie of its slots, keyed by keccak256 of the slot, of the
/// value's RLP. Each node keeps its hash. A complete trie holds a whole
/// world. A partial one starts from a state root and a source of its nodes,
/// such as a witness's, and holds each subtree it has not read as its hash:
/// a read or a change resolves the nodes on its path, so the trie reads only
/// the nodes it needs and never hashes what it has not changed. A caller
/// sets each account and slot that changed, and the root rehashes only their
/// paths. The trie depends only on what it holds, not on the order of the
/// changes: setting what a block changed back undoes the block. The first
/// fault, a failed allocation, a node missing or malformed, or a failed read
/// of the source, is kept: the trie then changes no more and has no root.
pub struct StateTrie<N: NodeSource = ()> {
    root: Child,
    accounts: Arena<Account>,
    leaves: Arena<Leaf>,
    extensions: Arena<Extension>,
    branches: Arena<Branch>,
    // The hash of each stub.
    stubs: Arena<u256>,
    // What stubs resolve from: `()` for a complete trie, which has none.
    source: N,
    fault: Option<TrieFault>,
}

impl StateTrie<()> {
    /// An empty complete trie, to be filled by the keyed setters, as from a
    /// store's flat tables, which hold no preimages.
    pub fn empty() -> Self { StateTrie::over(()) }

    /// The trie of every account and slot in `world`, whose nonces are under
    /// 2^64; mutable for the code hashes the world computes on first use.
    pub fn new(_ world: mut WorldState) -> Self {
        var trie = StateTrie::over(())
        for position in 0..world.account_count() {
            let address = world.account_at(position).address
            trie.set_account(address, world_account(mut world, address))
        }
        for at in 0..world.storage_slots() {
            let entry = world.storage_at(at)
            if entry.occupied { trie.set_slot(address: entry.address, slot: entry.slot, value: entry.value) }
        }
        trie
    }
}

impl<N: NodeSource> StateTrie<N> {
    // An empty trie over `source`.
    fn over(_ source: own N) -> Self {
        Self {
            root: Child::Empty,
            accounts: Arena::new(),
            leaves: Arena::new(),
            extensions: Arena::new(),
            branches: Arena::new(),
            stubs: Arena::new(),
            source,
            fault: Option::None,
        }
    }

    /// The trie of the state whose root is `root`, which reads its nodes from
    /// `source` as it reaches them. A source other than `()` needs the type
    /// argument, `StateTrie<N>::partial`: a path without it means the `()`
    /// instantiation.
    pub fn partial(root: u256, _ source: own N) -> Self {
        var trie = Self::over(source)
        if root != EMPTY_ROOT {
            match trie.stubs.add(root) {
                Option::Some(stub) => trie.root = Child::Hash(stub),
                Option::None => trie.fault = Option::Some(TrieFault::Allocation),
            }
        }
        trie
    }

    /// The source a partial trie reads from, such as `Nodes` with those it
    /// has read marked.
    pub fn into_source(own self) -> N { self.source }

    /// The account of `address`, if it exists. Read before the changes go
    /// in, while its storage root is not stale.
    pub fn account(mut self, _ address: u256) -> Result<TrieFault, Option<AccountState>> {
        self.account_keyed(hash(address, len: 20))
    }

    /// Slot `slot` of `address`, zero if it does not exist.
    pub fn slot(mut self, address: u256, slot: u256) -> Result<TrieFault, u256> {
        self.slot_keyed(account: hash(address, len: 20), key: hash(slot, len: 32))
    }

    /// Sets the account of `address` to `state`, all but its storage root:
    /// adds it with no storage, changes its fields, or for none removes it
    /// with its storage. A removal that leaves a branch one child reads that
    /// child, so a caller applying several changes sets before it removes.
    pub fn set_account(mut self, _ address: u256, _ state: Option<AccountState>) {
        self.set_account_keyed(hash(address, len: 20), state)
    }

    /// Removes the storage of the account of `address`, if the trie holds
    /// it, leaving its fields.
    pub fn clear_storage(mut self, _ address: u256) { self.clear_storage_keyed(hash(address, len: 20)) }

    /// Sets slot `slot` of `address` to `value`, zero removing it. The
    /// account must exist unless `value` is zero, which then changes nothing.
    /// As for accounts, a caller applying several changes sets before it
    /// removes.
    pub fn set_slot(mut self, address: u256, slot: u256, value: u256) {
        self.set_slot_keyed(account: hash(address, len: 20), key: hash(slot, len: 32), value)
    }

    /// The state root, or the trie's fault.
    pub fn root(mut self) -> Result<TrieFault, u256> {
        if let Option::Some(fault) = self.fault { return Result::Err(fault) }
        var rlp = Encoder::new()
        var value = Encoder::new()
        if let Option::Some(var path) = MemBuffer::try_new(33) {
            self.rehash(self.root, depth: 0, mut rlp, mut value, mut path)
            if rlp.finish().is_some() && value.finish().is_some() { return Result::Ok(self.root_of(self.root)) }
        }
        self.failed()
        Result::Err(self.fault.unwrap())
    }

    /// Adds to `nodes`, after rehashing, every node the trie holds that is
    /// reached by its hash: each of 32 bytes or more, and the root of each
    /// trie. False if the trie has a fault or an allocation fails.
    pub fn write_nodes(mut self, _ nodes: mut Nodes) -> bool {
        if self.root().is_err() { return false }
        var rlp = Encoder::new()
        var value = Encoder::new()
        let Option::Some(var path) = MemBuffer::try_new(33) else { return false }
        self.write(self.root, depth: 0, mut nodes, mut rlp, mut value, mut path) && rlp.finish().is_some()
            && value.finish().is_some()
    }

    /// The nodes in use, which are those of a new trie of the same world.
    pub(ingot) fn nodes(self) -> usize {
        self.accounts.len() + self.leaves.len() + self.extensions.len() + self.branches.len()
    }

    /// `account` of the account whose key is `key`.
    pub(ingot) fn account_keyed(mut self, _ key: u256) -> Result<TrieFault, Option<AccountState>> {
        if self.fault.is_none() && let Option::Some(found) = self.open_account(key) {
            let Option::Some(at) = found else { return Result::Ok(Option::None) }
            let account = self.accounts[at]
            core::assert(account.storage.is_empty() || self.reference(account.storage).1 != 0)
            return Result::Ok(Option::Some(AccountState {
                nonce: account.nonce, balance: account.balance, code_hash: account.code_hash,
                storage_root: self.root_of(account.storage),
            }))
        }
        self.failed()
        Result::Err(self.fault.unwrap())
    }

    /// `slot` of the slot whose key is `key`, of the account whose key is
    /// `account`.
    pub(ingot) fn slot_keyed(mut self, account: u256, key: u256) -> Result<TrieFault, u256> {
        if self.fault.is_none() && let Option::Some(found) = self.open_account(account) {
            let Option::Some(at) = found else { return Result::Ok(0) }
            if let Option::Some(leaf) = self.open_slot(at, key) {
                return Result::Ok(if let Option::Some(leaf) = leaf { self.leaves[leaf].value } else { 0 })
            }
        }
        self.failed()
        Result::Err(self.fault.unwrap())
    }

    /// `set_account` of the account whose key is `key`, keccak256 of its
    /// address, for a caller that holds accounts by that key, such as a store
    /// undoing a block. As there, a caller applying several changes sets
    /// before it removes.
    pub fn set_account_keyed(mut self, _ key: u256, _ state: Option<AccountState>) {
        if self.fault.is_none() && self.write_account(key, state).is_none() { self.failed() }
    }

    /// `clear_storage` of the account whose key is `key`, keccak256 of its
    /// address. A caller clears an account's storage before it sets any of
    /// its slots.
    pub fn clear_storage_keyed(mut self, _ key: u256) {
        if self.fault.is_some() { return }
        let Option::Some(found) = self.open_account(key) else { return self.failed() }
        if let Option::Some(at) = found && !self.accounts[at].storage.is_empty() {
            self.clear(self.accounts[at].storage)
            self.accounts[at].storage = Child::Empty
            self.touch(self.root, key, depth: 0)
        }
    }

    /// `set_slot` of the slot whose key is `key`, keccak256 of the slot, of
    /// the account whose key is `account`, keccak256 of its address. As
    /// there, the account is set first, and a caller applying several
    /// changes sets before it removes.
    pub fn set_slot_keyed(mut self, account: u256, key: u256, value: u256) {
        if self.fault.is_none() && self.write_slot(account, key, value).is_none() { self.failed() }
    }

    // Keeps `fault` unless the trie has one: none, for the operation it fails.
    fn fail<T>(mut self, _ fault: TrieFault) -> Option<T> {
        if self.fault.is_none() { self.fault = Option::Some(fault) }
        Option::None
    }

    // Keeps the fault of an operation that failed: an allocation's, unless
    // it kept one of a node or of the source.
    fn failed(mut self) { if self.fault.is_none() { self.fault = Option::Some(TrieFault::Allocation) } }

    // `set_account_keyed`; none if a node is missing or malformed, the
    // source fails or an allocation fails.
    fn write_account(mut self, _ key: u256, _ state: Option<AccountState>) -> Option<()> {
        let found = self.open_account(key)?
        let Option::Some(state) = state else {
            if found.is_some() { self.root = self.remove(self.root, key, depth: 0, owner: Option::None)? }
            return Option::Some(())
        }
        let Option::Some(at) = found else {
            let account = Account {
                key, nonce: state.nonce, balance: state.balance, code_hash: state.code_hash, reference: 0,
                storage: Child::Empty, len: 0,
            }
            let leaf = Child::Account(self.accounts.add(account)?)
            self.root = self.insert(self.root, leaf, key, depth: 0)?
            return Option::Some(())
        }
        let account = mut self.accounts[at]
        if account.nonce == state.nonce && account.balance == state.balance && account.code_hash == state.code_hash {
            return Option::Some(())
        }
        account.nonce = state.nonce
        account.balance = state.balance
        account.code_hash = state.code_hash
        self.touch(self.root, key, depth: 0)
        Option::Some(())
    }

    // `set_slot_keyed`; none if a node is missing or malformed, the source
    // fails or an allocation fails.
    fn write_slot(mut self, account: u256, key: u256, value: u256) -> Option<()> {
        let Option::Some(at) = self.open_account(account)? else {
            // A caller sets the account of a slot first.
            core::assert(value == 0)
            return Option::Some(())
        }
        let found = self.open_slot(at, key)?
        let storage = self.accounts[at].storage
        let storage = match found {
            Option::Some(leaf) => {
                if self.leaves[leaf].value == value { return Option::Some(()) }
                if value == 0 { self.remove(storage, key, depth: 0, owner: Option::Some(account))? } else {
                    self.leaves[leaf].value = value
                    self.touch(storage, key, depth: 0)
                    storage
                }
            },
            Option::None => {
                if value == 0 { return Option::Some(()) }
                let leaf = Child::Leaf(self.leaves.add(Leaf { key, value, reference: 0, len: 0 })?)
                self.insert(storage, leaf, key, depth: 0)?
            },
        }
        self.accounts[at].storage = storage
        self.touch(self.root, account, depth: 0)
        Option::Some(())
    }

    // Resolves the stubs on the path of `key` in the account trie, of which
    // a complete trie has none, and gives the position of its account if it
    // has one; none if a node is missing or malformed, the source fails or an
    // allocation fails.
    fn open_account(mut self, _ key: u256) -> Option<Option<u32>> {
        if self.stubs.len() != 0 { self.root = self.open(self.root, key, depth: 0, owner: Option::None)? }
        Option::Some(self.find(self.root, key, depth: 0))
    }

    // As `open_account`, for the slot of `key` in the storage of the account
    // at `at`.
    fn open_slot(mut self, _ at: u32, _ key: u256) -> Option<Option<u32>> {
        if self.stubs.len() != 0 {
            let account = self.accounts[at]
            let storage = self.open(account.storage, key, depth: 0, owner: Option::Some(account.key))?
            self.accounts[at].storage = storage
        }
        Option::Some(self.find(self.accounts[at].storage, key, depth: 0))
    }

    // The node in place of `node`, at `depth` of the trie of `owner`, with
    // every stub on the path of `key` under it resolved; none if a node is
    // missing or malformed, the source fails or an allocation fails. It stops
    // at an extension `key` leaves, whose child stays unread, so proving a key
    // absent there needs no more.
    fn open(mut self, _ node: Child, _ key: u256, depth: usize, owner: Option<u256>) -> Option<Child> {
        match node {
            Child::Hash(stub) => {
                let node = self.resolve(stub, owner, prefix: key, depth)?
                self.open(node, key, depth, owner)
            },
            Child::Branch(at) => {
                let digit = nibble(key, depth)
                let child = self.open(self.branches[at].children[digit], key, depth: depth + 1, owner)?
                self.branches[at].children[digit] = child
                Option::Some(node)
            },
            Child::Extension(at) => {
                let extension = self.extensions[at]
                let end = extension.end as usize
                if shared(extension.key, key) < end { return Option::Some(node) }
                // A stub is read, and must be a branch, before the path goes on.
                let child = match extension.child {
                    Child::Hash(stub) => {
                        let hash = self.stubs[stub]
                        let child = self.resolve(stub, owner, prefix: key, depth: end)?
                        let Child::Branch(_) = child else { return self.fail(TrieFault::Malformed(hash)) }
                        child
                    },
                    _ => extension.child,
                }
                self.extensions[at].child = child
                self.open(child, key, depth: end, owner)?
                Option::Some(node)
            },
            _ => Option::Some(node),
        }
    }

    // The node of `stub`, at `depth` of the trie of `owner`, below the first
    // `depth` nibbles of `prefix`, read from the source, which releases the
    // stub: the one place the trie reads a node. None if it is missing or
    // malformed, the source fails or an allocation fails.
    fn resolve(mut self, _ stub: u32, owner: Option<u256>, prefix: u256, depth: usize) -> Option<Child> {
        let hash = self.stubs[stub]
        let at = NodePath { owner, depth: depth.downcast_truncate(), path: above(prefix, depth) }
        let rlp = match self.source.read(at, hash) {
            Result::Ok(rlp) => MemBuffer::try_from_span(rlp)?,
            Result::Err(NodeError::Missing) => return self.fail(TrieFault::Missing(hash)),
            Result::Err(NodeError::Failed) => return self.fail(TrieFault::Source(hash)),
        }
        // A node under 32 bytes is its parent's, not reached by its hash,
        // unless it is a root.
        if rlp.len() < 32 && depth != 0 { return self.fail(TrieFault::Malformed(hash)) }
        let node = self.decode(rlp.span(), prefix, depth, storage: owner.is_some(), hash)?
        self.stubs.release(stub)
        Option::Some(node)
    }

    // The node `rlp` encodes, at `depth` of a storage trie if `storage`,
    // below the first `depth` nibbles of `prefix`, with its key rebuilt and
    // its reference cached: `hash`, or under 32 bytes below a root its RLP.
    // Its inline children are decoded with it, and a hashed child, or an
    // account's storage root, is a stub. None if it is not a node the trie
    // can hold, which makes the node of `hash` malformed, or if an
    // allocation fails.
    fn decode(mut self, _ rlp: MemSpan, prefix: u256, depth: usize, storage: bool, hash: u256) -> Option<Child> {
        let malformed = TrieFault::Malformed(hash)
        var reference = hash
        var len: u8 = 32
        if rlp.len() < 32 && depth != 0 {
            reference = 0
            for index in 0..rlp.len() { reference = reference << 8 | rlp[index] as u256 }
            len = rlp.len().downcast_truncate()
        }
        with (rlp) {
            // Its items, counted to 18 at most.
            var counter = Decoder::new()
            let items = mut counter.list()
            var count: usize = 0
            while count < 18 && !items.is_empty() {
                let _ = items.raw()
                count += 1
            }
            var node = Decoder::new()
            let items = mut node.list()
            if count == 17 {
                // A branch, below which keys of 64 nibbles have one at least.
                if depth >= 64 { return self.fail(malformed) }
                var children = [Child::Empty; 16]
                var filled: usize = 0
                for digit in 0..16 {
                    if items.is_list() {
                        let item = items.raw()
                        if item.len() >= 32 { return self.fail(malformed) }
                        let below = prefix ^ ((nibble(prefix, depth) ^ digit) as u256) << ((63 - depth) * 4) as u256
                        children[digit] = self.decode(item, prefix: below, depth: depth + 1, storage, hash)?
                    } else {
                        let item = items.bytes()
                        if item.len() == 32 {
                            children[digit] = Child::Hash(self.stubs.add(item.read_word(0))?)
                        } else if !item.is_empty() {
                            return self.fail(malformed)
                        }
                    }
                    if !children[digit].is_empty() { filled += 1 }
                }
                let valueless = items.bytes().is_empty()
                if filled < 2 || !valueless || !node.finish() { return self.fail(malformed) }
                return Option::Some(Child::Branch(self.branches.add(Branch { children, reference, len })?))
            }
            if count != 2 { return self.fail(malformed) }
            // Its path, hex-prefix encoded: a flag nibble, 2 for a leaf and 1
            // for an odd count of nibbles, then the first nibble if odd and a
            // zero one if not, then the others. A leaf's ends at nibble 64,
            // and an extension's has a nibble and ends before it.
            let path = items.bytes()
            if path.is_empty() || path.len() > 33 { return self.fail(malformed) }
            let flag = path[0] >> 4
            let odd = (flag & 1) as usize
            let end = depth + (path.len() - 1) * 2 + odd
            let leaf = flag >= 2
            let ends = if leaf { end == 64 } else { end > depth && end < 64 }
            if flag > 3 || (odd == 0 && path[0] & 0xf != 0) || !ends { return self.fail(malformed) }
            var bits: u256 = if odd == 1 { (path[0] & 0xf) as u256 } else { 0 }
            for index in 1..path.len() { bits = bits << 8 | path[index] as u256 }
            let key = above(prefix, depth) | bits << ((64 - end) * 4) as u256
            if !leaf {
                // An extension, over a branch.
                let child = if items.is_list() {
                    let item = items.raw()
                    if item.len() >= 32 { return self.fail(malformed) }
                    let child = self.decode(item, prefix: key, depth: end, storage, hash)?
                    let Child::Branch(_) = child else { return self.fail(malformed) }
                    child
                } else {
                    let item = items.bytes()
                    if item.len() != 32 { return self.fail(malformed) }
                    Child::Hash(self.stubs.add(item.read_word(0))?)
                }
                if !node.finish() { return self.fail(malformed) }
                let extension = Extension { key, reference, child, end: end.downcast_truncate(), len }
                return Option::Some(Child::Extension(self.extensions.add(extension)?))
            }
            // A leaf, whose value is a string of RLP.
            let value = items.bytes()
            if storage {
                let slot = with (value) {
                    var fields = Decoder::new()
                    let slot = fields.uint()
                    if fields.finish() { slot } else { 0 }
                }
                if slot == 0 || !node.finish() { return self.fail(malformed) }
                return Option::Some(Child::Leaf(self.leaves.add(Leaf { key, value: slot, reference, len })?))
            }
            let (nonce, balance, root, code_hash, canonical) = with (value) {
                var fields = Decoder::new()
                let account = mut fields.list()
                let nonce = account.u64()
                let balance = account.uint()
                let root = account.fixed(32)
                let code_hash = account.fixed(32)
                (nonce, balance, root, code_hash, fields.finish())
            }
            if !canonical || !node.finish() { return self.fail(malformed) }
            let storage = if root == EMPTY_ROOT { Child::Empty } else { Child::Hash(self.stubs.add(root)?) }
            let account = Account { key, nonce, balance, code_hash, reference, storage, len }
            Option::Some(Child::Account(self.accounts.add(account)?))
        }
    }

    // The position of the leaf of `key` under `node`, at `depth`, if it has
    // one.
    fn find(self, _ node: Child, _ key: u256, depth: usize) -> Option<u32> {
        match node {
            Child::Branch(at) => self.find(self.branches[at].children[nibble(key, depth)], key, depth: depth + 1),
            Child::Extension(at) => {
                let extension = self.extensions[at]
                if shared(extension.key, key) < extension.end as usize { return Option::None }
                self.find(extension.child, key, depth: extension.end as usize)
            },
            Child::Leaf(at) => if self.leaves[at].key == key { Option::Some(at) } else { Option::None },
            Child::Account(at) => if self.accounts[at].key == key { Option::Some(at) } else { Option::None },
            _ => Option::None,
        }
    }

    // Makes the nodes from `node`, at `depth`, to the leaf of `key`, which is
    // under it, stale.
    fn touch(mut self, _ node: Child, _ key: u256, depth: usize) {
        self.stale(node)
        match node {
            Child::Branch(at) => self.touch(self.branches[at].children[nibble(key, depth)], key, depth: depth + 1),
            Child::Extension(at) => self.touch(self.extensions[at].child, key, depth: self.extensions[at].end as usize),
            _ => {},
        }
    }

    // The node in place of `node`, at `depth`, once `leaf`, of `key`, which
    // is not under it, is added; none if an allocation fails.
    fn insert(mut self, _ node: Child, _ leaf: Child, _ key: u256, depth: usize) -> Option<Child> {
        match node {
            Child::Empty => Option::Some(leaf),
            Child::Branch(at) => {
                let digit = nibble(key, depth)
                let child = self.insert(self.branches[at].children[digit], leaf, key, depth: depth + 1)?
                let branch = mut self.branches[at]
                branch.children[digit] = child
                branch.len = 0
                Option::Some(node)
            },
            Child::Extension(at) => {
                let extension = self.extensions[at]
                let end = extension.end as usize
                let shared = shared(extension.key, key)
                if shared >= end {
                    let child = self.insert(extension.child, leaf, key, depth: end)?
                    let extension = mut self.extensions[at]
                    extension.child = child
                    extension.len = 0
                    return Option::Some(node)
                }
                // Below the fork, the rest of the extension, if any, over its
                // branch.
                let rest = if shared + 1 == end {
                    self.extensions.release(at)
                    extension.child
                } else {
                    self.stale(node)
                    node
                }
                self.fork(depth, at: shared, leaf, key, other: rest, other_key: extension.key)
            },
            _ => {
                // A leaf, which moves down below the fork.
                let other_key = self.key(node)
                self.stale(node)
                self.fork(depth, at: shared(other_key, key), leaf, key, other: node, other_key)
            },
        }
    }

    // A branch at depth `at` over `leaf`, of `key`, and `other`, which holds
    // keys with the nibble of `other_key` there, below an extension from
    // `depth` if `at` is deeper; none if an allocation fails.
    fn fork(mut self, depth: usize, at: usize, _ leaf: Child, _ key: u256, other: Child, other_key: u256)
        -> Option<Child> {
        var children = [Child::Empty; 16]
        children[nibble(key, at)] = leaf
        children[nibble(other_key, at)] = other
        let branch = Child::Branch(self.branches.add(Branch { children, reference: 0, len: 0 })?)
        if at == depth { return Option::Some(branch) }
        let extension = Extension { key, reference: 0, child: branch, end: at.downcast_truncate(), len: 0 }
        Option::Some(Child::Extension(self.extensions.add(extension)?))
    }

    // The node in place of `node`, at `depth` of the trie of `owner`, once
    // the leaf of `key`, which is under it, is removed with its storage; none
    // if a node is missing or malformed, the source fails or an allocation
    // fails. A branch left with one child gives way to it, and an extension
    // over what is no longer a branch gives it its path.
    fn remove(mut self, _ node: Child, _ key: u256, depth: usize, owner: Option<u256>) -> Option<Child> {
        match node {
            Child::Branch(at) => {
                let digit = nibble(key, depth)
                let child = self.remove(self.branches[at].children[digit], key, depth: depth + 1, owner)?
                let branch = mut self.branches[at]
                branch.children[digit] = child
                branch.len = 0
                var count: usize = 0
                var only: usize = 0
                for index in 0..16 {
                    if !branch.children[index].is_empty() {
                        count += 1
                        only = index
                    }
                }
                if count > 1 { return Option::Some(node) }
                let child = branch.children[only]
                self.branches.release(at)
                // The removed key with the child's nibble here, whose first
                // nibbles are the child's.
                let key = key ^ ((nibble(key, depth) ^ only) as u256) << ((63 - depth) * 4) as u256
                // A stub is read, for its kind decides what takes the
                // branch's place.
                let child = match child {
                    Child::Hash(stub) => self.resolve(stub, owner, prefix: key, depth: depth + 1)?,
                    _ => child,
                }
                let Child::Branch(_) = child else {
                    // A leaf or an extension, which moves up a nibble.
                    self.stale(child)
                    return Option::Some(child)
                }
                // An extension of the one nibble over the branch.
                let extension = Extension { key, reference: 0, child, end: (depth + 1).downcast_truncate(), len: 0 }
                Option::Some(Child::Extension(self.extensions.add(extension)?))
            },
            Child::Extension(at) => {
                let end = self.extensions[at].end as usize
                let child = self.remove(self.extensions[at].child, key, depth: end, owner)?
                let Child::Branch(_) = child else {
                    // A stale leaf or extension, which takes this one's path.
                    self.extensions.release(at)
                    return Option::Some(child)
                }
                let extension = mut self.extensions[at]
                extension.child = child
                extension.len = 0
                Option::Some(node)
            },
            _ => {
                self.clear(node)
                Option::Some(Child::Empty)
            },
        }
    }

    // Releases `node` and every node under it.
    fn clear(mut self, _ node: Child) {
        match node {
            Child::Leaf(at) => self.leaves.release(at),
            Child::Account(at) => {
                self.clear(self.accounts[at].storage)
                self.accounts.release(at)
            },
            Child::Extension(at) => {
                self.clear(self.extensions[at].child)
                self.extensions.release(at)
            },
            Child::Branch(at) => {
                let children = self.branches[at].children
                for child in children { self.clear(child) }
                self.branches.release(at)
            },
            Child::Hash(at) => self.stubs.release(at),
            Child::Empty => {},
        }
    }

    // The key of a leaf.
    fn key(self, _ leaf: Child) -> u256 {
        match leaf {
            Child::Leaf(at) => self.leaves[at].key,
            Child::Account(at) => self.accounts[at].key,
            _ => 0,
        }
    }

    fn stale(mut self, _ node: Child) { self.cache(node, reference: 0, len: 0) }

    fn cache(mut self, _ node: Child, reference: u256, len: u8) {
        match node {
            Child::Leaf(at) => {
                let leaf = mut self.leaves[at]
                leaf.reference = reference
                leaf.len = len
            },
            Child::Account(at) => {
                let account = mut self.accounts[at]
                account.reference = reference
                account.len = len
            },
            Child::Extension(at) => {
                let extension = mut self.extensions[at]
                extension.reference = reference
                extension.len = len
            },
            Child::Branch(at) => {
                let branch = mut self.branches[at]
                branch.reference = reference
                branch.len = len
            },
            _ => {},
        }
    }

    // The reference of a node and its length, zero for the empty node or a
    // stale one.
    fn reference(self, _ node: Child) -> (u256, usize) {
        match node {
            Child::Leaf(at) => (self.leaves[at].reference, self.leaves[at].len as usize),
            Child::Account(at) => (self.accounts[at].reference, self.accounts[at].len as usize),
            Child::Extension(at) => (self.extensions[at].reference, self.extensions[at].len as usize),
            Child::Branch(at) => (self.branches[at].reference, self.branches[at].len as usize),
            Child::Hash(at) => {
                let hash = self.stubs[at]
                (hash, 32)
            },
            Child::Empty => (0, 0),
        }
    }

    // The root of the trie whose root node is `node`, which is not stale: its
    // hash, even if under 32 bytes.
    fn root_of(self, _ node: Child) -> u256 {
        if node.is_empty() { return EMPTY_ROOT }
        let (reference, len) = self.reference(node)
        if len == 32 { reference } else { hash(reference, len) }
    }

    // Puts the reference of `node`, which is not stale, in a parent's RLP,
    // using `path` for an embedded node.
    fn put_child(self, _ rlp: mut Encoder, _ path: mut MemBuffer, _ node: Child) {
        let (reference, len) = self.reference(node)
        if node.is_empty() {
            rlp.fixed(0, len: 0)
        } else if len == 32 {
            rlp.fixed(reference, len: 32)
        } else {
            path.write_word(offset: 0, value: reference)
            rlp.raw(path.slice(offset: 32 - len, len))
        }
    }

    // Puts the RLP of `node`, at `depth`, whose children are not stale, in
    // `rlp`, making a leaf's value in `value` and paths in `path`.
    fn encode(self, _ node: Child, depth: usize, _ rlp: mut Encoder, _ value: mut Encoder, _ path: mut MemBuffer) {
        let start = rlp.begin()
        match node {
            Child::Leaf(at) => {
                let leaf = self.leaves[at]
                put_path(mut rlp, mut path, leaf.key, from: depth, to: 64, leaf: true)
                let item = value.begin()
                value.uint(leaf.value)
                rlp.bytes(value.since(item))
                value.truncate(item)
            },
            Child::Account(at) => {
                let account = self.accounts[at]
                put_path(mut rlp, mut path, account.key, from: depth, to: 64, leaf: true)
                let item = value.begin()
                value.uint(account.nonce as u256)
                value.uint(account.balance)
                value.fixed(self.root_of(account.storage), len: 32)
                value.fixed(account.code_hash, len: 32)
                value.end(item)
                rlp.bytes(value.since(item))
                value.truncate(item)
            },
            Child::Extension(at) => {
                let extension = self.extensions[at]
                put_path(mut rlp, mut path, extension.key, from: depth, to: extension.end as usize, leaf: false)
                self.put_child(mut rlp, mut path, extension.child)
            },
            Child::Branch(at) => {
                let children = self.branches[at].children
                for child in children { self.put_child(mut rlp, mut path, child) }
                rlp.fixed(0, len: 0)
            },
            _ => {},
        }
        rlp.end(start)
    }

    // Caches the reference of `node`, at `depth`, and of each stale node
    // under it: each node's RLP is made in `rlp`, a leaf's value in `value`,
    // and paths in `path`.
    fn rehash(mut self, _ node: Child, depth: usize, _ rlp: mut Encoder, _ value: mut Encoder,
              _ path: mut MemBuffer) {
        if node.is_empty() || self.reference(node).1 != 0 { return }
        match node {
            Child::Account(at) => self.rehash(self.accounts[at].storage, depth: 0, mut rlp, mut value, mut path),
            Child::Extension(at) => {
                let extension = self.extensions[at]
                self.rehash(extension.child, depth: extension.end as usize, mut rlp, mut value, mut path)
            },
            Child::Branch(at) => {
                let children = self.branches[at].children
                for child in children { self.rehash(child, depth: depth + 1, mut rlp, mut value, mut path) }
            },
            _ => {},
        }
        let start = rlp.begin()
        self.encode(node, depth, mut rlp, mut value, mut path)
        let len = rlp.since(start).len()
        var reference: u256 = 0
        if len >= 32 {
            reference = keccak256_word(rlp.since(start))
        } else {
            for index in 0..len { reference = reference << 8 | rlp.since(start)[index] as u256 }
        }
        rlp.truncate(start)
        self.cache(node, reference, len: if len >= 32 { 32 } else { len.downcast_truncate() })
    }

    // Adds to `nodes` the RLP of `node`, at `depth`, which is not stale, if
    // it is reached by its hash, and of each such node under it; false if an
    // allocation fails.
    fn write(self, _ node: Child, depth: usize, _ nodes: mut Nodes, _ rlp: mut Encoder, _ value: mut Encoder,
             _ path: mut MemBuffer) -> bool {
        match node {
            // The trie holds no node of a stub.
            Child::Empty | Child::Hash(_) => return true,
            _ => {},
        }
        if depth == 0 || self.reference(node).1 == 32 {
            let start = rlp.begin()
            self.encode(node, depth, mut rlp, mut value, mut path)
            let added = nodes.add(rlp.since(start))
            rlp.truncate(start)
            if !added { return false }
        }
        match node {
            Child::Account(at) => {
                self.write(self.accounts[at].storage, depth: 0, mut nodes, mut rlp, mut value, mut path)
            },
            Child::Extension(at) => {
                let extension = self.extensions[at]
                self.write(extension.child, depth: extension.end as usize, mut nodes, mut rlp, mut value, mut path)
            },
            Child::Branch(at) => {
                let children = self.branches[at].children
                for child in children {
                    if !self.write(child, depth: depth + 1, mut nodes, mut rlp, mut value, mut path) { return false }
                }
                true
            },
            _ => true,
        }
    }
}
