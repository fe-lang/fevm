// The consensus encoding of a receipt, which the receipts trie holds.
use core::{MemBuffer, Option}
use fevm::{Bloom, ERR_REVERT, LogBuffer, OK, Receipt}
use fevm::status::VALID
use fevm_rlp::Encoder
use ingot::trie::Trie

/// Puts the receipt of a transaction of type `kind`: `rlp([status,
/// cumulative_gas_used, logs_bloom, logs])`, with status 1 for a successful
/// message and 0 otherwise, each log `[address, [topic, ...], data]`; after
/// the type for a typed transaction (EIP-2718).
pub fn encode_receipt(_ rlp: mut Encoder, _ receipt: Receipt, kind: u8) {
    // A type, below 0x80, is its own RLP.
    if kind != 0 { rlp.uint(kind as u256) }
    let list = rlp.begin()
    rlp.uint(if receipt.status == OK { 1 } else { 0 })
    rlp.uint(receipt.cumulative_gas_used as u256)
    var bloom = Bloom::new()
    bloom.add_logs(receipt.logs)
    rlp.words(bloom.words)
    let logs = rlp.begin()
    var index: u64 = 0
    while index < receipt.logs.len() {
        let entry = receipt.logs.entry(index)
        let log = rlp.begin()
        rlp.fixed(entry.address, len: 20)
        let topics = rlp.begin()
        for topic in 0..entry.topic_count.downcast_truncate() { rlp.fixed(entry.topics[topic], len: 32) }
        rlp.end(topics)
        rlp.bytes(receipt.logs.payload(index))
        rlp.end(log)
        index += 1
    }
    rlp.end(logs)
    rlp.end(list)
}

// A receipt with `logs`, of a message that ended with `status`.
fn receipt(status: i32, cumulative_gas_used: u64, logs: own LogBuffer) -> Receipt {
    Receipt {
        invalid: VALID, status, gas_used: 0, cumulative_gas_used, gas_refunded: 0, execution_gas_used: 0,
        state_gas_used: 0, created: Option::None, output: MemBuffer::empty(), logs,
    }
}

#[test]
fn receipts_root_matches_sepolia() {
    // evmone's state_mpt_hash_test: Sepolia block 2,912,895's first two
    // receipts, a legacy transaction's with three logs and an EIP-1559 one's
    // with none.
    let address = 0x84bf5c35c54a994c72ff9d8b4cca8f5034153a2c
    let sender = 0x38dc84830b92d171d7b4c129c813360d6ab8b54e
    let empty = MemBuffer::empty()
    var logs = LogBuffer::new()
    let first = [0x0109fc6f55cf40689f02fbaad7af7fe7bbac8a3d2186600afc7d3e10cac60271, 0x27b6, sender, 0]
    core::assert(logs.append_word(address, topics: first, topic_count: 3, word: 0x63ee2f6c))
    let second = [0x92e98423f8adac6e64d0608e519fd1cefb861498385c6dee70d58fc926ddc68c, 0x481f2280, 0x27b6, sender]
    core::assert(logs.append(address, topics: second, topic_count: 4, data: empty.span()))
    let third = [0xfe25c73e3b9089fac37d55c4c7efcba6f04af04cebd2fc4d6d7dbb07e1e5234f, 0x0c958b4bca4282ac0000, 0, 0]
    core::assert(logs.append(address, topics: third, topic_count: 2, data: empty.span()))
    var receipts = Trie::new()
    encode_receipt(mut receipts.item(), receipt(status: OK, cumulative_gas_used: 0x24522, logs), kind: 0)
    let eip1559 = receipt(status: OK, cumulative_gas_used: 0x2cd9b, logs: LogBuffer::new())
    encode_receipt(mut receipts.item(), eip1559, kind: 2)
    core::assert(receipts.root().unwrap() == 0x7199a3a86010634dc205a1cdd6ec609f70b954167583cb3acb6a2e3057916016)
}

#[test]
fn receipts_root_matches_fixtures() {
    // test_set_code_to_log[log_opcode_LOG4]: a set-code transaction's, with
    // a log of four topics.
    let sender = 0xf6c3a9edc1afa0ad5b720e4d42e1437c43d3b3ff
    var logs = LogBuffer::new()
    core::assert(logs.append_word(address: sender, topics: [1, 2, 3, 4], topic_count: 4, word: 0x1234))
    var receipts = Trie::new()
    encode_receipt(mut receipts.item(), receipt(status: OK, cumulative_gas_used: 0x9681, logs), kind: 4)
    core::assert(receipts.root().unwrap() == 0x31f4171deac51e7f1fd2e2da373497a803a65ae31e2e6e05fdbc4857caf9566d)
    // test_withdrawal_requests[single_block_multiple_withdrawal_request_first_reverts]:
    // a reverted call's, then the withdrawal request contract's log of a
    // source address, a validator key and an amount.
    var request = MemBuffer::new(76)
    request.write_word(offset: 44, value: 0xfffffffffffffffe)
    request.write_word(offset: 0, value: sender << 96)
    request[67] = 0x02
    var logs = LogBuffer::new()
    let address = 0x00000961ef480eb55e80d19ad83579a64c007002
    core::assert(logs.append(address, topics: [0; 4], topic_count: 0, data: request.span()))
    var receipts = Trie::new()
    let reverted = receipt(status: ERR_REVERT, cumulative_gas_used: 0x5c20, logs: LogBuffer::new())
    encode_receipt(mut receipts.item(), reverted, kind: 0)
    encode_receipt(mut receipts.item(), receipt(status: OK, cumulative_gas_used: 0x021ed1, logs), kind: 0)
    core::assert(receipts.root().unwrap() == 0x8513e930bc6adaedf94c6b253546f42cf161244deafb4ddb1c1dc1d3179ec65e)
}

#[test]
fn receipts_root_crosses_index_boundaries() {
    // test_index_trie_shapes: blocks of transfers, each using 21,000 gas,
    // whose keys run past 0x7f to 0x8180 and past 0x81ff to 0x820100.
    let counts: [usize; 7] = [17, 129, 130, 145, 257, 258, 273]
    let roots: [u256; 7] = [
        0xd3aea88a6bd0ea6ea4a5d024ef610cf722474e7719ce2397e5285c68e6221d0f,
        0xe85fe9172e4db0df82865ac055bad84ce48bc90d0bc095632676277b1ebed0a7,
        0xcd04375e5321aae8c188ebaaf8806acf92c85ef34b8e159c87da2d6cb17de9f3,
        0x4888c55f7b3d63a4e304e3808a4664c58b5950cefbfe918cc9bab8249f54cbda,
        0x45a8ea702972bf053785b3e2943feec7a4c7fb07507fb49a203aa5bd1e41a341,
        0xf0ebd796b353b702be220e1c905930603c160547f68ccd3fa19deb155a3fd1ab,
        0x00cb49214e9564beef671fdaf0ac7cd71315a3a10c53060aeb9b3834ca8ef6da,
    ]
    for test in 0..7 {
        var receipts = Trie::new()
        for index in 0..counts[test] {
            let gas: u64 = 21_000 * (index + 1).downcast_truncate()
            encode_receipt(mut receipts.item(), receipt(status: OK, cumulative_gas_used: gas, logs: LogBuffer::new()), kind: 0)
        }
        core::assert(receipts.root().unwrap() == roots[test])
    }
}
