use ingot::transaction::Transaction
use ingot::constants::{ERR_OUT_OF_GAS, OK}
use ingot::state::WorldState
use ingot::types::{Program, default_block_env, default_call_env, empty_bytes}
use ingot::vm::{Vm, execute, execute_vm}

#[test]
fn vm_reuses_zeroed_memory_and_transfers_owned_output() {
    var bytes: [u8; 4096] = [0; 4096]
    var i: usize = 0
    // Store 0xab at 8999 and return the first 9000 bytes.
    for op in [0x60, 0xab, 0x61, 0x23, 0x27, 0x53, 0x61, 0x23, 0x28, 0x5f, 0xf3] {
        bytes[i] = op
        i += 1
    }
    let large = Program::copy_from(bytes, len: i)
    var state = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    var vm = Vm::new()
    vm.run(
        large,
        empty_bytes(),
        default_call_env(),
        default_block_env(),
        mut state,
    )
    core::assert(
        vm.status == OK && vm.gas_remaining == 998985,
    )
    core::assert(vm.memory_size == 9024 && vm.output.len() == 9000)
    core::assert(vm.output[8999 as usize] == 0xab)
    let memory_capacity = vm.memory.capacity()
    let output_capacity = vm.output.capacity()

    var bytes: [u8; 4096] = [0; 4096]
    bytes[0] = 0x60
    bytes[1] = 32
    bytes[2] = 0x5f
    bytes[3] = 0xf3
    let small = Program::copy_from(bytes, len: 4)
    var call = default_call_env()
    call.gas_limit = 20
    vm.run(small, empty_bytes(), call, default_block_env(), mut state)
    core::assert(vm.status == OK && vm.gas_remaining == 12 && vm.stack.len() == 0)
    core::assert(vm.memory_size == 32 && vm.output.len() == 32)
    core::assert(vm.memory.capacity() == memory_capacity)
    core::assert(vm.output.capacity() == output_capacity)

    var bytes: [u8; 4096] = [0; 4096]
    bytes[0] = 0x61
    bytes[1] = 0x23
    bytes[2] = 0x28
    bytes[3] = 0x5f
    bytes[4] = 0xf3
    let regrow = Program::copy_from(bytes, len: 5)
    vm.run(
        regrow,
        empty_bytes(),
        default_call_env(),
        default_block_env(),
        mut state,
    )
    core::assert(vm.status == OK && vm.gas_remaining == 998994)
    core::assert(
        vm.memory_size == 9024 && vm.memory.capacity() == memory_capacity,
    )
    let result = vm.into_result(mut state.frame_buffers())
    core::assert(result.output_valid && result.output.len() == 9000)
    for byte in result.output.span() {
        core::assert(byte == 0)
    }
    state.finish(commit: true, gas_spent: 0)
}

#[test]
fn vm_exhausts_gas_before_allocating_and_can_reset_after_fault() {
    var bytes: [u8; 4096] = [0; 4096]
    // MSTORE8 at 2^255: charge failure must precede host allocation.
    bytes[0] = 0x60
    bytes[1] = 1
    bytes[2] = 0x7f
    bytes[3] = 0x80
    bytes[35] = 0x53
    let huge = Program::copy_from(bytes, len: 36)
    var state = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    var vm = Vm::new()
    vm.run(
        huge,
        empty_bytes(),
        default_call_env(),
        default_block_env(),
        mut state,
    )
    core::assert(vm.status == ERR_OUT_OF_GAS && vm.gas_remaining == 0)
    core::assert(vm.memory_size == 0 && vm.memory.capacity() == 0)
    core::assert(vm.output.len() == 0 && vm.output.capacity() == 0)

    let stop = Program::copy_from([0 as u8], len: 1)
    var call = default_call_env()
    call.gas_limit = 0
    vm.run(stop, empty_bytes(), call, default_block_env(), mut state)
    core::assert(vm.status == OK && vm.gas_remaining == 0 && vm.stack.len() == 0)
    core::assert(vm.halted && !vm.output_valid && vm.memory_size == 0)
    state.finish(commit: true, gas_spent: 0)
}

#[test]
fn frames_take_over_finished_frames_memory_zeroed() {
    var state = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    // PUSH1 0x2a PUSH0 MSTORE: leaves a nonzero word in memory.
    let store = Program::copy_from([0x60 as u8, 0x2a, 0x5f, 0x52], len: 4)
    let stored = execute(store, empty_bytes(), default_call_env(), default_block_env(), mut state)
    core::assert(stored.status == OK)
    // STOP: a frame that touches no memory still holds the first one's buffer.
    let stop = Program::copy_from([0 as u8], len: 1)
    let vm = execute_vm(stop, empty_bytes(), default_call_env(), default_block_env(), mut state)
    core::assert(vm.memory_size == 0 && vm.memory.capacity() != 0 && vm.stack.capacity() != 0)
    vm.into_result(mut state.frame_buffers())
    // PUSH0 MLOAD: the reused memory reads zero.
    let load = Program::copy_from([0x5f as u8, 0x51], len: 2)
    let loaded = execute(load, empty_bytes(), default_call_env(), default_block_env(), mut state)
    core::assert(loaded.status == OK && loaded.stack_top == 0)
    state.finish(commit: true, gas_spent: 0)
}
