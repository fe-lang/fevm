use std::native::ByteBuffer
use std::io::{Write, write, write_char}
use std::native::Arg
use ingot::constants::{ERR_BAD_HEX, ERR_CODE_TOO_LONG, ERR_ODD_HEX, MAX_CODE, OK, INPUT_LIMIT}
use ingot::types::{InputData, Program}

fn hex_digit(_ value: u8) -> i32 {
    if value < 10 {
        (value as i32) + 48
    } else {
        (value as i32) + 87
    }
}

pub fn write_hex_u256(_ value: u256) uses (w: mut Write) {
    write_hex_word(value)
    write_char(10)
}

pub fn write_hex_word(_ value: u256) uses (w: mut Write) {
    write("0x")
    let mut i: usize = 0
    while i < 64 {
        let shift = ((63 - i) as u256) * 4
        let nibble: u8 = ((value >> shift) & 15).downcast_unchecked()
        write_char(hex_digit(nibble))
        i += 1
    }
}

pub fn write_hex_byte(_ value: i32) uses (w: mut Write) {
    let hi: u8 = (value / 16).downcast_unchecked()
    let lo: u8 = (value % 16).downcast_unchecked()
    write_char(hex_digit(hi))
    write_char(hex_digit(lo))
}

pub fn write_hex_bytes(_ bytes: ByteBuffer) uses (w: mut Write) {
    write("0x")
    let mut i: u64 = 0
    while i < bytes.len() {
        write_hex_byte(bytes.byte_at(i) as i32)
        i += 1
    }
    write_char(10)
}

fn is_prefixed_hex(_ arg: Arg) -> bool {
    arg.len() >= 2 && arg.byte_at(0) == 48 && (arg.byte_at(1) == 120 || arg.byte_at(1) == 88)
}

fn hex_value(_ byte: u8) -> i32 {
    if byte >= 48 && byte <= 57 {
        return (byte as i32) - 48
    }
    if byte >= 65 && byte <= 70 {
        return (byte as i32) - 55
    }
    if byte >= 97 && byte <= 102 {
        return (byte as i32) - 87
    }
    0 - 1
}

pub fn parse_hex_program(_ arg: Arg) -> Program {
    let mut bytes: [u8; MAX_CODE] = [0; MAX_CODE]
    let len = arg.len()
    let mut i: usize = 0
    if is_prefixed_hex(arg) {
        i = 2
    }

    if (len - i) % 2 != 0 {
        return Program::new(bytes, len: 0, status: ERR_ODD_HEX)
    }

    let mut out_len: usize = 0
    while i < len {
        if out_len >= MAX_CODE {
            return Program::new(bytes, len: out_len, status: ERR_CODE_TOO_LONG)
        }

        let hi = hex_value(arg.byte_at(i))
        let lo = hex_value(arg.byte_at(i + 1))
        if hi < 0 || lo < 0 {
            return Program::new(bytes, len: out_len, status: ERR_BAD_HEX)
        }

        bytes[out_len] = ((hi * 16) + lo).downcast_unchecked()
        out_len += 1
        i += 2
    }

    Program::new(bytes, len: out_len, status: OK)
}

pub fn parse_hex_bytes(_ arg: Arg) -> InputData {
    let mut bytes: [u8; INPUT_LIMIT] = [0; INPUT_LIMIT]
    let len = arg.len()
    let mut i: usize = 0
    if is_prefixed_hex(arg) {
        i = 2
    }

    if (len - i) % 2 != 0 {
        return InputData { bytes: bytes, len: 0, status: ERR_ODD_HEX }
    }

    let mut out_len: usize = 0
    while i < len {
        if out_len >= INPUT_LIMIT {
            return InputData { bytes: bytes, len: out_len, status: ERR_CODE_TOO_LONG }
        }

        let hi = hex_value(arg.byte_at(i))
        let lo = hex_value(arg.byte_at(i + 1))
        if hi < 0 || lo < 0 {
            return InputData { bytes: bytes, len: out_len, status: ERR_BAD_HEX }
        }

        bytes[out_len] = ((hi * 16) + lo).downcast_unchecked()
        out_len += 1
        i += 2
    }

    InputData { bytes: bytes, len: out_len, status: OK }
}
