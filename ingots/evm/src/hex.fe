use core::{MemBuffer, Option}
use std::io::{Write, write, write_char}
use std::native::Arg
use ingot::constants::{ERR_BAD_HEX, ERR_HOST_ALLOCATION, ERR_ODD_HEX, OK}
use ingot::types::{InputData, Program}

fn hex_digit(_ value: u8) -> i32 {
    if value < 10 {
        (value as i32) + 48
    } else {
        (value as i32) + 87
    }
}

pub fn write_hex_u256(_ value: u256) uses (w: mut Write) {
    write_hex_word(value)
    write_char(10)
}

pub fn write_hex_word(_ value: u256) uses (w: mut Write) {
    write("0x")
    var i: usize = 0
    while i < 64 {
        let shift = ((63 - i) as u256) * 4
        let nibble: u8 = ((value >> shift) & 15).downcast_unchecked()
        write_char(hex_digit(nibble))
        i += 1
    }
}

pub fn write_hex_byte(_ value: i32) uses (w: mut Write) {
    let hi: u8 = (value / 16).downcast_unchecked()
    let lo: u8 = (value % 16).downcast_unchecked()
    write_char(hex_digit(hi))
    write_char(hex_digit(lo))
}

pub fn write_hex_bytes(_ bytes: MemBuffer) uses (w: mut Write) {
    write("0x")
    for byte in bytes.span() {
        write_hex_byte(byte as i32)
    }
    write_char(10)
}

fn is_prefixed_hex(_ arg: Arg) -> bool {
    arg.len() >= 2 && arg.byte_at(0) == 48 && (arg.byte_at(1) == 120 || arg.byte_at(1) == 88)
}

fn hex_value(_ byte: u8) -> i32 {
    if byte >= 48 && byte <= 57 {
        return (byte as i32) - 48
    }
    if byte >= 65 && byte <= 70 {
        return (byte as i32) - 55
    }
    if byte >= 97 && byte <= 102 {
        return (byte as i32) - 87
    }
    0 - 1
}

pub fn parse_decimal(_ arg: Arg) -> Option<u64> {
    if arg.len() == 0 {
        return Option::None
    }
    var value: u64 = 0
    var i: usize = 0
    while i < arg.len() {
        let byte = arg.byte_at(i)
        if byte < 48 || byte > 57 {
            return Option::None
        }
        let digit = (byte - 48) as u64
        if value > (0xffffffffffffffff - digit) / 10 {
            return Option::None
        }
        value = value * 10 + digit
        i += 1
    }
    Option::Some(value)
}

pub fn parse_hex_program(_ arg: Arg) -> Program {
    Program::new(parse_hex_bytes(arg))
}

pub fn parse_hex_bytes(_ arg: Arg) -> InputData {
    var bytes = MemBuffer::empty()
    let len = arg.len()
    var i: usize = 0
    if is_prefixed_hex(arg) {
        i = 2
    }

    if (len - i) % 2 != 0 {
        return InputData::new(bytes, status: ERR_ODD_HEX)
    }
    if !bytes.try_resize(((len - i) / 2).downcast_unchecked()) {
        return InputData::new(bytes, status: ERR_HOST_ALLOCATION)
    }
    var out_len: u64 = 0
    while i < len {
        let hi = hex_value(arg.byte_at(i))
        let lo = hex_value(arg.byte_at(i + 1))
        if hi < 0 || lo < 0 {
            return InputData::new(bytes, status: ERR_BAD_HEX)
        }

        bytes[out_len as usize] = ((hi * 16) + lo).downcast_unchecked()
        out_len += 1
        i += 2
    }

    InputData::new(bytes, status: OK)
}
