use core::{MemBuffer, MemSpan, Option}
use std::env::Arg
use std::io::Display
use ingot::status::{ERR_HOST_ALLOCATION, OK}
use ingot::types::{InputData, Program}

// Parse failures.
pub const ERR_BAD_HEX: i32 = 3
pub const ERR_ODD_HEX: i32 = 4

fn hex_digit(_ value: u8) -> u8 {
    if value < 10 { value + 48 } else { value + 87 }
}

/// Appends `0x` and the 64 hex digits of `value`.
pub fn write_hex_word(_ value: u256) uses (text: mut MemBuffer) {
    "0x".fmt(mut text)
    var shift: u256 = 256
    while shift > 0 {
        shift -= 4
        text.push(hex_digit(((value >> shift) & 15).downcast_unchecked()))
    }
}

/// Appends the two hex digits of `value`.
pub fn write_hex_byte(_ value: u8) uses (text: mut MemBuffer) {
    text.push(hex_digit(value >> 4))
    text.push(hex_digit(value & 15))
}

/// Appends `0x` and the hex digits of `bytes`.
pub fn write_hex_bytes(_ bytes: MemSpan) uses (text: mut MemBuffer) {
    // Grow once. Doubling would pass through the VM's power-of-two buffer
    // sizes, which the CLI allocation fixtures count.
    text.reserve(2 + 2 * bytes.len())
    "0x".fmt(mut text)
    for byte in bytes {
        write_hex_byte(byte)
    }
}

fn is_prefixed_hex(_ arg: Arg) -> bool {
    let bytes = arg.span()
    bytes.len() >= 2 && bytes[0] == 48 && (bytes[1] == 120 || bytes[1] == 88)
}

fn hex_value(_ byte: u8) -> i32 {
    if byte >= 48 && byte <= 57 {
        return (byte as i32) - 48
    }
    if byte >= 65 && byte <= 70 {
        return (byte as i32) - 55
    }
    if byte >= 97 && byte <= 102 {
        return (byte as i32) - 87
    }
    0 - 1
}

pub fn parse_decimal(_ arg: Arg) -> Option<u64> {
    if arg.len() == 0 {
        return Option::None
    }
    var value: u64 = 0
    var i: usize = 0
    while i < arg.len() {
        let byte = arg.span()[i]
        if byte < 48 || byte > 57 {
            return Option::None
        }
        let digit = (byte - 48) as u64
        if value > (0xffffffffffffffff - digit) / 10 {
            return Option::None
        }
        value = value * 10 + digit
        i += 1
    }
    Option::Some(value)
}

pub fn parse_hex_program(_ arg: Arg) -> Program {
    Program::new(parse_hex_bytes(arg))
}

pub fn parse_hex_bytes(_ arg: Arg) -> InputData {
    let len = arg.len()
    var i: usize = 0
    if is_prefixed_hex(arg) {
        i = 2
    }

    if (len - i) % 2 != 0 {
        return InputData::new(MemBuffer::empty(), status: ERR_ODD_HEX)
    }
    let Option::Some(var bytes) = MemBuffer::try_new((len - i) / 2) else {
        return InputData::new(MemBuffer::empty(), status: ERR_HOST_ALLOCATION)
    }
    var out_len: u64 = 0
    while i < len {
        let hi = hex_value(arg.span()[i])
        let lo = hex_value(arg.span()[i + 1])
        if hi < 0 || lo < 0 {
            return InputData::new(bytes, status: ERR_BAD_HEX)
        }

        bytes[out_len as usize] = ((hi * 16) + lo).downcast_unchecked()
        out_len += 1
        i += 2
    }

    InputData::new(bytes, status: OK)
}
