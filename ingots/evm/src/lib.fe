pub use constants::{ERR_REVERT, OK}
pub use hex::{self, parse_hex_program}
pub use state::{StorageKey, WorldState}
pub use types::{
    BlockEnv,
    ByteBuffer,
    CallEnv,
    ExecutionResult,
    Program,
    default_block_env,
    default_call_env,
    empty_bytes,
}
pub use vm::{self, execute}

pub fn main(argc: i32, argv: **u8) -> i32 {
    cli::run(argc, argv)
}

#[test]
fn evm_sload_sstore_roundtrip() {
    let mut bytes: [u8; 4096] = [0; 4096]
    bytes[0] = 0x60
    bytes[1] = 0x2a
    bytes[2] = 0x60
    bytes[3] = 0x03
    bytes[4] = 0x55
    bytes[5] = 0x60
    bytes[6] = 0x03
    bytes[7] = 0x54
    bytes[8] = 0x00
    let program = Program::new(bytes, len: 9, status: OK)
    let call = CallEnv { address: 0xaa, caller: 0, origin: 0, callvalue: 0, gasprice: 0, gas: 0 }
    let mut state = WorldState::empty()
    let result = execute(
        program,
        empty_bytes(),
        call,
        default_block_env(),
        mut state,
    )

    core::assert(result.status == OK)
    core::assert(result.stack_top == 0x2a)
    core::assert(state.storage_load(0xaa, 3) == 0x2a)
}

#[test]
fn evm_balance_selfbalance_and_blockhash_use_state() {
    let mut bytes: [u8; 4096] = [0; 4096]
    bytes[0] = 0x60
    bytes[1] = 0xbb
    bytes[2] = 0x31
    bytes[3] = 0x47
    bytes[4] = 0x01
    bytes[5] = 0x60
    bytes[6] = 0x07
    bytes[7] = 0x40
    bytes[8] = 0x01
    bytes[9] = 0x00
    let program = Program::new(bytes, len: 10, status: OK)
    let call = CallEnv { address: 0xaa, caller: 0, origin: 0, callvalue: 0, gasprice: 0, gas: 0 }
    let mut state = WorldState::empty()
    core::assert(state.set_balance(0xaa, 100))
    core::assert(state.set_balance(0xbb, 23))
    core::assert(state.set_block_hash(7, 5))

    let result = execute(
        program,
        empty_bytes(),
        call,
        default_block_env(),
        mut state,
    )

    core::assert(result.status == OK)
    core::assert(result.stack_top == 128)
}

#[test]
fn evm_tload_tstore_roundtrip() {
    let mut bytes: [u8; 4096] = [0; 4096]
    bytes[0] = 0x60
    bytes[1] = 0x09
    bytes[2] = 0x60
    bytes[3] = 0x04
    bytes[4] = 0x5d
    bytes[5] = 0x60
    bytes[6] = 0x04
    bytes[7] = 0x5c
    bytes[8] = 0x00
    let program = Program::new(bytes, len: 9, status: OK)
    let call = CallEnv { address: 0xaa, caller: 0, origin: 0, callvalue: 0, gasprice: 0, gas: 0 }
    let mut state = WorldState::empty()
    let result = execute(
        program,
        empty_bytes(),
        call,
        default_block_env(),
        mut state,
    )

    core::assert(result.status == OK)
    core::assert(result.stack_top == 9)
    core::assert(state.transient_load(0xaa, 4) == 9)
}
