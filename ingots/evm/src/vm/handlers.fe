// The opcode handlers: the `Cursor` they pass from one to the next, the
// operations they run and the dispatch between them.
use core::num::{IntWord, from_be}
use core::ptr::{cast, offset_bytes}
use ingot::memory::small_growth_cost
use ingot::gas::base_cost
use core::ops::{WrappingAdd, WrappingMul, WrappingSub}
use core::num::leading_zeros
use std::evm::crypto::{addmod, mulmod}
use ingot::constants::{I256_MIN, STACK_LIMIT}
use ingot::trace::{Step, Tracer}
use ingot::status::{ERR_INVALID_JUMP, ERR_OUT_OF_GAS, ERR_STACK_OVERFLOW, ERR_STACK_UNDERFLOW}
use super::Vm

/// The big-endian `T` at `offset` bytes into `code`, which holds all of it.
unsafe fn read_code<T: IntWord>(_ code: *u8, _ offset: usize) -> T {
    from_be(*cast<u8, T>(offset_bytes(code, offset)))
}

/// Binary opcode `OP`'s result.
fn binary_result<const OP: i32>(_ lhs: u256, _ rhs: u256) -> u256 {
    match OP {
        0x01 => lhs.wrapping_add(rhs),
        0x02 => lhs.wrapping_mul(rhs),
        0x03 => lhs.wrapping_sub(rhs),
        0x04 => if rhs == 0 { 0 } else { lhs / rhs },
        0x05 => sdiv(lhs, rhs),
        0x06 => if rhs == 0 { 0 } else { lhs % rhs },
        0x07 => smod(lhs, rhs),
        0x10 => if lhs < rhs { 1 } else { 0 },
        0x11 => if lhs > rhs { 1 } else { 0 },
        0x14 => if lhs == rhs { 1 } else { 0 },
        0x16 => lhs & rhs,
        0x17 => lhs | rhs,
        0x18 => lhs ^ rhs,
        0x1b => if lhs >= 256 { 0 } else { rhs << lhs },
        0x1c => if lhs >= 256 { 0 } else { rhs >> lhs },
        0x12 => if signed_less(lhs, rhs) { 1 } else { 0 },
        0x13 => if signed_less(rhs, lhs) { 1 } else { 0 },
        0x0b => signextend(byte_index: lhs, value: rhs),
        0x1d => sar(shift: lhs, value: rhs),
        _ => core::panic(),
    }
}

/// SDIV: the quotient of two's complement words, rounded toward zero, with a
/// zero divisor giving zero and `MIN / -1` wrapping to `MIN`.
fn sdiv(_ lhs: u256, _ rhs: u256) -> u256 {
    if rhs == 0 {
        return 0
    }
    let lhs_signed: i256 = lhs.downcast_unchecked()
    let rhs_signed: i256 = rhs.downcast_unchecked()
    if lhs_signed == I256_MIN && rhs_signed == -1 {
        return lhs
    }
    (lhs_signed / rhs_signed).downcast_unchecked()
}

/// SMOD: the remainder of two's complement words, taking the dividend's
/// sign, with a zero divisor giving zero.
fn smod(_ lhs: u256, _ rhs: u256) -> u256 {
    let lhs_signed: i256 = lhs.downcast_unchecked()
    let rhs_signed: i256 = rhs.downcast_unchecked()
    if rhs == 0 || rhs_signed == -1 {
        return 0
    }
    (lhs_signed % rhs_signed).downcast_unchecked()
}

/// Unary opcode `OP`'s result.
fn unary_result<const OP: i32>(_ value: u256) -> u256 {
    match OP {
        0x15 => if value == 0 { 1 } else { 0 },
        0x19 => !value,
        0x1e => leading_zeros(value),
        _ => core::panic(),
    }
}

/// Where a running frame is, as the handlers pass it from one to the next:
/// its code, the position of the opcode to run, the gas left, and the stack,
/// as the slot just past its top word and the number of words below it.
pub(super) struct Cursor { code: *u8, pc: usize, gas: u64, top: *u256, depth: usize }
impl Copy for Cursor {}

impl Cursor {
    /// Charges `cost`, or leaves the gas as it is when it does not cover it.
    fn charge(mut self, _ cost: u64) -> bool {
        if cost > self.gas { return false }
        self.gas -= cost
        true
    }
    /// Whether the stack holds `count` words.
    fn holds(self, _ count: usize) -> bool { self.depth >= count }
    /// Whether the stack has room for another word (`STACK_LIMIT`).
    fn has_room(self) -> bool { self.depth < STACK_LIMIT }
    /// The slot of the word `index` from the top, 1 for the top word, which
    /// the stack must hold. The offset wraps, so this subtracts.
    fn slot(self, _ index: usize) -> *u256 {
        let zero: usize = 0
        offset_bytes(self.top, zero.wrapping_sub(index.wrapping_mul(32)))
    }
    fn peek(self, _ index: usize) -> u256 { unsafe { *self.slot(index) } }
    fn set(self, _ index: usize, _ value: u256) { unsafe { *self.slot(index) = value } }
    /// Removes the top word, which the stack must hold, and returns it.
    fn pop(mut self) -> u256 {
        let value = self.peek(1)
        self.discard(1)
        value
    }
    /// Removes `count` words, which the stack must hold.
    fn discard(mut self, _ count: usize) {
        self.top = self.slot(count)
        self.depth -= count
    }
    /// Pushes `value`, for which the stack must have room: `run_until_child`
    /// reserves `STACK_LIMIT` words.
    fn push(mut self, _ value: u256) {
        unsafe { *self.top = value }
        self.top = offset_bytes(self.top, 32)
        self.depth += 1
    }
    /// Moves on `count` bytes. `pc` stays within the code and its padding,
    /// far from overflow.
    fn advance(mut self, _ count: usize) { self.pc = self.pc.wrapping_add(count) }
    /// The big-endian `T` at `offset` bytes from the opcode, within the code
    /// or its padding, which follows every immediate with a whole word.
    fn read<T: IntWord>(self, _ offset: usize) -> T { unsafe { read_code<T>(self.code, self.pc.wrapping_add(offset)) } }
}

fn signed_less(_ lhs: u256, _ rhs: u256) -> bool {
    let lhs: i256 = lhs.downcast_unchecked()
    let rhs: i256 = rhs.downcast_unchecked()
    lhs < rhs
}

// Extends the sign of byte `byte_index`, counting from the least significant,
// within the 64-bit limb that holds it, so every shift is by a constant or
// within an i64.
fn signextend(byte_index: u256, value: u256) -> u256 {
    if byte_index >= 31 {
        return value
    }
    let index: u64 = byte_index.downcast_unchecked()
    let shift: i64 = ((7 - index % 8) * 8).downcast_unchecked()
    match index / 8 {
        0 => extend_limb(value, shift),
        1 => (extend_limb(value >> 64, shift) << 64) | (value & 0xffffffffffffffff),
        2 => (extend_limb(value >> 128, shift) << 128) | (value & 0xffffffffffffffffffffffffffffffff),
        _ => (extend_limb(value >> 192, shift) << 192) | (value & 0xffffffffffffffffffffffffffffffffffffffffffffffff),
    }
}

// The low limb of `word` with bits from `63 - shift` up set to that bit,
// widened to 256 bits.
fn extend_limb(_ word: u256, _ shift: i64) -> u256 {
    let low: u64 = word.downcast_truncate()
    let narrow: i64 = low.downcast_unchecked()
    let extended: i256 = ((narrow << shift) >> shift) as i256
    extended.downcast_unchecked()
}

// SAR: `value` shifted right by `shift` bits, filling with its sign bit. A
// shift by 255 already fills every bit with it, as any longer one does, so
// the count is a choice of two values below 256 and the shift branches on
// neither the count nor the sign.
fn sar(shift: u256, value: u256) -> u256 {
    let signed: i256 = value.downcast_unchecked()
    let count: i256 = if shift >= 256 { 255 } else { (shift & 255).downcast_unchecked() }
    (signed >> count).downcast_unchecked()
}

impl Vm {
    // Opcodes that need nothing but the stack, memory and the code run as
    // handlers, which take a `Cursor` and end by running the next opcode
    // themselves: dispatch is one indirect tail call, and the cursor stays
    // in registers from one handler to the next. `self.pc`, its gas and its
    // stack's length are stale while they run, until a handler saves the
    // cursor (`save`) to stop or to call code that uses them. Out of line,
    // so that `run_until_child`'s loop does not hold the cursor.
    #[inline(never)]
    pub(super) fn dispatch<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.next(c, mut tracer) }

    // The cursor at `pc` in `code` with `gas`, over the stack `self` holds.
    pub(super) fn cursor(self, _ code: *u8, _ pc: usize, _ gas: u64) -> Cursor {
        let depth = self.stack.len()
        // At most `STACK_LIMIT` words, whose offset cannot overflow.
        Cursor { code, pc, gas, top: offset_bytes(self.stack.ptr(), depth.wrapping_mul(32)), depth }
    }

    // Runs the opcode at the cursor. Every arm tail-calls its handler, which
    // Sonatina turns into a jump through a table. Every handler ends in its
    // own copy, so that the processor predicts each opcode's successor from
    // the opcode before it.
    #[inline(always)]
    fn next<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) {
        let op = c.read<u8>(0)
        tracer.step(Step { pc: c.pc, op, gas: c.gas, stack_len: c.depth, memory_size: self.memory_size, depth: self.call_depth })
        match op as i32 {
            0x00 => self.op_stop(c, mut tracer),
            0x04 => self.op_binary<0x04, T>(c, mut tracer),
            0x05 => self.op_binary<0x05, T>(c, mut tracer),
            0x06 => self.op_binary<0x06, T>(c, mut tracer),
            0x07 => self.op_binary<0x07, T>(c, mut tracer),
            0x08 => self.op_modular<0x08, T>(c, mut tracer),
            0x09 => self.op_modular<0x09, T>(c, mut tracer),
            0x0a => self.op_exp(c, mut tracer),
            0x5f => self.op_push0(c, mut tracer),
            0x60 => self.op_push<1, T>(c, mut tracer),
            0x61 => self.op_push<2, T>(c, mut tracer),
            0x62 => self.op_push<3, T>(c, mut tracer),
            0x63 => self.op_push<4, T>(c, mut tracer),
            0x64 => self.op_push<5, T>(c, mut tracer),
            0x65 => self.op_push<6, T>(c, mut tracer),
            0x66 => self.op_push<7, T>(c, mut tracer),
            0x67 => self.op_push<8, T>(c, mut tracer),
            0x68 => self.op_push<9, T>(c, mut tracer),
            0x69 => self.op_push<10, T>(c, mut tracer),
            0x6a => self.op_push<11, T>(c, mut tracer),
            0x6b => self.op_push<12, T>(c, mut tracer),
            0x6c => self.op_push<13, T>(c, mut tracer),
            0x6d => self.op_push<14, T>(c, mut tracer),
            0x6e => self.op_push<15, T>(c, mut tracer),
            0x6f => self.op_push<16, T>(c, mut tracer),
            0x70 => self.op_push<17, T>(c, mut tracer),
            0x71 => self.op_push<18, T>(c, mut tracer),
            0x72 => self.op_push<19, T>(c, mut tracer),
            0x73 => self.op_push<20, T>(c, mut tracer),
            0x74 => self.op_push<21, T>(c, mut tracer),
            0x75 => self.op_push<22, T>(c, mut tracer),
            0x76 => self.op_push<23, T>(c, mut tracer),
            0x77 => self.op_push<24, T>(c, mut tracer),
            0x78 => self.op_push<25, T>(c, mut tracer),
            0x79 => self.op_push<26, T>(c, mut tracer),
            0x7a => self.op_push<27, T>(c, mut tracer),
            0x7b => self.op_push<28, T>(c, mut tracer),
            0x7c => self.op_push<29, T>(c, mut tracer),
            0x7d => self.op_push<30, T>(c, mut tracer),
            0x7e => self.op_push<31, T>(c, mut tracer),
            0x7f => self.op_push<32, T>(c, mut tracer),
            0x50 => self.op_pop(c, mut tracer),
            0x80 => self.op_dup<1, T>(c, mut tracer),
            0x81 => self.op_dup<2, T>(c, mut tracer),
            0x82 => self.op_dup<3, T>(c, mut tracer),
            0x83 => self.op_dup<4, T>(c, mut tracer),
            0x84 => self.op_dup<5, T>(c, mut tracer),
            0x85 => self.op_dup<6, T>(c, mut tracer),
            0x86 => self.op_dup<7, T>(c, mut tracer),
            0x87 => self.op_dup<8, T>(c, mut tracer),
            0x88 => self.op_dup<9, T>(c, mut tracer),
            0x89 => self.op_dup<10, T>(c, mut tracer),
            0x8a => self.op_dup<11, T>(c, mut tracer),
            0x8b => self.op_dup<12, T>(c, mut tracer),
            0x8c => self.op_dup<13, T>(c, mut tracer),
            0x8d => self.op_dup<14, T>(c, mut tracer),
            0x8e => self.op_dup<15, T>(c, mut tracer),
            0x8f => self.op_dup<16, T>(c, mut tracer),
            0x90 => self.op_swap<1, T>(c, mut tracer),
            0x91 => self.op_swap<2, T>(c, mut tracer),
            0x92 => self.op_swap<3, T>(c, mut tracer),
            0x93 => self.op_swap<4, T>(c, mut tracer),
            0x94 => self.op_swap<5, T>(c, mut tracer),
            0x95 => self.op_swap<6, T>(c, mut tracer),
            0x96 => self.op_swap<7, T>(c, mut tracer),
            0x97 => self.op_swap<8, T>(c, mut tracer),
            0x98 => self.op_swap<9, T>(c, mut tracer),
            0x99 => self.op_swap<10, T>(c, mut tracer),
            0x9a => self.op_swap<11, T>(c, mut tracer),
            0x9b => self.op_swap<12, T>(c, mut tracer),
            0x9c => self.op_swap<13, T>(c, mut tracer),
            0x9d => self.op_swap<14, T>(c, mut tracer),
            0x9e => self.op_swap<15, T>(c, mut tracer),
            0x9f => self.op_swap<16, T>(c, mut tracer),
            0x01 => self.op_binary<0x01, T>(c, mut tracer),
            0x02 => self.op_binary<0x02, T>(c, mut tracer),
            0x03 => self.op_binary<0x03, T>(c, mut tracer),
            0x0b => self.op_binary<0x0b, T>(c, mut tracer),
            0x10 => self.op_binary<0x10, T>(c, mut tracer),
            0x11 => self.op_binary<0x11, T>(c, mut tracer),
            0x12 => self.op_binary<0x12, T>(c, mut tracer),
            0x13 => self.op_binary<0x13, T>(c, mut tracer),
            0x14 => self.op_binary<0x14, T>(c, mut tracer),
            0x15 => self.op_unary<0x15, T>(c, mut tracer),
            0x16 => self.op_binary<0x16, T>(c, mut tracer),
            0x17 => self.op_binary<0x17, T>(c, mut tracer),
            0x18 => self.op_binary<0x18, T>(c, mut tracer),
            0x19 => self.op_unary<0x19, T>(c, mut tracer),
            0x1e => self.op_unary<0x1e, T>(c, mut tracer),
            0x1a => self.op_byte(c, mut tracer),
            0x1b => self.op_binary<0x1b, T>(c, mut tracer),
            0x1c => self.op_binary<0x1c, T>(c, mut tracer),
            0x1d => self.op_binary<0x1d, T>(c, mut tracer),
            0x51 => self.op_mload(c, mut tracer),
            0x52 => self.op_mstore(c, mut tracer),
            0x53 => self.op_mstore8(c, mut tracer),
            0x37 => self.op_calldatacopy(c, mut tracer),
            0x39 => self.op_codecopy(c, mut tracer),
            0x5e => self.op_mcopy(c, mut tracer),
            0x3e => self.op_returndatacopy(c, mut tracer),
            0x20 => self.op_keccak256(c, mut tracer),
            0x56 => self.op_jump(c, mut tracer),
            0x57 => self.op_jumpi(c, mut tracer),
            0x58 => self.op_pc(c, mut tracer),
            0x59 => self.op_msize(c, mut tracer),
            0x5a => self.op_gas(c, mut tracer),
            0x5b => self.op_jumpdest(c, mut tracer),
            0x35 => self.op_calldataload(c, mut tracer),
            0x49 => self.op_blobhash(c, mut tracer),
            0x30 => self.op_address(c, mut tracer),
            0x32 => self.op_origin(c, mut tracer),
            0x33 => self.op_caller(c, mut tracer),
            0x34 => self.op_callvalue(c, mut tracer),
            0x36 => self.op_calldatasize(c, mut tracer),
            0x38 => self.op_codesize(c, mut tracer),
            0x3a => self.op_gasprice(c, mut tracer),
            0x3d => self.op_returndatasize(c, mut tracer),
            0x41 => self.op_coinbase(c, mut tracer),
            0x42 => self.op_timestamp(c, mut tracer),
            0x43 => self.op_number(c, mut tracer),
            0x44 => self.op_prevrandao(c, mut tracer),
            0x45 => self.op_gaslimit(c, mut tracer),
            0x46 => self.op_chainid(c, mut tracer),
            0x48 => self.op_basefee(c, mut tracer),
            0x4a => self.op_blobbasefee(c, mut tracer),
            _ => self.op_other(c, mut tracer),
        }
    }

    // Saves the cursor in `self`, for the interpreter loop, which runs the
    // opcode at its `pc` next unless the frame has stopped, or for code that
    // uses `self`'s pc, gas and stack.
    fn save(mut self, _ c: Cursor) {
        self.pc = c.pc
        self.gas_remaining = c.gas
        // The handlers kept `depth` words initialized, within the reserved
        // `STACK_LIMIT`.
        unsafe { self.stack.set_len(c.depth) }
    }

    // Runs the handlers again after code that used `self`'s pc, gas and
    // stack, unless it failed.
    fn resume<T: Tracer>(mut self, _ code: *u8, _ tracer: mut T) {
        if self.ok() { self.dispatch(self.cursor(code, self.pc, self.gas_remaining), mut tracer) }
    }

    // A handler's faults, exceptional halts, which leave the frame no gas.
    // Every handler can fault, most twice, so each stays out of line. One
    // per status keeps `self` and the cursor's five words within the six
    // registers a tail call passes arguments in.
    #[inline(never)]
    fn out_of_gas(mut self, _ c: Cursor) { self.halt(ERR_OUT_OF_GAS, c) }
    #[inline(never)]
    fn underflow(mut self, _ c: Cursor) { self.halt(ERR_STACK_UNDERFLOW, c) }
    #[inline(never)]
    fn overflow(mut self, _ c: Cursor) { self.halt(ERR_STACK_OVERFLOW, c) }
    #[inline(never)]
    fn invalid_jump(mut self, _ c: Cursor) { self.halt(ERR_INVALID_JUMP, c) }

    fn halt(mut self, _ status: i32, _ c: Cursor) {
        self.save(c)
        self.fault(status)
    }

    // The handlers that leave stay out of line, so every arm of `next` is a
    // tail call.
    #[inline(never)]
    fn op_stop<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        self.halted = true
        c.advance(1)
        self.save(c)
    }

    // Leaves the opcode to `run_until_child`.
    #[inline(never)]
    fn op_other<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.save(c) }

    // The top word indexes a byte of the second from its most significant
    // end. A native word holds its bytes least significant first, so the
    // byte is read from the second word's place.
    fn op_byte<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        if !c.holds(2) { return self.underflow(c) }
        let index = c.pop()
        c.set(1, if index >= 32 { 0 } else {
            let at: usize = (31 - index).downcast_unchecked()
            unsafe { *offset_bytes(cast<u256, u8>(c.slot(1)), at) } as u256
        })
        c.advance(1)
        self.next(c, mut tracer)
    }

    // ADDMOD and MULMOD: the top two words' sum or product modulo the third
    // replaces the third.
    fn op_modular<const OP: i32, T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(base_cost(OP)) { return self.out_of_gas(c) }
        if !c.holds(3) { return self.underflow(c) }
        let lhs = c.pop()
        let rhs = c.pop()
        // A zero modulus gives zero, which the third word already holds.
        let modulus = c.peek(1)
        if modulus != 0 {
            c.set(1, if OP == 0x08 { addmod(lhs, rhs, modulus) } else { mulmod(lhs, rhs, modulus) })
        }
        c.advance(1)
        self.next(c, mut tracer)
    }

    // EXP calls out, but stays in the handlers rather than returning to
    // `run_until_child`.
    fn op_exp<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(base_cost(0x0a)) { return self.out_of_gas(c) }
        c.advance(1)
        self.save(c)
        let base = self.pop()
        let exponent = self.pop()
        if self.ok() { self.exp(base, exponent) }
        self.resume(c.code, mut tracer)
    }

    // Pushes `value` and runs the opcode at the cursor, the one after the
    // push. Each handler that pushes has its own copy, with its own dispatch.
    #[inline(always)]
    fn push_next<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T, _ value: u256) {
        if !c.has_room() { return self.overflow(c) }
        c.push(value)
        self.next(c, mut tracer)
    }

    fn op_push0<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(2) { return self.out_of_gas(c) }
        c.advance(1)
        self.push_next(c, mut tracer, 0)
    }

    // PUSH1 to PUSH32: the immediate is the top N bytes of the smallest
    // whole word that holds it, which padding puts after every immediate.
    fn op_push<const N: usize, T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        let value: u256 = if N == 1 {
            c.read<u8>(1) as u256
        } else if N == 2 {
            c.read<u16>(1) as u256
        } else if N <= 4 {
            let shift: u32 = ((4 - N) * 8).downcast_truncate()
            (c.read<u32>(1) >> shift) as u256
        } else if N <= 8 {
            let shift: u64 = ((8 - N) * 8).downcast_truncate()
            (c.read<u64>(1) >> shift) as u256
        } else if N <= 16 {
            let shift: u128 = ((16 - N) * 8).downcast_truncate()
            (c.read<u128>(1) >> shift) as u256
        } else {
            c.read<u256>(1) >> ((32 - N) * 8) as u256
        }
        c.advance(1 + N)
        self.push_next(c, mut tracer, value)
    }

    fn op_pop<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(2) { return self.out_of_gas(c) }
        if !c.holds(1) { return self.underflow(c) }
        c.discard(1)
        c.advance(1)
        self.next(c, mut tracer)
    }

    // DUP1 to DUP16, each its own handler, with its depth a constant.
    fn op_dup<const N: usize, T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        if !c.holds(N) { return self.underflow(c) }
        let value = c.peek(N)
        c.advance(1)
        self.push_next(c, mut tracer, value)
    }

    // SWAP1 to SWAP16, as DUP.
    fn op_swap<const N: usize, T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        if !c.holds(N + 1) { return self.underflow(c) }
        let top = c.peek(1)
        c.set(1, c.peek(N + 1))
        c.set(N + 1, top)
        c.advance(1)
        self.next(c, mut tracer)
    }

    // A unary opcode's handler, whose result replaces the top word.
    fn op_unary<const OP: i32, T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(base_cost(OP)) { return self.out_of_gas(c) }
        if !c.holds(1) { return self.underflow(c) }
        c.set(1, unary_result<OP>(c.peek(1)))
        c.advance(1)
        self.next(c, mut tracer)
    }

    // A binary opcode's handler. The top word is the first operand; the
    // result replaces the second.
    fn op_binary<const OP: i32, T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(base_cost(OP)) { return self.out_of_gas(c) }
        if !c.holds(2) { return self.underflow(c) }
        let lhs = c.pop()
        c.set(1, binary_result<OP>(lhs, c.peek(1)))
        c.advance(1)
        self.next(c, mut tracer)
    }

    fn op_mload<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        if !c.holds(1) { return self.underflow(c) }
        let offset = c.peek(1)
        if !self.in_memory(offset, len: 32) {
            // Growth within the buffer; past it, `op_mload_slow` takes over.
            let size = self.buffered_growth(offset, len: 32)
            if size == 0 {
                return self.op_mload_slow(c, mut tracer)
            }
            if !c.charge(small_growth_cost(current: self.memory_size, size)) {
                return self.out_of_gas(c)
            }
            self.memory_size = size
        }
        c.set(1, unsafe { self.memory.span().read_be_unchecked<u256>(offset.downcast_unchecked()) })
        c.advance(1)
        self.next(c, mut tracer)
    }

    // Growth past the buffer and offsets past memory, which `mload` handles.
    // Out of line: calling it needs a frame, which the common path does not.
    fn op_mload_slow<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        c.advance(1)
        self.save(c)
        self.mload()
        self.resume(c.code, mut tracer)
    }

    fn op_mstore<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        if !c.holds(2) { return self.underflow(c) }
        let offset = c.peek(1)
        if !self.in_memory(offset, len: 32) {
            // Growth within the buffer; past it, `op_mstore_slow` takes over.
            let size = self.buffered_growth(offset, len: 32)
            if size == 0 {
                return self.op_mstore_slow(c, mut tracer)
            }
            if !c.charge(small_growth_cost(current: self.memory_size, size)) {
                return self.out_of_gas(c)
            }
            self.memory_size = size
        }
        unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: c.peek(2)) }
        c.discard(2)
        c.advance(1)
        self.next(c, mut tracer)
    }

    // As `op_mload_slow`, for `mstore`.
    fn op_mstore_slow<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        c.advance(1)
        self.save(c)
        self.mstore()
        self.resume(c.code, mut tracer)
    }

    fn op_mstore8<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        if !c.holds(2) { return self.underflow(c) }
        let offset = c.peek(1)
        if !self.in_memory(offset, len: 1) {
            // Growth within the buffer; past it, `op_mstore8_slow` takes over.
            let size = self.buffered_growth(offset, len: 1)
            if size == 0 {
                return self.op_mstore8_slow(c, mut tracer)
            }
            if !c.charge(small_growth_cost(current: self.memory_size, size)) {
                return self.out_of_gas(c)
            }
            self.memory_size = size
        }
        let byte: u8 = c.peek(2).downcast_truncate()
        unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: byte) }
        c.discard(2)
        c.advance(1)
        self.next(c, mut tracer)
    }

    // As `op_mstore_slow`, for one byte.
    fn op_mstore8_slow<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        c.advance(1)
        self.save(c)
        self.mstore8()
        self.resume(c.code, mut tracer)
    }

    // The gas of a copy of `len` bytes into memory that holds them, which
    // grows nothing: 3 and 3 per word. An empty copy grows nothing at any
    // offset. Zero when the range is not within memory, which the
    // interpreter loop then handles.
    fn copy_within_cost(self, dest: u256, len: u256) -> u64 {
        if len == 0 { return 3 }
        if len > self.memory_size as u256 { return 0 }
        let count: u64 = len.downcast_unchecked()
        if !self.in_memory(dest, len: count) { return 0 }
        3 + 3 * ((count + 31) / 32)
    }

    // For the copy whose destination, source and length are the cursor's
    // top three words, copy `len` bytes from `size` bytes at `from`,
    // starting at `source`, into memory at `dest`, zero past the end; the
    // range is within memory and not empty.
    fn copy_padded(mut self, _ c: Cursor, from: *u8, size: usize) {
        let dest = c.peek(1)
        let source = c.peek(2)
        let len = c.peek(3)
        let start: usize = dest.downcast_unchecked()
        let count: usize = len.downcast_unchecked()
        let copied: usize = if source >= size as u256 { 0 }
            else if (size as u256) - source < len { size - source.downcast_unchecked() }
            else { count }
        if copied == 32 {
            // A word, the usual copy, without a call.
            unsafe {
                *cast<u8, u256>(offset_bytes(self.memory.span().ptr(), start)) =
                    *cast<u8, u256>(offset_bytes(from, source.downcast_unchecked()))
            }
        } else if copied != 0 {
            unsafe {
                core::ptr::copy_raw(offset_bytes(self.memory.span().ptr(), start), offset_bytes(from, source.downcast_unchecked()), copied)
            }
        }
        if copied < count { self.memory.slice(offset: start + copied, len: count - copied).zero() }
    }

    // CALLDATALOAD: the calldata word at the offset on top, bytes past the end
    // reading as zero.
    fn op_calldataload<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        if !c.holds(1) { return self.underflow(c) }
        let offset = c.peek(1)
        let len = self.calldata_len
        // Most loads read one whole word within the calldata.
        c.set(1, if offset <= len as u256 && len as u256 - offset >= 32 {
            unsafe { read_code<u256>(self.calldata, offset.downcast_unchecked()) }
        } else { self.calldata_tail(offset) })
        c.advance(1)
        self.next(c, mut tracer)
    }

    // The calldata word at `offset`, which runs past the end: its bytes
    // within the calldata, then zeros.
    fn calldata_tail(self, _ offset: u256) -> u256 {
        let len = self.calldata_len
        if offset >= len as u256 { return 0 }
        let start: usize = offset.downcast_unchecked()
        var value: u256 = 0
        for index in start..len { value = (value << 8) | unsafe { read_code<u8>(self.calldata, index) } as u256 }
        value << ((32 - (len - start)) * 8) as u256
    }

    // BLOBHASH: the transaction's blob hash at the index on top, or zero.
    fn op_blobhash<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(3) { return self.out_of_gas(c) }
        if !c.holds(1) { return self.underflow(c) }
        let index = c.peek(1)
        c.set(1, if index < self.blob_count as u256 {
            let at: usize = index.downcast_unchecked()
            unsafe { *offset_bytes(self.blob_hashes, at * 32) }
        } else { 0 })
        c.advance(1)
        self.next(c, mut tracer)
    }

    // CALLDATACOPY within memory; the interpreter loop handles everything else.
    fn op_calldatacopy<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.holds(3) { return self.op_other(c, mut tracer) }
        let cost = self.copy_within_cost(dest: c.peek(1), len: c.peek(3))
        if cost == 0 || !c.charge(cost) { return self.op_other(c, mut tracer) }
        // An empty copy costs only the base 3.
        if cost > 3 { self.copy_padded(c, from: self.calldata, size: self.calldata_len) }
        c.discard(3)
        c.advance(1)
        self.next(c, mut tracer)
    }

    // CODECOPY within memory; the interpreter loop handles everything else.
    fn op_codecopy<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.holds(3) { return self.op_other(c, mut tracer) }
        let cost = self.copy_within_cost(dest: c.peek(1), len: c.peek(3))
        if cost == 0 || !c.charge(cost) { return self.op_other(c, mut tracer) }
        if cost > 3 { self.copy_padded(c, from: c.code, size: self.code_len) }
        c.discard(3)
        c.advance(1)
        self.next(c, mut tracer)
    }

    // RETURNDATACOPY within memory and the return data; the interpreter
    // loop handles everything else.
    fn op_returndatacopy<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.holds(3) { return self.op_other(c, mut tracer) }
        let source = c.peek(2)
        let len = c.peek(3)
        let cost = self.copy_within_cost(dest: c.peek(1), len)
        let available = self.return_data.len() as u256
        if cost == 0 || source > available || len > available - source || !c.charge(cost) {
            return self.op_other(c, mut tracer)
        }
        if cost > 3 { self.copy_padded(c, from: self.return_data.span().ptr(), size: self.return_data.len()) }
        c.discard(3)
        c.advance(1)
        self.next(c, mut tracer)
    }

    // KECCAK256 of a range within memory; the interpreter loop handles
    // everything else.
    fn op_keccak256<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.holds(2) { return self.op_other(c, mut tracer) }
        let offset = c.peek(1)
        let len = c.peek(2)
        let cost = self.hash_within_cost(offset, len)
        if cost == 0 || !c.charge(cost) { return self.op_other(c, mut tracer) }
        let hash = self.hash_memory(offset, len)
        c.discard(1)
        c.set(1, hash)
        c.advance(1)
        self.next(c, mut tracer)
    }

    // The gas of KECCAK256 over a range that needs no memory growth: 30 and 6
    // per word, or zero for a range outside memory.
    fn hash_within_cost(self, _ offset: u256, _ len: u256) -> u64 {
        if len == 0 { return 30 }
        if len > self.memory_size as u256 { return 0 }
        let count: u64 = len.downcast_unchecked()
        if !self.in_memory(offset, len: count) { return 0 }
        30 + 6 * ((count + 31) / 32)
    }

    // MCOPY with both ranges within memory; the interpreter loop handles
    // everything else.
    fn op_mcopy<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.holds(3) { return self.op_other(c, mut tracer) }
        let dest = c.peek(1)
        let source = c.peek(2)
        let len = c.peek(3)
        let cost = self.copy_within_cost(dest, len)
        if cost == 0 || self.copy_within_cost(dest: source, len) == 0 || !c.charge(cost) {
            return self.op_other(c, mut tracer)
        }
        if len == 32 {
            // A word, the usual copy: load it whole, then store it, which
            // also holds for overlapping ranges.
            let base = self.memory.span().ptr()
            unsafe {
                let word = *cast<u8, u256>(offset_bytes(base, source.downcast_unchecked()))
                *cast<u8, u256>(offset_bytes(base, dest.downcast_unchecked())) = word
            }
        } else if len != 0 {
            self.memory.span().copy_within(source: source.downcast_unchecked(), dest: dest.downcast_unchecked(), len: len.downcast_unchecked())
        }
        c.discard(3)
        c.advance(1)
        self.next(c, mut tracer)
    }

    fn op_jump<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(8) { return self.out_of_gas(c) }
        if !c.holds(1) { return self.underflow(c) }
        let dest = c.pop()
        if !self.jump_ok(dest) { return self.invalid_jump(c) }
        c.pc = dest.downcast_unchecked()
        self.next(c, mut tracer)
    }

    fn op_jumpi<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(10) { return self.out_of_gas(c) }
        if !c.holds(2) { return self.underflow(c) }
        let dest = c.pop()
        if c.pop() == 0 {
            c.advance(1)
            return self.next(c, mut tracer)
        }
        if !self.jump_ok(dest) { return self.invalid_jump(c) }
        c.pc = dest.downcast_unchecked()
        self.next(c, mut tracer)
    }

    fn op_pc<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(2) { return self.out_of_gas(c) }
        let pc = c.pc
        c.advance(1)
        self.push_next(c, mut tracer, pc as u256)
    }

    fn op_msize<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(2) { return self.out_of_gas(c) }
        c.advance(1)
        self.push_next(c, mut tracer, self.memory_size as u256)
    }

    fn op_gas<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(2) { return self.out_of_gas(c) }
        c.advance(1)
        self.push_next(c, mut tracer, c.gas as u256)
    }

    // The environment opcodes push a word of the call, the block or the frame for two gas.
    #[inline(always)]
    fn push_environment<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T, _ value: u256) {
        if !c.charge(2) { return self.out_of_gas(c) }
        c.advance(1)
        self.push_next(c, mut tracer, value)
    }

    fn op_address<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.call.address) }
    fn op_origin<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.call.origin) }
    fn op_caller<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.call.caller) }
    fn op_callvalue<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.call.callvalue) }
    fn op_calldatasize<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.calldata_len as u256) }
    fn op_codesize<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.code_len as u256) }
    fn op_gasprice<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.call.gasprice) }
    fn op_returndatasize<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.return_data.len() as u256) }
    fn op_coinbase<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.block.coinbase) }
    fn op_timestamp<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.block.timestamp) }
    fn op_number<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.block.number) }
    fn op_prevrandao<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.block.prevrandao) }
    fn op_gaslimit<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.block.gaslimit) }
    fn op_chainid<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.block.chainid) }
    fn op_basefee<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.block.basefee) }
    fn op_blobbasefee<T: Tracer>(mut self, _ c: own Cursor, _ tracer: mut T) { self.push_environment(c, mut tracer, self.block.blobbasefee) }

    fn op_jumpdest<T: Tracer>(mut self, var _ c: own Cursor, _ tracer: mut T) {
        if !c.charge(1) { return self.out_of_gas(c) }
        c.advance(1)
        self.next(c, mut tracer)
    }

    // As `Program::is_jumpdest`, from the bitmap `run_until_child` keeps in
    // `self`.
    fn jump_ok(self, _ destination: u256) -> bool {
        if destination >= self.jump_limit as u256 {
            return false
        }
        let pc: usize = destination.downcast_unchecked()
        let bit: u8 = (pc % 8).downcast_unchecked()
        let byte = unsafe { *offset_bytes(self.jumpdests, pc / 8) }
        byte & (1 << bit) != 0
    }
}
