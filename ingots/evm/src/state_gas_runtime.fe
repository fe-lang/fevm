use ingot::constants::{ERR_OUT_OF_GAS, ERR_REVERT, OK}
use ingot::state::WorldState
use ingot::transaction::Transaction
use ingot::transaction_runtime::{checkpoint, program}
use ingot::types::{default_block_env, default_call_env, empty_bytes}
use ingot::vm::execute

#[test]
fn upfront_warming_and_access_lists_survive_revert() {
    var tx = Transaction::new(WorldState::empty(), sender: 0x21, destination: 0x22, coinbase: 0x23)
    // The precompiles, the sender, the destination and the coinbase.
    var address: u256 = 1
    while address <= 0x11 {
        core::assert(tx.account_is_warm(address))
        address += 1
    }
    for address in [0x100, 0x21, 0x22, 0x23] { core::assert(tx.account_is_warm(address)) }
    core::assert(!tx.account_is_warm(0x12) && !tx.account_is_warm(0x24))
    core::assert(tx.access_list_account(address: 0x24))
    core::assert(tx.access_list_slot(address: 0x25, slot: 9))
    let point = checkpoint(mut tx, is_static: false)
    core::assert(tx.warm_account(address: 0x26) == OK)
    core::assert(tx.warm_slot(address: 0x25, slot: 10) == OK)
    tx.revert(point)
    core::assert(tx.account_is_warm(0x24) && tx.account_is_warm(0x25))
    core::assert(tx.storage_is_warm(address: 0x25, slot: 9))
    core::assert(!tx.account_is_warm(0x26) && !tx.storage_is_warm(address: 0x25, slot: 10))
    tx.finish(commit: true, gas_spent: 0)
}

#[test]
fn balance_masks_high_address_bits_and_charges_one_cold_access() {
    var world = WorldState::empty()
    core::assert(world.set_balance(0x44, 99))
    var tx = Transaction::new(world, sender: 0, destination: 0, coinbase: 0)
    let result = execute(
        program([0x60, 0x44, 0x31, 0x50, 0x60, 1, 0x60, 160, 0x1b, 0x60, 0x44, 0x17, 0x31]),
        empty_bytes(), default_call_env(), default_block_env(), mut tx,
    )
    core::assert(result.status == OK && result.stack_top == 99)
    core::assert(result.gas_remaining == 997280 && result.refund_delta == 0)
    tx.finish(commit: true, gas_spent: 2720)
}

#[test]
fn storage_reads_warm_once_and_reverted_reads_become_cold() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let result = execute(program([0x5f, 0x54, 0x5f, 0x54, 0x5f, 0x5f, 0xfd]),
        empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(result.status == ERR_REVERT && result.gas_remaining == 997792)
    core::assert(!tx.storage_is_warm(address: 0, slot: 0))
    let result = execute(program([0x5f, 0x54, 0x5f, 0x54]),
        empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(result.status == OK && result.gas_remaining == 997796)
    core::assert(tx.storage_is_warm(address: 0, slot: 0))
    tx.finish(commit: true, gas_spent: 4412)
}

#[test]
fn storage_refunds_are_signed_and_follow_nested_checkpoints() {
    var world = WorldState::empty()
    core::assert(world.storage_store(0, 0, 1))
    var tx = Transaction::new(world, sender: 0, destination: 0, coinbase: 0)
    let parent = checkpoint(mut tx, is_static: false)
    let result = execute(program([0x5f, 0x5f, 0x55]),
        empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(result.status == OK && result.gas_remaining == 994996)
    core::assert(result.refund_delta == 4800 && tx.refund() == 4800)
    let child = checkpoint(mut tx, is_static: false)
    let result = execute(program([0x60, 1, 0x5f, 0x55]),
        empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(result.status == OK && result.gas_remaining == 999895)
    core::assert(result.refund_delta == -2000 && tx.refund() == 2800)
    tx.revert(child)
    core::assert(tx.storage_load(address: 0, slot: 0) == 0 && tx.refund() == 4800)
    core::assert(tx.storage_is_warm(address: 0, slot: 0))
    tx.revert(parent)
    core::assert(tx.storage_load(address: 0, slot: 0) == 1 && tx.refund() == 0)
    core::assert(tx.original_storage(address: 0, slot: 0) == 1)
    core::assert(!tx.storage_is_warm(address: 0, slot: 0))
    let settled = tx.finish(commit: true, gas_spent: 5109)
    core::assert(settled.gas_refunded == 0 && settled.gas_used == 5109)
}

#[test]
fn original_zero_survives_revert_and_refunds_are_capped_at_transaction_end() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let point = checkpoint(mut tx, is_static: false)
    core::assert(tx.storage_store(address: 0, slot: 0, value: 7) == OK)
    core::assert(tx.original_storage(address: 0, slot: 0) == 0)
    tx.revert(point)
    let result = execute(program([0x60, 1, 0x5f, 0x55, 0x5f, 0x5f, 0x55]),
        empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(result.status == OK && result.gas_remaining == 977791)
    core::assert(result.refund_delta == 19900 && tx.refund() == 19900)
    let settled = tx.finish(commit: true, gas_spent: 22209)
    core::assert(settled.gas_refunded == 4441 && settled.gas_used == 17768)
    core::assert(settled.state.storage_load(0, 0) == 0)
}

#[test]
fn sstore_sentry_and_exact_cold_cost_boundaries() {
    for warm in [false, true] {
        for gas in [2304, 2305] {
            var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
            if warm { core::assert(tx.access_list_slot(address: 0, slot: 0)) }
            var call = default_call_env()
            call.gas_limit = gas
            let result = execute(program([0x5f, 0x5f, 0x55]), empty_bytes(), call, default_block_env(), mut tx)
            if gas == 2304 {
                core::assert(result.status == ERR_OUT_OF_GAS && result.gas_remaining == 0)
                core::assert(tx.storage_is_warm(address: 0, slot: 0) == warm)
            } else {
                core::assert(result.status == OK)
                core::assert(result.gas_remaining == if warm { 2201 } else { 101 })
            }
            tx.finish(commit: true, gas_spent: gas)
        }
    }
    for gas in [22104, 22105] {
        var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
        var call = default_call_env()
        call.gas_limit = gas
        let result = execute(program([0x60, 1, 0x5f, 0x55]), empty_bytes(), call, default_block_env(), mut tx)
        core::assert(result.gas_remaining == 0)
        if gas == 22104 {
            core::assert(result.status == ERR_OUT_OF_GAS && tx.storage_load(address: 0, slot: 0) == 0)
            core::assert(!tx.storage_is_warm(address: 0, slot: 0))
        } else {
            core::assert(result.status == OK && tx.storage_load(address: 0, slot: 0) == 1)
        }
        tx.finish(commit: true, gas_spent: gas)
    }
}

#[test]
fn refunds_never_pay_for_execution_and_failed_frames_discard_them() {
    var world = WorldState::empty()
    core::assert(world.storage_store(0, 0, 1))
    var tx = Transaction::new(world, sender: 0, destination: 0, coinbase: 0)
    var call = default_call_env()
    call.gas_limit = 5005
    let result = execute(program([0x5f, 0x5f, 0x55, 0x5f]), empty_bytes(), call, default_block_env(), mut tx)
    core::assert(result.status == ERR_OUT_OF_GAS && result.refund_delta == 0)
    core::assert(tx.refund() == 0 && tx.storage_load(address: 0, slot: 0) == 1)
    core::assert(!tx.storage_is_warm(address: 0, slot: 0))
    let settled = tx.finish(commit: true, gas_spent: 5005)
    core::assert(settled.gas_refunded == 0 && settled.gas_used == 5005)
}

#[test]
fn transaction_boundaries_reset_original_storage_and_access_state() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    core::assert(tx.storage_store(address: 0, slot: 0, value: 7) == OK)
    core::assert(tx.warm_slot(address: 0, slot: 0) == OK)
    let settled = tx.finish(commit: true, gas_spent: 22100)
    var tx = Transaction::new(settled.state, sender: 0, destination: 0, coinbase: 0)
    core::assert(!tx.storage_is_warm(address: 0, slot: 0))
    core::assert(tx.original_storage(address: 0, slot: 0) == 7)
    let result = execute(program([0x5f, 0x5f, 0x55]),
        empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(result.refund_delta == 4800 && result.gas_remaining == 994996)
    let settled = tx.finish(commit: false, gas_spent: 5004)
    core::assert(settled.gas_refunded == 0 && settled.gas_used == 5004)
    core::assert(settled.state.storage_load(0, 0) == 7)
}

#[test]
fn access_cache_grows_and_rolls_back() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let point = checkpoint(mut tx, is_static: false)
    // Above the precompiles at 0x01 through 0x11.
    var address: u256 = 0x12
    while address < 1000 {
        core::assert(tx.warm_account(address) == OK)
        address += 1
    }
    core::assert(tx.account_is_warm(999))
    tx.revert(point)
    core::assert(tx.account_is_warm(0x11) && !tx.account_is_warm(0x12) && !tx.account_is_warm(999))
    core::assert(tx.warm_account(address: 256) == OK)
    tx.finish(commit: true, gas_spent: 0)
}

#[test]
fn original_cache_grows_and_survives_rollback() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let point = checkpoint(mut tx, is_static: false)
    var slot: u256 = 0
    while slot < 1000 {
        core::assert(tx.storage_store(address: 0, slot, value: 1) == OK)
        core::assert(tx.storage_store(address: 0, slot, value: 0) == OK)
        slot += 1
    }
    core::assert(tx.storage_store(address: 0, slot: 1000, value: 1) == OK)
    core::assert(tx.storage_load(address: 0, slot: 1000) == 1)
    tx.revert(point)
    core::assert(tx.storage_load(address: 0, slot: 1000) == 0)
    core::assert(tx.refund() == 0 && tx.original_storage(address: 0, slot: 255) == 0)
    core::assert(tx.storage_store(address: 0, slot: 255, value: 2) == OK)
    let settled = tx.finish(commit: true, gas_spent: 0)
    core::assert(settled.state.storage_load(0, 255) == 2)
    core::assert(settled.state.storage_load(0, 256) == 0)
}
