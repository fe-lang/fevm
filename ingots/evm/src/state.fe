use core::{MemBuffer, MemSpan, MemVec, Option}
use core::default::Default
use swisstable::{Lookup, SwissKey, SwissTable, hash_u256}
use ingot::constants::MAX_U256
use keccak::{ByteSource, keccak256_word}
use ingot::status::{ERR_HOST_ALLOCATION, OK}
use ingot::types::{Program, jumpdest_map_len, mark_jumpdests}

pub const EMPTY_CODE_HASH: u256 = 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470

// An account's record. Absent accounts read as zero with no code.
struct Account {
    address: u256,
    balance: u256,
    nonce: u256,
    code_hash: u256,
    code_offset: usize,
    code_len: usize,
    // Nonzero storage slots, so deployability and deletion need not scan
    // the storage table.
    storage_slots: u64,
}
impl Copy for Account {}

// EVM account operands use only their low 160 bits.
pub fn address_word(_ word: u256) -> u256 { word & 0xffffffffffffffffffffffffffffffffffffffff }

/// The EIP-7702 delegation designator `0xef0100 || delegate`.
pub fn designator(_ delegate: u256) -> [u8; 23] {
    var code: [u8; 23] = [0; 23]
    code[0] = 0xef
    code[1] = 0x01
    for i in 0..20 { code[3 + i] = (delegate >> ((19 - i) * 8) as u256).downcast_truncate() }
    code
}

/// The account an EIP-7702 delegation designator delegates to, if `code` is one.
pub fn delegation(_ code: MemSpan) -> Option<u256> {
    if code.len() != 23 || code[0] != 0xef || code[1] != 0x01 || code[2] != 0 { return Option::None }
    var delegate: u256 = 0
    for i in 3..23 { delegate = (delegate << 8) | code[i] as u256 }
    Option::Some(delegate)
}

pub struct StorageKey { pub address: u256, pub slot: u256 }

// An account, for iterating the world.
pub struct AccountEntry {
    pub address: u256,
    pub balance: u256,
    pub nonce: u256,
    pub code_len: usize,
}
pub struct StorageEntry { pub occupied: bool, pub address: u256, pub slot: u256, pub value: u256 }

/// A balance or nonce replacement: the previous value, whether the account
/// existed, whether the value changed, whether the table could hold it and
/// whether an addition overflowed instead.
pub struct Replaced { pub previous: u256, pub found: bool, pub changed: bool, pub written: bool, pub overflowed: bool }

/// What validating a sender reads from its account.
pub struct Sender { pub nonce: u256, pub balance: u256, pub code_len: usize }

/// A sender's nonce and balance before `charge`, whether its account existed,
/// and whether the table could hold a new one.
pub struct Charged { pub nonce: u256, pub balance: u256, pub found: bool, pub written: bool }

impl Copy for StorageKey {}

impl Default for StorageKey {
    fn default() -> Self {
        StorageKey { address: 0, slot: 0 }
    }
}

impl SwissKey for StorageKey {
    fn hash(self) -> u64 {
        hash_u256(self.address) ^ hash_u256(self.slot ^ 0x517cc1b727220a95)
    }

    fn equals(self, _ other: StorageKey) -> bool {
        self.address == other.address && self.slot == other.slot
    }
}

// An arena record's bytes for `len` bytes of code.
// The address word of a dead code record, which no address word is.
const DEAD_CODE: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

fn record_len(_ len: usize) -> usize {
    64 + len + jumpdest_map_len(len)
}

// A copy of `table`; none if allocation fails.
fn copy_table<K, V>(_ table: SwissTable<K, V>) -> Option<SwissTable<K, V>> where K: SwissKey + Default + Copy, V: Default + Copy {
    var copy = SwissTable<K, V>::empty()
    if !copy.try_reserve(table.len()) { return Option::None }
    for slot in 0..table.capacity() {
        let entry = table.entry(slot)
        if entry.occupied && !copy.try_insert(entry.key, entry.value) { return Option::None }
    }
    Option::Some(copy)
}

pub struct WorldState {
    // Each account's position in `accounts`.
    index: SwissTable<u256, usize>,
    // The account records, in no order: removing one moves the last into its
    // place. Fields change in place, with one lookup of the position.
    accounts: MemVec<Account>,
    // Packed [address:32, length:32, code:length, jumpdests] records, where
    // `jumpdests` is the code's `mark_jumpdests` bitmap. A replaced or removed
    // record stays, its address `DEAD_CODE`, until dead records outgrow live
    // ones and one pass compacts the arena, so it holds at most twice the
    // live code and each removal moves amortized constant bytes.
    code: MemBuffer,
    // The bytes of dead records in `code`.
    dead_code: usize,
    storage: SwissTable<StorageKey, u256>,
    block_hashes: SwissTable<u256, u256>,
}

impl WorldState {
    pub fn empty() -> Self {
        WorldState {
            index: SwissTable<u256, usize>::empty(),
            accounts: MemVec::new(),
            code: MemBuffer::empty(),
            dead_code: 0,
            storage: SwissTable<StorageKey, u256>::empty(),
            block_hashes: SwissTable<u256, u256>::empty(),
        }
    }
    /// A copy of the world, which a host can keep to restore later; none if
    /// allocation fails.
    pub fn try_clone(self) -> Option<WorldState> {
        let index = copy_table(self.index)?
        var accounts = MemVec<Account>::new()
        if !accounts.try_reserve(self.accounts.len()) { return Option::None }
        for account in self.accounts { accounts.push(account) }
        let storage = copy_table(self.storage)?
        let block_hashes = copy_table(self.block_hashes)?
        let code = MemBuffer::try_from_span(self.code.span())?
        Option::Some(WorldState { index, accounts, code, dead_code: self.dead_code, storage, block_hashes })
    }

    // The position of the record of `address`, an address word, made if it has
    // none; none if allocation fails.
    fn record(mut self, _ address: u256) -> Option<usize> {
        let lookup = self.index.get(address)
        if lookup.found { Option::Some(lookup.value) } else { self.add_record(address) }
    }
    // The position of a new record for `address`, which has none.
    fn add_record(mut self, _ address: u256) -> Option<usize> {
        let at = self.accounts.len()
        let account = Account {
            address, balance: 0, nonce: 0, code_hash: EMPTY_CODE_HASH, code_offset: 0, code_len: 0, storage_slots: 0,
        }
        if self.accounts.try_push(account).is_err() { return Option::None }
        if !self.index.try_insert(address, at) {
            let _ = self.accounts.pop()
            return Option::None
        }
        Option::Some(at)
    }
    // Removes the record of `address`, an address word, if it has one.
    fn remove_record(mut self, _ address: u256) -> bool {
        let lookup = self.index.get(address)
        if lookup.found { self.remove_at(address, lookup.value) }
        lookup.found
    }
    // Removes the record of `address`, an address word, at `position`.
    fn remove_at(mut self, _ address: u256, _ position: usize) {
        let _ = self.index.remove(address)
        let _ = self.accounts.swap_remove(position)
        if position < self.accounts.len() {
            // Moving an existing key does not grow the table.
            core::assert(self.index.try_insert(self.accounts[position].address, position))
        }
    }

    pub fn exists(self, _ address: u256) -> bool {
        self.index.contains(address_word(address))
    }
    // EIP-161 emptiness of the record at `position`: zero balance and nonce, and no code.
    fn empty_at(self, _ position: usize) -> bool {
        let account = ref self.accounts[position]
        account.balance == 0 && account.nonce == 0 && account.code_len == 0
    }
    // EIP-161 emptiness. Absent accounts are empty.
    pub fn is_empty(self, _ address: u256) -> bool {
        let lookup = self.index.get(address_word(address))
        !lookup.found || self.empty_at(lookup.value)
    }
    /// Deletes the account of `address`, with its storage, if it exists and is empty.
    pub fn remove_if_empty(mut self, _ address: u256) {
        let lookup = self.index.get(address_word(address))
        if lookup.found && self.empty_at(lookup.value) { self.remove_account(address) }
    }
    // Delete an account record with its code and storage.
    pub fn remove_account(mut self, _ address: u256) {
        let address = address_word(address)
        let empty: [u8; 0] = []
        core::assert(self.set_code(address, code: empty) == OK)
        let lookup = self.index.get(address)
        if !lookup.found { return }
        var slots = self.accounts[lookup.value].storage_slots
        let _ = self.remove_record(address)
        var slot: usize = 0
        while slots > 0 && slot < self.storage.capacity() {
            let entry = self.storage.entry(slot)
            if entry.occupied && entry.key.address == address {
                let _ = self.storage.remove(entry.key)
                slots -= 1
            }
            slot += 1
        }
    }
    /// EIP-684/EIP-7610: whether creation can use `address`, which needs no
    /// nonce, code or storage.
    pub fn deployable(self, _ address: u256) -> bool {
        let lookup = self.index.get(address_word(address))
        if !lookup.found { return true }
        let account = ref self.accounts[lookup.value]
        account.nonce == 0 && account.code_len == 0 && account.storage_slots == 0
    }
    /// The length of the code of `address`, if it has a record.
    pub fn existing_code_len(self, _ address: u256) -> Option<usize> {
        let lookup = self.index.get(address_word(address))
        if lookup.found { Option::Some(self.accounts[lookup.value].code_len) } else { Option::None }
    }
    pub fn has_storage(self, _ address: u256) -> bool {
        let lookup = self.index.get(address_word(address))
        lookup.found && self.accounts[lookup.value].storage_slots != 0
    }
    /// The number of accounts, which `account_at` visits in no particular order.
    pub fn account_count(self) -> usize { self.accounts.len() }
    pub fn account_at(self, _ position: usize) -> AccountEntry {
        let account = ref self.accounts[position]
        AccountEntry { address: account.address, balance: account.balance, nonce: account.nonce, code_len: account.code_len }
    }
    pub fn storage_slots(self) -> usize { self.storage.capacity() }
    pub fn storage_at(self, _ slot: usize) -> StorageEntry {
        let entry = self.storage.entry(slot)
        StorageEntry { occupied: entry.occupied, address: entry.key.address, slot: entry.key.slot, value: entry.value }
    }
    pub fn ensure_account(mut self, _ address: u256) -> bool {
        self.record(address_word(address)).is_some()
    }
    // Used only by undo after restoring every write that created this account.
    pub fn remove_empty_account(mut self, _ address: u256) -> bool {
        let address = address_word(address)
        core::assert(self.is_empty(address))
        self.remove_record(address)
    }
    pub fn balance(self, _ address: u256) -> u256 {
        let lookup = self.index.get(address_word(address))
        if lookup.found { self.accounts[lookup.value].balance } else { 0 }
    }
    pub fn set_balance(mut self, _ address: u256, _ value: u256) -> bool {
        self.replace(balance: true, address, value).written
    }
    pub fn nonce(self, _ address: u256) -> u256 {
        let lookup = self.index.get(address_word(address))
        if lookup.found { self.accounts[lookup.value].nonce } else { 0 }
    }
    pub fn sender(self, _ address: u256) -> Sender {
        let lookup = self.index.get(address_word(address))
        if !lookup.found { return Sender { nonce: 0, balance: 0, code_len: 0 } }
        let account = ref self.accounts[lookup.value]
        Sender { nonce: account.nonce, balance: account.balance, code_len: account.code_len }
    }
    /// Sets the balance (or nonce) with one lookup; an absent account stays
    /// absent for zero.
    pub fn replace(mut self, balance: bool, _ address: u256, _ value: u256) -> Replaced {
        let address = address_word(address)
        let lookup = self.index.get(address)
        let previous = self.field(balance, lookup)
        self.store(balance, address, lookup, previous, value)
    }
    /// Adds `amount` to the balance (or nonce), or subtracts it, which the
    /// value must hold, with one lookup. An addition past 2^256 changes
    /// nothing and reports `overflowed`; an absent account stays absent for
    /// zero.
    pub fn adjust(mut self, balance: bool, _ address: u256, amount: u256, add: bool) -> Replaced {
        let address = address_word(address)
        let lookup = self.index.get(address)
        let previous = self.field(balance, lookup)
        if add && amount > MAX_U256 - previous {
            return Replaced { previous, found: lookup.found, changed: false, written: true, overflowed: true }
        }
        self.store(balance, address, lookup, previous, value: if add { previous + amount } else { previous - amount })
    }
    /// Increments the nonce of `address`, an address word, and subtracts
    /// `fee`, which its balance must hold, with one lookup. A nonce of
    /// 2^256 - 1 is left as it is, and so is the balance.
    pub fn charge(mut self, _ address: u256, fee: u256) -> Charged {
        let lookup = self.index.get(address)
        let at = if lookup.found { lookup.value } else {
            match self.add_record(address) {
                Option::Some(at) => at,
                Option::None => return Charged { nonce: 0, balance: 0, found: false, written: false },
            }
        }
        let account = mut self.accounts[at]
        let charged = Charged { nonce: account.nonce, balance: account.balance, found: lookup.found, written: true }
        if account.nonce != MAX_U256 {
            account.nonce += 1
            account.balance -= fee
        }
        charged
    }
    // The balance (or nonce) of a looked-up account.
    fn field(self, _ balance: bool, _ lookup: Lookup<usize>) -> u256 {
        if !lookup.found { return 0 }
        if balance { self.accounts[lookup.value].balance } else { self.accounts[lookup.value].nonce }
    }
    // Replaces `previous`, the balance (or nonce) of a looked-up account, with `value`.
    fn store(mut self, _ balance: bool, _ address: u256, _ lookup: Lookup<usize>, _ previous: u256,
             _ value: u256) -> Replaced {
        if previous == value { return Replaced { previous, found: lookup.found, changed: false, written: true, overflowed: false } }
        let at = if lookup.found { lookup.value } else {
            match self.add_record(address) {
                Option::Some(at) => at,
                Option::None => return Replaced { previous, found: false, changed: true, written: false, overflowed: false },
            }
        }
        let account = mut self.accounts[at]
        if balance { account.balance = value } else { account.nonce = value }
        Replaced { previous, found: lookup.found, changed: true, written: true, overflowed: false }
    }
    /// Sets the balance (or nonce) of `address` back to `value` with one
    /// lookup. Undoing the change that created the account leaves it empty,
    /// and removes its record. `false` if the table cannot hold the value.
    pub fn restore(mut self, balance: bool, _ address: u256, _ value: u256, existed: bool) -> bool {
        let address = address_word(address)
        let lookup = self.index.get(address)
        let previous = self.field(balance, lookup)
        if !self.store(balance, address, lookup, previous, value).written { return false }
        if !existed {
            core::assert(lookup.found && self.empty_at(lookup.value))
            self.remove_at(address, lookup.value)
        }
        true
    }
    pub fn set_nonce(mut self, _ address: u256, _ value: u256) -> bool {
        self.replace(balance: false, address, value).written
    }
    pub fn code_size(self, _ address: u256) -> usize {
        let lookup = self.index.get(address_word(address))
        if lookup.found { self.accounts[lookup.value].code_len } else { 0 }
    }
    // EIP-1052: even an explicitly present account hashes to zero if its
    // balance, nonce and code are empty. Storage is not part of that predicate.
    pub fn code_hash(self, _ address: u256) -> u256 {
        let lookup = self.index.get(address_word(address))
        if !lookup.found || self.empty_at(lookup.value) { 0 } else { self.accounts[lookup.value].code_hash }
    }
    // The arena offset and length of an account's code. One without code has
    // no arena record to address.
    fn code_extent(self, _ address: u256) -> (usize, usize) {
        let lookup = self.index.get(address_word(address))
        if !lookup.found { return (0, 0) }
        let account = ref self.accounts[lookup.value]
        if account.code_len == 0 { (0, 0) } else { (account.code_offset + 64, account.code_len) }
    }
    // An account's code.
    pub fn code(self, _ address: u256) -> ref MemSpan {
        let (offset, len) = self.code_extent(address)
        self.code.slice(offset, len)
    }
    /// The account an EIP-7702 delegation designator delegates to, if that is
    /// the account's code.
    pub fn delegate(self, _ address: u256) -> Option<u256> { delegation(self.code(address)) }
    /// The account's code, with the JUMPDEST bitmap computed when the code was set.
    pub fn program(self, _ address: u256) -> Program {
        let (offset, len) = self.code_extent(address)
        let jumpdests = self.code.slice(offset: offset + len, len: jumpdest_map_len(len))
        Program::analyzed(self.code.slice(offset, len), jumpdests)
    }
    // Copies `code` into the arena with its jump-destination map and hash. Hosts
    // set up accounts with it; code deposits and EIP-7702 delegations use it too.
    pub fn set_code<T: ByteSource>(mut self, address: u256, code: T) -> i32 {
        let address = address_word(address)
        let lookup = self.index.get(address)
        let len = code.len()
        if !lookup.found && len == 0 { return OK }
        let (code_offset, code_len) = if lookup.found {
            (self.accounts[lookup.value].code_offset, self.accounts[lookup.value].code_len)
        } else { (0, 0) }
        let old_size = self.code.len()
        // Bound before addition and before ByteSource traversal/allocation,
        // leaving room for the bitmap, an eighth of the code.
        if len != 0 && (old_size > 0x3fffffffffffffff - 64 || len > 0x3fffffffffffffff - 64 - old_size) {
            return ERR_HOST_ALLOCATION
        }
        let new_size = old_size + if len == 0 { 0 } else { record_len(len) }
        if new_size > old_size && !self.code.try_resize(new_size) { return ERR_HOST_ALLOCATION }
        // The arena is unchanged until here, so an account without a record
        // that cannot get one leaves the world as it was.
        let added = if lookup.found { Option::Some(lookup.value) } else { self.add_record(address) }
        let at = match added {
            Option::Some(at) => at,
            Option::None => {
                self.code.truncate(old_size)
                return ERR_HOST_ALLOCATION
            },
        }
        if code_len != 0 {
            self.code.span().write_word(offset: code_offset, value: DEAD_CODE)
            self.dead_code += record_len(code_len)
        }
        var hash = EMPTY_CODE_HASH
        if len != 0 {
            self.code.span().write_word(offset: old_size, value: address)
            self.code.span().write_word(offset: old_size + 32, value: len as u256)
            // Eight bytes at a time, then the tail.
            let start = old_size + 64
            var i: usize = 0
            while i + 8 <= len {
                self.code.write_le<u64>(offset: start + i, value: code.lane_at(i))
                i += 8
            }
            while i < len {
                self.code[start + i] = code.byte_at(i)
                i += 1
            }
            // Growth can expose old bytes where the bitmap goes.
            let map = old_size + 64 + len
            let map_len = jumpdest_map_len(len)
            self.code.slice(offset: map, len: map_len).zero()
            mark_jumpdests(code, mut self.code.slice(offset: map, len: map_len))
            hash = keccak256_word(code)
        }
        let account = mut self.accounts[at]
        account.code_offset = old_size
        account.code_len = len
        account.code_hash = hash
        if self.dead_code > self.code.len() - self.dead_code { self.compact_code() }
        OK
    }
    // Moves the live code records down over the dead ones, in order.
    fn compact_code(mut self) {
        let size = self.code.len()
        var from: usize = 0
        var to: usize = 0
        while from < size {
            let address = self.code.read_word(from)
            let record = record_len(self.code.read_word(from + 32).downcast_unchecked())
            if address != DEAD_CODE {
                if to != from { self.code.span().copy_within(source: from, dest: to, len: record) }
                self.accounts[self.index.get(address).value].code_offset = to
                to += record
            }
            from += record
        }
        self.code.truncate(to)
        self.dead_code = 0
    }
    pub fn storage_load(self, _ address: u256, _ slot: u256) -> u256 {
        let address = address_word(address)
        self.storage.get(StorageKey { address: address, slot: slot }).value
    }
    pub fn storage_store(mut self, _ address: u256, _ slot: u256, _ value: u256) -> bool {
        let address = address_word(address)
        let key = StorageKey { address: address, slot: slot }
        if value == 0 {
            if self.storage.remove(key) {
                // A slot's account has a record.
                let lookup = self.index.get(address)
                core::assert(lookup.found)
                self.accounts[lookup.value].storage_slots -= 1
            }
            return true
        }
        let slots = self.storage.len()
        if !self.storage.try_insert(key, value) { return false }
        // A slot that existed needs no account change.
        if self.storage.len() == slots { return true }
        match self.record(address) {
            Option::Some(at) => {
                self.accounts[at].storage_slots += 1
                true
            },
            Option::None => {
                let _ = self.storage.remove(key)
                false
            },
        }
    }
    pub fn block_hash(self, _ number: u256) -> u256 {
        self.block_hashes.get(number).value
    }
    pub fn set_block_hash(mut self, _ number: u256, _ hash: u256) -> bool {
        if hash == 0 {
            let _ = self.block_hashes.remove(number)
            return true
        }
        self.block_hashes.try_insert(number, hash)
    }
}

impl Default for WorldState {
    fn default() -> Self {
        WorldState::empty()
    }
}

#[test]
fn world_state_defaults_to_zero() {
    let state = WorldState::empty()
    core::assert(state.balance(1) == 0)
    core::assert(state.nonce(1) == 0)
    core::assert(state.storage_load(1, 2) == 0)
    core::assert(state.block_hash(3) == 0)
}

#[test]
fn storage_counts_follow_slots() {
    var state = WorldState::empty()
    core::assert(!state.has_storage(0xaa))
    core::assert(state.storage_store(0xaa, 1, 5) && state.storage_store(0xaa, 2, 6) && state.storage_store(0xaa, 1, 7))
    core::assert(state.has_storage(0xaa) && !state.has_storage(0xbb))
    // Clearing one of two slots, and a slot never set, leave the account's storage.
    core::assert(state.storage_store(0xaa, 1, 0) && state.storage_store(0xaa, 3, 0))
    core::assert(state.has_storage(0xaa))
    core::assert(state.storage_store(0xaa, 2, 0))
    core::assert(!state.has_storage(0xaa))
    // Deleting an account deletes its slots and no others.
    core::assert(state.storage_store(0xaa, 4, 1) && state.storage_store(0xbb, 4, 1))
    state.remove_account(0xaa)
    core::assert(!state.has_storage(0xaa) && state.storage_load(0xaa, 4) == 0)
    core::assert(state.has_storage(0xbb) && state.storage_load(0xbb, 4) == 1)
}

#[test]
fn world_state_roundtrips_account_storage() {
    var state = WorldState::empty()
    core::assert(state.set_balance(0xaa, 100))
    core::assert(state.set_nonce(0xaa, 7))
    core::assert(state.storage_store(0xaa, 3, 44))
    core::assert(state.set_block_hash(8, 0x1234))

    core::assert(state.balance(0xaa) == 100)
    core::assert(state.nonce(0xaa) == 7)
    core::assert(state.storage_load(0xaa, 3) == 44)
    core::assert(state.block_hash(8) == 0x1234)
}

#[test]
fn world_state_zero_balance_preserves_account() {
    var state = WorldState::empty()
    core::assert(state.set_balance(0xaa, 100))
    core::assert(state.storage_store(0xaa, 3, 44))
    core::assert(state.set_balance(0xaa, 0))
    core::assert(state.storage_store(0xaa, 3, 0))

    core::assert(state.balance(0xaa) == 0 && state.exists(0xaa))
    core::assert(state.storage_load(0xaa, 3) == 0)
}

#[test]
fn removing_an_account_keeps_the_others() {
    var state = WorldState::empty()
    for address in [0xaa as u256, 0xbb, 0xcc] {
        let byte: u8 = address.downcast_truncate()
        core::assert(state.set_balance(address, address) && state.set_code(address, code: [byte, byte]) == OK)
    }
    core::assert(state.storage_store(0xcc, 1, 2))
    // The last record moves into the first one's place.
    state.remove_account(0xaa)
    core::assert(!state.exists(0xaa) && state.code_size(0xaa) == 0 && state.account_count() == 2)
    var seen: u256 = 0
    for position in 0..state.account_count() {
        let account = state.account_at(position)
        let byte: u8 = account.address.downcast_truncate()
        core::assert(account.balance == account.address && account.code_len == 2)
        core::assert(state.code(account.address)[0] == byte && state.code(account.address)[1] == byte)
        seen += account.address
    }
    core::assert(seen == 0xbb + 0xcc && state.has_storage(0xcc) && state.storage_load(0xcc, 1) == 2)
    let copy = state.try_clone().unwrap()
    core::assert(copy.balance(0xcc) == 0xcc && copy.code_size(0xbb) == 2 && copy.account_count() == 2)
}
