use core::{MemBuffer, MemSpan, Option}
use core::default::Default
use swisstable::{SwissKey, SwissTable, hash_u256}
use keccak::{ByteSource, keccak256_word}
use ingot::status::{ERR_HOST_ALLOCATION, OK}
use ingot::types::{Program, jumpdest_map_len, mark_jumpdests}

pub const EMPTY_CODE_HASH: u256 = 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470

struct Account {
    balance: u256,
    nonce: u256,
    code_offset: usize,
    code_len: usize,
    code_hash: u256,
    // Nonzero storage slots, so deployability and deletion need not scan
    // the storage table.
    storage_slots: u64,
}
impl Copy for Account {}
impl Default for Account {
    fn default() -> Self {
        Self { balance: 0, nonce: 0, code_offset: 0, code_len: 0, code_hash: EMPTY_CODE_HASH, storage_slots: 0 }
    }
}

// EVM account operands use only their low 160 bits.
pub fn address_word(_ word: u256) -> u256 { word & 0xffffffffffffffffffffffffffffffffffffffff }

/// The EIP-7702 delegation designator `0xef0100 || delegate`.
pub fn designator(_ delegate: u256) -> [u8; 23] {
    var code: [u8; 23] = [0; 23]
    code[0] = 0xef
    code[1] = 0x01
    for i in 0..20 { code[3 + i] = (delegate >> ((19 - i) * 8) as u256).downcast_truncate() }
    code
}

/// The account an EIP-7702 delegation designator delegates to, if `code` is one.
pub fn delegation(_ code: MemSpan) -> Option<u256> {
    if code.len() != 23 || code[0] != 0xef || code[1] != 0x01 || code[2] != 0 { return Option::None }
    var delegate: u256 = 0
    for i in 3..23 { delegate = (delegate << 8) | code[i] as u256 }
    Option::Some(delegate)
}

pub struct StorageKey { pub address: u256, pub slot: u256 }

// Physical table slots for iterating the world; `occupied` is false for free slots.
pub struct AccountEntry {
    pub occupied: bool,
    pub address: u256,
    pub balance: u256,
    pub nonce: u256,
    pub code_len: usize,
}
pub struct StorageEntry { pub occupied: bool, pub address: u256, pub slot: u256, pub value: u256 }

/// A balance or nonce replacement: the previous value, whether the account
/// existed, whether the value changed and whether the table could hold it.
pub struct Replaced { pub previous: u256, pub found: bool, pub changed: bool, pub written: bool }

/// What validating a sender reads from its account.
pub struct Sender { pub nonce: u256, pub balance: u256, pub code_len: usize }

impl Copy for StorageKey {}

impl Default for StorageKey {
    fn default() -> Self {
        StorageKey { address: 0, slot: 0 }
    }
}

impl SwissKey for StorageKey {
    fn hash(self) -> u64 {
        hash_u256(self.address) ^ hash_u256(self.slot ^ 0x517cc1b727220a95)
    }

    fn equals(self, _ other: StorageKey) -> bool {
        self.address == other.address && self.slot == other.slot
    }
}

// An arena record's bytes for `len` bytes of code.
fn record_len(_ len: usize) -> usize {
    64 + len + jumpdest_map_len(len)
}

// A copy of `table`; none if allocation fails.
fn copy_table<K, V>(_ table: SwissTable<K, V>) -> Option<SwissTable<K, V>> where K: SwissKey + Default + Copy, V: Default + Copy {
    var copy = SwissTable<K, V>::empty()
    if !copy.try_reserve(table.len()) { return Option::None }
    for slot in 0..table.capacity() {
        let entry = table.entry(slot)
        if entry.occupied && !copy.try_insert(entry.key, entry.value) { return Option::None }
    }
    Option::Some(copy)
}

pub struct WorldState {
    accounts: SwissTable<u256, Account>,
    // Packed [address:32, length:32, code:length, jumpdests] records, where
    // `jumpdests` is the code's `mark_jumpdests` bitmap. Replacements compact
    // the arena, so retained storage is bounded by the peak live code extent.
    code: MemBuffer,
    storage: SwissTable<StorageKey, u256>,
    block_hashes: SwissTable<u256, u256>,
}

impl WorldState {
    pub fn empty() -> Self {
        WorldState {
            accounts: SwissTable<u256, Account>::empty(),
            code: MemBuffer::empty(),
            storage: SwissTable<StorageKey, u256>::empty(),
            block_hashes: SwissTable<u256, u256>::empty(),
        }
    }
    /// A copy of the world, which a host can keep to restore later; none if
    /// allocation fails.
    pub fn try_clone(self) -> Option<WorldState> {
        let accounts = match copy_table(self.accounts) {
            Option::Some(accounts) => accounts,
            Option::None => return Option::None,
        }
        let storage = match copy_table(self.storage) {
            Option::Some(storage) => storage,
            Option::None => return Option::None,
        }
        let block_hashes = match copy_table(self.block_hashes) {
            Option::Some(block_hashes) => block_hashes,
            Option::None => return Option::None,
        }
        match MemBuffer::try_from_span(self.code.span()) {
            Option::Some(code) => Option::Some(WorldState { accounts, code, storage, block_hashes }),
            Option::None => Option::None,
        }
    }

    pub fn exists(self, _ address: u256) -> bool {
        self.accounts.contains(address_word(address))
    }
    // EIP-161 emptiness: zero balance and nonce, and no code. Absent accounts are empty.
    pub fn is_empty(self, _ address: u256) -> bool {
        let account = self.accounts.get(address_word(address)).value
        account.balance == 0 && account.nonce == 0 && account.code_len == 0
    }
    // Delete an account record with its code and storage.
    pub fn remove_account(mut self, _ address: u256) {
        let address = address_word(address)
        let empty: [u8; 0] = []
        core::assert(self.set_code(address, code: empty) == OK)
        var slots = self.accounts.get(address).value.storage_slots
        let _ = self.accounts.remove(address)
        var slot: usize = 0
        while slots > 0 && slot < self.storage.capacity() {
            let entry = self.storage.entry(slot)
            if entry.occupied && entry.key.address == address {
                let _ = self.storage.remove(entry.key)
                slots -= 1
            }
            slot += 1
        }
    }
    pub fn has_storage(self, _ address: u256) -> bool {
        self.accounts.get(address_word(address)).value.storage_slots != 0
    }
    pub fn table_slots(self) -> usize { self.accounts.capacity() }
    pub fn account_at(self, _ slot: usize) -> AccountEntry {
        let entry = self.accounts.entry(slot)
        AccountEntry {
            occupied: entry.occupied, address: entry.key, balance: entry.value.balance,
            nonce: entry.value.nonce, code_len: entry.value.code_len,
        }
    }
    pub fn storage_slots(self) -> usize { self.storage.capacity() }
    pub fn storage_at(self, _ slot: usize) -> StorageEntry {
        let entry = self.storage.entry(slot)
        StorageEntry { occupied: entry.occupied, address: entry.key.address, slot: entry.key.slot, value: entry.value }
    }
    pub fn ensure_account(mut self, _ address: u256) -> bool {
        let address = address_word(address)
        self.accounts.contains(address) || self.accounts.try_insert(address, Account::default())
    }
    // Used only by undo after restoring every write that created this account.
    pub fn remove_empty_account(mut self, _ address: u256) -> bool {
        let address = address_word(address)
        let account = self.accounts.get(address).value
        core::assert(account.balance == 0 && account.nonce == 0 && account.code_len == 0)
        self.accounts.remove(address)
    }
    pub fn balance(self, _ address: u256) -> u256 {
        self.accounts.get(address_word(address)).value.balance
    }
    pub fn set_balance(mut self, _ address: u256, _ value: u256) -> bool {
        let address = address_word(address)
        let previous = self.accounts.get(address)
        if !previous.found && value == 0 { return true }
        var account = previous.value
        account.balance = value
        self.accounts.try_insert(address, account)
    }
    pub fn nonce(self, _ address: u256) -> u256 {
        self.accounts.get(address_word(address)).value.nonce
    }
    pub fn sender(self, _ address: u256) -> Sender {
        let account = self.accounts.get(address_word(address)).value
        Sender { nonce: account.nonce, balance: account.balance, code_len: account.code_len }
    }
    /// Sets the balance (or nonce) with one lookup; an absent account stays
    /// absent for zero.
    pub fn replace(mut self, balance: bool, _ address: u256, _ value: u256) -> Replaced {
        let address = address_word(address)
        let lookup = self.accounts.get(address)
        var account = lookup.value
        let previous = if balance { account.balance } else { account.nonce }
        if previous == value { return Replaced { previous, found: lookup.found, changed: false, written: true } }
        if balance { account.balance = value } else { account.nonce = value }
        Replaced { previous, found: lookup.found, changed: true, written: self.accounts.try_insert(address, account) }
    }
    pub fn set_nonce(mut self, _ address: u256, _ value: u256) -> bool {
        let address = address_word(address)
        let previous = self.accounts.get(address)
        if !previous.found && value == 0 { return true }
        var account = previous.value
        account.nonce = value
        self.accounts.try_insert(address, account)
    }
    pub fn code_size(self, _ address: u256) -> usize {
        self.accounts.get(address_word(address)).value.code_len
    }
    // EIP-1052: even an explicitly present account hashes to zero if its
    // balance, nonce and code are empty. Storage is not part of that predicate.
    pub fn code_hash(self, _ address: u256) -> u256 {
        let account = self.accounts.get(address_word(address)).value
        if account.balance == 0 && account.nonce == 0 && account.code_len == 0 {
            0
        } else { account.code_hash }
    }
    // An account's code. One without code has no arena record to address.
    pub fn code(self, _ address: u256) -> ref MemSpan {
        let account = self.accounts.get(address_word(address)).value
        let offset = if account.code_len == 0 { 0 } else { account.code_offset + 64 }
        self.code.slice(offset, len: account.code_len)
    }
    /// The account an EIP-7702 delegation designator delegates to, if that is
    /// the account's code.
    pub fn delegate(self, _ address: u256) -> Option<u256> { delegation(self.code(address)) }
    /// The account's code, with the JUMPDEST bitmap computed when the code was set.
    pub fn program(self, _ address: u256) -> Program {
        let account = self.accounts.get(address_word(address)).value
        let len = account.code_len
        let offset = if len == 0 { 0 } else { account.code_offset + 64 }
        let jumpdests = self.code.slice(offset: offset + len, len: jumpdest_map_len(len))
        Program::analyzed(self.code.slice(offset, len), jumpdests)
    }
    // Copies `code` into the arena with its jump-destination map and hash. Hosts
    // set up accounts with it; code deposits and EIP-7702 delegations use it too.
    pub fn set_code<T: ByteSource>(mut self, address: u256, code: T) -> i32 {
        let address = address_word(address)
        let previous = self.accounts.get(address)
        let len = code.len()
        if !previous.found && len == 0 { return OK }
        // With room for the account, the final insertion cannot fail.
        if !previous.found && !self.accounts.try_reserve(1) { return ERR_HOST_ALLOCATION }
        var account = previous.value
        let old_size = self.code.len()
        let removed = if account.code_len == 0 { 0 } else { record_len(account.code_len) }
        let retained = old_size - removed
        // Bound before addition and before ByteSource traversal/allocation,
        // leaving room for the bitmap, an eighth of the code.
        if len != 0 && (retained > 0x3fffffffffffffff - 64 || len > 0x3fffffffffffffff - 64 - retained) {
            return ERR_HOST_ALLOCATION
        }
        let new_size = retained + if len == 0 { 0 } else { record_len(len) }
        if new_size > old_size && !self.code.try_resize(new_size) { return ERR_HOST_ALLOCATION }
        if removed != 0 {
            let start = account.code_offset
            let end = start + removed
            self.code.span().copy_within(source: end, dest: start, len: old_size - end)
            var cursor = start
            while cursor < retained {
                let key = self.code.read_word(cursor)
                let size: usize = self.code.read_word(cursor + 32).downcast_unchecked()
                var moved = self.accounts.get(key).value
                moved.code_offset = cursor
                self.accounts.insert(key, moved)
                cursor += record_len(size)
            }
        }
        account.code_offset = retained
        account.code_len = len
        account.code_hash = EMPTY_CODE_HASH
        if len != 0 {
            self.code.span().write_word(offset: retained, value: address)
            self.code.span().write_word(offset: retained + 32, value: len as u256)
            for i in 0..len { self.code[retained + 64 + i] = code.byte_at(i) }
            // Compaction can leave old bytes where the bitmap goes.
            let map = retained + 64 + len
            let map_len = jumpdest_map_len(len)
            self.code.slice(offset: map, len: map_len).zero()
            mark_jumpdests(code, mut self.code.slice(offset: map, len: map_len))
            account.code_hash = keccak256_word(code)
        }
        self.code.truncate(new_size)
        self.accounts.insert(address, account)
        OK
    }
    pub fn storage_load(self, _ address: u256, _ slot: u256) -> u256 {
        let address = address_word(address)
        self.storage.get(StorageKey { address: address, slot: slot }).value
    }
    pub fn storage_store(mut self, _ address: u256, _ slot: u256, _ value: u256) -> bool {
        let address = address_word(address)
        let key = StorageKey { address: address, slot: slot }
        if value == 0 {
            if self.storage.remove(key) {
                // The slot's account exists, and updating it does not grow the table.
                var account = self.accounts.get(address).value
                account.storage_slots -= 1
                core::assert(self.accounts.try_insert(address, account))
            }
            return true
        }
        let previous = self.accounts.get(address)
        let slots = self.storage.len()
        if !self.storage.try_insert(key, value) { return false }
        let added = self.storage.len() > slots
        // A slot's account exists, so a slot that existed needs no account change.
        if !added { return true }
        var account = previous.value
        account.storage_slots += 1
        if !self.accounts.try_insert(address, account) {
            let _ = self.storage.remove(key)
            return false
        }
        true
    }
    pub fn block_hash(self, _ number: u256) -> u256 {
        self.block_hashes.get(number).value
    }
    pub fn set_block_hash(mut self, _ number: u256, _ hash: u256) -> bool {
        if hash == 0 {
            let _ = self.block_hashes.remove(number)
            return true
        }
        self.block_hashes.try_insert(number, hash)
    }
}

impl Default for WorldState {
    fn default() -> Self {
        WorldState::empty()
    }
}

#[test]
fn world_state_defaults_to_zero() {
    let state = WorldState::empty()
    core::assert(state.balance(1) == 0)
    core::assert(state.nonce(1) == 0)
    core::assert(state.storage_load(1, 2) == 0)
    core::assert(state.block_hash(3) == 0)
}

#[test]
fn storage_counts_follow_slots() {
    var state = WorldState::empty()
    core::assert(!state.has_storage(0xaa))
    core::assert(state.storage_store(0xaa, 1, 5) && state.storage_store(0xaa, 2, 6) && state.storage_store(0xaa, 1, 7))
    core::assert(state.has_storage(0xaa) && !state.has_storage(0xbb))
    // Clearing one of two slots, and a slot never set, leave the account's storage.
    core::assert(state.storage_store(0xaa, 1, 0) && state.storage_store(0xaa, 3, 0))
    core::assert(state.has_storage(0xaa))
    core::assert(state.storage_store(0xaa, 2, 0))
    core::assert(!state.has_storage(0xaa))
    // Deleting an account deletes its slots and no others.
    core::assert(state.storage_store(0xaa, 4, 1) && state.storage_store(0xbb, 4, 1))
    state.remove_account(0xaa)
    core::assert(!state.has_storage(0xaa) && state.storage_load(0xaa, 4) == 0)
    core::assert(state.has_storage(0xbb) && state.storage_load(0xbb, 4) == 1)
}

#[test]
fn world_state_roundtrips_account_storage() {
    var state = WorldState::empty()
    core::assert(state.set_balance(0xaa, 100))
    core::assert(state.set_nonce(0xaa, 7))
    core::assert(state.storage_store(0xaa, 3, 44))
    core::assert(state.set_block_hash(8, 0x1234))

    core::assert(state.balance(0xaa) == 100)
    core::assert(state.nonce(0xaa) == 7)
    core::assert(state.storage_load(0xaa, 3) == 44)
    core::assert(state.block_hash(8) == 0x1234)
}

#[test]
fn world_state_zero_balance_preserves_account() {
    var state = WorldState::empty()
    core::assert(state.set_balance(0xaa, 100))
    core::assert(state.storage_store(0xaa, 3, 44))
    core::assert(state.set_balance(0xaa, 0))
    core::assert(state.storage_store(0xaa, 3, 0))

    core::assert(state.balance(0xaa) == 0 && state.exists(0xaa))
    core::assert(state.storage_load(0xaa, 3) == 0)
}
