use core::{MemBuffer, MemVec, Option, Result}
use keccak::Keccak256
use ingot::address::{create_address, rlp_integer_len, update_rlp_integer}
use ingot::constants::MAX_U256
use ingot::gas::{ACCOUNT_WRITE, AUTH_BASE, NEW_ACCOUNT, STORAGE_SET, StateGas, TX_MAX_TOTAL_GAS, account_access}
use ingot::fork::Rules
use ingot::logs::LogBuffer
use ingot::state::{StorageKey, WorldState, address_word, delegation}
use ingot::transaction::{SYSTEM_ADDRESS, Transaction}
use ingot::trace::{CallEnd, CallStart, Tracer}
use ingot::types::{BlockEnv, CallEnv, Config, ExecutionResult, InputData, Program, empty_bytes}
use ingot::vm::{Vm, begin_create, run_precompile, spend, status_result, transfer}
use fevm_precompiles::{is_precompile, recover_signer}
use fevm_precompiles::secp256k1::N as SECP256K1_N
use swisstable::SwissTable
use ingot::status::{
    ERR_ADDRESS_COLLISION,
    ERR_OUT_OF_GAS,
    ERR_HOST_ALLOCATION,
    ERR_REVERT,
    INVALID_BALANCE,
    INVALID_BLOB_COUNT,
    INVALID_BLOB_GAS,
    INVALID_BLOB_FEE_CAP,
    INVALID_BLOB_VERSION,
    INVALID_CHAIN_ID,
    INVALID_CREATE,
    INVALID_FEE_CAP,
    INVALID_GAS_LIMIT,
    INVALID_GAS_LIMIT_CAP,
    INVALID_INITCODE_SIZE,
    INVALID_INTRINSIC_GAS,
    INVALID_NONCE,
    INVALID_NONCE_LIMIT,
    INVALID_NO_AUTHORIZATIONS,
    INVALID_NO_BLOBS,
    INVALID_PRIORITY_FEE,
    INVALID_SENDER_CODE,
    INVALID_TX_TYPE,
    OK,
    VALID,
    exceptional,
    is_evm_outcome,
}

// Transaction envelope kinds.
pub const TX_LEGACY: u8 = 0
pub const TX_ACCESS_LIST: u8 = 1
pub const TX_FEE_MARKET: u8 = 2
pub const TX_BLOB: u8 = 3
pub const TX_SET_CODE: u8 = 4

pub const GAS_PER_BLOB: u64 = 131072
// EIP-7594. Every blob schedule since Prague fits six blobs in a block.
const MAX_BLOBS_PER_TX: u64 = 6
// EIP-4788: a system call's gas, which is no part of its block's.
const SYSTEM_CALL_GAS: u64 = 30_000_000
// EIP-8037: the storage slots a system call's state gas reservoir pays for.
const SYSTEM_CALL_SLOTS: u64 = 16
// EIP-7702 intrinsic gas per authorization, of which an existing authority
// refunds half until Amsterdam.
const AUTHORIZATION_GAS: u128 = 25000
const EXISTING_AUTHORITY_REFUND: i128 = 12500
// From Amsterdam (EIP-2780 and EIP-8037), an authorization's intrinsic gas:
// its 101 bytes of floor tokens, an ecrecover, a cold access and two warm ones.
const AUTHORIZATION_BASE: u128 = 7816

// What an authority's authorizations paid for (EIP-8037 and EIP-8038): its
// first write, and a delegation that is new state, which one it held before
// the transaction also stands for.
const SEEN: u8 = 1
const WRITE_PAID: u8 = 2
const DELEGATION_PAID: u8 = 4

pub struct TxEnv {
    pub kind: u8,
    // The signed chain ID; none for a legacy transaction signed before EIP-155.
    pub chain_id: Option<u256>,
    pub sender: u256,
    pub to: u256,
    pub creates: bool,
    pub nonce: u256,
    pub gas_limit: u64,
    // The legacy/EIP-2930 gas price, or the EIP-1559 maximum fee per gas.
    pub gas_price: u256,
    pub max_priority_fee_per_gas: u256,
    pub max_fee_per_blob_gas: u256,
    pub value: u256,
}

impl Copy for TxEnv {}

/// An EIP-7702 authorization: its signer delegates its code to `address`, or
/// clears the delegation when `address` is zero.
pub struct Authorization {
    pub chain_id: u256,
    pub address: u256,
    pub nonce: u256,
    pub y_parity: u256,
    pub r: u256,
    pub s: u256,
}

impl Copy for Authorization {}

/// A transaction with its owned calldata (initcode for creations), access list,
/// versioned blob hashes and authorizations.
pub struct TxRequest {
    pub env: TxEnv,
    data: InputData,
    access_accounts: MemVec<u256>,
    access_keys: MemVec<StorageKey>,
    blob_hashes: MemVec<u256>,
    authorizations: MemVec<Authorization>,
}

impl TxRequest {
    pub fn new(_ env: TxEnv, data: own InputData) -> Self {
        Self {
            env, data, access_accounts: MemVec::new(), access_keys: MemVec::new(), blob_hashes: MemVec::new(),
            authorizations: MemVec::new(),
        }
    }
    pub fn add_authorization(mut self, _ authorization: Authorization) -> bool {
        self.authorizations.try_push(authorization).is_ok()
    }
    /// One access-list entry; each of its storage keys is added with `add_access_key`.
    pub fn add_access_account(mut self, _ address: u256) -> bool { self.access_accounts.try_push(address).is_ok() }
    pub fn add_access_key(mut self, address: u256, slot: u256) -> bool {
        self.access_keys.try_push(StorageKey { address, slot }).is_ok()
    }
    pub fn add_blob_hash(mut self, _ hash: u256) -> bool { self.blob_hashes.try_push(hash).is_ok() }
    pub fn data(self) -> ref InputData { ref self.data }
    fn blob_count(self) -> u64 { self.blob_hashes.len().downcast_unchecked() }
    /// The blob gas the transaction uses (EIP-4844).
    pub fn blob_gas(self) -> u64 { self.blob_count() * GAS_PER_BLOB }
    fn authorization_count(self) -> usize { self.authorizations.len() }
}

/// `invalid` is VALID for an executed transaction. `status` is the message's
/// outcome (OK, ERR_REVERT or an exceptional halt); any other status is a host
/// failure, which changes nothing. `created` is the new
/// contract's address when a creation succeeds. `gas_refunded` is the refund
/// that reduced `gas_used`. `execution_gas_used` and `state_gas_used` are what
/// the transaction adds to its block's gas totals: before Amsterdam,
/// `gas_used` and zero; from Amsterdam, its gas before refunds less its state
/// gas, at least the calldata floor (EIP-7778), and its state gas (EIP-8037).
/// `cumulative_gas_used` is the `gas_used` of its block's transactions
/// through this one; outside a block, its own.
pub struct Receipt {
    pub invalid: i32,
    pub status: i32,
    pub gas_used: u64,
    pub cumulative_gas_used: u64,
    pub gas_refunded: u64,
    pub execution_gas_used: u64,
    pub state_gas_used: u64,
    pub created: Option<u256>,
    pub output: MemBuffer,
    pub logs: LogBuffer,
}

// `a * b`, or none past 256 bits. With `b` split at bit 64, `a` times the
// high part fits in 256 bits and times the low part in 128.
fn checked_mul(_ a: u64, _ b: u256) -> Option<u256> {
    let high = (b >> 64) * a as u256
    let low = (b & 0xffffffffffffffff) * a as u256
    if high >> 192 != 0 || low > MAX_U256 - (high << 64) { Option::None } else { Option::Some((high << 64) + low) }
}

fn checked_add(_ a: u256, _ b: u256) -> Option<u256> {
    if b > MAX_U256 - a { Option::None } else { Option::Some(a + b) }
}

fn words(_ len: usize) -> u128 {
    let len: u128 = len.downcast_unchecked()
    (len + 31) / 32
}

/// The intrinsic charge paid before execution, and the EIP-7623 calldata floor
/// on the gas a transaction uses.
pub struct IntrinsicGas { pub regular: u128, pub floor: u128 }

/// Calldata, creation, access-list and authorization charges, and the
/// calldata floor.
pub fn intrinsic_gas<F: Rules>(_ request: TxRequest) -> IntrinsicGas {
    let data = ref request.data()
    let bytes = data.bytes()
    let len = data.len()
    var nonzero: usize = 0
    var index: usize = 0
    // Eight bytes at a time: a byte's top bit marks it nonzero, and the
    // multiplication sums the marks into the top byte.
    while len - index >= 8 {
        let word: u64 = unsafe { bytes.read_be_unchecked<u64>(index) }
        let low = (word & 0x7f7f7f7f7f7f7f7f).wrapping_add(0x7f7f7f7f7f7f7f7f)
        let marks = ((low | word) & 0x8080808080808080) >> 7
        nonzero += (marks.wrapping_mul(0x0101010101010101) >> 56) as usize
        index += 8
    }
    while index < len {
        if bytes[index] != 0 { nonzero += 1 }
        index += 1
    }
    // A zero byte is one token and the others four; a token costs 4 gas, or
    // 10 for the floor.
    // Lengths are far below 2^62, so the token count fits a `usize`.
    let tokens: u128 = (len + 3 * nonzero).downcast_unchecked()
    let accounts: u128 = request.access_accounts.len().downcast_unchecked()
    let keys: u128 = request.access_keys.len().downcast_unchecked()
    let count: u128 = request.authorization_count().downcast_unchecked()
    let env = ref request.env
    if F::TX_REPRICING {
        // EIP-2780: the sender's 12,000, and the recipient's access and value,
        // which a transfer to oneself does not pay, or CREATE's base.
        let recipient: u128 = if env.creates { F::CREATE as u128 }
            else if address_word(env.to) == address_word(env.sender) { 0 }
            else { F::COLD_ACCOUNT_ACCESS as u128 + if env.value != 0 { 6000 } else { 0 } }
        let base = 12000 + recipient
        // An access-list entry costs its cold access less a warm one, and
        // from EIP-7981 its addresses and keys are 80 and 128 floor tokens,
        // charged on both sides.
        let listed = 16 * (80 * accounts + 128 * keys)
        var gas = base + 4 * tokens + 2900 * accounts + 2000 * keys + listed + AUTHORIZATION_BASE * count
        if env.creates { gas += 2 * words(len) }
        // EIP-7976: every calldata byte is four floor tokens.
        let bytes: u128 = len.downcast_unchecked()
        return IntrinsicGas { regular: gas, floor: base + 64 * bytes + listed }
    }
    var gas: u128 = 21000 + 4 * tokens
    if env.creates { gas += 32000 + 2 * words(data.len()) }
    let authorizations = AUTHORIZATION_GAS * count
    IntrinsicGas { regular: gas + 2400 * accounts + 1900 * keys + authorizations, floor: 21000 + 10 * tokens }
}

fn fee_market(_ env: TxEnv) -> bool { env.kind >= TX_FEE_MARKET }

// EIP-1559: the base fee plus the priority fee the fee cap leaves room for.
fn effective_gas_price(_ env: TxEnv, base_fee: u256) -> u256 {
    // Only a host that skips the base fee check admits a fee cap below it; the
    // transaction then pays its cap.
    if !fee_market(env) || env.gas_price <= base_fee { return env.gas_price }
    let headroom = env.gas_price - base_fee
    base_fee + if env.max_priority_fee_per_gas < headroom { env.max_priority_fee_per_gas } else { headroom }
}

fn blob_fee(_ request: TxRequest, price: u256) -> Option<u256> {
    checked_mul(request.blob_gas(), price)
}

/// The gas a block has left for a transaction: for its execution, from
/// EIP-8037 for its state gas apart, and for its blobs.
pub struct Capacity { pub gas: u64, pub state_gas: u64, pub blob_gas: u64 }

impl Copy for Capacity {}

impl Capacity {
    /// The capacity of an empty block.
    pub fn of(_ block: BlockEnv, _ config: Config) -> Self {
        let gas: u64 = if block.gaslimit >> 64 != 0 { 0xffffffffffffffff } else { block.gaslimit.downcast_unchecked() }
        Capacity { gas, state_gas: gas, blob_gas: config.blob_schedule.max * GAS_PER_BLOB }
    }
}

// Validation's verdict, from the includability checks in specification
// order, and the intrinsic gas it computed.
pub(ingot) struct Checked { pub invalid: i32, pub intrinsic: IntrinsicGas }

pub(ingot) fn checked<F: Rules>(_ world: WorldState, _ request: TxRequest, _ block: BlockEnv, _ config: Config,
                                _ available: Capacity) -> Checked {
    let intrinsic = intrinsic_gas<F>(request)
    Checked { invalid: verdict<F>(world, request, block, config, available, intrinsic), intrinsic }
}

fn verdict<F: Rules>(_ world: WorldState, _ request: TxRequest, _ block: BlockEnv, _ config: Config,
                     _ available: Capacity, _ intrinsic: IntrinsicGas) -> i32 {
    let env = request.env
    let sender = address_word(env.sender)
    if env.kind > TX_SET_CODE { return INVALID_TX_TYPE }
    // Only the blob envelope has versioned hashes, and only the set-code
    // envelope authorizations.
    if env.kind != TX_BLOB && request.blob_count() != 0 { return INVALID_TX_TYPE }
    if env.kind != TX_SET_CODE && request.authorization_count() != 0 { return INVALID_TX_TYPE }
    let required = if intrinsic.regular > intrinsic.floor { intrinsic.regular } else { intrinsic.floor }
    if required > env.gas_limit as u128 { return INVALID_INTRINSIC_GAS }
    if env.creates && request.data().len() > config.max_initcode_size.downcast_truncate() { return INVALID_INITCODE_SIZE }
    if F::STATE_GAS {
        // EIP-8037: gas past the execution cap is state gas, so only the
        // intrinsic gas and floor must fit the cap.
        if env.gas_limit > TX_MAX_TOTAL_GAS { return INVALID_GAS_LIMIT_CAP }
        if required > config.tx_gas_limit_cap as u128 { return INVALID_INTRINSIC_GAS }
    } else if env.gas_limit > config.tx_gas_limit_cap { return INVALID_GAS_LIMIT_CAP }
    if env.nonce >= 0xffffffffffffffff { return INVALID_NONCE_LIMIT }
    if fee_market(env) && env.gas_price < env.max_priority_fee_per_gas { return INVALID_PRIORITY_FEE }
    // EIP-8037: the block counts at most the execution cap of a
    // transaction's gas as execution gas, and all of it as state gas.
    let execution = if F::STATE_GAS && env.gas_limit > config.tx_gas_limit_cap { config.tx_gas_limit_cap }
        else { env.gas_limit }
    if execution > available.gas || (F::STATE_GAS && env.gas_limit > available.state_gas) { return INVALID_GAS_LIMIT }
    if request.blob_gas() > available.blob_gas { return INVALID_BLOB_GAS }
    if config.check_chain_id && let Option::Some(chain_id) = env.chain_id && chain_id != block.chainid {
        return INVALID_CHAIN_ID
    }
    if config.check_base_fee && env.gas_price < block.basefee { return INVALID_FEE_CAP }
    var max_fee = checked_mul(env.gas_limit, env.gas_price)
    if env.kind == TX_BLOB {
        if request.blob_count() == 0 { return INVALID_NO_BLOBS }
        if request.blob_count() > MAX_BLOBS_PER_TX { return INVALID_BLOB_COUNT }
        for hash in request.blob_hashes {
            if hash >> 248 != 0x01 { return INVALID_BLOB_VERSION }
        }
        if env.max_fee_per_blob_gas < block.blobbasefee { return INVALID_BLOB_FEE_CAP }
        max_fee = match (max_fee, blob_fee(request, price: env.max_fee_per_blob_gas)) {
            (Option::Some(gas), Option::Some(blobs)) => checked_add(gas, blobs),
            _ => Option::None,
        }
    }
    if (env.kind == TX_BLOB || env.kind == TX_SET_CODE) && env.creates { return INVALID_CREATE }
    if env.kind == TX_SET_CODE && request.authorization_count() == 0 { return INVALID_NO_AUTHORIZATIONS }
    let account = world.sender(sender)
    if config.check_nonce && account.nonce != env.nonce { return INVALID_NONCE }
    let required = match max_fee {
        Option::Some(fee) => checked_add(fee, env.value),
        Option::None => Option::None,
    }
    match required {
        Option::Some(required) => if account.balance < required { return INVALID_BALANCE },
        Option::None => return INVALID_BALANCE,
    }
    // EIP-3607, except that an EIP-7702 delegated account may send.
    if config.check_sender_code && account.code_len != 0 && world.delegate(sender).is_none() {
        return INVALID_SENDER_CODE
    }
    VALID
}

fn empty_receipt(invalid: i32, status: i32) -> Receipt {
    Receipt {
        invalid, status, gas_used: 0, cumulative_gas_used: 0, gas_refunded: 0, execution_gas_used: 0, state_gas_used: 0,
        created: Option::None, output: MemBuffer::empty(),
        logs: LogBuffer::new(),
    }
}

// A host failure during a valid transaction leaves the pre-state.
fn host_failure(_ tx: mut Transaction, status: i32) -> Receipt {
    tx.end(commit: false)
    empty_receipt(invalid: VALID, status)
}

// Warm the access list and blob hashes, then buy gas and increment the nonce.
fn prepare(_ tx: mut Transaction, _ request: TxRequest, price: u256, blob_price: u256) -> i32 {
    for address in request.access_accounts {
        if !tx.access_list_account(address) { return ERR_HOST_ALLOCATION }
    }
    for key in request.access_keys {
        if !tx.access_list_slot(address: key.address, slot: key.slot) { return ERR_HOST_ALLOCATION }
    }
    for hash in request.blob_hashes {
        if !tx.add_blob_hash(hash) { return ERR_HOST_ALLOCATION }
    }
    let sender = address_word(request.env.sender)
    let fee = request.env.gas_limit as u256 * price + request.blob_gas() as u256 * blob_price
    tx.charge(sender, fee)
}

// What an authority signs: keccak256(0x05 || rlp([chain_id, address, nonce])).
fn authorization_hash(_ authorization: Authorization) -> u256 {
    // At most 33 + 21 + 9 bytes, with the nonce below 2^64, so the list
    // header is one byte or two.
    let payload = (rlp_integer_len(authorization.chain_id) + 21 + rlp_integer_len(authorization.nonce)) as u256
    var hash = Keccak256::new()
    if payload < 56 { hash.update_word(0x05c0 + payload, len: 2) } else { hash.update_word(0x05f800 + payload, len: 3) }
    update_rlp_integer(mut hash, authorization.chain_id)
    hash.update_word((0x94 << 160) | address_word(authorization.address), len: 21)
    update_rlp_integer(mut hash, authorization.nonce)
    hash.finish_word()
}

// The signer of an authorization for this chain, if its signature is
// well-formed (EIP-2 s) and recovers one.
fn authority(_ authorization: Authorization, chain_id: u256) -> Option<u256> {
    let a = authorization
    let usable = (a.chain_id == 0 || a.chain_id == chain_id) && a.nonce < 0xffffffffffffffff && a.y_parity <= 1
        && a.r != 0 && a.r < SECP256K1_N && a.s != 0 && a.s <= SECP256K1_N / 2
    if !usable { return Option::None }
    recover_signer(hash: authorization_hash(a), recovery_id: a.y_parity, r: a.r, s: a.s)
}

// EIP-7702: apply the authorizations in order, skipping invalid ones. Each
// recovered authority is warmed; a valid one gets the delegation and its next
// nonce. Until Amsterdam it refunds part of the intrinsic charge if the
// account existed; from Amsterdam the top frame's `gas` and `state_gas` pay
// for a new account, the authority's first write and a new delegation
// (EIP-8037 and EIP-8038). The changes precede the message's checkpoint, so
// they survive its failure.
fn authorize<F: Rules>(_ tx: mut Transaction, _ request: TxRequest, chain_id: u256, gas: mut u64,
                       state_gas: mut StateGas) -> i32 {
    var paid = SwissTable<u256, u8>::empty()
    let env = ref request.env
    for authorization in request.authorizations {
        let signer = authority(authorization, chain_id)
        if signer.is_none() { continue }
        let authority = signer.unwrap()
        var status = tx.warm_account(address: authority)
        if status != OK { return status }
        let delegable = tx.code_size(authority) == 0 || tx.delegate(authority).is_some()
        if !delegable || tx.nonce(authority) != authorization.nonce { continue }
        let delegate = address_word(authorization.address)
        if F::STATE_GAS {
            let Option::Some(slot) = paid.try_find_or_insert(authority) else { return ERR_HOST_ALLOCATION }
            let flags = mut paid.value_at(slot)
            if flags == 0 {
                // The transaction pays for writing its sender and a recipient
                // of value already.
                flags = SEEN
                if authority == address_word(env.sender) || (env.value != 0 && authority == address_word(env.to)) {
                    flags |= WRITE_PAID
                }
                if tx.delegate(authority).is_some() { flags |= DELEGATION_PAID }
            }
            if !tx.exists(authority) && !state_gas.charge(mut gas, NEW_ACCOUNT) { return ERR_OUT_OF_GAS }
            if flags & WRITE_PAID == 0 {
                if !spend(mut gas, ACCOUNT_WRITE) { return ERR_OUT_OF_GAS }
                flags |= WRITE_PAID
            }
            if delegate != 0 && flags & DELEGATION_PAID == 0 {
                if !state_gas.charge(mut gas, AUTH_BASE) { return ERR_OUT_OF_GAS }
                flags |= DELEGATION_PAID
            }
        } else if tx.exists(authority) {
            tx.add_refund(EXISTING_AUTHORITY_REFUND)
        }
        status = tx.delegate_code(address: authority, delegate)
        if status == OK { status = tx.increment_nonce(authority) }
        if status != OK { return status }
    }
    OK
}

// From EIP-8037, charges the top frame's `gas` and `state_gas` for the
// message to `target`: the EIP-7702 authorizations, the account the message
// makes, and the access of the target's delegate. A failure undoes all of it
// and ends the message as an exceptional halt before it starts.
fn prepare_message<F: Rules>(_ tx: mut Transaction, _ request: TxRequest, target: u256, chain_id: u256,
                             gas: mut u64, state_gas: mut StateGas) -> i32 {
    let env = ref request.env
    let checkpoint = tx.checkpoint(is_static: false)
    var status = if env.kind == TX_SET_CODE { authorize<F>(mut tx, request, chain_id, mut gas, mut state_gas) } else { OK }
    // Once its authorizations are paid for, the message reads its target,
    // which is warm; a block's access list has the read even if the
    // message then fails.
    if status == OK && F::BLOCK_ACCESS_LIST { status = tx.access_account(target, warm: true) }
    if status == OK {
        // The delegations survive the message's failure, and so does their state gas.
        state_gas.commit()
        // A creation that collides makes no account.
        let creates_account = if env.creates { tx.deployable(target) } else { env.value != 0 }
        if creates_account && tx.is_empty(target) && !state_gas.charge(mut gas, NEW_ACCOUNT) {
            status = ERR_OUT_OF_GAS
        } else if !env.creates && let Option::Some(delegate) = tx.delegate(target) {
            status = if spend(mut gas, account_access<F>(warm: tx.account_is_warm(delegate))) {
                tx.warm_account(address: delegate)
            } else {
                ERR_OUT_OF_GAS
            }
        }
    }
    if status == OK { tx.commit(checkpoint) } else { tx.revert(checkpoint) }
    status
}

// From EIP-8037, gives `result`, a message that ran no code, its top frame's
// `state_gas`: a failure refills what the message's preparation charged.
fn without_code<F: Rules>(var _ state_gas: own StateGas, _ result: mut ExecutionResult) {
    if !F::STATE_GAS { return }
    if result.status != OK { state_gas.restore(mut result.gas_remaining, halted: exceptional(result.status)) }
    result.reservoir = state_gas.reservoir
    result.spilled = state_gas.spilled
}

// The top-level message, with the prepared top frame's `call.gas_limit` and
// `state_gas`: a creation or a call, each under its own checkpoint.
fn execute_message<F: Rules, T: Tracer>(_ tx: mut Transaction, _ request: TxRequest, call: CallEnv, block: BlockEnv,
                                        state_gas: StateGas, _ tracer: mut T) -> ExecutionResult {
    let sender = call.caller
    let target = call.address
    let value = call.callvalue
    if request.env.creates {
        if !tx.deployable(target) {
            var result = status_result(ERR_ADDRESS_COLLISION)
            without_code<F>(state_gas, mut result)
            return result
        }
        let checkpoint = match begin_create<F>(mut tx, sender, address: target, value) {
            Result::Ok(checkpoint) => checkpoint,
            Result::Err(status) => return status_result(status),
        }
        let program = Program::copy_from(request.data(), len: request.data().len() as usize)
        var vm = Vm::new()
        vm.reset(gas: call.gas_limit, state_gas)
        vm.run_root<F>(program, empty_bytes(), call, block, mut tx, mut tracer, creates: true)
        if vm.status == OK { tx.commit(checkpoint) } else { tx.revert(checkpoint) }
        return vm.into_result(mut tx.buffers())
    }
    let checkpoint = tx.checkpoint(is_static: false)
    // The call touches its target even without value; a failed call undoes the touch.
    let moved = if value == 0 { tx.touch_unmarked(target) } else { transfer<F>(mut tx, from: sender, to: target, value) }
    if moved != OK {
        tx.revert(checkpoint)
        return status_result(moved)
    }
    // A delegated account runs its delegate's code, never a precompile (EIP-7702).
    if is_precompile(target) && tx.delegate(target).is_none() {
        var result = run_precompile(address: target, input: request.data(), gas: call.gas_limit)
        if result.status == OK { tx.commit(checkpoint) } else { tx.revert(checkpoint) }
        without_code<F>(state_gas, mut result)
        return result
    }
    let code = tx.code(target)
    let delegate = delegation(code)
    // A precompile delegate runs nothing.
    let runs_code = match delegate {
        Option::Some(address) => !is_precompile(address) && tx.code_size(address) != 0,
        Option::None => code.len() != 0,
    }
    if let Option::Some(address) = delegate {
        let warmed = tx.warm_account(address)
        if warmed != OK {
            tx.revert(checkpoint)
            return status_result(warmed)
        }
    }
    // Without code the message stops at once with its gas, as a call from code does.
    if !runs_code {
        tx.commit(checkpoint)
        var result = status_result(OK)
        result.gas_remaining = call.gas_limit
        without_code<F>(state_gas, mut result)
        return result
    }
    var vm = Vm::new()
    vm.reset(gas: call.gas_limit, state_gas)
    vm.run_root<F>(tx.program(delegate.unwrap_or(default: target)), request.data(), call, block, mut tx, mut tracer,
                      creates: false)
    if vm.status == OK { tx.commit(checkpoint) } else { tx.revert(checkpoint) }
    vm.into_result(mut tx.buffers())
}

// Validates and executes one transaction on `tx`'s world, between
// transactions before and after, in a block with `available` gas left. A
// valid transaction pays for gas, runs its message, refunds unused and
// refunded gas to the sender, pays the priority fee to the coinbase, and
// settles deletions; without `commit` it is then undone, and its receipt is
// the one it would have had.
pub(ingot) fn apply<F: Rules, T: Tracer>(_ tx: mut Transaction, _ request: TxRequest, _ block: BlockEnv, _ config: Config,
                                         _ available: Capacity, _ tracer: mut T, commit: bool) -> Receipt {
    let env = request.env
    let checked = checked<F>(tx.world(), request, block, config, available)
    if checked.invalid != VALID {
        return empty_receipt(invalid: checked.invalid, status: OK)
    }
    let intrinsic = checked.intrinsic
    let sender = address_word(env.sender)
    let price = effective_gas_price(env, base_fee: block.basefee)
    let target = if env.creates { create_address(sender, nonce: tx.world().nonce(sender)) } else { address_word(env.to) }
    tx.begin(sender, destination: target, coinbase: block.coinbase, config)
    var prepared = prepare(mut tx, request, price, blob_price: block.blobbasefee)
    // EIP-8037: gas past the execution cap is the top frame's state gas reservoir.
    let regular: u64 = intrinsic.regular.downcast_unchecked()
    let available = env.gas_limit - regular
    var gas = if F::STATE_GAS && available > config.tx_gas_limit_cap - regular { config.tx_gas_limit_cap - regular }
        else { available }
    let reservoir = available - gas
    var state_gas = StateGas::new(reservoir)
    if prepared == OK {
        prepared = if F::STATE_GAS {
            prepare_message<F>(mut tx, request, target, chain_id: block.chainid, mut gas, mut state_gas)
        } else if env.kind == TX_SET_CODE {
            authorize<F>(mut tx, request, chain_id: block.chainid, mut gas, mut state_gas)
        } else {
            OK
        }
    }
    let call = CallEnv {
        address: target, caller: sender, origin: sender, callvalue: env.value,
        gasprice: price, gas_limit: gas, is_static: false,
    }
    let result = if prepared == OK {
        // The transaction's own message is a call or creation at depth zero.
        tracer.enter(CallStart { kind: if env.creates { 0xf0 } else { 0xf1 }, depth: 0, from: sender, to: target,
                                 value: env.value, gas: call.gas_limit }, input: request.data().bytes())
        let result = execute_message<F>(mut tx, request, call, block, state_gas, mut tracer)
        tracer.leave(CallEnd { depth: 0, status: result.status, gas: result.gas_remaining },
                     output: result.output.span())
        result
    } else if exceptional(prepared) {
        // A failed preparation undoes its state, so its state gas refills.
        state_gas = StateGas::new(reservoir)
        var result = status_result(prepared)
        result.reservoir = reservoir
        result
    } else {
        status_result(prepared)
    }
    if !is_evm_outcome(result.status) {
        return host_failure(mut tx, status: result.status)
    }
    // Exceptional halts and collisions consume all gas but the reservoir.
    let gas_left = if result.status == OK || result.status == ERR_REVERT { result.gas_remaining } else { 0 }
    let gas_spent = env.gas_limit - gas_left - result.reservoir
    // EIP-7623: a transaction uses at least its calldata floor.
    let refunded = gas_spent - tx.capped_refund(gas_spent)
    let floor: u64 = intrinsic.floor.downcast_unchecked()
    let gas_used = if refunded > floor { refunded } else { floor }
    // EIP-8037: the state gas the transaction used, which refunds can make
    // negative and the block counts as zero.
    let state_gas_used: u64 = if F::STATE_GAS {
        let used = (reservoir + result.spilled + state_gas.committed) as i128 - result.reservoir as i128
        if used > 0 { used.downcast_unchecked() } else { 0 }
    } else {
        0
    }
    // EIP-7778: from Amsterdam the block counts gas before refunds.
    let execution_gas_used = if !F::STATE_GAS { gas_used }
        else if gas_spent - state_gas_used > floor { gas_spent - state_gas_used }
        else { floor }
    var paid = tx.credit(address: sender, amount: (env.gas_limit - gas_used) as u256 * price)
    if paid == OK {
        let tip = if price > block.basefee { price - block.basefee } else { 0 }
        paid = tx.credit(address: address_word(block.coinbase), amount: gas_used as u256 * tip)
    }
    if paid != OK {
        return host_failure(mut tx, status: paid)
    }
    // Settlement's deletions bypass the journal, which undoes the rest.
    // Aborting discards the logs, which a simulation still reports.
    let logs = if commit {
        tx.settle<F>()
        if F::BLOCK_ACCESS_LIST { tx.record_changes() }
        tx.end(commit: true)
        tx.take_logs()
    } else {
        let logs = tx.take_logs()
        tx.end(commit: false)
        logs
    }
    Receipt {
        invalid: VALID, status: result.status, gas_used, cumulative_gas_used: gas_used,
        gas_refunded: if gas_spent > gas_used { gas_spent - gas_used } else { 0 },
        execution_gas_used, state_gas_used,
        created: if env.creates && result.status == OK { Option::Some(target) } else { Option::None },
        output: result.output, logs,
    }
}

/// A system call (EIP-4788): `data` to `target` from the system address,
/// run as a transaction's message is, with 30,000,000 gas that no one pays
/// for and, from EIP-8037, a state gas reservoir for 16 storage slots. It
/// starts with no account warm, or from Amsterdam with a transaction's
/// (`Rules::WARM_SYSTEM_CALLS`). A call that succeeds keeps its state
/// changes; its logs and refund are dropped. A target without code does
/// nothing and succeeds.
pub(ingot) fn system_call<F: Rules>(_ tx: mut Transaction, target: u256, _ data: own InputData, _ block: BlockEnv,
                                    _ config: Config) -> ExecutionResult {
    let target = address_word(target)
    if F::WARM_SYSTEM_CALLS {
        tx.begin(sender: SYSTEM_ADDRESS, destination: target, coinbase: block.coinbase, config)
    } else {
        tx.begin_cold(config)
    }
    let env = TxEnv {
        kind: TX_LEGACY, chain_id: Option::None, sender: SYSTEM_ADDRESS, to: target, creates: false, nonce: 0,
        gas_limit: SYSTEM_CALL_GAS, gas_price: block.basefee, max_priority_fee_per_gas: 0, max_fee_per_blob_gas: 0,
        value: 0,
    }
    let request = TxRequest::new(env, data)
    var gas = SYSTEM_CALL_GAS
    var state_gas = StateGas::new(if F::STATE_GAS { SYSTEM_CALL_SLOTS * STORAGE_SET } else { 0 })
    let prepared = if F::STATE_GAS {
        prepare_message<F>(mut tx, request, target, chain_id: block.chainid, mut gas, mut state_gas)
    } else {
        OK
    }
    let call = CallEnv {
        address: target, caller: SYSTEM_ADDRESS, origin: SYSTEM_ADDRESS, callvalue: 0,
        gasprice: block.basefee, gas_limit: gas, is_static: false,
    }
    var tracer = ()
    let result = if prepared == OK { execute_message<F>(mut tx, request, call, block, state_gas, mut tracer) }
        else { status_result(prepared) }
    if is_evm_outcome(result.status) {
        tx.settle<F>()
        if F::BLOCK_ACCESS_LIST { tx.record_changes() }
    }
    tx.end(commit: is_evm_outcome(result.status))
    let _ = tx.take_logs()
    result
}

/// A withdrawal (EIP-4895): `amount` gwei for `address`.
pub struct Withdrawal { pub address: u256, pub amount: u64 }

impl Copy for Withdrawal {}

/// Credits a block's withdrawals, together and outside any transaction. A
/// balance that would pass 2^256 is ERR_BALANCE_OVERFLOW and credits none.
pub(ingot) fn withdraw<F: Rules>(_ tx: mut Transaction, _ withdrawals: MemVec<Withdrawal>, _ config: Config) -> i32 {
    tx.begin_cold(config)
    var status = OK
    for withdrawal in withdrawals {
        if status == OK { status = tx.credit(address: withdrawal.address, amount: withdrawal.amount as u256 * 1_000_000_000) }
    }
    if status == OK {
        tx.settle<F>()
        if F::BLOCK_ACCESS_LIST { tx.record_changes() }
    }
    tx.end(commit: status == OK)
    status
}
