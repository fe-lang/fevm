use ingot::constants::{MAX_CODE, OK, RETURN_LIMIT}

// Code and its instruction-boundary analysis stay immutable together.
pub struct Program {
    bytes: [u8; MAX_CODE],
    len: usize,
    jumpdests: [u8; MAX_CODE / 8],
    pub status: i32,
}

impl Program {
    pub fn new(_ bytes: [u8; MAX_CODE], len: usize, status: i32) -> Self {
        core::assert(len <= MAX_CODE)
        let mut jumpdests: [u8; MAX_CODE / 8] = [0; MAX_CODE / 8]
        let mut pc: usize = 0
        while pc < len {
            let op = bytes[pc]
            if op == 0x5b {
                let bit: u8 = (pc % 8).downcast_unchecked()
                jumpdests[pc / 8] |= 1 << bit
            } else if op >= 0x60 && op <= 0x7f {
                pc += (op as usize) - 0x5f
            }
            pc += 1
        }
        Self { bytes: bytes, len: len, jumpdests: jumpdests, status: status }
    }

    pub fn len(self) -> usize { self.len }

    pub fn byte_at(self, _ index: usize) -> u8 { self.bytes[index] }

    pub fn is_jumpdest(self, _ destination: u256) -> bool {
        if destination >= self.len as u256 { return false }
        let pc: usize = destination.downcast_unchecked()
        let bit: u8 = (pc % 8).downcast_unchecked()
        self.jumpdests[pc / 8] & (1 << bit) != 0
    }
}

pub struct ByteBuffer { pub bytes: [u8; RETURN_LIMIT], pub len: usize, pub status: i32 }

pub struct CallEnv {
    pub address: u256,
    pub caller: u256,
    pub origin: u256,
    pub callvalue: u256,
    pub gasprice: u256,
    pub gas: u256,
}

pub struct BlockEnv {
    pub coinbase: u256,
    pub timestamp: u256,
    pub number: u256,
    pub prevrandao: u256,
    pub gaslimit: u256,
    pub chainid: u256,
    pub basefee: u256,
    pub blobbasefee: u256,
}

pub struct ExecutionResult {
    pub status: i32,
    pub output: ByteBuffer,
    pub output_valid: bool,
    pub stack_top: u256,
    pub stack_len: usize,
    pub unsupported_opcode: i32,
}

pub fn empty_bytes() -> ByteBuffer {
    ByteBuffer { bytes: [0; RETURN_LIMIT], len: 0, status: OK }
}

pub fn default_call_env() -> CallEnv {
    CallEnv { address: 0, caller: 0, origin: 0, callvalue: 0, gasprice: 0, gas: 0 }
}

pub fn default_block_env() -> BlockEnv {
    BlockEnv {
        coinbase: 0,
        timestamp: 0,
        number: 0,
        prevrandao: 0,
        gaslimit: 0,
        chainid: 0,
        basefee: 0,
        blobbasefee: 0,
    }
}
