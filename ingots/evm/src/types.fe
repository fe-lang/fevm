use std::native::ByteBuffer
use keccak::ByteSource
use ingot::constants::{ERR_HOST_ALLOCATION, OK}

// Code and its instruction-boundary analysis stay immutable together.
pub struct Program {
    bytes: ByteBuffer,
    jumpdests: ByteBuffer,
    pub status: i32,
}

impl Program {
    pub fn new(_ input: own InputData) -> Self {
        let mut status = input.status
        let len = input.len()
        let mut jumpdests = ByteBuffer::new()
        if status == OK {
            // ByteBuffer extents fit PTRDIFF_MAX, including room for rounding.
            if !jumpdests.try_resize((len + 7) / 8) {
                status = ERR_HOST_ALLOCATION
            } else {
                let mut pc: u64 = 0
                while pc < len {
                    let op = input.byte_at(pc)
                    if op == 0x5b {
                        let bit: u8 = (pc % 8).downcast_unchecked()
                        let old = jumpdests.byte_at(pc / 8)
                        jumpdests.set_byte(index: pc / 8, value: old | (1 << bit))
                    } else if op >= 0x60 && op <= 0x7f {
                        pc += (op as u64) - 0x5f
                    }
                    pc += 1
                }
            }
        }
        Self { bytes: input.bytes, jumpdests, status }
    }
    pub fn copy_from<T: ByteSource>(_ source: T, len: usize) -> Self {
        core::assert((len as u256) <= source.len() as u256)
        Self::new(InputData::copy_from(source, offset: 0, len: len.downcast_unchecked()))
    }
    pub fn len(self) -> usize {
        self.bytes.len().downcast_unchecked()
    }
    pub fn byte_at(self, _ index: usize) -> u8 {
        core::assert(index < self.len())
        self.bytes.byte_at(index.downcast_unchecked())
    }
    pub fn is_jumpdest(self, _ destination: u256) -> bool {
        if self.status != OK || destination >= self.bytes.len() as u256 {
            return false
        }
        let pc: u64 = destination.downcast_unchecked()
        let bit: u8 = (pc % 8).downcast_unchecked()
        self.jumpdests.byte_at(pc / 8) & (1 << bit) != 0
    }
    pub fn release(own self) {
        self.bytes.release()
        self.jumpdests.release()
    }
}

// Inputs own immutable bytes; constructing a frame never borrows a mutable
// account-code arena or the caller's expandable memory.
pub struct InputData { bytes: ByteBuffer, pub status: i32 }

impl InputData {
    pub fn new(_ bytes: own ByteBuffer, status: i32) -> Self { Self { bytes, status } }
    pub fn copy_from<T: ByteSource>(_ source: T, offset: u64, len: u64) -> Self {
        core::assert(offset <= source.len() && len <= source.len() - offset)
        let mut bytes = ByteBuffer::new()
        let mut status = OK
        if !bytes.try_resize(len) {
            status = ERR_HOST_ALLOCATION
        } else {
            let mut index: u64 = 0
            while index < len {
                bytes.set_byte(index, value: source.byte_at(offset + index))
                index += 1
            }
        }
        Self { bytes, status }
    }
    pub fn len(self) -> u64 { self.bytes.len() }
    pub fn byte_at(self, _ index: u64) -> u8 { self.bytes.byte_at(index) }
    pub fn release(own self) { self.bytes.release() }
}

impl ByteSource for InputData {
    fn len(self) -> u64 { self.bytes.len() }
    fn byte_at(self, _ index: u64) -> u8 { self.bytes.byte_at(index) }
}

pub struct CallEnv {
    pub address: u256,
    pub caller: u256,
    pub origin: u256,
    pub callvalue: u256,
    pub gasprice: u256,
    pub gas_limit: u64,
    pub is_static: bool,
}

impl Copy for CallEnv {}

pub struct BlockEnv {
    pub coinbase: u256,
    pub timestamp: u256,
    pub number: u256,
    pub prevrandao: u256,
    pub gaslimit: u256,
    pub chainid: u256,
    pub basefee: u256,
    pub blobbasefee: u256,
}

pub struct ExecutionResult {
    pub status: i32,
    pub output: ByteBuffer,
    pub gas_remaining: u64,
    pub refund_delta: i128,
    pub output_valid: bool,
    pub stack_top: u256,
    pub stack_len: usize,
    pub unsupported_opcode: i32,
}

pub fn empty_bytes() -> InputData {
    InputData::new(ByteBuffer::new(), status: OK)
}

pub fn default_call_env() -> CallEnv {
    CallEnv { address: 0, caller: 0, origin: 0, callvalue: 0, gasprice: 0, gas_limit: 1_000_000, is_static: false }
}

pub fn default_block_env() -> BlockEnv {
    BlockEnv {
        coinbase: 0,
        timestamp: 0,
        number: 0,
        prevrandao: 0,
        gaslimit: 0,
        chainid: 0,
        basefee: 0,
        blobbasefee: 0,
    }
}

impl ExecutionResult {
    pub fn release(own self) {
        self.output.release()
    }
}
