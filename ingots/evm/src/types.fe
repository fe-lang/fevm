use core::{MemBuffer, MemSpan, Option}
use keccak::ByteSource
use ingot::constants::{ERR_HOST_ALLOCATION, OK}

// Zero bytes after the code: execution that runs off the end reads STOP, and
// a PUSH32 at the last byte reads its zero-padded immediate in one word, so
// the dispatch loop checks neither against the code's length.
const CODE_PADDING: u64 = 33

// Code and its instruction-boundary analysis stay immutable together.
pub struct Program {
    bytes: MemBuffer,
    len: usize,
    jumpdests: MemBuffer,
    pub status: i32,
}

/// The bytes of the instruction-boundary JUMPDEST bitmap of `len` bytes of code.
pub fn jumpdest_map_len(_ len: u64) -> u64 {
    (len + 7) / 8
}

/// Sets the bit of each JUMPDEST of `code` at an instruction boundary in
/// `jumpdests`, a zeroed bitmap of `jumpdest_map_len(code.len())` bytes.
pub fn mark_jumpdests<T: ByteSource>(_ code: T, _ jumpdests: mut MemSpan) {
    let len = code.len()
    var pc: u64 = 0
    while pc < len {
        let op = code.byte_at(pc)
        if op == 0x5b {
            let bit: u8 = (pc % 8).downcast_unchecked()
            jumpdests[(pc / 8) as usize] |= 1 << bit
        } else if op >= 0x60 && op <= 0x7f {
            pc += (op as u64) - 0x5f
        }
        pc += 1
    }
}

impl Program {
    pub fn new(_ input: own InputData) -> Self {
        var status = input.status
        let len = input.len()
        var jumpdests = MemBuffer::empty()
        if status == OK {
            if !jumpdests.try_resize(jumpdest_map_len(len) as usize) {
                status = ERR_HOST_ALLOCATION
            } else {
                mark_jumpdests(input.bytes(), mut jumpdests.span())
            }
        }
        var bytes = input.bytes
        if status == OK && !bytes.try_resize((len + CODE_PADDING) as usize) {
            status = ERR_HOST_ALLOCATION
        }
        Self { bytes, len: len as usize, jumpdests, status }
    }
    pub fn copy_from<T: ByteSource>(_ source: T, len: usize) -> Self {
        core::assert((len as u256) <= source.len() as u256)
        Self::new(InputData::copy_from(source, offset: 0, len: len.downcast_unchecked()))
    }
    /// A copy of `code` whose `mark_jumpdests` bitmap is `jumpdests`.
    pub fn analyzed(_ code: MemSpan, jumpdests: MemSpan) -> Self {
        let len = code.len()
        var bytes = MemBuffer::empty()
        var map = MemBuffer::empty()
        // Reserving the padding first copies the code only once.
        if !bytes.try_reserve(len + CODE_PADDING as usize) || !map.try_reserve(jumpdests.len()) {
            return Self { bytes, len: 0, jumpdests: map, status: ERR_HOST_ALLOCATION }
        }
        bytes.extend_from(code)
        map.extend_from(jumpdests)
        core::assert(bytes.try_resize(len + CODE_PADDING as usize))
        Self { bytes, len, jumpdests: map, status: OK }
    }
    pub fn len(self) -> usize {
        self.len
    }
    pub fn byte_at(self, _ index: usize) -> u8 {
        self.bytes[index]
    }
    pub fn bytes(self) -> ref MemSpan {
        self.bytes.slice(offset: 0, len: self.len)
    }
    /// The code and the zero padding after it.
    pub fn padded(self) -> ref MemSpan {
        self.bytes.span()
    }
    pub fn is_jumpdest(self, _ destination: u256) -> bool {
        if self.status != OK || destination >= self.len as u256 {
            return false
        }
        let pc: usize = destination.downcast_unchecked()
        let bit: u8 = (pc % 8).downcast_unchecked()
        self.jumpdests[pc / 8] & (1 << bit) != 0
    }
}

// Inputs own immutable bytes; constructing a frame never borrows a mutable
// account-code arena or the caller's expandable memory.
pub struct InputData { bytes: MemBuffer, pub status: i32 }

impl InputData {
    pub fn new(_ bytes: own MemBuffer, status: i32) -> Self { Self { bytes, status } }
    pub fn copy_from<T: ByteSource>(_ source: T, offset: u64, len: u64) -> Self {
        core::assert(offset <= source.len() && len <= source.len() - offset)
        var bytes = MemBuffer::empty()
        if !bytes.try_resize(len as usize) {
            return Self { bytes, status: ERR_HOST_ALLOCATION }
        }
        var index: u64 = 0
        while index < len {
            bytes[index as usize] = source.byte_at(offset + index)
            index += 1
        }
        Self { bytes, status: OK }
    }
    // One bulk copy, such as call input from frame memory.
    pub fn copy_bytes(_ source: MemSpan) -> Self {
        match MemBuffer::try_from_span(source) {
            Option::Some(bytes) => Self { bytes, status: OK }
            Option::None => Self { bytes: MemBuffer::empty(), status: ERR_HOST_ALLOCATION }
        }
    }
    pub fn bytes(self) -> ref MemSpan { self.bytes.span() }
    pub fn len(self) -> u64 { self.bytes.len().downcast_unchecked() }
    pub fn byte_at(self, _ index: u64) -> u8 { self.bytes[index as usize] }
}

impl ByteSource for InputData {
    fn len(self) -> u64 { InputData::len(self) }
    fn byte_at(self, _ index: u64) -> u8 { InputData::byte_at(self, index) }
}

pub struct CallEnv {
    pub address: u256,
    pub caller: u256,
    pub origin: u256,
    pub callvalue: u256,
    pub gasprice: u256,
    pub gas_limit: u64,
    pub is_static: bool,
}

impl Copy for CallEnv {}

pub struct BlockEnv {
    pub coinbase: u256,
    pub timestamp: u256,
    pub number: u256,
    pub prevrandao: u256,
    pub gaslimit: u256,
    pub chainid: u256,
    pub basefee: u256,
    pub blobbasefee: u256,
}

pub struct ExecutionResult {
    pub status: i32,
    pub output: MemBuffer,
    pub gas_remaining: u64,
    pub refund_delta: i128,
    pub output_valid: bool,
    pub stack_top: u256,
    pub stack_len: usize,
    pub unsupported_opcode: i32,
}

pub fn empty_bytes() -> InputData {
    InputData::new(MemBuffer::empty(), status: OK)
}

pub fn default_call_env() -> CallEnv {
    CallEnv { address: 0, caller: 0, origin: 0, callvalue: 0, gasprice: 0, gas_limit: 1_000_000, is_static: false }
}

pub fn default_block_env() -> BlockEnv {
    BlockEnv {
        coinbase: 0,
        timestamp: 0,
        number: 0,
        prevrandao: 0,
        gaslimit: 0,
        chainid: 0,
        basefee: 0,
        blobbasefee: 0,
    }
}
