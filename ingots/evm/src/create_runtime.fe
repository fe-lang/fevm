use core::MemBuffer
use keccak::keccak256_word
use ingot::address::{create_address, create2_address}
use ingot::constants::{ERR_PRECOMPILE, OK}
use ingot::processor::{Applied, INVALID_NONCE, INVALID_TX_TYPE, TX_FEE_MARKET, TX_LEGACY, TxEnv, TxRequest, VALID, transact}
use ingot::state::WorldState
use ingot::transaction::Transaction
use ingot::types::{BlockEnv, InputData, Program, default_block_env, default_call_env, empty_bytes}
use ingot::vm::Vm

// MSTORE8(0, first); RETURN(0, 1): deploys the one-byte code `first`.
fn initcode(_ first: u8) -> [u8; 10] { [0x60, first, 0x60, 0, 0x53, 0x60, 1, 0x60, 0, 0xf3] }

// PUSH10 initcode; MSTORE at 0 (bytes 22..32); then `tail` creates from it.
fn creator<const N: usize>(_ init: [u8; 10], _ tail: [u8; N]) -> Program {
    let len: u64 = N.downcast_unchecked()
    var bytes = MemBuffer::empty()
    core::assert(bytes.try_resize((14 + len) as usize))
    bytes[0] = 0x69
    var i: u64 = 0
    while i < 10 {
        bytes[(1 + i) as usize] = init[i as usize]
        i += 1
    }
    bytes[11] = 0x60
    bytes[12] = 0
    bytes[13] = 0x52
    i = 0
    while i < len {
        bytes[(14 + i) as usize] = tail[i as usize]
        i += 1
    }
    Program::new(InputData::new(bytes, status: OK))
}

fn run_at(_ program: own Program, address: u256, _ tx: mut Transaction) -> Vm {
    var call = default_call_env()
    call.address = address
    call.gas_limit = 10_000_000
    var vm = Vm::new()
    vm.run(program, empty_bytes(), call, default_block_env(), mut tx)
    vm
}

#[test]
fn create_and_create2_deploy_code_endow_and_bump_nonces() {
    var world = WorldState::empty()
    core::assert(world.set_balance(0xaa, 100))
    var tx = Transaction::new(world, sender: 0, destination: 0xaa, coinbase: 0)
    // CREATE(value 7, offset 22, len 10); CREATE2(value 0, offset 22, len 10, salt 5).
    let vm = run_at(creator(initcode(0), [0x60, 10, 0x60, 22, 0x60, 7, 0xf0,
                                          0x60, 5, 0x60, 10, 0x60, 22, 0x60, 0, 0xf5]), address: 0xaa, mut tx)
    let first = create_address(sender: 0xaa, nonce: 0)
    let second = create2_address(sender: 0xaa, salt: 5, code_hash: keccak256_word(initcode(0)))
    core::assert(vm.status == OK && vm.stack.len() == 2 && vm.stack[0] == first && vm.stack[1] == second)
    core::assert(vm.return_data.len() == 0)
    core::assert(tx.nonce(0xaa) == 2 && tx.balance(0xaa) == 93)
    core::assert(tx.nonce(first) == 1 && tx.balance(first) == 7 && tx.code_size(first) == 1)
    core::assert(tx.nonce(second) == 1 && tx.code_size(second) == 1 && tx.code_byte(address: second, index: 0) == 0)
    core::assert(tx.was_created(first) && tx.account_is_warm(second))
    tx.finish(commit: true, gas_spent: 0)
}

#[test]
fn create_rejects_code_prefix_and_collisions() {
    var world = WorldState::empty()
    let target = create_address(sender: 0xaa, nonce: 0)
    core::assert(world.set_code(address: create_address(sender: 0xaa, nonce: 1), code: [0x00 as u8]) == OK)
    var tx = Transaction::new(world, sender: 0, destination: 0xaa, coinbase: 0)
    // The first creation deposits 0xEF code and fails; the second collides.
    let vm = run_at(creator(initcode(0xef), [0x60, 10, 0x60, 22, 0x5f, 0xf0,
                                             0x60, 10, 0x60, 22, 0x5f, 0xf0, 0x5a]), address: 0xaa, mut tx)
    core::assert(vm.status == OK && vm.stack.len() == 3 && vm.stack[0] == 0 && vm.stack[1] == 0)
    // Each failure consumed the 63/64 of the remaining gas it forwarded.
    core::assert(vm.stack[2] < 5000)
    core::assert(tx.nonce(0xaa) == 2 && !tx.exists(target) && tx.nonce(target) == 0)
    tx.finish(commit: true, gas_spent: 0)
}

#[test]
fn selfdestruct_moves_balance_and_deletes_only_new_accounts() {
    var world = WorldState::empty()
    core::assert(world.set_balance(0xbb, 50))
    core::assert(world.set_code(address: 0xbb, code: [0x60 as u8, 0xcc, 0xff]) == OK)
    core::assert(world.set_balance(0xaa, 100))
    var tx = Transaction::new(world, sender: 0, destination: 0xaa, coinbase: 0)
    let vm = run_at(Program::copy_from([0x60 as u8, 0xcc, 0xff], len: 3), address: 0xbb, mut tx)
    core::assert(vm.status == OK && tx.balance(0xcc) == 50 && tx.balance(0xbb) == 0)
    // Initcode PUSH1 0xdd SELFDESTRUCT, endowed with 7: the new account is doomed.
    let init: [u8; 10] = [0x60, 0xdd, 0xff, 0, 0, 0, 0, 0, 0, 0]
    let vm = run_at(creator(init, [0x60, 3, 0x60, 22, 0x60, 7, 0xf0]), address: 0xaa, mut tx)
    let created = create_address(sender: 0xaa, nonce: 0)
    core::assert(vm.status == OK && vm.stack[0] == created)
    core::assert(tx.balance(0xdd) == 7 && tx.balance(created) == 0 && tx.exists(created))
    tx.settle()
    core::assert(!tx.exists(created) && tx.code_size(0xbb) == 3 && tx.exists(0xbb))
    tx.finish(commit: true, gas_spent: 0)
}

#[test]
fn transact_charges_fees_and_rejects_bad_nonces() {
    var world = WorldState::empty()
    core::assert(world.set_balance(0x1000, 1_000_000_000_000))
    // SSTORE(0, 1).
    core::assert(world.set_code(address: 0xbb, code: [0x60 as u8, 1, 0x5f, 0x55]) == OK)
    var block = default_block_env()
    block.gaslimit = 30_000_000
    block.basefee = 7
    block.coinbase = 0xc0
    var env = TxEnv {
        kind: TX_FEE_MARKET, sender: 0x1000, to: 0xbb, creates: false, nonce: 0, gas_limit: 100_000,
        gas_price: 10, max_priority_fee_per_gas: 2, max_fee_per_blob_gas: 0, value: 5,
    }
    let request = TxRequest::new(env, data: empty_bytes())
    let applied = transact(world, request, block)
    // 21,000 intrinsic plus PUSH1, PUSH0 and a cold zero-to-nonzero SSTORE.
    let used: u64 = 21000 + 3 + 2 + 22100
    let receipt = applied.receipt
    core::assert(receipt.invalid == VALID && receipt.status == OK && receipt.gas_used == used)
    var state = applied.state
    core::assert(state.nonce(0x1000) == 1 && state.balance(0xbb) == 5 && state.storage_load(0xbb, 0) == 1)
    // The effective price is the base fee 7 plus the full priority fee 2.
    core::assert(state.balance(0x1000) == 1_000_000_000_000 - used as u256 * 9 - 5)
    core::assert(state.balance(0xc0) == used as u256 * 2)
    env.nonce = 0
    let replay = TxRequest::new(env, data: empty_bytes())
    let rejected = transact(state, replay, block)
    core::assert(rejected.receipt.invalid == INVALID_NONCE && rejected.state.nonce(0x1000) == 1)
}

#[test]
fn transact_calls_accounts_without_code_in_a_world_without_code() {
    // No account has code, so the code arena is empty.
    var world = WorldState::empty()
    core::assert(world.set_balance(0x1000, 1_000_000))
    var block = default_block_env()
    block.gaslimit = 30_000_000
    let env = TxEnv {
        kind: TX_FEE_MARKET, sender: 0x1000, to: 0xdd, creates: false, nonce: 0, gas_limit: 21_000,
        gas_price: 1, max_priority_fee_per_gas: 1, max_fee_per_blob_gas: 0, value: 5,
    }
    let request = TxRequest::new(env, data: empty_bytes())
    let applied = transact(world, request, block)
    core::assert(applied.receipt.invalid == VALID && applied.receipt.status == OK)
    core::assert(applied.receipt.gas_used == 21000 && applied.state.balance(0xdd) == 5)
    core::assert(applied.state.balance(0x1000) == 1_000_000 - 21000 - 5)
}

fn send(_ world: own WorldState, _ env: TxEnv, _ block: BlockEnv) -> Applied {
    transact(world, TxRequest::new(env, data: empty_bytes()), block)
}

#[test]
fn transact_rejects_blob_hashes_outside_blob_transactions() {
    var world = WorldState::empty()
    core::assert(world.set_balance(0x1000, 1_000_000_000_000))
    var block = default_block_env()
    block.gaslimit = 30_000_000
    let env = TxEnv {
        kind: TX_FEE_MARKET, sender: 0x1000, to: 0xbb, creates: false, nonce: 0, gas_limit: 100_000,
        gas_price: 10, max_priority_fee_per_gas: 2, max_fee_per_blob_gas: 0, value: 0,
    }
    var request = TxRequest::new(env, data: empty_bytes())
    core::assert(request.add_blob_hash((1 as u256) << 248))
    let rejected = transact(world, request, block)
    core::assert(rejected.receipt.invalid == INVALID_TX_TYPE)
    core::assert(rejected.state.balance(0x1000) == 1_000_000_000_000 && rejected.state.nonce(0x1000) == 0)
}

#[test]
fn transact_deletes_empty_call_targets_unless_the_call_fails() {
    var world = WorldState::empty()
    core::assert(world.set_balance(0x1000, 1_000_000_000_000))
    // Explicitly present empty accounts: two child call targets, a destination and a precompile.
    for address in [0xcc as u256, 0xdd, 0xee, 2] { core::assert(world.ensure_account(address)) }
    // CALL(gas, 0xcc, 0, 0, 0, 0, 0); STATICCALL(gas, 0xdd, 0, 0, 0, 0).
    let code = [0x5f as u8, 0x5f, 0x5f, 0x5f, 0x5f, 0x60, 0xcc, 0x5a, 0xf1, 0x5f, 0x5f, 0x5f, 0x5f, 0x60, 0xdd, 0x5a, 0xfa]
    core::assert(world.set_code(address: 0xaa, code) == OK)
    var block = default_block_env()
    block.gaslimit = 30_000_000
    var env = TxEnv {
        kind: TX_LEGACY, sender: 0x1000, to: 0xaa, creates: false, nonce: 0, gas_limit: 100_000,
        gas_price: 10, max_priority_fee_per_gas: 0, max_fee_per_blob_gas: 0, value: 0,
    }
    let called = send(world, env, block)
    core::assert(called.receipt.invalid == VALID && called.receipt.status == OK)
    let world = called.state
    core::assert(!world.exists(0xcc) && !world.exists(0xdd) && world.exists(0xaa))
    env.nonce = 1
    env.to = 0xee
    let reached = send(world, env, block)
    core::assert(reached.receipt.invalid == VALID && reached.receipt.status == OK)
    let world = reached.state
    core::assert(!world.exists(0xee))
    // SHA-256 needs 60 gas; its failure undoes the touch.
    env.nonce = 2
    env.to = 2
    env.gas_limit = 21_059
    let failed = send(world, env, block)
    core::assert(failed.receipt.invalid == VALID && failed.receipt.status == ERR_PRECOMPILE)
    core::assert(failed.state.exists(2) && failed.state.nonce(0x1000) == 3)
}

#[test]
fn transact_deletes_the_storage_of_empty_touched_accounts() {
    var world = WorldState::empty()
    core::assert(world.set_balance(0x1000, 1_000_000_000_000))
    // A storage-only coinbase is empty; a zero priority fee still touches it.
    core::assert(world.storage_store(0xc0, 0, 9))
    var block = default_block_env()
    block.gaslimit = 30_000_000
    block.basefee = 7
    block.coinbase = 0xc0
    let env = TxEnv {
        kind: TX_FEE_MARKET, sender: 0x1000, to: 0xbb, creates: false, nonce: 0, gas_limit: 100_000,
        gas_price: 7, max_priority_fee_per_gas: 2, max_fee_per_blob_gas: 0, value: 0,
    }
    let applied = send(world, env, block)
    core::assert(applied.receipt.invalid == VALID && applied.receipt.status == OK)
    var world = applied.state
    core::assert(!world.exists(0xc0) && !world.has_storage(0xc0))
    core::assert(world.set_balance(0xc0, 1) && world.storage_load(0xc0, 0) == 0)
}

#[test]
fn transact_grows_the_account_table_to_pay_the_coinbase() {
    var world = WorldState::empty()
    core::assert(world.set_balance(0x1000, 1_000_000_000_000))
    // Fill what was the fixed account table; the absent coinbase still receives its fee.
    var address: u256 = 0
    while address < 255 {
        core::assert(world.ensure_account(address))
        address += 1
    }
    var block = default_block_env()
    block.gaslimit = 30_000_000
    block.basefee = 7
    block.coinbase = 0x2000
    let env = TxEnv {
        kind: TX_FEE_MARKET, sender: 0x1000, to: 0xbb, creates: false, nonce: 0, gas_limit: 100_000,
        gas_price: 10, max_priority_fee_per_gas: 2, max_fee_per_blob_gas: 0, value: 0,
    }
    let applied = send(world, env, block)
    core::assert(applied.receipt.invalid == VALID && applied.receipt.status == OK && applied.receipt.gas_used == 21000)
    // The effective price is the base fee 7 plus the full priority fee 2.
    let world = applied.state
    core::assert(world.balance(0x1000) == 1_000_000_000_000 - 21000 * 9 && world.nonce(0x1000) == 1)
    core::assert(world.balance(0x2000) == 21000 * 2)
}
