use keccak::ByteSource
use ingot::constants::{ERR_HOST_ALLOCATION, OK}
use ingot::state::{EMPTY_CODE_HASH, WorldState}
use ingot::transaction::Transaction
use ingot::transaction_runtime::checkpoint

struct OversizedCode {}
impl ByteSource for OversizedCode {
    fn len(self) -> usize { 0xffffffffffffffff }
    fn byte_at(self, _ index: usize) -> u8 { core::panic() }
}

#[test]
fn account_code_replacement_compacts_and_preserves_other_accounts() {
    var world = WorldState::empty()
    core::assert(world.set_balance(11, 9))
    core::assert(world.set_nonce(11, 2))
    core::assert(world.set_code(address: 11, code: [97 as u8, 98, 99]) == OK)
    let abc = 0x4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45
    core::assert(world.code_hash(11) == abc)
    core::assert(world.set_code(address: 22, code: [1 as u8, 2, 3, 4]) == OK)
    core::assert(world.set_code(address: 33, code: [97 as u8, 98, 99]) == OK)
    // Replace the first, middle and last records, including shrink and removal.
    core::assert(world.set_code(address: 11, code: [8 as u8; 257]) == OK)
    core::assert(world.set_code(address: 33, code: [9 as u8]) == OK)
    core::assert(world.set_code(address: 22, code: [0 as u8; 0]) == OK)
    core::assert(world.exists(22) && world.code_size(22) == 0 && world.code_hash(22) == 0)
    core::assert(world.code_size(11) == 257 && world.code(11)[256] == 8)
    core::assert(world.code_size(33) == 1 && world.code(33)[0] == 9)
    let alias = ((1 as u256) << 255) | 11
    core::assert(world.set_code(address: alias, code: [97 as u8, 98, 99]) == OK)
    core::assert(world.code_hash(11) == abc && world.code_hash(alias) == abc)
    core::assert(world.balance(11) == 9 && world.nonce(11) == 2)
    core::assert(world.set_code(address: 11, code: OversizedCode {}) == ERR_HOST_ALLOCATION)
    core::assert(world.code_size(11) == 3 && world.code_hash(11) == abc)
    core::assert(world.code(33)[0] == 9)
    core::assert(world.set_code(address: 44, code: OversizedCode {}) == ERR_HOST_ALLOCATION)
    core::assert(!world.exists(44))
}

// The account program's code length and JUMPDEST bit mask.
fn jumpdests(_ world: WorldState, _ address: u256) -> (usize, u256) {
    let program = world.program(address)
    var mask: u256 = 0
    for pc in 0..program.len() {
        if program.is_jumpdest(pc as u256) { mask |= 1 << pc as u256 }
    }
    (program.len(), mask)
}

#[test]
fn account_code_jumpdests_follow_compaction() {
    var world = WorldState::empty()
    // PUSH1 hides the middle 0x5b; the first and last are JUMPDESTs.
    core::assert(world.set_code(address: 1, code: [0x5b as u8, 0x60, 0x5b, 0x5b]) == OK)
    core::assert(world.set_code(address: 2, code: [0 as u8, 0, 0, 0, 0, 0, 0, 0, 0x5b, 0x5b]) == OK)
    core::assert(jumpdests(world, 1) == (4, 0b1001))
    // Replacing the first record moves the second down, and the new record
    // lands on the second's old code bytes.
    core::assert(world.set_code(address: 1, code: [0x60 as u8]) == OK)
    core::assert(jumpdests(world, 1) == (1, 0) && jumpdests(world, 2) == (10, 0b11 << 8))
    core::assert(world.set_code(address: 2, code: [0 as u8; 0]) == OK)
    core::assert(jumpdests(world, 2) == (0, 0))
}

#[test]
fn account_empty_hash_predicate_and_code_extent_are_independent_of_frame_limits() {
    var world = WorldState::empty()
    core::assert(!world.exists(1) && world.code_hash(1) == 0)
    core::assert(world.ensure_account(1))
    core::assert(world.exists(1) && world.code_hash(1) == 0)
    core::assert(world.storage_store(1, 0, 7))
    core::assert(world.code_hash(1) == 0)
    core::assert(world.set_balance(1, 1))
    core::assert(world.code_hash(1) == EMPTY_CODE_HASH)
    core::assert(world.set_balance(1, 0) && world.set_nonce(1, 1))
    core::assert(world.code_hash(1) == EMPTY_CODE_HASH)
    // EIP-170's maximum deployed code size exceeds this harness's frame input.
    core::assert(world.set_code(address: 2, code: [0x5b as u8; 24576]) == OK)
    core::assert(world.code_size(2) == 24576 && world.code(2)[24575] == 0x5b)
    core::assert(world.code_hash(2) != 0 && world.code_hash(2) != EMPTY_CODE_HASH)
}

#[test]
fn account_creation_undo_distinguishes_empty_existing_and_absent_accounts() {
    var world = WorldState::empty()
    core::assert(world.ensure_account(1))
    core::assert(world.set_code(address: 4, code: [97 as u8, 98, 99]) == OK)
    var tx = Transaction::new(world, sender: 0, destination: 0, coinbase: 0)
    let parent = checkpoint(mut tx, is_static: false)
    core::assert(tx.set_balance(address: 1, value: 1) == OK)
    core::assert(tx.set_nonce(address: 2, value: 1) == OK)
    core::assert(tx.storage_store(address: 3, slot: 0, value: 1) == OK)
    core::assert(tx.exists(1) && tx.exists(2) && tx.exists(3))
    let child = checkpoint(mut tx, is_static: false)
    core::assert(tx.set_balance(address: 2, value: 7) == OK)
    core::assert(tx.set_nonce(address: 2, value: 0) == OK)
    core::assert(tx.set_balance(address: 4, value: 9) == OK)
    tx.commit(child)
    tx.revert(parent)
    core::assert(tx.exists(1) && !tx.exists(2) && !tx.exists(3))
    core::assert(tx.code_hash(1) == 0 && tx.code_size(4) == 3 && tx.balance(4) == 0)
    core::assert(tx.set_balance(address: 5, value: 0) == OK && !tx.exists(5))
    core::assert(tx.set_balance(address: 5, value: 1) == OK)
    let world = tx.finish(commit: false, gas_spent: 0).state
    core::assert(world.exists(1) && !world.exists(5) && world.code_size(4) == 3)
}

#[test]
fn accounts_grow_and_undo_removes_the_accounts_a_frame_created() {
    var world = WorldState::empty()
    var address: u256 = 0
    while address < 1000 {
        core::assert(world.ensure_account(address))
        address += 1
    }
    var tx = Transaction::new(world, sender: 0, destination: 0, coinbase: 0)
    let point = checkpoint(mut tx, is_static: false)
    core::assert(tx.set_balance(address: 1000, value: 1) == OK)
    core::assert(tx.set_nonce(address: 1001, value: 1) == OK)
    core::assert(tx.storage_store(address: 1002, slot: 0, value: 1) == OK)
    core::assert(tx.exists(1001) && tx.exists(1002))
    tx.revert(point)
    core::assert(!tx.exists(1000) && !tx.exists(1001) && !tx.exists(1002) && tx.exists(999))
    core::assert(tx.set_nonce(address: 1001, value: 1) == OK)
    var world = tx.finish(commit: true, gas_spent: 0).state
    core::assert(world.set_code(address: 1003, code: [1 as u8]) == OK)
    core::assert(world.exists(1003) && world.nonce(1001) == 1)
    core::assert(world.set_code(address: 0, code: [1 as u8]) == OK)
}
