use core::{MemBuffer, MemSpan, MemVec}
use ingot::state::address_word

// Copied header metadata. Payload bytes are read through their current owner.
pub struct LogEntry {
    pub address: u256,
    pub topics: [u256; 4],
    pub topic_count: u64,
    start: u64,
    len: u64,
}

impl Copy for LogEntry {}

impl LogEntry {
    pub fn len(self) -> u64 { self.len }
}

// Stored entries: topics live in their own buffer, so a log keeps only those
// it has.
struct Stored {
    address: u256,
    topic_start: u64,
    topic_count: u64,
    start: u64,
    len: u64,
}

impl Copy for Stored {}

// Entries, their topics and their payloads back to back: indexed reads and
// checkpoint truncation take constant time.
pub struct LogBuffer { entries: MemVec<Stored>, topics: MemVec<u256>, data: MemBuffer }

impl LogBuffer {
    pub fn new() -> Self {
        Self { entries: MemVec::new(), topics: MemVec::new(), data: MemBuffer::empty() }
    }
    pub fn len(self) -> u64 { self.entries.len().downcast_unchecked() }
    pub fn entry(self, _ index: u64) -> LogEntry {
        let stored = self.entries[index.downcast_truncate()]
        var topics: [u256; 4] = [0; 4]
        let first: usize = stored.topic_start.downcast_truncate()
        for topic in 0..stored.topic_count.downcast_truncate() {
            topics[topic] = self.topics[first + topic]
        }
        LogEntry { address: stored.address, topics, topic_count: stored.topic_count, start: stored.start, len: stored.len }
    }
    pub fn payload(self, _ entry: u64) -> ref MemSpan {
        let stored = self.entries[entry.downcast_truncate()]
        self.data.slice(offset: stored.start.downcast_truncate(), len: stored.len.downcast_truncate())
    }
    pub fn byte_at(self, entry: u64, index: u64) -> u8 {
        self.payload(entry)[index.downcast_truncate()]
    }
    pub fn append(mut self, address: u256, topics: [u256; 4], topic_count: u64, data: MemSpan) -> bool {
        let start = self.data.len()
        // Empty data, as LOG0 of nothing, reserves and copies nothing.
        if data.len() != 0 {
            if !self.data.try_reserve(data.len()) { return false }
            self.data.extend_from(data)
        }
        self.record(address, topics, topic_count, start)
    }
    /// As `append`, with the 32 big-endian bytes of `word` as the data.
    pub fn append_word(mut self, address: u256, topics: [u256; 4], topic_count: u64, word: u256) -> bool {
        let start = self.data.len()
        if !self.data.try_resize(start + 32) { return false }
        self.data.span().write_word(offset: start, value: word)
        self.record(address, topics, topic_count, start)
    }
    // Adds an entry whose data is `data` from `start` on, or drops those bytes
    // if the entry or its topics do not fit. Inline, so that LOG's topics stay
    // in place.
    #[inline(always)]
    fn record(mut self, _ address: u256, _ topics: [u256; 4], _ topic_count: u64, _ start: usize) -> bool {
        core::assert(topic_count <= 4)
        if !self.entries.try_reserve(1)
            || (topic_count != 0 && !self.topics.try_reserve(topic_count.downcast_truncate())) {
            self.data.truncate(start)
            return false
        }
        let topic_start: u64 = self.topics.len().downcast_unchecked()
        for topic in 0..topic_count.downcast_truncate() { self.topics.push(topics[topic]) }
        self.entries.push(Stored {
            address: address_word(address), topic_start, topic_count, start: start.downcast_unchecked(),
            len: (self.data.len() - start).downcast_unchecked(),
        })
        true
    }
    pub fn truncate(mut self, _ count: u64) {
        core::assert(count <= self.len())
        let (end, topic_end) = if count == 0 { (0, 0) } else {
            let last = self.entries[(count - 1).downcast_truncate()]
            (last.start + last.len, last.topic_start + last.topic_count)
        }
        self.data.truncate(end.downcast_truncate())
        self.topics.truncate(topic_end.downcast_truncate())
        self.entries.truncate(count.downcast_truncate())
    }
}
