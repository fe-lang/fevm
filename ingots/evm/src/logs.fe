use core::{MemBuffer, MemSpan, MemVec}
use ingot::state::address_word

// Copied header metadata. Payload bytes are read through their current owner.
pub struct LogEntry {
    pub address: u256,
    pub topics: [u256; 4],
    pub topic_count: u64,
    start: u64,
    len: u64,
}

impl Copy for LogEntry {}

impl LogEntry {
    pub fn len(self) -> u64 { self.len }
}

// Entries, and their payloads back to back: indexed reads and checkpoint
// truncation take constant time.
pub struct LogBuffer { entries: MemVec<LogEntry>, data: MemBuffer }

impl LogBuffer {
    pub fn new() -> Self {
        Self { entries: MemVec::new(), data: MemBuffer::empty() }
    }
    pub fn len(self) -> u64 { self.entries.len().downcast_unchecked() }
    pub fn entry(self, _ index: u64) -> LogEntry { self.entries[index as usize] }
    pub fn payload(self, _ entry: u64) -> ref MemSpan {
        let entry = self.entries[entry as usize]
        self.data.slice(offset: entry.start as usize, len: entry.len as usize)
    }
    pub fn byte_at(self, entry: u64, index: u64) -> u8 {
        self.payload(entry)[index as usize]
    }
    pub fn append(mut self, address: u256, topics: [u256; 4], topic_count: u64, data: MemSpan) -> bool {
        core::assert(topic_count <= 4)
        if !self.entries.try_reserve(1) || !self.data.try_reserve(data.len()) { return false }
        let start: u64 = self.data.len().downcast_unchecked()
        self.data.extend_from(data)
        var kept: [u256; 4] = [0; 4]
        for topic in 0..(topic_count as usize) {
            kept[topic] = topics[topic]
        }
        self.entries.push(LogEntry {
            address: address_word(address), topics: kept, topic_count, start, len: data.len().downcast_unchecked(),
        })
        true
    }
    pub fn truncate(mut self, _ count: u64) {
        core::assert(count <= self.len())
        let end = if count == 0 { 0 } else {
            let last = self.entries[(count - 1) as usize]
            last.start + last.len
        }
        self.data.truncate(end as usize)
        self.entries.truncate(count as usize)
    }
}
