use ingot::transaction::Transaction
use std::io::{Write, host, write, write_char, writeln}
use std::native::Args
use ingot::session::serve
use ingot::hex::{
    ERR_BAD_HEX,
    ERR_ODD_HEX,
    parse_hex_bytes,
    parse_hex_program,
    write_hex_bytes,
    write_hex_u256,
}
use ingot::state::WorldState
use ingot::status::{ERR_HOST_ALLOCATION, ERR_REVERT, OK, write_status_name}
use ingot::types::{default_block_env, default_call_env, empty_bytes}
use ingot::vm::{Vm, execute_vm}

const ERR_USAGE: i32 = 2

fn usage() -> i32 uses (w: mut Write) {
    writeln("usage: fevm <hex-bytecode> [hex-calldata] | fevm serve")
    ERR_USAGE
}

fn write_parse_error(_ status: i32) uses (w: mut Write) {
    match status {
        ERR_BAD_HEX => writeln("invalid hex bytecode"),
        ERR_ODD_HEX => writeln("hex bytecode has an odd number of digits"),
        ERR_HOST_ALLOCATION => writeln("host allocation failed"),
        _ => writeln("failed to parse bytecode"),
    }
}

fn write_vm_error(_ vm: Vm) uses (w: mut Write) {
    write_status_name(vm.status)
    if vm.status == ERR_REVERT {
        write(" ")
        write_hex_bytes(vm.output)
    } else {
        write_char(10)
    }
}

fn write_result(_ vm: Vm) uses (w: mut Write) {
    if vm.output_valid {
        write_hex_bytes(vm.output)
    } else if vm.stack.len() == 0 {
        writeln("empty")
    } else {
        write_hex_u256(vm.stack[vm.stack.len() - 1])
    }
}

pub fn run(_ args: Args) -> i32 {
    with (Write = host()) {
        if args.len() != 2 && args.len() != 3 {
            return usage()
        }
        let first = args.get(1)
        let serve_word: [u8; 5] = [0x73, 0x65, 0x72, 0x76, 0x65]
        var serving = args.len() == 2 && first.len() == 5
        for i in 0..5 {
            serving = serving && first.byte_at(i) == serve_word[i]
        }
        if serving {
            return serve()
        }

        let program = parse_hex_program(args.get(1))
        if program.status != OK {
            write_parse_error(program.status)
            return program.status
        }

        let calldata = if args.len() == 3 { parse_hex_bytes(args.get(2)) } else { empty_bytes() }
        if calldata.status != OK {
            write_parse_error(calldata.status)
            return calldata.status
        }

        var state = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
        let vm = execute_vm(
            program,
            calldata,
            default_call_env(),
            default_block_env(),
            mut state,
        )
        state.finish(commit: vm.status == OK, gas_spent: default_call_env().gas_limit - vm.gas_remaining)
        if vm.status != OK {
            write_vm_error(vm)
            return vm.status
        }

        write_result(vm)
        OK
    }
}
