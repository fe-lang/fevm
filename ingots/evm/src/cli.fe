use std::io::{Write, host, write, write_char, writeln}
use std::native::Args
use ingot::constants::{
    ERR_BAD_HEX,
    ERR_CODE_TOO_LONG,
    ERR_INVALID_JUMP,
    ERR_INVALID_OPCODE,
    ERR_MEMORY_LIMIT,
    ERR_ODD_HEX,
    ERR_RETURN_DATA_OOB,
    ERR_REVERT,
    ERR_STACK_OVERFLOW,
    ERR_STACK_UNDERFLOW,
    ERR_STATE_LIMIT,
    ERR_TODO_OPCODE,
    ERR_UNSUPPORTED_OPCODE,
    ERR_USAGE,
    OK,
}
use ingot::hex::{
    parse_hex_bytes,
    parse_hex_program,
    write_hex_byte,
    write_hex_bytes,
    write_hex_u256,
}
use ingot::opcodes::write_opcode_name
use ingot::state::WorldState
use ingot::types::{default_block_env, default_call_env, empty_bytes}
use ingot::vm::{Vm, execute_vm}

fn usage() -> i32 uses (w: mut Write) {
    writeln("usage: fevm <hex-bytecode> [hex-calldata]")
    ERR_USAGE
}

fn write_parse_error(_ status: i32) uses (w: mut Write) {
    match status {
        ERR_BAD_HEX => writeln("invalid hex bytecode"),
        ERR_ODD_HEX => writeln("hex bytecode has an odd number of digits"),
        ERR_CODE_TOO_LONG => writeln("bytecode is too large"),
        _ => writeln("failed to parse bytecode"),
    }
}

fn write_vm_error(_ vm: Vm) uses (w: mut Write) {
    match vm.status {
        ERR_STACK_UNDERFLOW => writeln("stack underflow"),
        ERR_STACK_OVERFLOW => writeln("stack overflow"),
        ERR_TODO_OPCODE => {
            write("todo opcode 0x")
            write_hex_byte(vm.unsupported_opcode)
            write(" ")
            write_opcode_name(vm.unsupported_opcode)
            write_char(10)
        },
        ERR_MEMORY_LIMIT => writeln("memory limit exceeded"),
        ERR_INVALID_JUMP => writeln("invalid jump destination"),
        ERR_INVALID_OPCODE => writeln("invalid opcode"),
        ERR_RETURN_DATA_OOB => writeln("return data out of bounds"),
        ERR_STATE_LIMIT => writeln("state table capacity exceeded"),
        ERR_REVERT => {
            write("revert ")
            write_hex_bytes(vm.output, vm.output_len)
        },
        ERR_UNSUPPORTED_OPCODE => {
            write("unsupported opcode 0x")
            write_hex_byte(vm.unsupported_opcode)
            write(" ")
            write_opcode_name(vm.unsupported_opcode)
            write_char(10)
        },
        _ => writeln("execution failed"),
    }
}

fn write_result(_ vm: Vm) uses (w: mut Write) {
    if vm.output_valid {
        write_hex_bytes(vm.output, vm.output_len)
    } else if vm.sp == 0 {
        writeln("empty")
    } else {
        write_hex_u256(vm.stack[vm.sp - 1])
    }
}

pub fn run(argc: i32, argv: **u8) -> i32 {
    let args = Args::new(argc, argv)
    with (Write = host()) {
        if args.len() != 2 && args.len() != 3 {
            return usage()
        }

        let program = parse_hex_program(args.get(1))
        if program.status != OK {
            write_parse_error(program.status)
            return program.status
        }

        let mut calldata = empty_bytes()
        if args.len() == 3 {
            calldata = parse_hex_bytes(args.get(2))
            if calldata.status != OK {
                write_parse_error(calldata.status)
                return calldata.status
            }
        }

        let mut state = WorldState::empty()
        let vm = execute_vm(
            program,
            calldata,
            default_call_env(),
            default_block_env(),
            mut state,
        )
        if vm.status != OK {
            write_vm_error(vm)
            return vm.status
        }

        write_result(vm)
        OK
    }
}
