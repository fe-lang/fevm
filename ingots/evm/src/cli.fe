use core::MemBuffer
use std::env::{Arg, Args}
use std::io::{Display, Stdin, Stdout}
use ingot::transaction::Transaction
use ingot::session::serve
use ingot::hex::{
    ERR_BAD_HEX,
    ERR_ODD_HEX,
    parse_hex_bytes,
    parse_hex_program,
    write_hex_bytes,
    write_hex_word,
}
use ingot::state::WorldState
use ingot::status::{ERR_HOST_ALLOCATION, ERR_REVERT, OK, status_name}
use ingot::types::{Config, default_block_env, default_call_env, empty_bytes}
use ingot::vm::{Buffers, Vm, execute_vm}

const ERR_USAGE: i32 = 2

fn write_parse_error(_ status: i32) uses (text: mut MemBuffer) {
    match status {
        ERR_BAD_HEX => "invalid hex bytecode\n".fmt(mut text),
        ERR_ODD_HEX => "hex bytecode has an odd number of digits\n".fmt(mut text),
        ERR_HOST_ALLOCATION => "host allocation failed\n".fmt(mut text),
        _ => "failed to parse bytecode\n".fmt(mut text),
    }
}

fn write_vm_error(_ vm: Vm) uses (text: mut MemBuffer) {
    status_name(vm.status).fmt(mut text)
    if vm.status == ERR_REVERT {
        " ".fmt(mut text)
        write_hex_bytes(vm.output.span())
    }
    "\n".fmt(mut text)
}

fn write_result(_ vm: Vm) uses (text: mut MemBuffer) {
    if vm.output_valid {
        write_hex_bytes(vm.output.span())
    } else if vm.stack.len() == 0 {
        "empty".fmt(mut text)
    } else {
        write_hex_word(vm.stack[vm.stack.len() - 1])
    }
    "\n".fmt(mut text)
}

fn is_serve(_ arg: Arg) -> bool {
    let bytes = arg.span()
    let serve_word: [u8; 5] = [0x73, 0x65, 0x72, 0x76, 0x65]
    var serving = bytes.len() == 5
    for i in 0..5 {
        serving = serving && bytes[i] == serve_word[i]
    }
    serving
}

pub fn run() -> i32 uses (args: Args, input: mut Stdin, out: mut Stdout) {
    if args.count() == 2 && is_serve(args.get(1)) {
        return serve()
    }
    var text = MemBuffer::empty()
    let status = with (mut text) { execute() }
    print!(text)
    status
}

// Runs the bytecode in the arguments and writes its result or error.
fn execute() -> i32 uses (args: Args, text: mut MemBuffer) {
    if args.count() != 2 && args.count() != 3 {
        "usage: fevm <hex-bytecode> [hex-calldata] | fevm serve\n".fmt(mut text)
        return ERR_USAGE
    }
    let program = parse_hex_program(args.get(1))
    if program.status != OK {
        write_parse_error(program.status)
        return program.status
    }

    let calldata = if args.count() == 3 { parse_hex_bytes(args.get(2)) } else { empty_bytes() }
    if calldata.status != OK {
        write_parse_error(calldata.status)
        return calldata.status
    }

    var state = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0,
                                 config: Config::osaka(), buffers: Buffers::new())
    let vm = execute_vm(
        program,
        calldata,
        default_call_env(),
        default_block_env(),
        mut state,
    )
    state.finish(commit: vm.status == OK, gas_spent: default_call_env().gas_limit - vm.gas_remaining)
    if vm.status != OK {
        write_vm_error(vm)
        return vm.status
    }

    write_result(vm)
    OK
}
