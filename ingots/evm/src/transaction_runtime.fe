use ingot::constants::{ERR_INVALID_OPCODE, ERR_OUT_OF_GAS, ERR_REVERT, ERR_STACK_UNDERFLOW, ERR_STATIC_WRITE, OK}
use ingot::state::WorldState
use ingot::transaction::{Checkpoint, Transaction}
use ingot::types::{Program, default_block_env, default_call_env, empty_bytes}
use ingot::vm::{Vm, execute}

pub fn program<const N: usize>(_ ops: [u8; N]) -> Program {
    Program::copy_from(ops, len: N)
}

pub fn checkpoint(_ transaction: mut Transaction, is_static: bool) -> Checkpoint {
    transaction.checkpoint(is_static)
}

#[test]
fn transaction_reverts_committed_children_and_restores_all_state_kinds() {
    var world = WorldState::empty()
    core::assert(world.set_balance(7, 10))
    core::assert(world.set_nonce(7, 2))
    core::assert(world.storage_store(7, 8, 11))
    var tx = Transaction::new(world, sender: 0, destination: 0, coinbase: 0)
    let parent = checkpoint(mut tx, is_static: false)
    core::assert(tx.set_balance(address: 7, value: 30) == OK)
    core::assert(tx.set_nonce(address: 7, value: 3) == OK)
    core::assert(tx.storage_store(address: 7, slot: 8, value: 0) == OK)
    core::assert(tx.transient_store(address: 7, slot: 8, value: 9) == OK)
    let child = checkpoint(mut tx, is_static: false)
    core::assert(tx.set_balance(address: 7, value: 0) == OK)
    core::assert(tx.storage_store(address: 7, slot: 8, value: 50) == OK)
    core::assert(tx.transient_store(address: 7, slot: 8, value: 0) == OK)
    tx.commit(child)
    core::assert(tx.balance(7) == 0 && tx.storage_load(address: 7, slot: 8) == 50)
    tx.revert(parent)
    core::assert(tx.balance(7) == 10 && tx.nonce(7) == 2)
    core::assert(tx.storage_load(address: 7, slot: 8) == 11)
    core::assert(tx.transient_load(address: 7, slot: 8) == 0)
    let world = tx.finish(commit: true, gas_spent: 0).state
    core::assert(world.storage_load(7, 8) == 11)
}

#[test]
fn transaction_child_revert_preserves_parent_and_transaction_abort_undoes_it() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let parent = checkpoint(mut tx, is_static: false)
    core::assert(tx.storage_store(address: 1, slot: 2, value: 3) == OK)
    core::assert(tx.transient_store(address: 1, slot: 2, value: 4) == OK)
    let child = checkpoint(mut tx, is_static: false)
    core::assert(tx.storage_store(address: 1, slot: 2, value: 5) == OK)
    core::assert(tx.transient_store(address: 1, slot: 2, value: 6) == OK)
    tx.revert(child)
    core::assert(tx.storage_load(address: 1, slot: 2) == 3)
    core::assert(tx.transient_load(address: 1, slot: 2) == 4)
    tx.commit(parent)
    let world = tx.finish(commit: false, gas_spent: 0).state
    core::assert(world.storage_load(1, 2) == 0)
}

#[test]
fn transaction_static_mode_is_inherited_and_restored() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let parent = checkpoint(mut tx, is_static: true)
    let child = checkpoint(mut tx, is_static: false)
    core::assert(tx.is_static())
    core::assert(tx.set_balance(address: 1, value: 2) == ERR_STATIC_WRITE)
    core::assert(tx.set_nonce(address: 1, value: 2) == ERR_STATIC_WRITE)
    core::assert(tx.storage_store(address: 1, slot: 2, value: 3) == ERR_STATIC_WRITE)
    core::assert(tx.transient_store(address: 1, slot: 2, value: 0) == ERR_STATIC_WRITE)
    tx.commit(child)
    core::assert(tx.is_static())
    tx.revert(parent)
    core::assert(!tx.is_static())
    core::assert(tx.storage_store(address: 1, slot: 2, value: 3) == OK)
    let world = tx.finish(commit: true, gas_spent: 0).state
    core::assert(world.storage_load(1, 2) == 3)
}

#[test]
fn transaction_undo_restores_tables_grown_past_their_first_capacity() {
    var world = WorldState::empty()
    var slot: u256 = 0
    while slot < 256 {
        core::assert(world.storage_store(1, slot, slot + 1))
        slot += 1
    }
    var tx = Transaction::new(world, sender: 0, destination: 0, coinbase: 0)
    let point = checkpoint(mut tx, is_static: false)
    core::assert(tx.storage_store(address: 1, slot: 0, value: 0) == OK)
    slot = 256
    while slot < 1000 {
        core::assert(tx.storage_store(address: 1, slot, value: 2) == OK)
        slot += 1
    }
    // Hundreds of updates to one slot must grow the journal, not impose a new
    // consensus instruction-count limit.
    var value: u256 = 3
    while value < 600 {
        core::assert(tx.storage_store(address: 1, slot: 256, value) == OK)
        value += 1
    }
    tx.revert(point)
    let world = tx.finish(commit: true, gas_spent: 0).state
    core::assert(world.storage_load(1, 0) == 1)
    core::assert(world.storage_load(1, 255) == 256)
    core::assert(world.storage_load(1, 256) == 0)
    core::assert(world.storage_load(1, 999) == 0)
}

#[test]
fn transaction_checkpoints_do_not_consume_evm_call_depth() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let parent = checkpoint(mut tx, is_static: false)
    var vm = Vm::new()
    vm.run(program([0x00]), empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(vm.status == OK && tx.depth() == 1)
    tx.commit(parent)
    tx.finish(commit: true, gas_spent: 0)
}

#[test]
fn vm_rollback_covers_revert_exceptional_and_operational_exits() {
    // Both persistent and transient writes precede each exit.
    for exit in [0xfd, 0xfe, 0x01] {
        var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
        // ADD has two operands here; use a second ADD to trigger underflow.
        let selected = if exit == 0x01 {
            program([0x60, 9, 0x5f, 0x55, 0x60, 8, 0x5f, 0x5d, 0x01])
        } else {
            program([0x60, 9, 0x5f, 0x55, 0x60, 8, 0x5f, 0x5d, 0x5f, 0x5f, exit])
        }
        let expected = match exit {
            0xfd => ERR_REVERT,
            0xfe => ERR_INVALID_OPCODE,
            _ => ERR_STACK_UNDERFLOW,
        }
        let result = execute(selected, empty_bytes(), default_call_env(), default_block_env(), mut tx)
        core::assert(result.status == expected && tx.depth() == 0)
        core::assert(tx.storage_load(address: 0, slot: 0) == 0)
        core::assert(tx.transient_load(address: 0, slot: 0) == 0)
        tx.finish(commit: true, gas_spent: 0)
    }
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    var call = default_call_env()
    call.gas_limit = 208
    let result = execute(
        program([0x60, 8, 0x5f, 0x5d, 0x60, 9, 0x5f, 0x5d]),
        empty_bytes(), call, default_block_env(), mut tx,
    )
    core::assert(result.status == ERR_OUT_OF_GAS && result.gas_remaining == 0)
    core::assert(tx.transient_load(address: 0, slot: 0) == 0)
    tx.finish(commit: true, gas_spent: 0)
}

#[test]
fn vm_transient_state_is_shared_by_frames_and_cleared_between_transactions() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let write = program([0x60, 9, 0x5f, 0x5d, 0x60, 7, 0x5f, 0x55])
    let read = program([0x5f, 0x5c])
    let result = execute(write, empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(result.status == OK)
    let result = execute(read, empty_bytes(), default_call_env(), default_block_env(), mut tx)
    core::assert(result.status == OK && result.stack_top == 9)
    let world = tx.finish(commit: true, gas_spent: 0).state
    core::assert(world.storage_load(0, 0) == 7)
    var next = Transaction::new(world, sender: 0, destination: 0, coinbase: 0)
    let result = execute(program([0x5f, 0x5c]), empty_bytes(), default_call_env(), default_block_env(), mut next)
    core::assert(result.status == OK && result.stack_top == 0)
    next.finish(commit: true, gas_spent: 0)
}

#[test]
fn vm_static_storage_writes_fault_but_reads_are_allowed() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    var call = default_call_env()
    call.is_static = true
    for op in [0x55, 0x5d] {
        let result = execute(program([0x60, 9, 0x5f, op]), empty_bytes(), call, default_block_env(), mut tx)
        core::assert(result.status == ERR_STATIC_WRITE && result.gas_remaining == 0)
        core::assert(!tx.is_static() && tx.depth() == 0)
    }
    let result = execute(program([0x5f, 0x54, 0x5f, 0x5c]), empty_bytes(), call, default_block_env(), mut tx)
    core::assert(result.status == OK && result.stack_top == 0)
    tx.finish(commit: true, gas_spent: 0)
}
