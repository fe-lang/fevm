use core::{MemSpan, MemVec, Option}
use ingot::logs::LogBuffer
use ingot::constants::MAX_U256
use ingot::status::{ERR_BALANCE_OVERFLOW, ERR_HOST_ALLOCATION, ERR_STATIC_WRITE, OK}
use ingot::journal::Change
use ingot::state::{Charged, Replaced, Sender, StorageKey, WorldState, address_word, designator}
use ingot::types::{Config, Program}
use ingot::gas::{StorageCharge, storage_charge}
use ingot::vm::Buffers
use fevm_precompiles::is_precompile

const BALANCE: u8 = 0
const NONCE: u8 = 1
const STORAGE: u8 = 2
const TRANSIENT: u8 = 3
const WARM_ACCOUNT: u8 = 4
const WARM_STORAGE: u8 = 5
const CODE: u8 = 6
const TOUCHED: u8 = 7
const DOOMED: u8 = 8
// An EIP-7702 delegation: `slot` is 1 when the code was a designator to `previous`.
const DELEGATION: u8 = 9
// A touch without a mark, for touches gas bounds to a few per transaction:
// writes that leave their value, and the transaction's own call. Undo has
// nothing to restore.
const TOUCHED_ONCE: u8 = 10
// The transaction's nonce increment and gas purchase: `slot` is the
// sender's previous nonce and `previous` its previous balance.
const SENDER: u8 = 11
// A new contract's first nonce and endowment: `slot` is its account's
// position and `previous` its previous balance. Its nonce was zero.
const CONTRACT: u8 = 12

// An address's marks, the bits of its `marks` entry. Undo clears the warm,
// touched and doomed marks a frame set; creation marks survive rollback.
const MARK_WARM: u8 = 1
const MARK_TOUCHED: u8 = 2
const MARK_CREATED: u8 = 4
const MARK_DOOMED: u8 = 8

// A checkpoint must be closed once, in reverse opening order. Committing a
// child retains its undo entries so a later parent revert still undoes it.
// `transient_empty`: no transient storage was set, so undoing to the
// checkpoint empties it whole instead of entry by entry.
pub struct Checkpoint { position: u64, depth: usize, was_static: bool, refund: i128, logs: u64, transient_empty: bool }

pub struct TransactionResult {
    pub state: WorldState,
    pub logs: LogBuffer,
    // Gas charged after the transaction refund cap; refunds never refill a frame.
    pub gas_used: u64,
    pub gas_refunded: u64,
    // The buffers the transaction was lent, for the next.
    pub buffers: Buffers,
}

// The persistent database is unavailable to callers until finish consumes the
// transaction. Every write during execution must therefore pass the journal.
pub struct Transaction {
    state: WorldState,
    logs: LogBuffer,
    blob_hashes: MemVec<u256>,
    // The sender, destination and coinbase, warm from the start (EIP-2929,
    // EIP-3651).
    endpoints: [u256; 3],
    refund: i128,
    started: bool,
    depth: usize,
    is_static: bool,
    config: Config,
    // Lent by the caller for the journal, the transaction's frames and its
    // tables (see `Buffers`).
    buffers: Buffers,
}

impl Transaction {
    /// A transaction on `state` from `sender` to `destination` (the created
    /// address for a creation), with `buffers` lent until `finish` returns
    /// them.
    pub fn new(_ state: own WorldState, sender: u256, destination: u256, coinbase: u256, config: Config,
               buffers: own Buffers) -> Self {
        core::assert(buffers.journal.len() == 0)
        Self {
            state,
            logs: LogBuffer::new(),
            blob_hashes: MemVec::new(),
            endpoints: [address_word(sender), address_word(destination), address_word(coinbase)],
            refund: 0,
            started: false,
            depth: 0,
            is_static: false,
            config,
            buffers,
        }
    }

    /// Starts the next transaction on the same state and buffers, as `new`
    /// does, after `end` closed the last one.
    pub fn begin(mut self, sender: u256, destination: u256, coinbase: u256, config: Config) {
        core::assert(self.depth == 0 && self.buffers.journal.len() == 0)
        self.endpoints = [address_word(sender), address_word(destination), address_word(coinbase)]
        self.refund = 0
        self.started = false
        self.is_static = false
        self.config = config
        self.blob_hashes.clear()
    }

    /// Replaces the state, between transactions, dropping the old one.
    pub fn load(mut self, _ state: own WorldState) {
        core::assert(self.depth == 0 && self.buffers.journal.len() == 0)
        self.state = state
    }

    /// The state, between transactions.
    pub fn world(self) -> ref WorldState { ref self.state }

    pub fn config(self) -> Config { self.config }

    pub fn buffers(mut self) -> mut Buffers { mut self.buffers }

    pub fn logs(self) -> ref LogBuffer { ref self.logs }
    pub fn take_logs(mut self) -> LogBuffer { core::mem::replace(mut self.logs, LogBuffer::new()) }

    pub fn emit_log(mut self, address: u256, topics: [u256; 4], topic_count: u64, data: MemSpan) -> i32 {
        self.started = true
        if self.is_static { return ERR_STATIC_WRITE }
        if self.logs.append(address, topics, topic_count, data) { OK }
        else { ERR_HOST_ALLOCATION }
    }

    pub fn add_blob_hash(mut self, _ hash: u256) -> bool {
        core::assert(!self.started)
        self.blob_hashes.try_push(hash).is_ok()
    }
    pub fn blob_hash(self, _ index: u256) -> u256 {
        if index >= self.blob_hashes.len() as u256 { return 0 }
        self.blob_hashes[index.downcast_unchecked()]
    }
    // The blob hashes, for the VM's BLOBHASH handler; fixed once the transaction starts.
    pub(ingot) fn blob_hash_ptr(self) -> *u256 { self.blob_hashes.ptr() }
    pub(ingot) fn blob_count(self) -> usize { self.blob_hashes.len() }

    pub fn refund(self) -> i128 { self.refund }
    pub fn add_refund(mut self, _ amount: i128) { self.refund += amount }

    // EIP-3529: positive refunds are capped at one fifth of the gas spent.
    pub fn capped_refund(self, gas_spent: u64) -> u64 {
        if self.refund <= 0 { return 0 }
        let cap = (gas_spent / 5) as i128
        (if self.refund < cap { self.refund } else { cap }).downcast_unchecked()
    }

    // Access-list initialization precedes all frames and is never rolled back.
    pub fn access_list_account(mut self, address: u256) -> bool {
        core::assert(!self.started)
        self.add_mark(address_word(address), MARK_WARM)
    }

    pub fn access_list_slot(mut self, address: u256, slot: u256) -> bool {
        core::assert(!self.started)
        let address = address_word(address)
        let was_warm = self.marked(address, MARK_WARM)
        if !self.add_mark(address, MARK_WARM) { return false }
        if !self.buffers.warm_storage.try_insert(StorageKey { address, slot }, true) {
            if !was_warm { core::assert(self.unmark(address, MARK_WARM)) }
            return false
        }
        true
    }

    pub fn account_is_warm(self, _ address: u256) -> bool {
        let address = address_word(address)
        self.always_warm(address) || self.marked(address, MARK_WARM)
    }

    // Whether `address`, an address word, is warm without a mark: a
    // precompile, or the sender, destination or coinbase.
    fn always_warm(self, _ address: u256) -> bool {
        is_precompile(address) || address == self.endpoints[0] || address == self.endpoints[1]
            || address == self.endpoints[2]
    }

    // Whether `address`, an address word, has `mark`.
    fn marked(self, _ address: u256, _ mark: u8) -> bool {
        self.buffers.marks.get(address).value & mark != 0
    }

    // Adds `mark` to `address`'s marks, unjournaled; false, changing nothing,
    // if the table cannot grow.
    fn add_mark(mut self, _ address: u256, _ mark: u8) -> bool {
        let Option::Some(slot) = self.buffers.marks.try_find_or_insert(address) else { return false }
        let marks = mut self.buffers.marks.value_at(slot)
        marks |= mark
        true
    }

    // Clears `mark` from `address`'s marks, which it has an entry for; an
    // address left without marks loses its entry. Neither grows the table.
    fn unmark(mut self, _ address: u256, _ mark: u8) -> bool {
        let Option::Some(slot) = self.buffers.marks.find(address) else { return false }
        let marks = mut self.buffers.marks.value_at(slot)
        marks &= ~mark
        marks != 0 || self.buffers.marks.remove(address)
    }

    pub fn storage_is_warm(self, address: u256, slot: u256) -> bool {
        self.buffers.warm_storage.contains(StorageKey { address: address_word(address), slot })
    }

    // Adds the warm, touched or doomed mark of `kind` to `address`, journaled
    // if new; a journal that cannot grow restores the marks.
    fn mark(mut self, kind: u8, address: u256) -> i32 {
        self.started = true
        let address = address_word(address)
        if kind == WARM_ACCOUNT && self.always_warm(address) { return OK }
        let mark = mark_of(kind)
        // A new address gets an entry without marks first.
        let Option::Some(slot) = self.buffers.marks.try_find_or_insert(address) else { return ERR_HOST_ALLOCATION }
        let marks = mut self.buffers.marks.value_at(slot)
        if marks & mark != 0 { return OK }
        marks |= mark
        if !self.buffers.journal.record(kind, address, slot: 0, previous: 0, existed: true) {
            core::assert(self.unmark(address, mark))
            return ERR_HOST_ALLOCATION
        }
        OK
    }

    pub fn warm_account(mut self, address: u256) -> i32 {
        self.mark(kind: WARM_ACCOUNT, address)
    }

    // Inserts first, with one lookup, and journals only a new slot; a journal
    // that cannot grow removes it again.
    pub fn warm_slot(mut self, address: u256, slot: u256) -> i32 {
        self.started = true
        let key = StorageKey { address: address_word(address), slot }
        let before = self.buffers.warm_storage.len()
        if !self.buffers.warm_storage.try_insert(key, true) { return ERR_HOST_ALLOCATION }
        if self.buffers.warm_storage.len() == before { return OK }
        if !self.buffers.journal.record(kind: WARM_STORAGE, address: key.address, slot, previous: 0, existed: true) {
            let _ = self.buffers.warm_storage.remove(key)
            return ERR_HOST_ALLOCATION
        }
        OK
    }

    pub fn touch(mut self, _ address: u256) -> i32 {
        self.mark(kind: TOUCHED, address)
    }

    /// Touches `address` with a journal entry and no mark, which repeated
    /// touches of one address would each add: for the transaction's own call.
    pub fn touch_once(mut self, _ address: u256) -> i32 {
        self.started = true
        let change = Change { kind: TOUCHED_ONCE, address: address_word(address), slot: 0, previous: 0, existed: true }
        if self.buffers.journal.append(change) { OK } else { ERR_HOST_ALLOCATION }
    }

    // SELFDESTRUCT of an account created by this transaction (EIP-6780).
    pub fn doom(mut self, _ address: u256) -> i32 {
        self.mark(kind: DOOMED, address)
    }

    pub fn mark_created(mut self, _ address: u256) -> i32 {
        if self.add_mark(address_word(address), MARK_CREATED) { OK } else { ERR_HOST_ALLOCATION }
    }

    pub fn was_created(self, _ address: u256) -> bool {
        self.marked(address_word(address), MARK_CREATED)
    }

    pub fn original_storage(self, address: u256, slot: u256) -> u256 {
        let original = self.buffers.originals.get(StorageKey { address: address_word(address), slot })
        if original.found { original.value } else { self.storage_load(address, slot) }
    }

    pub fn storage_charge(self, address: u256, slot: u256, value: u256) -> StorageCharge {
        storage_charge(
            original: self.original_storage(address, slot),
            current: self.storage_load(address, slot), value,
            cold: !self.storage_is_warm(address, slot),
        )
    }

    pub fn is_static(self) -> bool { self.is_static }
    pub fn depth(self) -> usize { self.depth }

    // Administrative checkpoints do not count toward EVM call depth.
    pub fn checkpoint(mut self, is_static: bool) -> Checkpoint {
        self.started = true
        self.depth += 1
        let checkpoint = Checkpoint {
            position: self.buffers.journal.len(), depth: self.depth, was_static: self.is_static, refund: self.refund, logs: self.logs.len(),
            transient_empty: self.buffers.transient.is_empty(),
        }
        self.is_static = self.is_static || is_static
        checkpoint
    }

    pub fn commit(mut self, _ checkpoint: own Checkpoint) {
        core::assert(self.depth == checkpoint.depth)
        self.depth -= 1
        self.is_static = checkpoint.was_static
    }

    pub fn revert(mut self, _ checkpoint: own Checkpoint) {
        core::assert(self.depth == checkpoint.depth)
        self.undo_to(checkpoint.position, transient: !checkpoint.transient_empty)
        if checkpoint.transient_empty {
            self.buffers.transient.clear()
        }
        self.logs.truncate(checkpoint.logs)
        self.refund = checkpoint.refund
        self.depth -= 1
        self.is_static = checkpoint.was_static
    }

    // Undoes journal entries past `position`, but for transient storage's
    // unless `transient`.
    fn undo_to(mut self, _ position: u64, transient: bool) {
        while self.buffers.journal.len() > position {
            let change = self.buffers.journal.pop()
            // A balance or nonce change that created its account also
            // removes it.
            let restored = match change.kind {
                BALANCE => self.state.restore_at(balance: true, change.address, position: change.slot.downcast_truncate(),
                                                 value: change.previous, existed: change.existed),
                NONCE => self.state.restore_at(balance: false, change.address, position: change.slot.downcast_truncate(),
                                               value: change.previous, existed: change.existed),
                CONTRACT => self.state.restore_at(balance: false, change.address,
                                                  position: change.slot.downcast_truncate(), value: 0, existed: true)
                    && self.state.restore_at(balance: true, change.address, position: change.slot.downcast_truncate(),
                                             value: change.previous, existed: change.existed),
                SENDER => self.state.set_nonce(change.address, change.slot)
                    && self.state.restore(balance: true, change.address, value: change.previous,
                                          existed: change.existed),
                STORAGE => self.state.storage_store(change.address, change.slot, change.previous),
                TRANSIENT => !transient || self.write_transient(change.address, change.slot, change.previous),
                WARM_ACCOUNT | TOUCHED | DOOMED => self.unmark(change.address, mark_of(change.kind)),
                WARM_STORAGE => self.buffers.warm_storage.remove(StorageKey { address: change.address, slot: change.slot }),
                CODE => {
                    let empty: [u8; 0] = []
                    self.state.set_code(address: change.address, code: empty) == OK
                },
                DELEGATION => if change.slot == 1 {
                    self.state.set_code_unhashed(address: change.address, code: designator(change.previous)) == OK
                } else {
                    let empty: [u8; 0] = []
                    self.state.set_code(address: change.address, code: empty) == OK
                },
                TOUCHED_ONCE => true,
                _ => core::panic(),
            }
            // Reverse replay restores entries the tables held before. A table
            // that cannot allocate to hold one again is a fatal host failure.
            core::assert(restored)
            let account_write = change.kind == STORAGE || change.kind == CODE || change.kind == DELEGATION
            if !change.existed && account_write {
                core::assert(self.state.remove_empty_account(change.address))
            }
        }
    }

    pub fn exists(self, _ address: u256) -> bool { self.state.exists(address) }
    pub fn is_empty(self, _ address: u256) -> bool { self.state.is_empty(address) }
    // EIP-684/EIP-7610: creation needs an address without nonce, code or storage.
    pub fn deployable(self, _ address: u256) -> bool { self.state.deployable(address) }
    pub fn sender(self, _ address: u256) -> Sender { self.state.sender(address) }
    pub fn code_size(self, _ address: u256) -> usize { self.state.code_size(address) }
    pub fn code_hash(mut self, _ address: u256) -> u256 { self.state.code_hash(address) }
    pub fn code(self, _ address: u256) -> ref MemSpan { self.state.code(address) }
    pub fn delegate(self, _ address: u256) -> Option<u256> { self.state.delegate(address) }
    pub fn program(self, _ address: u256) -> Program { self.state.program(address) }
    pub fn balance(self, _ address: u256) -> u256 { self.state.balance(address) }
    pub fn nonce(self, _ address: u256) -> u256 { self.state.nonce(address) }
    pub fn storage_load(self, address: u256, slot: u256) -> u256 {
        self.state.storage_load(address, slot)
    }
    pub fn transient_load(self, address: u256, slot: u256) -> u256 {
        self.buffers.transient.get(StorageKey { address: address_word(address), slot }).value
    }
    pub fn block_hash(self, _ number: u256) -> u256 { self.state.block_hash(number) }

    fn write_transient(mut self, _ address: u256, _ slot: u256, _ value: u256) -> bool {
        let key = StorageKey { address, slot }
        if value == 0 {
            let _ = self.buffers.transient.remove(key)
            return true
        }
        self.buffers.transient.try_insert(key, value)
    }

    fn write(mut self, kind: u8, address: u256, slot: u256, value: u256) -> i32 {
        self.started = true
        if self.is_static { return ERR_STATIC_WRITE }
        let address = address_word(address)
        if kind == BALANCE || kind == NONCE {
            return self.journal_account(kind, address, self.state.replace(balance: kind == BALANCE, address, value))
        }
        core::assert(kind == STORAGE)
        let previous = self.storage_load(address, slot)
        if previous == value { return OK }
        // Undo deletes an account its write created.
        let existed = self.state.exists(address)
        if !self.buffers.journal.record(kind, address, slot, previous, existed) {
            return ERR_HOST_ALLOCATION
        }
        if !self.state.storage_store(address, slot, value) {
            let _ = self.buffers.journal.pop()
            return ERR_HOST_ALLOCATION
        }
        OK
    }

    // Journals a balance or nonce write the world already made, which touches
    // the account; a journal that cannot grow restores the previous value. An
    // unchanged value still touches it.
    fn journal_account(mut self, kind: u8, address: u256, _ replaced: Replaced) -> i32 {
        if !replaced.written { return ERR_HOST_ALLOCATION }
        if !replaced.changed { return self.touch_once(address) }
        // A balance or nonce record keeps the account's position for `undo_to`.
        if !self.buffers.journal.record(kind, address, slot: replaced.position as u256, previous: replaced.previous,
                                        existed: replaced.found) {
            // Restoring a value the record holds needs no allocation.
            core::assert(self.state.replace(balance: kind != NONCE, address, value: replaced.previous).written)
            if kind == CONTRACT { core::assert(self.state.replace(balance: false, address, value: 0).written) }
            if !replaced.found { core::assert(self.state.remove_empty_account(address)) }
            return ERR_HOST_ALLOCATION
        }
        OK
    }

    // Adds `amount` to a balance or nonce, or subtracts it, touching the
    // account, with one account lookup. A transaction runs it a few times in
    // different places, so it stays one copy.
    #[inline(never)]
    fn adjust(mut self, kind: u8, address: u256, amount: u256, add: bool) -> i32 {
        self.started = true
        if self.is_static { return ERR_STATIC_WRITE }
        // Zero changes nothing and only touches the account: a value-free
        // transfer's debit and credit need no lookup.
        if amount == 0 { return self.touch_once(address) }
        let address = address_word(address)
        let replaced = self.state.adjust(balance: kind == BALANCE, address, amount, add)
        if replaced.overflowed { return ERR_BALANCE_OVERFLOW }
        self.journal_account(kind, address, replaced)
    }

    // Balance, nonce and code writes touch their account even when unchanged.
    pub fn set_balance(mut self, address: u256, value: u256) -> i32 {
        self.write(kind: BALANCE, address, slot: 0, value)
    }
    pub fn set_nonce(mut self, address: u256, value: u256) -> i32 {
        self.write(kind: NONCE, address, slot: 0, value)
    }
    /// Sets a new contract's nonce to one and credits it `value`, with one
    /// lookup and one journal entry; one past 2^256 is ERR_BALANCE_OVERFLOW
    /// and changes nothing.
    pub fn endow(mut self, address: u256, value: u256) -> i32 {
        self.started = true
        if self.is_static { return ERR_STATIC_WRITE }
        let address = address_word(address)
        let replaced = self.state.endow(address, amount: value)
        if replaced.overflowed { return ERR_BALANCE_OVERFLOW }
        self.journal_account(kind: CONTRACT, address, replaced)
    }
    pub fn increment_nonce(mut self, _ address: u256) -> i32 {
        self.adjust(kind: NONCE, address, amount: 1, add: true)
    }
    /// Increments the sender's nonce and subtracts `fee`, which its balance
    /// must hold, with one lookup and one journal entry: the transaction's
    /// nonce increment and gas purchase. A nonce of 2^256 - 1 is
    /// ERR_BALANCE_OVERFLOW and changes nothing.
    pub fn charge(mut self, _ sender: u256, fee: u256) -> i32 {
        self.started = true
        if self.is_static { return ERR_STATIC_WRITE }
        let address = address_word(sender)
        let charged: Charged = self.state.charge(address, fee)
        if !charged.written { return ERR_HOST_ALLOCATION }
        if charged.nonce == MAX_U256 { return ERR_BALANCE_OVERFLOW }
        let change = Change { kind: SENDER, address, slot: charged.nonce, previous: charged.balance, existed: charged.found }
        if !self.buffers.journal.append(change) {
            // Restoring values the record holds needs no allocation.
            core::assert(self.state.set_nonce(address, charged.nonce))
            core::assert(self.state.set_balance(address, charged.balance))
            if !charged.found { core::assert(self.state.remove_empty_account(address)) }
            return ERR_HOST_ALLOCATION
        }
        OK
    }
    /// Adds `amount` to the balance, touching the account; one past 2^256 is
    /// ERR_BALANCE_OVERFLOW and changes no balance.
    pub fn credit(mut self, address: u256, amount: u256) -> i32 {
        self.adjust(kind: BALANCE, address, amount, add: true)
    }
    /// Subtracts `amount`, which the balance must hold, touching the account.
    pub fn debit(mut self, address: u256, amount: u256) -> i32 {
        self.adjust(kind: BALANCE, address, amount, add: false)
    }
    // Contract deployment writes code to an account that has none (EIP-684).
    pub fn deploy_code(mut self, address: u256, code: MemSpan) -> i32 {
        self.started = true
        if self.is_static { return ERR_STATIC_WRITE }
        // Empty code leaves the account as it is, with nothing to undo.
        if code.len() == 0 { return OK }
        let address = address_word(address)
        let existing = self.state.existing_code_len(address)
        core::assert(existing.unwrap_or(default: 0) == 0)
        if !self.buffers.journal.record(kind: CODE, address, slot: 0, previous: 0, existed: existing.is_some()) {
            return ERR_HOST_ALLOCATION
        }
        let written = self.state.set_code_unhashed(address, code)
        if written != OK { let _ = self.buffers.journal.pop() }
        written
    }
    // EIP-7702: point an authority's code at `delegate`, or clear it for zero.
    // The code must be empty or a designator, which the journal can restore.
    pub fn delegate_code(mut self, address: u256, delegate: u256) -> i32 {
        self.started = true
        let address = address_word(address)
        let previous = self.state.delegate(address)
        core::assert(self.state.code_size(address) == 0 || previous.is_some())
        let (was_delegated, previous_delegate): (u256, u256) = match previous {
            Option::Some(previous) => (1, previous),
            Option::None => (0, 0),
        }
        let change = Change { kind: DELEGATION, address, slot: was_delegated, previous: previous_delegate, existed: self.state.exists(address) }
        if !self.buffers.journal.append(change) { return ERR_HOST_ALLOCATION }
        let empty: [u8; 0] = []
        let written = if delegate == 0 { self.state.set_code(address, code: empty) }
            else { self.state.set_code_unhashed(address, code: designator(delegate)) }
        if written != OK { let _ = self.buffers.journal.pop() }
        written
    }
    pub fn storage_store(mut self, address: u256, slot: u256, value: u256) -> i32 {
        if self.is_static { return ERR_STATIC_WRITE }
        let address = address_word(address)
        let key = StorageKey { address, slot }
        let charge = self.storage_charge(address, slot, value)
        // Capture even an original zero. This cache survives frame rollback and
        // precedes every persistent write, including direct host-side writes.
        if !self.buffers.originals.contains(key)
            && !self.buffers.originals.try_insert(key, self.storage_load(address, slot)) {
            return ERR_HOST_ALLOCATION
        }
        let status = self.write(kind: STORAGE, address, slot, value)
        if status == OK { self.refund += charge.refund }
        status
    }
    // TSTORE's write, journaled, with one search of the transient table when
    // the value is not zero. The table holds no zeros, so an entry the search
    // finds at zero is the one it just inserted.
    pub fn transient_store(mut self, address: u256, slot: u256, value: u256) -> i32 {
        self.started = true
        if self.is_static { return ERR_STATIC_WRITE }
        let key = StorageKey { address: address_word(address), slot }
        if value == 0 {
            let Option::Some(at) = self.buffers.transient.find(key) else { return OK }
            let previous = self.buffers.transient.value_at(at)
            if !self.buffers.journal.record(kind: TRANSIENT, address: key.address, slot, previous, existed: true) {
                return ERR_HOST_ALLOCATION
            }
            let _ = self.buffers.transient.remove(key)
            return OK
        }
        let Option::Some(at) = self.buffers.transient.try_find_or_insert(key) else { return ERR_HOST_ALLOCATION }
        let previous = self.buffers.transient.value_at(at)
        if previous == value { return OK }
        if !self.buffers.journal.record(kind: TRANSIENT, address: key.address, slot, previous, existed: true) {
            if previous == 0 { let _ = self.buffers.transient.remove(key) }
            return ERR_HOST_ALLOCATION
        }
        let stored = mut self.buffers.transient.value_at(at)
        stored = value
        OK
    }

    // End-of-transaction deletions, after every frame has closed and fees are
    // paid: self-destructed accounts created by this transaction, and touched
    // accounts left empty. Each loses its code and storage. These direct world
    // updates are not journaled.
    pub fn settle(mut self) {
        core::assert(self.depth == 0)
        // The journal holds the changes and marks that survived their frames:
        // each touch, as a mark or as a balance, nonce or code change. It
        // mostly touches the sender, destination and coinbase, repeatedly, and
        // settling changes no balance, so an address checked recently is
        // skipped. No address word is 2^256 - 1.
        var recent: [u256; 4] = [MAX_U256; 4]
        var next: usize = 0
        var position: u64 = 0
        while position < self.buffers.journal.len() {
            let change = self.buffers.journal.change(position)
            let kind = change.kind
            let address = change.address
            if kind == DOOMED { self.state.remove_account(address) }
            let touched = kind == TOUCHED || kind == TOUCHED_ONCE || kind == BALANCE || kind == NONCE
                || kind == SENDER || kind == CONTRACT || kind == CODE || kind == DELEGATION
            if touched && address != recent[0] && address != recent[1] && address != recent[2]
                && address != recent[3] {
                self.state.remove_if_empty(address)
                recent[next] = address
                next = (next + 1) % 4
            }
            position += 1
        }
    }

    // Commit/abort the transaction only after every frame has been closed.
    // Transient storage is dropped at this boundary, never at a frame boundary.
    /// Closes the transaction in place: undoes it unless `commit`, and empties
    /// its tables. The logs stay for `take_logs`.
    pub fn end(mut self, commit: bool) {
        core::assert(self.depth == 0)
        if !commit {
            self.undo_to(0, transient: false)
            self.logs.truncate(0)
        }
        self.buffers.journal.clear()
        self.buffers.transient.clear()
        self.buffers.marks.clear()
        self.buffers.warm_storage.clear()
        self.buffers.originals.clear()
    }

    /// The state and buffers, after `end`.
    pub fn release(var own self) -> (WorldState, Buffers) { (self.state, self.buffers) }

    pub fn finish(var own self, commit: bool, gas_spent: u64) -> TransactionResult {
        self.end(commit)
        let gas_refunded = if commit { self.capped_refund(gas_spent) } else { 0 }
        TransactionResult {
            state: self.state, logs: self.logs, gas_used: gas_spent - gas_refunded, gas_refunded, buffers: self.buffers,
        }
    }
}

// The mark a journaled kind sets.
fn mark_of(_ kind: u8) -> u8 {
    match kind {
        WARM_ACCOUNT => MARK_WARM,
        TOUCHED => MARK_TOUCHED,
        _ => MARK_DOOMED,
    }
}
