use core::{MemSpan, MemVec, Option, Result}
use ingot::access::AccessRecorder
use ingot::changes::BlockChanges
use ingot::fork::Rules
use ingot::logs::LogBuffer
use ingot::status::{ERR_HOST_ALLOCATION, ERR_STATIC_WRITE, OK}
use ingot::journal::{Change, ChangeKind, Mark}
use ingot::state::{Field, Sender, StorageKey, WorldState, WriteError, Written, address_word, designator}
use ingot::types::{Config, Program}
use ingot::gas::{StorageCharge, storage_charge}
use ingot::vm::Buffers
use fevm_precompiles::is_precompile
use swisstable::Lookup

// The caller of system calls (EIP-4788). From EIP-7708 an ether transfer's
// log comes from it, with the topic
// keccak256("Transfer(address,address,uint256)").
pub const SYSTEM_ADDRESS: u256 = 0xfffffffffffffffffffffffffffffffffffffffe

// Bits of an address's marks that `record_changes` sets as it notes the
// account's balance, nonce and code, each once.
const NOTED_BALANCE: u8 = 32
const NOTED_NONCE: u8 = 64
const NOTED_CODE: u8 = 128
const TRANSFER_TOPIC: u256 = 0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef

// A checkpoint must be closed once, in reverse opening order. Committing a
// child retains its undo entries so a later parent revert still undoes it.
// `transient_empty`: transient storage was empty at the checkpoint, so
// reverting to it empties the table instead of undoing each write.
pub struct Checkpoint { position: usize, depth: usize, was_static: bool, refund: i128, logs: u64, transient_empty: bool }

pub struct TransactionResult {
    pub state: WorldState,
    pub logs: LogBuffer,
    // Gas charged after the transaction refund cap; refunds never refill a frame.
    pub gas_used: u64,
    pub gas_refunded: u64,
    // The buffers the transaction was lent, for the next.
    pub buffers: Buffers,
}

// The persistent database is unavailable to callers until finish consumes the
// transaction. Every write during execution must therefore pass the journal.
pub struct Transaction {
    state: WorldState,
    logs: LogBuffer,
    blob_hashes: MemVec<u256>,
    // The sender, destination and coinbase, warm from the start (EIP-2929,
    // EIP-3651) with the precompiles, unless the run has no `warm_set`.
    endpoints: [u256; 3],
    warm_set: bool,
    refund: i128,
    started: bool,
    depth: usize,
    is_static: bool,
    config: Config,
    // The journal, the transaction's frames and its tables (see `Buffers`).
    buffers: Buffers,
    // What the block's transactions read and change (EIP-7928), while a
    // block records it.
    access: AccessRecorder,
    // What the block changed, with what it held before, while a block runs.
    changes: BlockChanges,
}

impl Transaction {
    /// A transaction on `state` from `sender` to `destination` (the created
    /// address for a creation), with `buffers` lent until `finish` returns
    /// them.
    pub fn new(_ state: own WorldState, sender: u256, destination: u256, coinbase: u256, config: Config,
               buffers: own Buffers) -> Self {
        core::assert(buffers.journal.len() == 0)
        Self {
            state,
            logs: LogBuffer::new(),
            blob_hashes: MemVec::new(),
            endpoints: [address_word(sender), address_word(destination), address_word(coinbase)],
            warm_set: true,
            refund: 0,
            started: false,
            depth: 0,
            is_static: false,
            config,
            buffers,
            access: AccessRecorder::new(),
            changes: BlockChanges::new(),
        }
    }

    /// Starts the next transaction on the same state and buffers, as `new`
    /// does, after `end` closed the last one.
    pub fn begin(mut self, sender: u256, destination: u256, coinbase: u256, config: Config) {
        core::assert(self.depth == 0 && self.buffers.journal.len() == 0)
        self.endpoints = [address_word(sender), address_word(destination), address_word(coinbase)]
        self.warm_set = true
        self.refund = 0
        self.started = false
        self.is_static = false
        self.config = config
        self.blob_hashes.clear()
    }

    /// Starts the next run as `begin` does, with no account warm from the
    /// start, not even a precompile: a system call before Amsterdam, or the
    /// withdrawals. Such a run reads no endpoints.
    pub fn begin_cold(mut self, _ config: Config) {
        self.begin(sender: 0, destination: 0, coinbase: 0, config)
        self.warm_set = false
    }

    /// The state, between transactions.
    pub fn world(self) -> ref WorldState { ref self.state }

    /// The state, for a host's own writes between transactions.
    pub fn world_mut(mut self) -> mut WorldState {
        core::assert(self.depth == 0 && self.buffers.journal.len() == 0)
        mut self.state
    }

    pub fn config(self) -> Config { self.config }

    /// The block's access list recorder.
    pub fn access(mut self) -> mut AccessRecorder { mut self.access }

    /// The block's changes.
    pub(ingot) fn changes(mut self) -> mut BlockChanges { mut self.changes }

    pub fn buffers(mut self) -> mut Buffers { mut self.buffers }

    pub fn logs(self) -> ref LogBuffer { ref self.logs }
    pub fn take_logs(mut self) -> LogBuffer { core::mem::replace(mut self.logs, LogBuffer::new()) }

    pub fn emit_log(mut self, address: u256, topics: [u256; 4], topic_count: u64, data: MemSpan) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        if self.logs.append(address, topics, topic_count, data) { OK }
        else { ERR_HOST_ALLOCATION }
    }

    /// EIP-7708: logs `value` moving from `from` to `to`.
    pub fn log_transfer(mut self, from: u256, to: u256, value: u256) -> i32 {
        let topics = [TRANSFER_TOPIC, address_word(from), address_word(to), 0]
        if self.logs.append_word(address: SYSTEM_ADDRESS, topics, topic_count: 3, word: value) { OK }
        else { ERR_HOST_ALLOCATION }
    }

    pub fn add_blob_hash(mut self, _ hash: u256) -> bool {
        core::assert(!self.started)
        self.blob_hashes.try_push(hash).is_ok()
    }
    pub fn blob_hash(self, _ index: u256) -> u256 {
        if index >= self.blob_hashes.len() as u256 { return 0 }
        self.blob_hashes[index.downcast_unchecked()]
    }
    // The blob hashes, for the VM's BLOBHASH handler; fixed once the transaction starts.
    pub(ingot) fn blob_hash_ptr(self) -> *u256 { self.blob_hashes.ptr() }
    pub(ingot) fn blob_count(self) -> usize { self.blob_hashes.len() }

    pub fn refund(self) -> i128 { self.refund }
    pub fn add_refund(mut self, _ amount: i128) { self.refund += amount }

    // EIP-3529: positive refunds are capped at one fifth of the gas spent.
    pub fn capped_refund(self, gas_spent: u64) -> u64 {
        if self.refund <= 0 { return 0 }
        let cap = (gas_spent / 5) as i128
        (if self.refund < cap { self.refund } else { cap }).downcast_unchecked()
    }

    // Access-list initialization precedes all frames and is never rolled back.
    pub fn access_list_account(mut self, address: u256) -> bool {
        core::assert(!self.started)
        self.add_mark(address_word(address), Mark::Warm)
    }

    pub fn access_list_slot(mut self, address: u256, slot: u256) -> bool {
        core::assert(!self.started)
        let address = address_word(address)
        let was_warm = self.marked(address, Mark::Warm)
        if !self.add_mark(address, Mark::Warm) { return false }
        // Warm, and not yet read.
        if !self.buffers.warm_storage.try_insert(StorageKey { address, slot }, false) {
            if !was_warm { core::assert(self.unmark(address, Mark::Warm)) }
            return false
        }
        true
    }

    pub fn account_is_warm(self, _ address: u256) -> bool {
        let address = address_word(address)
        self.always_warm(address) || self.marked(address, Mark::Warm)
    }

    // Whether `address`, an address word, is warm without a mark: in a run
    // with the warm set, a precompile, or the sender, destination or
    // coinbase.
    fn always_warm(self, _ address: u256) -> bool {
        self.warm_set && (is_precompile(address) || address == self.endpoints[0] || address == self.endpoints[1]
            || address == self.endpoints[2])
    }

    // Whether `address`, an address word, has `mark`.
    fn marked(self, _ address: u256, _ mark: Mark) -> bool {
        self.buffers.marks.get(address).value & mark.bit() != 0
    }

    // Adds `mark` to `address`'s marks, unjournaled; false, changing nothing,
    // if the table cannot grow.
    fn add_mark(mut self, _ address: u256, _ mark: Mark) -> bool {
        let Option::Some(slot) = self.buffers.marks.try_find_or_insert(address) else { return false }
        let marks = mut self.buffers.marks.value_at(slot)
        marks |= mark.bit()
        true
    }

    // Clears `mark` from `address`'s marks, which it has an entry for; an
    // address left without marks loses its entry. Neither grows the table.
    fn unmark(mut self, _ address: u256, _ mark: Mark) -> bool {
        let Option::Some(slot) = self.buffers.marks.find(address) else { return false }
        let marks = mut self.buffers.marks.value_at(slot)
        marks &= ~mark.bit()
        marks != 0 || self.buffers.marks.remove(address)
    }

    pub fn storage_is_warm(self, address: u256, slot: u256) -> bool {
        self.buffers.warm_storage.contains(StorageKey { address: address_word(address), slot })
    }

    /// Whether the slot is warm (`found`) and has been read or written since
    /// it was (`value`): an access-list slot is warm from the start, and
    /// `warm_slot` marks its first access.
    pub fn slot_access(self, address: u256, slot: u256) -> Lookup<bool> {
        self.buffers.warm_storage.get(StorageKey { address: address_word(address), slot })
    }

    // Adds `mark` to `address`, journaled if new. A new address gets an
    // entry without marks first.
    fn mark(mut self, _ mark: Mark, _ address: u256) -> i32 {
        self.started = true
        let address = address_word(address)
        let Option::Some(slot) = self.buffers.marks.try_find_or_insert(address) else { return ERR_HOST_ALLOCATION }
        let marks = mut self.buffers.marks.value_at(slot)
        if marks & mark.bit() != 0 { return OK }
        marks |= mark.bit()
        self.journal(address, ChangeKind::Mark(mark))
    }

    // Notes in the block's access list that `address`, an address word, was
    // read, once in a transaction. The note stays through reverts.
    fn note_read(mut self, _ address: u256) -> i32 {
        let Option::Some(slot) = self.buffers.marks.try_find_or_insert(address) else { return ERR_HOST_ALLOCATION }
        let marks = mut self.buffers.marks.value_at(slot)
        if marks & Mark::Read.bit() == 0 {
            marks |= Mark::Read.bit()
            self.access.account(address)
        }
        OK
    }

    /// Warms an account that an access reads, once the access's gas is paid.
    pub fn warm_account(mut self, address: u256) -> i32 {
        self.access_account(address, warm: false)
    }

    /// An access of an account, once its gas is paid: warms it unless it is
    /// `warm`, and notes the read while a block records its access list.
    pub fn access_account(mut self, _ address: u256, warm: bool) -> i32 {
        self.started = true
        let address = address_word(address)
        if self.access.recording() {
            let noted = self.note_read(address)
            if noted != OK { return noted }
        }
        if warm || self.always_warm(address) { return OK }
        self.mark(Mark::Warm, address)
    }

    /// The first access of a slot (see `slot_access`), once its gas is known
    /// to be affordable: warms it, and notes the read while a block records
    /// its access list.
    pub fn warm_slot(mut self, address: u256, slot: u256) -> i32 {
        self.started = true
        let address = address_word(address)
        let key = StorageKey { address, slot }
        let known = self.buffers.warm_storage.get(key)
        if known.found && known.value { return OK }
        if !self.buffers.warm_storage.try_insert(key, true) { return ERR_HOST_ALLOCATION }
        if self.access.recording() { self.access.slot(address, slot) }
        if known.found { OK } else { self.journal(address, ChangeKind::WarmSlot { slot }) }
    }

    pub fn touch(mut self, _ address: u256) -> i32 {
        self.mark(Mark::Touched, address)
    }

    /// Touches `address` with a journal entry and no mark: for the
    /// transaction's own call, which touches its target once.
    pub fn touch_unmarked(mut self, _ address: u256) -> i32 {
        self.started = true
        if self.buffers.journal.push(Change { address: address_word(address), kind: ChangeKind::Touch }) { OK }
        else { ERR_HOST_ALLOCATION }
    }

    // SELFDESTRUCT of an account created by this transaction (EIP-6780).
    pub fn doom(mut self, _ address: u256) -> i32 {
        self.mark(Mark::Doomed, address)
    }

    pub fn mark_created(mut self, _ address: u256) -> i32 {
        if self.add_mark(address_word(address), Mark::Created) { OK } else { ERR_HOST_ALLOCATION }
    }

    pub fn was_created(self, _ address: u256) -> bool {
        self.marked(address_word(address), Mark::Created)
    }

    pub fn original_storage(self, address: u256, slot: u256) -> u256 {
        let original = self.buffers.originals.get(StorageKey { address: address_word(address), slot })
        if original.found { original.value } else { self.storage_load(address, slot) }
    }

    /// SSTORE's charge for writing `value`, by `F`'s rules.
    pub fn storage_charge<F: Rules>(self, address: u256, slot: u256, value: u256) -> StorageCharge {
        storage_charge<F>(
            original: self.original_storage(address, slot),
            current: self.storage_load(address, slot), value,
            cold: !self.storage_is_warm(address, slot),
        )
    }

    pub fn is_static(self) -> bool { self.is_static }
    pub fn depth(self) -> usize { self.depth }

    // Administrative checkpoints do not count toward EVM call depth.
    pub fn checkpoint(mut self, is_static: bool) -> Checkpoint {
        self.started = true
        self.depth += 1
        let checkpoint = Checkpoint {
            position: self.buffers.journal.len(), depth: self.depth, was_static: self.is_static, refund: self.refund,
            logs: self.logs.len(), transient_empty: self.buffers.transient.is_empty(),
        }
        self.is_static = self.is_static || is_static
        checkpoint
    }

    pub fn commit(mut self, _ checkpoint: own Checkpoint) {
        core::assert(self.depth == checkpoint.depth)
        self.depth -= 1
        self.is_static = checkpoint.was_static
    }

    pub fn revert(mut self, _ checkpoint: own Checkpoint) {
        core::assert(self.depth == checkpoint.depth)
        if checkpoint.transient_empty { self.buffers.transient.clear() }
        self.undo_to(checkpoint.position, transient: !checkpoint.transient_empty)
        self.logs.truncate(checkpoint.logs)
        self.refund = checkpoint.refund
        self.depth -= 1
        self.is_static = checkpoint.was_static
    }

    // Undoes the journal's changes past `position`, latest first, but for
    // transient storage's unless `transient`.
    fn undo_to(mut self, _ position: usize, transient: bool) {
        while self.buffers.journal.len() > position {
            let change = self.buffers.journal.pop()
            let skip = match change.kind {
                ChangeKind::Transient { .. } => !transient,
                _ => false,
            }
            if !skip { self.undo(change) }
        }
    }

    // Reverses `change`, the latest change not undone. It restores entries
    // the tables held before; a table that cannot allocate to hold one again
    // is a fatal host failure. Undoing the change that created an account
    // removes it.
    fn undo(mut self, _ change: Change) {
        let empty: [u8; 0] = []
        let address = change.address
        match change.kind {
            ChangeKind::Account { field, previous, .. } => self.state.restore(field, address, previous),
            ChangeKind::Sender { nonce, balance, .. } => {
                self.state.restore(Field::Nonce, address, nonce)
                self.state.restore(Field::Balance, address, balance)
            },
            ChangeKind::Contract { balance, .. } => {
                self.state.restore(Field::Nonce, address, 0)
                self.state.restore(Field::Balance, address, balance)
            },
            ChangeKind::Storage { slot, previous, .. } => core::assert(self.state.storage_store(address, slot, previous)),
            ChangeKind::Transient { slot, previous } => core::assert(self.write_transient(address, slot, previous)),
            ChangeKind::Mark(mark) => core::assert(self.unmark(address, mark)),
            ChangeKind::WarmSlot { slot } => core::assert(self.buffers.warm_storage.remove(StorageKey { address, slot })),
            ChangeKind::Code { .. } => core::assert(self.state.set_code(address, code: empty) == OK),
            ChangeKind::Touch => {},
            ChangeKind::Delegation { previous, .. } => {
                let restored = match previous {
                    Option::Some(delegate) => self.state.set_code_unhashed(address, code: designator(delegate)),
                    Option::None => self.state.set_code(address, code: empty),
                }
                core::assert(restored == OK)
            },
        }
        if change.created() { self.state.remove_empty_account(address) }
    }

    // Journals a change to `address`, which the world or tables already
    // made; a journal that cannot grow undoes it.
    fn journal(mut self, _ address: u256, _ kind: ChangeKind) -> i32 {
        let change = Change { address, kind }
        if self.buffers.journal.push(change) { return OK }
        self.undo(change)
        ERR_HOST_ALLOCATION
    }

    // Starts a write, which a static frame may not make.
    fn writable(mut self) -> bool {
        self.started = true
        !self.is_static
    }

    pub fn exists(self, _ address: u256) -> bool { self.state.exists(address) }
    pub fn is_empty(self, _ address: u256) -> bool { self.state.is_empty(address) }
    // EIP-684/EIP-7610: creation needs an address without nonce, code or storage.
    pub fn deployable(self, _ address: u256) -> bool { self.state.deployable(address) }
    pub fn sender(self, _ address: u256) -> Sender { self.state.sender(address) }
    pub fn code_size(self, _ address: u256) -> usize { self.state.code_size(address) }
    pub fn code_hash(mut self, _ address: u256) -> u256 { self.state.code_hash(address) }
    pub fn code(self, _ address: u256) -> ref MemSpan { self.state.code(address) }
    pub fn delegate(self, _ address: u256) -> Option<u256> { self.state.delegate(address) }
    pub fn program(self, _ address: u256) -> Program { self.state.program(address) }
    pub fn balance(self, _ address: u256) -> u256 { self.state.balance(address) }
    pub fn nonce(self, _ address: u256) -> u256 { self.state.nonce(address) }
    pub fn storage_load(self, address: u256, slot: u256) -> u256 {
        self.state.storage_load(address, slot)
    }
    pub fn transient_load(self, address: u256, slot: u256) -> u256 {
        self.buffers.transient.get(StorageKey { address: address_word(address), slot }).value
    }
    pub fn block_hash(self, _ number: u256) -> u256 { self.state.block_hash(number) }

    // The transient table holds no zeros.
    fn write_transient(mut self, _ address: u256, _ slot: u256, _ value: u256) -> bool {
        let key = StorageKey { address, slot }
        if value == 0 {
            let _ = self.buffers.transient.remove(key)
            return true
        }
        self.buffers.transient.try_insert(key, value)
    }

    // Journals a balance or nonce write of `address`, an address word, which
    // touches the account even if the value is unchanged.
    fn journal_write(mut self, _ field: Field, _ address: u256, _ written: Result<WriteError, Written>) -> i32 {
        match written {
            Result::Ok(written) => if written.changed {
                self.journal(address, ChangeKind::Account { field, previous: written.previous, existed: written.existed })
            } else {
                self.touch_unmarked(address)
            },
            Result::Err(error) => error.status(),
        }
    }

    pub fn set_balance(mut self, address: u256, value: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(address)
        self.journal_write(Field::Balance, address, self.state.replace(Field::Balance, address, value))
    }
    pub fn set_nonce(mut self, address: u256, value: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(address)
        self.journal_write(Field::Nonce, address, self.state.replace(Field::Nonce, address, value))
    }
    pub fn increment_nonce(mut self, _ address: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(address)
        self.journal_write(Field::Nonce, address, self.state.add(Field::Nonce, address, amount: 1))
    }
    /// Adds `amount` to the balance, touching the account; one past 2^256 is
    /// ERR_BALANCE_OVERFLOW and changes no balance.
    pub fn credit(mut self, address: u256, amount: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(address)
        self.journal_write(Field::Balance, address, self.state.add(Field::Balance, address, amount))
    }
    /// Subtracts `amount`, which the balance must hold, touching the account.
    pub fn debit(mut self, address: u256, amount: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(address)
        self.journal_write(Field::Balance, address, self.state.subtract(Field::Balance, address, amount))
    }
    /// Sets a new contract's nonce to one and credits it `value`; one past
    /// 2^256 is ERR_BALANCE_OVERFLOW and changes nothing.
    pub fn endow(mut self, address: u256, value: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(address)
        match self.state.endow(address, amount: value) {
            Result::Ok(written) => self.journal(address, ChangeKind::Contract {
                balance: written.previous, existed: written.existed,
            }),
            Result::Err(error) => error.status(),
        }
    }
    /// Increments the sender's nonce and subtracts `fee`, which its balance
    /// must hold: the transaction's nonce increment and gas purchase. A nonce
    /// of 2^256 - 1 is ERR_BALANCE_OVERFLOW and changes nothing.
    pub fn charge(mut self, _ sender: u256, fee: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(sender)
        match self.state.charge(address, fee) {
            Result::Ok(charged) => self.journal(address, ChangeKind::Sender {
                nonce: charged.nonce, balance: charged.balance, existed: charged.existed,
            }),
            Result::Err(error) => error.status(),
        }
    }
    // Contract deployment writes code to an account that has none (EIP-684).
    pub fn deploy_code(mut self, address: u256, code: MemSpan) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        // Empty code leaves the account as it is, with nothing to undo.
        if code.len() == 0 { return OK }
        let address = address_word(address)
        let existing = self.state.existing_code_len(address)
        core::assert(existing.unwrap_or(default: 0) == 0)
        // Journaled first: undoing a code write cannot fail, but code writes can.
        if !self.buffers.journal.push(Change { address, kind: ChangeKind::Code { existed: existing.is_some() } }) {
            return ERR_HOST_ALLOCATION
        }
        let written = self.state.set_code_unhashed(address, code)
        if written != OK { let _ = self.buffers.journal.pop() }
        written
    }
    // EIP-7702: point an authority's code at `delegate`, or clear it for zero.
    // The code must be empty or a designator, which the journal can restore.
    pub fn delegate_code(mut self, address: u256, delegate: u256) -> i32 {
        self.started = true
        let address = address_word(address)
        let previous = self.state.delegate(address)
        core::assert(self.state.code_size(address) == 0 || previous.is_some())
        // Journaled first: restoring a designator can need allocation.
        let kind = ChangeKind::Delegation { previous, existed: self.state.exists(address) }
        if !self.buffers.journal.push(Change { address, kind }) {
            return ERR_HOST_ALLOCATION
        }
        let empty: [u8; 0] = []
        let written = if delegate == 0 { self.state.set_code(address, code: empty) }
            else { self.state.set_code_unhashed(address, code: designator(delegate)) }
        if written != OK { let _ = self.buffers.journal.pop() }
        written
    }
    pub fn storage_store(mut self, address: u256, slot: u256, value: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(address)
        let key = StorageKey { address, slot }
        let previous = self.storage_load(address, slot)
        // Capture even an original zero. This cache survives frame rollback and
        // precedes every persistent write, including direct host-side writes.
        if !self.buffers.originals.contains(key) && !self.buffers.originals.try_insert(key, previous) {
            return ERR_HOST_ALLOCATION
        }
        if previous != value {
            // Undo deletes an account its write created.
            let existed = self.state.exists(address)
            if !self.state.storage_store(address, slot, value) { return ERR_HOST_ALLOCATION }
            let status = self.journal(address, ChangeKind::Storage { slot, previous, existed })
            if status != OK { return status }
        }
        OK
    }
    // TSTORE's write (EIP-1153). The transient table holds no zeros: a zero
    // takes the entry out, and another value finds or makes one, each with
    // a single search.
    pub fn transient_store(mut self, address: u256, slot: u256, value: u256) -> i32 {
        if !self.writable() { return ERR_STATIC_WRITE }
        let address = address_word(address)
        let key = StorageKey { address, slot }
        let previous = if value == 0 {
            let Option::Some(previous) = self.buffers.transient.take(key) else { return OK }
            previous
        } else {
            let Option::Some(at) = self.buffers.transient.try_find_or_insert(key) else { return ERR_HOST_ALLOCATION }
            let stored = mut self.buffers.transient.value_at(at)
            if stored == value { return OK }
            core::mem::replace(mut stored, value)
        }
        self.journal(address, ChangeKind::Transient { slot, previous })
    }

    // End-of-transaction deletions, after every frame has closed and fees are
    // paid: self-destructed accounts created by this transaction, and touched
    // accounts left empty. Each loses its code and storage; from EIP-8246 a
    // self-destructed account keeps the ether it holds. These direct world
    // updates are not journaled.
    pub fn settle<F: Rules>(mut self) {
        core::assert(self.depth == 0)
        // The journal holds the changes and marks that survived their frames.
        for change in self.buffers.journal.changes() {
            if let ChangeKind::Mark(Mark::Doomed) = change.kind {
                if F::SELFDESTRUCT_BURNS { self.state.remove_account(change.address) }
                else { self.state.clear_keeping_balance(change.address) }
            }
            if change.touches() { self.state.remove_if_empty(change.address) }
        }
    }

    // Whether `bit` of `address`'s marks was clear; sets it.
    fn first_note(mut self, _ address: u256, _ bit: u8) -> bool {
        let Option::Some(slot) = self.buffers.marks.find(address) else { return false }
        let marks = mut self.buffers.marks.value_at(slot)
        let first = marks & bit == 0
        marks |= bit
        first
    }

    /// Adds what the transaction, system call or withdrawals left changed to
    /// the block's changes and, from Amsterdam, its access list, in one pass
    /// over the journal's surviving entries before `settle`, whose deletions
    /// bypass the journal. The first entry for each account field and slot
    /// holds what it was at the start, since a reverted frame put back what
    /// it changed. The access list has each account an entry names, and its
    /// balance, nonce, code and slots where they end different from the
    /// start. False if the block's changes cannot grow, for the caller to
    /// undo the run, which `settle` has not changed yet.
    pub(ingot) fn record_changes<F: Rules>(mut self) -> bool {
        if !self.changes.recording() { return true }
        let listing = F::BLOCK_ACCESS_LIST && self.access.recording()
        if listing { self.access.begin_changes() }
        var position: usize = 0
        while position < self.buffers.journal.len() {
            let change = self.buffers.journal.changes()[position]
            position += 1
            if !self.changes.keep(change, world: self.state, originals: self.buffers.originals) {
                // The list has part of a run that is to be undone.
                self.access.fail()
                return false
            }
            if !listing { continue }
            let address = change.address
            if self.note_read(address) != OK {
                self.access.fail()
                continue
            }
            // Settlement clears a self-destructed account, which this run
            // made, of its nonce, code and storage, so they end as they
            // began; from EIP-8246 it keeps the ether.
            let cleared = self.marked(address, Mark::Doomed)
            match change.kind {
                ChangeKind::Account { field, previous, .. } => match field {
                    Field::Balance => self.note_balance(address, previous),
                    Field::Nonce => if !cleared { self.note_nonce(address, previous) },
                },
                ChangeKind::Sender { nonce, balance, .. } => {
                    self.note_nonce(address, previous: nonce)
                    self.note_balance(address, previous: balance)
                },
                ChangeKind::Contract { balance, .. } => {
                    if !cleared { self.note_nonce(address, previous: 0) }
                    self.note_balance(address, previous: balance)
                },
                ChangeKind::Storage { slot, .. } => {
                    // The slot's first write kept what it held at the start.
                    let original = self.buffers.originals.take(StorageKey { address, slot })
                    if !cleared && let Option::Some(original) = original {
                        self.access.storage(address, slot, pre: original, post: self.state.storage_load(address, slot))
                    }
                },
                ChangeKind::Code { .. } => if !cleared { self.note_code(address, previous: Option::None) },
                ChangeKind::Delegation { previous, .. } => if !cleared { self.note_code(address, previous) },
                _ => {},
            }
        }
        true
    }

    fn note_balance(mut self, _ address: u256, previous: u256) {
        if self.first_note(address, NOTED_BALANCE) {
            self.access.balance(address, pre: previous, post: self.state.balance(address))
        }
    }

    fn note_nonce(mut self, _ address: u256, previous: u256) {
        if self.first_note(address, NOTED_NONCE) {
            self.access.nonce(address, pre: previous, post: self.state.nonce(address))
        }
    }

    fn note_code(mut self, _ address: u256, previous: Option<u256>) {
        if self.first_note(address, NOTED_CODE) { self.access.code(address, pre: previous, post: self.state.code(address)) }
    }

    // Commit/abort the transaction only after every frame has been closed.
    // Transient storage is dropped at this boundary, never at a frame boundary.
    /// Closes the transaction in place: undoes it unless `commit`, and empties
    /// its tables. The logs stay for `take_logs`.
    pub fn end(mut self, commit: bool) {
        core::assert(self.depth == 0)
        if !commit {
            self.undo_to(0, transient: false)
            self.logs.truncate(0)
        }
        self.buffers.journal.clear()
        self.buffers.transient.clear()
        self.buffers.marks.clear()
        self.buffers.warm_storage.clear()
        self.buffers.originals.clear()
    }

    /// The state and buffers, after `end`.
    pub fn release(var own self) -> (WorldState, Buffers) { (self.state, self.buffers) }

    pub fn finish(var own self, commit: bool, gas_spent: u64) -> TransactionResult {
        self.end(commit)
        let gas_refunded = if commit { self.capped_refund(gas_spent) } else { 0 }
        TransactionResult {
            state: self.state, logs: self.logs, gas_used: gas_spent - gas_refunded, gas_refunded, buffers: self.buffers,
        }
    }
}
