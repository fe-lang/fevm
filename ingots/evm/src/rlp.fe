use core::{MemBuffer, MemSpan, Option}

// The bytes of `len`'s big-endian form, without leading zeros.
fn length_bytes(_ len: usize) -> usize {
    var bytes: usize = 0
    while bytes < 8 && len >> (bytes * 8) != 0 { bytes += 1 }
    bytes
}

/// An RLP encoding under construction. An allocation that fails leaves the
/// encoder failed, and it then drops what is put in it.
pub struct Encoder { bytes: MemBuffer, failed: bool }

impl Encoder {
    pub fn new() -> Self { Encoder { bytes: MemBuffer::empty(), failed: false } }

    fn reserve(mut self, _ additional: usize) -> bool {
        if !self.failed && !self.bytes.try_reserve(additional) { self.failed = true }
        !self.failed
    }

    // The header of a payload of `len` bytes: a string's with `base` 0x80,
    // a list's with 0xc0.
    fn header(mut self, _ len: usize, base: u256) {
        if len <= 55 { return self.bytes.extend_from_word(base + len as u256, len: 1) }
        let bytes = length_bytes(len)
        self.bytes.extend_from_word(base + 55 + bytes as u256, len: 1)
        self.bytes.extend_from_word(len as u256, len: bytes)
    }

    /// An integer: its big-endian bytes without leading zeros.
    pub fn uint(mut self, _ value: u256) {
        var len: usize = 0
        while len < 32 && value >> (len * 8) as u256 != 0 { len += 1 }
        self.fixed(value, len)
    }

    /// The low `len` bytes of `word` as a string, such as an address's 20.
    pub fn fixed(mut self, _ word: u256, len: usize) {
        if !self.reserve(len + 1) { return }
        if len != 1 || word >= 0x80 { self.header(len, base: 0x80) }
        self.bytes.extend_from_word(word, len)
    }

    pub fn bytes(mut self, _ bytes: MemSpan) {
        if !self.reserve(bytes.len() + 9) { return }
        if bytes.len() != 1 || bytes[0] >= 0x80 { self.header(bytes.len(), base: 0x80) }
        self.bytes.extend_from(bytes)
    }

    /// Where a list begins, for `end`.
    pub fn begin(self) -> usize { self.bytes.len() }

    /// Makes a list of the items put since `begin` gave `start`.
    pub fn end(mut self, _ start: usize) {
        if self.failed { return }
        let payload = self.bytes.len() - start
        let header: usize = if payload <= 55 { 1 } else { 1 + length_bytes(payload) }
        if !self.bytes.try_resize(start + header + payload) {
            self.failed = true
            return
        }
        self.bytes.span().copy_within(source: start, dest: start + header, len: payload)
        self.write_header(start, payload)
    }

    fn write_header(mut self, _ at: usize, _ payload: usize) {
        if payload <= 55 {
            self.bytes[at] = (0xc0 + payload).downcast_truncate()
            return
        }
        let bytes = length_bytes(payload)
        self.bytes[at] = (0xf7 + bytes).downcast_truncate()
        for index in 0..bytes {
            self.bytes[at + 1 + index] = (payload >> ((bytes - 1 - index) * 8)).downcast_truncate()
        }
    }

    /// The encoding; none if an allocation failed.
    pub fn finish(own self) -> Option<MemBuffer> {
        if self.failed { Option::None } else { Option::Some(self.bytes) }
    }
}

#[test]
fn rlp_encodes_integers_strings_and_lists() {
    // [0, 15, 1024, "dog", [], <60 bytes>], with a two-byte list header.
    var rlp = Encoder::new()
    let list = rlp.begin()
    rlp.uint(0)
    rlp.uint(15)
    rlp.uint(1024)
    rlp.fixed(0x646f67, len: 3)
    let empty = rlp.begin()
    rlp.end(empty)
    var long = MemBuffer::empty()
    core::assert(long.try_resize(60))
    rlp.bytes(long.span())
    rlp.end(list)
    let bytes = rlp.finish().unwrap()
    let head: [u8; 13] = [0xf8, 72, 0x80, 0x0f, 0x82, 0x04, 0x00, 0x83, 0x64, 0x6f, 0x67, 0xc0, 0xb8]
    core::assert(bytes.len() == 74 && bytes[13] == 60)
    for index in 0..13 { core::assert(bytes[index] == head[index]) }
}
