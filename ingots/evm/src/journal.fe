use core::MemVec

pub struct Change {
    pub kind: u8,
    pub address: u256,
    pub slot: u256,
    pub previous: u256,
    pub existed: bool,
}

impl Copy for Change {}

// A growable list of changes. Undo only reads and pops changes, so it cannot
// fail to allocate while unwinding a failed frame.
pub struct Journal { changes: MemVec<Change> }

impl Journal {
    pub fn new() -> Self { Self { changes: MemVec::new() } }

    pub fn len(self) -> u64 { self.changes.len().downcast_unchecked() }

    pub fn append(mut self, _ change: Change) -> bool {
        self.record(kind: change.kind, address: change.address, slot: change.slot, previous: change.previous,
                    existed: change.existed)
    }

    /// Appends the change of these fields. Each path builds it where it goes:
    /// with room, in the journal's next slot; `try_push` returns it back on
    /// failure, a copy through a result the fast path never needs.
    #[inline(always)]
    pub fn record(mut self, kind: u8, address: u256, slot: u256, previous: u256, existed: bool) -> bool {
        if self.changes.len() < self.changes.capacity() {
            unsafe { self.changes.push_unchecked(Change { kind, address, slot, previous, existed }) }
            return true
        }
        self.changes.try_push(Change { kind, address, slot, previous, existed }).is_ok()
    }

    pub fn change(self, _ index: u64) -> Change { self.changes[index.downcast_truncate()] }

    pub fn pop(mut self) -> Change { self.changes.pop().unwrap() }

    /// Drops the changes from `len` on.
    pub fn truncate(mut self, _ len: u64) { self.changes.truncate(len.downcast_truncate()) }

    pub fn clear(mut self) { self.changes.clear() }
}
