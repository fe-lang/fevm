    }

    fn op_iszero<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_unary(code, pc, gas, depth, top, mut tracer, cost: 3, op: 0x15)
    }

    fn op_not<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_unary(code, pc, gas, depth, top, mut tracer, cost: 3, op: 0x19)
    }

    fn op_clz<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_unary(code, pc, gas, depth, top, mut tracer, cost: 5, op: 0x1e)
    }

    fn op_div<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_binary(code, pc, gas, depth, top, mut tracer, cost: 5, op: 0x04)
    }

    fn op_sdiv<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_binary(code, pc, gas, depth, top, mut tracer, cost: 5, op: 0x05)
    }

    fn op_mod<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_binary(code, pc, gas, depth, top, mut tracer, cost: 5, op: 0x06)
    }

    fn op_smod<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_binary(code, pc, gas, depth, top, mut tracer, cost: 5, op: 0x07)
    }

    fn op_addmod<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_modular(code, pc, gas, depth, top, mut tracer, op: 0x08)
    }

    fn op_mulmod<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_modular(code, pc, gas, depth, top, mut tracer, op: 0x09)
    }

    // ADDMOD and MULMOD: the top two words' sum or product modulo the third
    // replaces the third.
    #[inline(always)]
    fn op_modular<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T, op: i32) {
        if gas < 8 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 3 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 8, depth)
        }
        let third = below(top, 3)
        unsafe {
            let lhs = *offset_bytes(third, 64)
            let rhs = *offset_bytes(third, 32)
            *third = if op == 0x08 { addmod(lhs, rhs, *third) } else { mulmod(lhs, rhs, *third) }
        }
        self.next(code, pc.wrapping_add(1), gas - 8, depth - 2, below(top, 2), mut tracer)
    }

    // EXP calls out, but stays in the handlers rather than returning to
    // `run_until_child`.
    fn op_exp<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        let cost = base_cost(0x0a)
        if gas < cost {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.gas_remaining = gas - cost
        unsafe { self.stack.set_len(depth) }
        let base = self.pop()
        let exponent = self.pop()
        if self.ok() { self.exp(base, exponent) }
        let gas = self.gas_remaining
        if !self.ok() {
            return self.stopped_at(pc.wrapping_add(1), gas, self.stack.len())
        }
        self.dispatch(code, pc.wrapping_add(1), gas, mut tracer)
    }

    fn stopped_at(mut self, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.pc = pc
        self.gas_remaining = gas
        // The handlers kept `depth` words initialized, within the reserved
        // `STACK_LIMIT`.
        unsafe { self.stack.set_len(depth) }
    }

    // Every handler can fault, usually twice; one copy out of line keeps
    // the handlers small.
    #[inline(never)]
    fn faulted_at(mut self, _ status: i32, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.fault(status)
        self.stopped_at(pc, gas, depth)
    }

    // Pushes `value` and runs the opcode at `pc`, the one after the push.
    #[inline(always)]
    fn push_next<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T,
                            _ value: u256) {
        if depth >= STACK_LIMIT {
            return self.faulted_at(ERR_STACK_OVERFLOW, pc, gas, depth)
        }
        unsafe { *top = value }
        self.next(code, pc, gas, depth + 1, offset_bytes(top, 32), mut tracer)
    }

    fn op_push0<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.push_next(code, pc.wrapping_add(1), gas - 2, depth, top, mut tracer, 0)
    }

    // The common widths read just their immediate; padding gives every
    // immediate a whole word of code after it.
    fn op_push1<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let value = unsafe { read_code<u8>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(2), gas - 3, depth, top, mut tracer, value as u256)
    }

    fn op_push2<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let value = unsafe { read_code<u16>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(3), gas - 3, depth, top, mut tracer, value as u256)
    }

    fn op_push4<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let value = unsafe { read_code<u32>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(5), gas - 3, depth, top, mut tracer, value as u256)
    }

    fn op_push32<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let value = unsafe { read_code<u256>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(33), gas - 3, depth, top, mut tracer, value)
    }

    // PUSH3 and PUSH5 through PUSH8: the immediate is the top n bytes of an
    // eight-byte read.
    fn op_push_upto8<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let op = unsafe { read_code<u8>(code, pc) }
        let n: u64 = (op.wrapping_sub(0x5f) & 0x1f) as u64
        let word = unsafe { read_code<u64>(code, pc.wrapping_add(1)) }
        let value = word >> ((8 - n) * 8) as u64
        self.push_next(code, pc.wrapping_add(1 + n.downcast_truncate()), gas - 3, depth, top, mut tracer, value as u256)
    }

    // PUSH9 through PUSH16, from a sixteen-byte read.
    fn op_push_upto16<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let op = unsafe { read_code<u8>(code, pc) }
        let n: u64 = (op.wrapping_sub(0x5f) & 0x1f) as u64
        let word = unsafe { read_code<u128>(code, pc.wrapping_add(1)) }
        let value = word >> ((16 - n) * 8) as u128
        self.push_next(code, pc.wrapping_add(1 + n.downcast_truncate()), gas - 3, depth, top, mut tracer, value as u256)
    }

    fn op_push_wide<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let op = unsafe { read_code<u8>(code, pc) }
        let n: usize = (op.wrapping_sub(0x5f) & 0x1f) as usize
        let word = unsafe { read_code<u256>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(1 + n), gas - 3, depth, top, mut tracer, word >> ((32 - n) * 8) as u256)
    }

    fn op_pop<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 1 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 2, depth)
        }
        self.next(code, pc.wrapping_add(1), gas - 2, depth - 1, below(top, 1), mut tracer)
    }

    fn op_dup1<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 1)
    }

    fn op_dup2<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 2)
