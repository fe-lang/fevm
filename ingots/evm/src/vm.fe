    fn op_dup9<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 9)
