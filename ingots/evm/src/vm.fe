use core::{Box, MemBuffer, MemVec, Option, Result}
use core::num::{IntWord, from_be}
use core::ptr::{cast, offset, offset_bytes}
use keccak::Keccak256
use ingot::memory::{
    MemoryExpansion, SMALL_EXTENT, memory_expansion, copy_expansion, copy_gas, small_growth_cost,
}
use ingot::gas::base_cost
use ingot::state::address_word
use core::ops::{WrappingAdd, WrappingMul, WrappingSub}
use core::num::leading_zeros
use std::evm::crypto::{addmod, mulmod}
use ingot::constants::{
    ERR_BALANCE_OVERFLOW,
    ERR_CODE_PREFIX,
    ERR_PRECOMPILE,
    ERR_INVALID_JUMP,
    ERR_INVALID_OPCODE,
    ERR_OUT_OF_GAS,
    ERR_HOST_ALLOCATION,
    ERR_RETURN_DATA_OOB,
    ERR_REVERT,
    ERR_STACK_OVERFLOW,
    ERR_STACK_UNDERFLOW,
    ERR_STATIC_WRITE,
    I256_MIN,
    OK,
    STACK_LIMIT,
}
use ingot::address::{create_address, create2_address}
use ingot::transaction::{Checkpoint, Transaction}
use ingot::types::{BlockEnv, InputData, CallEnv, ExecutionResult, Program, empty_bytes}
use fevm_precompiles::{FAILURE, SUCCESS, is_precompile}

// Charges `cost` against `gas`, or fails without charging.
#[inline(always)]
fn spend(_ gas: mut u64, _ cost: u64) -> bool {
    if cost > gas {
        return false
    }
    gas -= cost
    true
}

/// The big-endian `T` at `offset` bytes into `code`, which holds all of it.
#[inline(always)]
unsafe fn read_code<T: IntWord>(_ code: *u8, _ offset: usize) -> T {
    from_be(*cast<u8, T>(offset_bytes(code, offset)))
}

/// Binary opcode `op`'s result, or `None` for other opcodes.
#[inline(always)]
fn binary_result(_ op: i32, _ lhs: u256, _ rhs: u256) -> Option<u256> {
    Option::Some(match op {
        0x01 => lhs.wrapping_add(rhs),
        0x02 => lhs.wrapping_mul(rhs),
        0x03 => lhs.wrapping_sub(rhs),
        0x04 => if rhs == 0 { 0 } else { lhs / rhs },
        0x05 => sdiv(lhs, rhs),
        0x06 => if rhs == 0 { 0 } else { lhs % rhs },
        0x07 => smod(lhs, rhs),
        0x10 => if lhs < rhs { 1 } else { 0 },
        0x11 => if lhs > rhs { 1 } else { 0 },
        0x14 => if lhs == rhs { 1 } else { 0 },
        0x16 => lhs & rhs,
        0x17 => lhs | rhs,
        0x18 => lhs ^ rhs,
        0x1b => if lhs >= 256 { 0 } else { rhs << lhs },
        0x1c => if lhs >= 256 { 0 } else { rhs >> lhs },
        0x12 => if signed_less(lhs, rhs) { 1 } else { 0 },
        0x13 => if signed_less(rhs, lhs) { 1 } else { 0 },
        0x1a => if lhs >= 32 { 0 } else { (rhs >> ((31 - lhs) * 8)) & 255 },
        0x0b => signextend(byte_index: lhs, value: rhs),
        0x1d => sar(shift: lhs, value: rhs),
        _ => return Option::None,
    })
}

/// SDIV: the quotient of two's complement words, rounded toward zero, with a
/// zero divisor giving zero and `MIN / -1` wrapping to `MIN`.
#[inline(always)]
fn sdiv(_ lhs: u256, _ rhs: u256) -> u256 {
    if rhs == 0 {
        return 0
    }
    let lhs_signed: i256 = lhs.downcast_unchecked()
    let rhs_signed: i256 = rhs.downcast_unchecked()
    if lhs_signed == I256_MIN && rhs_signed == -1 {
        return lhs
    }
    (lhs_signed / rhs_signed).downcast_unchecked()
}

/// SMOD: the remainder of two's complement words, taking the dividend's
/// sign, with a zero divisor giving zero.
#[inline(always)]
fn smod(_ lhs: u256, _ rhs: u256) -> u256 {
    let lhs_signed: i256 = lhs.downcast_unchecked()
    let rhs_signed: i256 = rhs.downcast_unchecked()
    if rhs == 0 || rhs_signed == -1 {
        return 0
    }
    (lhs_signed % rhs_signed).downcast_unchecked()
}

/// Unary opcode `op`'s result, or `None` for other opcodes.
#[inline(always)]
fn unary_result(_ op: i32, _ value: u256) -> Option<u256> {
    match op {
        0x15 => Option::Some(if value == 0 { 1 } else { 0 }),
        0x19 => Option::Some(!value),
        0x1e => Option::Some(leading_zeros(value)),
        _ => Option::None,
    }
}

/// Swaps the 64-bit pieces `index` of two stack words.
#[inline(always)]
unsafe fn swap_piece(_ a: *u64, _ b: *u64, _ index: usize) {
    let a = offset(a, index)
    let b = offset(b, index)
    let value = *a
    *a = *b
    *b = value
}

/// Word `index` of the handlers' stack, which stays below its reserved
/// `STACK_LIMIT` words.
#[inline(always)]
fn slot(_ base: *u256, _ index: usize) -> *u256 {
    offset_bytes(base, index.wrapping_mul(32))
}

fn signed_less(_ lhs: u256, _ rhs: u256) -> bool {
    let lhs: i256 = lhs.downcast_unchecked()
    let rhs: i256 = rhs.downcast_unchecked()
    lhs < rhs
}

// Extends the sign of byte `byte_index`, counting from the least significant,
// within the 64-bit limb that holds it, so every shift is by a constant or
// within an i64.
fn signextend(byte_index: u256, value: u256) -> u256 {
    if byte_index >= 31 {
        return value
    }
    let index: u64 = byte_index.downcast_unchecked()
    let shift: i64 = ((7 - index % 8) * 8).downcast_unchecked()
    match index / 8 {
        0 => extend_limb(value, shift),
        1 => (extend_limb(value >> 64, shift) << 64) | (value & 0xffffffffffffffff),
        2 => (extend_limb(value >> 128, shift) << 128) | (value & 0xffffffffffffffffffffffffffffffff),
        _ => (extend_limb(value >> 192, shift) << 192) | (value & 0xffffffffffffffffffffffffffffffffffffffffffffffff),
    }
}

// The low limb of `word` with bits from `63 - shift` up set to that bit,
// widened to 256 bits.
fn extend_limb(_ word: u256, _ shift: i64) -> u256 {
    let low: u64 = word.downcast_truncate()
    let narrow: i64 = low.downcast_unchecked()
    let extended: i256 = ((narrow << shift) >> shift) as i256
    extended.downcast_unchecked()
}

fn sar(shift: u256, value: u256) -> u256 {
    let signed = ((value >> 255) & 1) == 1
    if shift == 0 {
        value
    } else if shift >= 256 {
        if signed { !(0 as u256) } else { 0 }
    } else {
        let shifted = value >> shift
        if signed { shifted | !((1 << (256 - shift)) - 1) } else { shifted }
    }
}

/// Memory and stacks of finished frames, which later frames take over with
/// the capacity they grew. Frames nest, so each call depth tends to get back
/// its last frame's buffers, and a caller that keeps the pool across
/// transactions allocates them once.
pub struct FrameBuffers {
    memories: MemVec<MemBuffer>,
    stacks: MemVec<MemVec<u256>>,
}

impl FrameBuffers {
    pub fn new() -> Self {
        FrameBuffers { memories: MemVec::new(), stacks: MemVec::new() }
    }
}

pub struct Vm {
    // EVM memory is the first `memory_size` bytes of `memory`, whose bytes
    // past it stay zero, so most growth only moves the size.
    pub memory: MemBuffer,
    pub memory_size: u64,
    pub output: MemBuffer,
    pub return_data: MemBuffer,
    pub gas_remaining: u64,
    pub refund_delta: i128,
    pub output_valid: bool,
    // On the heap, so moving a frame does not copy it.
    pub stack: MemVec<u256>,
    pub pc: usize,
    pub status: i32,
    pub halted: bool,
    pub unsupported_opcode: i32,
    // The running code's JUMPDEST bitmap and the length it covers, which
    // `run_until_child` sets for the opcode handlers.
    jumpdests: *u8,
    jump_limit: usize,
}

impl Vm {
    pub fn new() -> Self {
        Vm {
            memory: MemBuffer::empty(),
            memory_size: 0,
            output: MemBuffer::empty(),
            return_data: MemBuffer::empty(),
            gas_remaining: 0,
            refund_delta: 0,
            output_valid: false,
            stack: MemVec::new(),
            pc: 0,
            status: OK,
            halted: false,
            unsupported_opcode: 0,
            jumpdests: (0 as usize) as *u8,
            jump_limit: 0,
        }
    }

    fn ok(self) -> bool {
        self.status == OK
    }

    // A frame that has allocated nothing takes over a finished frame's
    // memory and stack, which hold no bytes or words.
    fn adopt(mut self, _ buffers: mut FrameBuffers) {
        if self.memory.capacity() == 0 {
            match buffers.memories.pop() {
                Option::Some(memory) => self.memory = memory,
                Option::None => {},
            }
        }
        if self.stack.capacity() == 0 {
            match buffers.stacks.pop() {
                Option::Some(stack) => self.stack = stack,
                Option::None => {},
            }
        }
    }

    fn fault(mut self, _ status: i32) {
        if self.status == OK {
            self.status = status
            if exceptional(status) { self.gas_remaining = 0 }
        }
    }

    fn push(mut self, _ value: u256) {
        if self.stack.len() >= STACK_LIMIT {
            self.fault(ERR_STACK_OVERFLOW)
            return
        }
        // `run_until_child` reserves room for `STACK_LIMIT` words.
        unsafe { self.stack.push_unchecked(value) }
    }

    // `push` for the dispatch loop, which stops when it fails.
    #[inline(always)]
    fn pushed(mut self, _ value: u256) -> bool {
        if self.stack.len() >= STACK_LIMIT {
            self.fault(ERR_STACK_OVERFLOW)
            return false
        }
        unsafe { self.stack.push_unchecked(value) }
        true
    }

    fn pop(mut self) -> u256 {
        match self.stack.pop() {
            Option::Some(value) => value,
            Option::None => {
                self.fault(ERR_STACK_UNDERFLOW)
                0
            },
        }
    }

    fn push_bool(mut self, _ value: bool) {
        if value { self.push(1) } else { self.push(0) }
    }

    fn charge(mut self, _ amount: u128) -> bool {
        if amount > self.gas_remaining as u128 {
            self.fault(ERR_OUT_OF_GAS)
            return false
        }
        self.gas_remaining -= amount.downcast_unchecked()
        true
    }

    // Plan and charge before converting EVM words or touching host allocation.
    fn plan_memory(mut self, offset: u256, len: u256, copying: bool) -> Option<MemoryExpansion> {
        // A range within active memory grows nothing; only copy gas applies.
        let size = self.memory_size
        let plan = if len <= size as u256 && self.in_memory(offset, len: len.downcast_unchecked()) {
            MemoryExpansion { size, gas: 0 }
        } else {
            match memory_expansion(current: size, offset, len) {
                Option::Some(plan,) => plan,
                Option::None => {
                    self.fault(ERR_OUT_OF_GAS)
                    return Option::None
                },
            }
        }
        if self.charge_expansion(plan, len, copying) { Option::Some(plan) } else { Option::None }
    }

    fn charge_expansion(mut self, _ plan: MemoryExpansion, len: u256, copying: bool) -> bool {
        var gas = plan.gas as u128
        if copying {
            match copy_gas(len) {
                Option::Some(cost,) => gas += cost as u128,
                Option::None => {
                    self.fault(ERR_OUT_OF_GAS)
                    return false
                },
            }
        }
        self.charge(gas)
    }

    // Copies pad past their source with zeros.
    fn zero_memory(mut self, from: u64, to: u64) {
        self.memory.slice(offset: from as usize, len: (to - from) as usize).zero()
    }

    // Grows memory to a planned size, at least its current one. A buffer
    // too small doubles, or takes just the size if doubling fails.
    fn expand_memory(mut self, _ size: u64) -> bool {
        let len: u64 = self.memory.len().downcast_unchecked()
        if size > len {
            let doubled = 2 * len
            if !(doubled > size && self.memory.try_resize(doubled as usize))
                && !self.memory.try_resize(size as usize) {
                self.fault(ERR_HOST_ALLOCATION)
                return false
            }
        }
        self.memory_size = size
        true
    }

    fn sha3(mut self) {
        let offset = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        // A range within active memory pays only the per-word gas.
        if len <= self.memory_size as u256 && self.in_memory(offset, len: len.downcast_unchecked()) {
            let words: u64 = (len / 32 + if len % 32 == 0 { 0 } else { 1 }).downcast_unchecked()
            if !self.charge(words as u128 * 6) { return }
        } else {
            match memory_expansion(current: self.memory_size, offset, len) {
                Option::Some(plan,) => {
                    // A successful plan bounds every nonempty range below 2^42.
                    // Charge the whole operation before allocating or narrowing offsets.
                    let words: u64 = (len / 32 + if len % 32 == 0 { 0 } else { 1 }).downcast_unchecked()
                    let gas = plan.gas as u128 + words as u128 * 6
                    if !self.charge(gas) || !self.expand_memory(plan.size) { return }
                },
                Option::None => {
                    self.fault(ERR_OUT_OF_GAS)
                    return
                },
            }
        }
        var hash = Keccak256::new()
        if len != 0 {
            hash.update(self.memory, offset: offset.downcast_unchecked(), len: len.downcast_unchecked())
        }
        self.push(hash.finish_word())
    }

    // An access within active memory needs no charge or growth.
    fn in_memory(self, _ offset: u256, len: u64) -> bool {
        let size = self.memory_size
        size >= len && offset <= (size - len) as u256
    }

    // The word-rounded size covering a range that `in_memory` rejected, when
    // the buffer already holds it and the offset is below SMALL_EXTENT, or zero.
    #[inline(always)]
    fn buffered_growth(self, _ offset: u256, len: u64) -> u64 {
        if offset >= SMALL_EXTENT as u256 {
            return 0
        }
        let start: u64 = offset.downcast_unchecked()
        let size = (start + len + 31) / 32 * 32
        if size as usize > self.memory.len() { 0 } else { size }
    }

    // Grows memory to cover a range that `in_memory` rejected. Below
    // SMALL_EXTENT the range also ends past active memory, and both sizes'
    // gas needs only u64 arithmetic.
    fn grow_memory(mut self, _ offset: u256, len: u64) -> bool {
        if offset < SMALL_EXTENT as u256 {
            let start: u64 = offset.downcast_unchecked()
            let size = (start + len + 31) / 32 * 32
            let gas = small_growth_cost(current: self.memory_size, size)
            return self.charge(gas as u128) && self.expand_memory(size)
        }
        match self.plan_memory(offset, len: len as u256, copying: false) {
            Option::Some(plan,) => self.expand_memory(plan.size),
            Option::None => false,
        }
    }


    fn mload(mut self) {
        let offset = self.pop()
        if !self.ok() || !self.in_memory(offset, len: 32) && !self.grow_memory(offset, len: 32) {
            return
        }
        let value = self.memory.read_word(offset.downcast_unchecked())
        self.push(value)
    }

    fn mstore(mut self) {
        let offset = self.pop()
        let value = self.pop()
        if !self.ok() || !self.in_memory(offset, len: 32) && !self.grow_memory(offset, len: 32) {
            return
        }
        self.memory.span().write_word(offset: offset.downcast_unchecked(), value)
    }

    fn mstore8(mut self) {
        let offset = self.pop()
        let value = self.pop()
        if !self.ok() || !self.in_memory(offset, len: 1) && !self.grow_memory(offset, len: 1) {
            return
        }
        let start: usize = offset.downcast_unchecked()
        self.memory[start] = (value & 255).downcast_unchecked()
    }

    fn codecopy(mut self, _ program: Program) {
        let offset = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        if len == 0 { return }
        let dest: u64 = offset.downcast_unchecked()
        let count: u64 = len.downcast_unchecked()
        // Bound the source before narrowing or adding an index to it.
        let available: u256 = if source < program.len() as u256 {
            program.len() as u256 - source
        } else {
            0
        }
        let copied: u64 = if (count as u256) < available { count } else { available.downcast_unchecked() }
        if copied != 0 {
            self.memory.slice(offset: dest as usize, len: copied as usize)
                .copy_from(program.bytes().slice(offset: source.downcast_unchecked(), len: copied as usize))
        }
        self.zero_memory(from: dest + copied, to: dest + count)
    }

    fn mcopy(mut self) {
        let dest = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        match copy_expansion(current: self.memory_size, dest, source, len) {
            Option::Some(plan,) => {
                if !self.charge_expansion(plan, len, copying: true)
                    || !self.expand_memory(plan.size) {
                    return
                }
            },
            Option::None => {
                self.fault(ERR_OUT_OF_GAS)
                return
            },
        }
        if len != 0 {
            self.memory.span().copy_within(
                source: source.downcast_unchecked(),
                dest: dest.downcast_unchecked(),
                len: len.downcast_unchecked(),
            )
        }
    }

    fn calldataload(mut self, _ calldata: InputData) {
        let offset = self.pop()
        if !self.ok() { return }
        let len = calldata.len()
        // Most loads read one whole word within the calldata.
        if offset <= len as u256 && len as u256 - offset >= 32 {
            self.push(calldata.bytes().read_word(offset.downcast_unchecked()))
            return
        }
        // Bytes past the end read as zero.
        var value: u256 = 0
        if offset < len as u256 {
            let start: usize = offset.downcast_unchecked()
            for index in start..len { value = (value << 8) | calldata.byte_at(index) as u256 }
            value <<= ((32 - (len - start)) * 8) as u256
        }
        self.push(value)
    }

    fn calldatacopy(mut self, _ calldata: InputData) {
        let offset = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        if len == 0 { return }
        let dest: u64 = offset.downcast_unchecked()
        let count: u64 = len.downcast_unchecked()
        let available: u256 = if source < calldata.len() as u256 {
            calldata.len() as u256 - source
        } else {
            0
        }
        let copied: u64 = if (count as u256) < available { count } else { available.downcast_unchecked() }
        if copied != 0 {
            self.memory.slice(offset: dest as usize, len: copied as usize)
                .copy_from(calldata.bytes().slice(offset: source.downcast_unchecked(), len: copied as usize))
        }
        self.zero_memory(from: dest + copied, to: dest + count)
    }

    fn returndatacopy(mut self) {
        let offset = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        // Charge first, then check bounds even for length zero, then allocate.
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => {
                let available = self.return_data.len() as u256
                if source > available || len > available - source {
                    self.fault(ERR_RETURN_DATA_OOB)
                } else if self.expand_memory(plan.size) && len != 0 {
                    let len: usize = len.downcast_unchecked()
                    self.memory.slice(offset: offset.downcast_unchecked(), len)
                        .copy_from(self.return_data.slice(offset: source.downcast_unchecked(), len))
                }
            },
            Option::None => {},
        }
    }

    fn finish_from_memory(mut self, _ status: i32) {
        let offset = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        match self.plan_memory(offset, len, copying: false) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        let count: usize = len.downcast_unchecked()
        if !self.output.try_resize(count) {
            self.fault(ERR_HOST_ALLOCATION)
            return
        }
        if count != 0 {
            self.output.span().copy_from(self.memory.slice(offset: offset.downcast_unchecked(), len: count))
        }
        self.output_valid = true
        self.status = status
        self.halted = true
    }

    fn exp(mut self, base: u256, exponent: u256) {
        var significant = exponent
        var gas: u128 = 0
        while significant != 0 {
            gas += 50
            significant >>= 8
        }
        if !self.charge(gas) {
            return
        }
        var result: u256 = 1
        var factor = base
        var power = exponent
        while power != 0 {
            if power & 1 == 1 {
                result = result.wrapping_mul(factor)
            }
            factor = factor.wrapping_mul(factor)
            power = power >> 1
        }
        self.push(result)
    }

    // The dispatch loop's arithmetic, which stops the loop when it fails.
    #[inline(always)]
    fn binary_arith(mut self, _ op: i32) -> bool {
        // The top item is the first EVM operand; the result replaces the
        // second, so the stack shrinks by one without a separate push.
        let len = self.stack.len()
        if len < 2 {
            self.fault(ERR_STACK_UNDERFLOW)
            return false
        }
        // `len` covers both operands.
        let lhs = unsafe { self.stack.get_unchecked(len - 1) }
        let rhs = unsafe { self.stack.get_unchecked(len - 2) }
        let result = match binary_result(op, lhs, rhs) {
            Option::Some(result) => result,
            Option::None => {
                self.invalid(op)
                return false
            },
        }
        // The result is stored before the stack shrinks, so no store comes
        // between the operands' loads and the operation that reads them.
        unsafe {
            self.stack.set_unchecked(len - 2, result)
            self.stack.truncate_unchecked(len - 1)
        }
        true
    }

    // Division, modular arithmetic and EXP.
    fn binary_arith_general(mut self, _ op: i32) {
        // The top item is the first EVM operand.
        let lhs = self.pop()
        let rhs = self.pop()
        if !self.ok() { return }

        match op {
            0x08 => {
                let modulus = self.pop()
                if self.ok() {
                    self.push(addmod(lhs, rhs, modulus))
                }
            },
            0x09 => {
                let modulus = self.pop()
                if self.ok() {
                    self.push(mulmod(lhs, rhs, modulus))
                }
            },
            0x0a => self.exp(base: lhs, exponent: rhs),
            _ => match binary_result(op, lhs, rhs) {
                Option::Some(result) => self.push(result),
                Option::None => self.invalid(op),
            },
        }
    }

    #[inline(always)]
    fn unary(mut self, _ op: i32) -> bool {
        // The result replaces the operand in place.
        let len = self.stack.len()
        if len < 1 {
            self.fault(ERR_STACK_UNDERFLOW)
            return false
        }
        let value = unsafe { self.stack.get_unchecked(len - 1) }
        let result = match unary_result(op, value) {
            Option::Some(result) => result,
            Option::None => {
                self.invalid(op)
                return false
            },
        }
        unsafe { self.stack.set_unchecked(len - 1, result) }
        true
    }

    #[inline(always)]
    fn dup(mut self, _ index: usize) -> bool {
        let len = self.stack.len()
        if len < index {
            self.fault(ERR_STACK_UNDERFLOW)
            return false
        }
        let value = unsafe { self.stack.get_unchecked(len - index) }
        self.pushed(value)
    }

    #[inline(always)]
    fn swap(mut self, _ index: usize) -> bool {
        let len = self.stack.len()
        if len <= index {
            self.fault(ERR_STACK_UNDERFLOW)
            return false
        }
        unsafe {
            let top = self.stack.get_unchecked(len.wrapping_sub(1))
            // `len` exceeds `index`, so neither subtraction wraps.
            let other = self.stack.get_unchecked(len.wrapping_sub(1).wrapping_sub(index))
            self.stack.set_unchecked(len.wrapping_sub(1), other)
            self.stack.set_unchecked(len.wrapping_sub(1).wrapping_sub(index), top)
        }
        true
    }

    fn invalid(mut self, _ op: i32) {
        self.unsupported_opcode = op
        self.fault(ERR_INVALID_OPCODE)
    }

    fn sload(mut self, _ call: CallEnv, _ state: mut Transaction) {
        let slot = self.pop()
        if !self.ok() { return }
        // A warm slot needs no journal entry.
        let warm = state.storage_is_warm(address: call.address, slot)
        if !self.charge(if warm { 100 } else { 2100 }) { return }
        if !warm {
            self.fault(state.warm_slot(address: call.address, slot))
            if !self.ok() { return }
        }
        self.push(state.storage_load(address: call.address, slot))
    }

    fn sstore(mut self, _ call: CallEnv, _ state: mut Transaction) {
        if state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return
        }
        let slot = self.pop()
        let value = self.pop()
        if self.ok() {
            if self.gas_remaining <= 2300 {
                self.fault(ERR_OUT_OF_GAS)
                return
            }
            let charge = state.storage_charge(address: call.address, slot, value)
            if self.charge(charge.gas as u128) {
                self.fault(state.warm_slot(address: call.address, slot))
                if self.ok() { self.fault(state.storage_store(address: call.address, slot, value)) }
            }
        }
    }

    fn tload(mut self, _ call: CallEnv, _ state: Transaction) {
        let slot = self.pop()
        if self.ok() {
            self.push(state.transient_load(address: call.address, slot))
        }
    }

    fn tstore(mut self, _ call: CallEnv, _ state: mut Transaction) {
        if state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return
        }
        let slot = self.pop()
        let value = self.pop()
        if self.ok() {
            self.fault(state.transient_store(address: call.address, slot, value))
        }
    }

    fn extcodecopy(mut self, _ state: mut Transaction) {
        let address = address_word(self.pop())
        let dest = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        let access_gas: u128 = if state.account_is_warm(address) { 100 } else { 2600 }
        if !self.charge(access_gas) { return }
        let plan = match self.plan_memory(offset: dest, len, copying: true) {
            Option::Some(plan) => plan,
            Option::None => return,
        }
        self.fault(state.warm_account(address))
        if !self.ok() || !self.expand_memory(plan.size) || len == 0 { return }
        let size = state.code_size(address) as u256
        let available = if source < size { size - source } else { 0 }
        let copied: u64 = (if len < available { len } else { available }).downcast_unchecked()
        let dest: u64 = dest.downcast_unchecked()
        if copied != 0 {
            self.memory.slice(offset: dest as usize, len: copied as usize)
                .copy_from(state.code(address).slice(offset: source.downcast_unchecked(), len: copied as usize))
        }
        self.zero_memory(from: dest + copied, to: dest + len.downcast_unchecked())
    }

    fn log(mut self, _ topics_count: u64, _ call: CallEnv, _ state: mut Transaction) {
        if state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return
        }
        let offset = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        let plan = match memory_expansion(current: self.memory_size, offset, len) {
            Option::Some(plan) => plan,
            Option::None => {
                self.fault(ERR_OUT_OF_GAS)
                return
            },
        }
        let length: u64 = len.downcast_unchecked()
        if !self.charge(375 + topics_count as u128 * 375 + length as u128 * 8 + plan.gas as u128) { return }
        var topics: [u256; 4] = [0; 4]
        var topic: u64 = 0
        while topic < topics_count {
            topics[topic as usize] = self.pop()
            topic += 1
        }
        if !self.ok() || !self.expand_memory(plan.size) { return }
        let start: usize = if length == 0 { 0 } else { offset.downcast_unchecked() }
        self.fault(state.emit_log(address: call.address, topics, topic_count: topics_count,
                                  data: self.memory.slice(offset: start, len: length as usize)))
    }

    /// BALANCE, EXTCODESIZE and EXTCODEHASH, charging for a cold account.
    fn account_field(mut self, _ op: i32, _ state: mut Transaction) {
        let address = address_word(self.pop())
        if self.ok() {
            let gas: u128 = if state.account_is_warm(address) { 100 } else { 2600 }
            if self.charge(gas) {
                self.fault(state.warm_account(address))
                if self.ok() {
                    let value = if op == 0x31 { state.balance(address) }
                        else if op == 0x3b { state.code_size(address) as u256 }
                        else { state.code_hash(address) }
                    self.push(value)
                }
            }
        }
    }
}


// The root is depth zero; at most 1024 child frames may execute beneath it.
pub const CALL_DEPTH_LIMIT: usize = 1024
// EIP-170 deployed code and EIP-3860 initcode limits.
const MAX_CODE_SIZE: u64 = 24576
const MAX_INITCODE_SIZE: u256 = 49152

struct Frame {
    vm: Vm,
    program: Program,
    calldata: InputData,
    call: CallEnv,
    checkpoint: Checkpoint,
    output_offset: u64,
    output_len: u64,
    // CREATE frames deposit their output as code at `call.address`.
    creates: bool,
}

struct ChildResult { result: ExecutionResult, offset: u64, len: u64, creates: bool, address: u256 }

impl Frame {
    fn resume(mut self, _ block: BlockEnv, _ state: mut Transaction, depth: usize) -> Option<Frame> {
        self.vm.run_until_child(self.program, self.calldata, self.call, block, mut state, depth)
    }

    fn finish(var own self, _ state: mut Transaction) -> ChildResult {
        let creates = self.creates
        let address = self.call.address
        if creates && self.vm.status == OK { self.vm.deposit_code(address, mut state) }
        if self.vm.status == OK { state.commit(self.checkpoint) }
        else { state.revert(self.checkpoint) }
        ChildResult { result: self.vm.into_result(mut state.frame_buffers()), offset: self.output_offset, len: self.output_len, creates, address }
    }

    fn abort(own self, _ state: mut Transaction) {
        state.revert(self.checkpoint)
    }
}

fn exceptional(_ status: i32) -> bool {
    status == ERR_STACK_UNDERFLOW || status == ERR_STACK_OVERFLOW
        || status == ERR_INVALID_JUMP || status == ERR_INVALID_OPCODE
        || status == ERR_RETURN_DATA_OOB || status == ERR_STATIC_WRITE
        || status == ERR_OUT_OF_GAS || status == ERR_CODE_PREFIX || status == ERR_PRECOMPILE
}

/// Move ether as the specification's move_ether, writing (and touching) both
/// accounts even for a self-transfer. The sender must hold `value`.
pub fn transfer(_ state: mut Transaction, from: u256, to: u256, value: u256) -> i32 {
    let available = state.balance(from)
    core::assert(available >= value)
    // A self-transfer changes no balance, so static frames may perform it.
    if from == to { return state.touch(from) }
    if value > !(0 as u256) - state.balance(to) { return ERR_BALANCE_OVERFLOW }
    let status = state.set_balance(address: from, value: available - value)
    if status != OK { return status }
    state.set_balance(address: to, value: state.balance(to) + value)
}

/// Copy an account's code into an analyzed program.
pub fn load_program(_ state: Transaction, address: u256) -> Program {
    Program::analyzed(state.code(address), jumpdests: state.jumpdests(address))
}

/// Open a contract creation's checkpoint and apply its prologue: the creation
/// mark, the new account's first nonce and its endowment. Initcode failure or a
/// rejected deposit reverts all of it.
pub fn begin_create(_ state: mut Transaction, sender: u256, address: u256, value: u256) -> Result<i32, Checkpoint> {
    let checkpoint = state.checkpoint(is_static: false)
    var status = state.mark_created(address)
    if status == OK { status = state.increment_nonce(address) }
    if status == OK && value != 0 { status = transfer(mut state, from: sender, to: address, value) }
    if status == OK { return Result::Ok(checkpoint) }
    state.revert(checkpoint)
    Result::Err(status)
}

/// Run a precompile and express its outcome as a frame result. Invalid input and
/// insufficient gas are exceptional halts that consume all `gas`; unsupported
/// input sizes and allocation failures are host errors.
pub fn run_precompile(address: u256, input: InputData, gas: u64) -> ExecutionResult {
    let outcome = fevm_precompiles::run(address, input, gas)
    let status = if outcome.status == SUCCESS { OK }
        else if outcome.status == FAILURE { ERR_PRECOMPILE }
        else { ERR_HOST_ALLOCATION }
    let gas_remaining = if status == OK { gas - outcome.gas_used } else { 0 }
    ExecutionResult {
        status,
        output: outcome.output,
        gas_remaining,
        refund_delta: 0,
        output_valid: status == OK,
        stack_top: 0,
        stack_len: 0,
        unsupported_opcode: 0,
    }
}

/// Outcomes defined by the EVM: success, revert and exceptional halts. Every
/// other status is a host failure that aborts the whole execution.
pub fn is_evm_outcome(_ status: i32) -> bool {
    status == OK || status == ERR_REVERT || exceptional(status)
}

/// A result without output or remaining gas, for messages that never run code.
pub fn status_result(_ status: i32) -> ExecutionResult {
    ExecutionResult {
        status, output: MemBuffer::empty(), gas_remaining: 0, refund_delta: 0,
        output_valid: false, stack_top: 0, stack_len: 0, unsupported_opcode: 0,
    }
}

impl Vm {
    fn accept_child(mut self, _ child: own ChildResult) {
        let result = child.result
        if !is_evm_outcome(result.status) {
            // Host failures and unfinished VM features abort the execution. They
            // must never be reported to EVM code as an ordinary failed CALL.
            self.unsupported_opcode = result.unsupported_opcode
            self.fault(result.status)
            return
        }
        if result.status == OK || result.status == ERR_REVERT {
            self.gas_remaining += result.gas_remaining
        }
        if child.creates {
            // A successful creation leaves the return data empty; a failed one
            // exposes its revert data.
            self.push(if result.status == OK { child.address } else { 0 })
            if result.status == OK { return }
        } else {
            let available = result.output.len()
            let count = if (child.len as usize) < available { child.len as usize } else { available }
            self.memory.slice(offset: child.offset as usize, len: count).copy_from(result.output.slice(offset: 0, len: count))
            self.push_bool(result.status == OK)
        }
        self.return_data = result.output
    }

    // Deposit successful initcode output: EIP-3541 prefix, 200 gas per byte and
    // the EIP-170 size limit. A rejected deposit is an exceptional halt.
    fn deposit_code(mut self, address: u256, _ state: mut Transaction) {
        let len: u64 = self.output.len().downcast_unchecked()
        if len > 0 && self.output[0] == 0xef {
            self.fault(ERR_CODE_PREFIX)
        } else if len > MAX_CODE_SIZE || !self.charge(len as u128 * 200) {
            self.fault(ERR_OUT_OF_GAS)
        } else {
            self.fault(state.deploy_code(address, code: self.output.span()))
        }
        if !self.ok() {
            self.output.clear()
            self.output_valid = false
        }
    }

    fn start_call(mut self, op: i32, _ call: CallEnv, _ state: mut Transaction, depth: usize) -> Option<Frame> {
        let requested = self.pop()
        let code_address = address_word(self.pop())
        let sender = address_word(call.address)
        let transfers = op == 0xf1 || op == 0xf2
        let value = if transfers { self.pop() } else { 0 }
        if !self.ok() { return Option::None }
        if op == 0xf1 && value != 0 && state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return Option::None
        }
        let input_offset = self.pop()
        let input_len = self.pop()
        let output_offset = self.pop()
        let output_len = self.pop()
        if !self.ok() { return Option::None }
        // Zero-length ranges ignore their offsets, including oversized words.
        for (offset, len) in [(input_offset, input_len), (output_offset, output_len)] {
            match self.plan_memory(offset, len, copying: false) {
                Option::Some(plan) => if !self.expand_memory(plan.size) { return Option::None },
                Option::None => return Option::None,
            }
        }
        let has_value = transfers && value != 0
        if !self.charge(100 + if has_value { 9000 } else { 0 }) { return Option::None }
        let cold = !state.account_is_warm(code_address)
        let empty = state.is_empty(code_address)
        let access_status = state.warm_account(address: code_address)
        if access_status != OK {
            self.fault(access_status)
            return Option::None
        }
        // EIP-7702: a delegated account runs its delegate's code, whose access is charged too.
        let delegate = state.delegate(code_address)
        var delegate_access: u128 = 0
        if let Option::Some(delegate) = delegate {
            delegate_access = if state.account_is_warm(delegate) { 100 } else { 2600 }
            let warmed = state.warm_account(address: delegate)
            if warmed != OK {
                self.fault(warmed)
                return Option::None
            }
        }
        let extra: u128 = (if cold { 2500 } else { 0 }) + delegate_access
            + if op == 0xf1 && has_value && empty { 25000 } else { 0 }
        if !self.charge(extra) { return Option::None }
        let cap = self.gas_remaining - self.gas_remaining / 64
        let forwarded: u64 = if requested < cap as u256 { requested.downcast_unchecked() } else { cap }
        self.gas_remaining -= forwarded
        let child_gas = forwarded + if has_value { 2300 } else { 0 }
        self.return_data.clear()
        // Target warming belongs to the caller checkpoint, including failures.
        if depth == CALL_DEPTH_LIMIT || (transfers && state.balance(sender) < value) {
            self.gas_remaining += child_gas
            self.push(0)
            return Option::None
        }
        let address = if op == 0xf2 || op == 0xf4 { sender } else { code_address }
        let is_static = state.is_static() || op == 0xfa
        let checkpoint = state.checkpoint(is_static)
        // The call touches its target even without value; a failed call undoes the touch.
        let moved = if has_value { transfer(mut state, from: sender, to: address, value) } else { state.touch(address) }
        if moved != OK {
            state.revert(checkpoint)
            self.fault(moved)
            return Option::None
        }
        let out_offset: u64 = if output_len == 0 { 0 } else { output_offset.downcast_unchecked() }
        let out_len: u64 = output_len.downcast_unchecked()
        let calldata = InputData::copy_bytes(self.memory.slice(
            offset: if input_len == 0 { 0 } else { input_offset.downcast_unchecked() },
            len: input_len.downcast_unchecked(),
        ))
        if calldata.status != OK {
            self.fault(calldata.status)
            state.revert(checkpoint)
            return Option::None
        }
        if delegate.is_none() && is_precompile(code_address) {
            let result = run_precompile(address: code_address, input: calldata, gas: child_gas)
            if result.status == OK { state.commit(checkpoint) } else { state.revert(checkpoint) }
            self.accept_child(ChildResult { result, offset: out_offset, len: out_len, creates: false, address: code_address })
            return Option::None
        }
        // A delegate that is a precompile runs nothing.
        let program_address = match delegate { Option::Some(delegate) => delegate, Option::None => code_address }
        let code_len = if delegate.is_some() && is_precompile(program_address) { 0 } else { state.code_size(program_address) }
        if code_len == 0 {
            state.commit(checkpoint)
            self.gas_remaining += child_gas
            self.push(1)
            return Option::None
        }
        let program = load_program(state, address: program_address)
        if program.status != OK {
            self.fault(program.status)
            state.revert(checkpoint)
            return Option::None
        }
        let child_call = CallEnv {
            address, caller: if op == 0xf4 { address_word(call.caller) } else { sender },
            callvalue: if op == 0xf4 { call.callvalue } else { value },
            origin: call.origin, gasprice: call.gasprice, gas_limit: child_gas, is_static,
        }
        var vm = Vm::new()
        vm.gas_remaining = child_gas
        Option::Some(Frame { vm, program, calldata, call: child_call, checkpoint,
            output_offset: out_offset, output_len: out_len, creates: false })
    }

    fn start_create(mut self, op: i32, _ call: CallEnv, _ state: mut Transaction, depth: usize) -> Option<Frame> {
        let value = self.pop()
        let offset = self.pop()
        let len = self.pop()
        let salt = if op == 0xf5 { self.pop() } else { 0 }
        if !self.ok() { return Option::None }
        let plan = match self.plan_memory(offset, len, copying: false) {
            Option::Some(plan) => plan,
            Option::None => return Option::None,
        }
        // A successful plan bounds a nonempty range below 2^42 bytes.
        let words: u128 = ((len + 31) / 32).downcast_unchecked()
        // 32,000 gas, two per initcode word (EIP-3860), and six per word hashed by CREATE2.
        let cost = 32000 + words * if op == 0xf5 { 8 } else { 2 }
        if !self.charge(cost) || !self.expand_memory(plan.size) { return Option::None }
        if len > MAX_INITCODE_SIZE {
            self.fault(ERR_OUT_OF_GAS)
            return Option::None
        }
        let count: usize = len.downcast_unchecked()
        let start: usize = if count == 0 { 0 } else { offset.downcast_unchecked() }
        let sender = address_word(call.address)
        let address = if op == 0xf0 {
            create_address(sender, nonce: state.nonce(sender))
        } else {
            var hash = Keccak256::new()
            hash.update(self.memory, offset: start, len: count)
            create2_address(sender, salt, code_hash: hash.finish_word())
        }
        let create_gas = self.gas_remaining - self.gas_remaining / 64
        self.gas_remaining -= create_gas
        if state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return Option::None
        }
        self.return_data.clear()
        if state.balance(sender) < value || state.nonce(sender) == 0xffffffffffffffff || depth == CALL_DEPTH_LIMIT {
            self.gas_remaining += create_gas
            self.push(0)
            return Option::None
        }
        self.fault(state.warm_account(address))
        if !self.ok() { return Option::None }
        // A collision with existing code or nonce consumes the forwarded gas.
        if !state.deployable(address) {
            self.fault(state.increment_nonce(sender))
            self.push(0)
            return Option::None
        }
        self.fault(state.increment_nonce(sender))
        if !self.ok() { return Option::None }
        let checkpoint = match begin_create(mut state, sender, address, value) {
            Result::Ok(checkpoint) => checkpoint,
            Result::Err(status) => {
                self.fault(status)
                return Option::None
            },
        }
        let program = Program::new(InputData::copy_bytes(self.memory.slice(offset: start, len: count)))
        if program.status != OK {
            self.fault(program.status)
            state.revert(checkpoint)
            return Option::None
        }
        let child_call = CallEnv {
            address, caller: sender, callvalue: value, origin: call.origin,
            gasprice: call.gasprice, gas_limit: create_gas, is_static: false,
        }
        var vm = Vm::new()
        vm.gas_remaining = create_gas
        Option::Some(Frame { vm, program, calldata: empty_bytes(), call: child_call, checkpoint,
            output_offset: 0, output_len: 0, creates: true })
    }

    // EIP-6780: the balance moves to the beneficiary; only an account created by
    // this transaction is deleted, at settlement, and loses ether sent to itself.
    fn selfdestruct(mut self, _ call: CallEnv, _ state: mut Transaction) {
        let beneficiary = address_word(self.pop())
        if !self.ok() { return }
        let me = address_word(call.address)
        let balance = state.balance(me)
        var gas: u128 = 5000
        if !state.account_is_warm(beneficiary) { gas += 2600 }
        if state.is_empty(beneficiary) && balance != 0 { gas += 25000 }
        if !self.charge(gas) { return }
        self.fault(state.warm_account(address: beneficiary))
        if !self.ok() { return }
        if state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return
        }
        var status = transfer(mut state, from: me, to: beneficiary, value: balance)
        if status == OK && state.was_created(me) {
            status = state.set_balance(address: me, value: 0)
            if status == OK { status = state.doom(me) }
        }
        self.fault(status)
        if self.ok() { self.halted = true }
    }

    // Opcodes that need nothing but the stack, memory and the code run as
    // handlers, each of which ends by dispatching the next opcode itself, so
    // dispatch is one indirect tail call and `pc`, gas and the stack depth
    // stay in argument registers instead of a loop body Cranelift spills
    // them across. Each handler gets the opcode's own `pc`. `self.stack`'s
    // length is stale while they run: they keep `depth` words initialized
    // from `self.stack.ptr()` up, and store it with `pc` and gas when the
    // frame stops, reaches an opcode `run_until_child` runs, or calls code
    // that uses the stack. `pc` stays within the code and its padding, far
    // from overflow.
    #[inline(never)]
    fn dispatch(mut self, _ code: *u8, _ pc: usize, _ gas: u64) {
        self.next(code, pc, gas, self.stack.len())
    }

    // Every arm tail-calls a handler with the same arguments, which Sonatina
    // turns into a table of handlers.
    #[inline(always)]
    fn next(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        let op = unsafe { read_code<u8>(code, pc) } as i32
        match op {
            0x00 => self.op_stop(code, pc, gas, depth),
            0x04 => self.op_div(code, pc, gas, depth),
            0x05 => self.op_sdiv(code, pc, gas, depth),
            0x06 => self.op_mod(code, pc, gas, depth),
            0x07 => self.op_smod(code, pc, gas, depth),
            0x08 => self.op_addmod(code, pc, gas, depth),
            0x09 => self.op_mulmod(code, pc, gas, depth),
            0x0a => self.op_general(code, pc, gas, depth),
            0x5f => self.op_push0(code, pc, gas, depth),
            0x60 => self.op_push1(code, pc, gas, depth),
            0x61 => self.op_push2(code, pc, gas, depth),
            0x63 => self.op_push4(code, pc, gas, depth),
            0x7f => self.op_push32(code, pc, gas, depth),
            0x62 | 0x64 | 0x65 | 0x66 | 0x67 | 0x68 | 0x69 | 0x6a | 0x6b | 0x6c | 0x6d | 0x6e | 0x6f | 0x70 | 0x71 | 0x72 | 0x73 | 0x74 | 0x75 | 0x76 | 0x77 | 0x78 | 0x79 | 0x7a | 0x7b | 0x7c | 0x7d | 0x7e => self.op_push_wide(code, pc, gas, depth),
            0x50 => self.op_pop(code, pc, gas, depth),
            0x80 => self.op_dup1(code, pc, gas, depth),
            0x81 => self.op_dup2(code, pc, gas, depth),
            0x82 => self.op_dup3(code, pc, gas, depth),
            0x83 => self.op_dup4(code, pc, gas, depth),
            0x84 => self.op_dup5(code, pc, gas, depth),
            0x85 => self.op_dup6(code, pc, gas, depth),
            0x86 => self.op_dup7(code, pc, gas, depth),
            0x87 => self.op_dup8(code, pc, gas, depth),
            0x88 => self.op_dup9(code, pc, gas, depth),
            0x89 => self.op_dup10(code, pc, gas, depth),
            0x8a => self.op_dup11(code, pc, gas, depth),
            0x8b => self.op_dup12(code, pc, gas, depth),
            0x8c => self.op_dup13(code, pc, gas, depth),
            0x8d => self.op_dup14(code, pc, gas, depth),
            0x8e => self.op_dup15(code, pc, gas, depth),
            0x8f => self.op_dup16(code, pc, gas, depth),
            0x90 => self.op_swap1(code, pc, gas, depth),
            0x91 => self.op_swap2(code, pc, gas, depth),
            0x92 => self.op_swap3(code, pc, gas, depth),
            0x93 => self.op_swap4(code, pc, gas, depth),
            0x94 => self.op_swap5(code, pc, gas, depth),
            0x95 => self.op_swap6(code, pc, gas, depth),
            0x96 => self.op_swap7(code, pc, gas, depth),
            0x97 => self.op_swap8(code, pc, gas, depth),
            0x98 => self.op_swap9(code, pc, gas, depth),
            0x99 => self.op_swap10(code, pc, gas, depth),
            0x9a => self.op_swap11(code, pc, gas, depth),
            0x9b => self.op_swap12(code, pc, gas, depth),
            0x9c => self.op_swap13(code, pc, gas, depth),
            0x9d => self.op_swap14(code, pc, gas, depth),
            0x9e => self.op_swap15(code, pc, gas, depth),
            0x9f => self.op_swap16(code, pc, gas, depth),
            0x01 => self.op_add(code, pc, gas, depth),
            0x02 => self.op_mul(code, pc, gas, depth),
            0x03 => self.op_sub(code, pc, gas, depth),
            0x0b => self.op_signextend(code, pc, gas, depth),
            0x10 => self.op_lt(code, pc, gas, depth),
            0x11 => self.op_gt(code, pc, gas, depth),
            0x12 => self.op_slt(code, pc, gas, depth),
            0x13 => self.op_sgt(code, pc, gas, depth),
            0x14 => self.op_eq(code, pc, gas, depth),
            0x15 => self.op_iszero(code, pc, gas, depth),
            0x16 => self.op_and(code, pc, gas, depth),
            0x17 => self.op_or(code, pc, gas, depth),
            0x18 => self.op_xor(code, pc, gas, depth),
            0x19 => self.op_not(code, pc, gas, depth),
            0x1e => self.op_clz(code, pc, gas, depth),
            0x1a => self.op_byte(code, pc, gas, depth),
            0x1b => self.op_shl(code, pc, gas, depth),
            0x1c => self.op_shr(code, pc, gas, depth),
            0x1d => self.op_sar(code, pc, gas, depth),
            0x51 => self.op_mload(code, pc, gas, depth),
            0x52 => self.op_mstore(code, pc, gas, depth),
            0x56 => self.op_jump(code, pc, gas, depth),
            0x57 => self.op_jumpi(code, pc, gas, depth),
            0x58 => self.op_pc(code, pc, gas, depth),
            0x59 => self.op_msize(code, pc, gas, depth),
            0x5a => self.op_gas(code, pc, gas, depth),
            0x5b => self.op_jumpdest(code, pc, gas, depth),
            _ => self.op_other(code, pc, gas, depth),
        }
    }

    // The handlers that leave stay out of line, so every arm of `next` is a
    // tail call.
    #[inline(never)]
    fn op_stop(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.halted = true
        self.stopped_at(pc.wrapping_add(1), gas, depth)
    }

    // Leaves the opcode to `run_until_child`.
    #[inline(never)]
    fn op_other(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.stopped_at(pc, gas, depth)
    }

    fn op_add(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x01)
    }

    fn op_mul(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 5, op: 0x02)
    }

    fn op_sub(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x03)
    }

    fn op_signextend(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 5, op: 0x0b)
    }

    fn op_lt(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x10)
    }

    fn op_gt(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x11)
    }

    fn op_slt(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x12)
    }

    fn op_sgt(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x13)
    }

    fn op_eq(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x14)
    }

    fn op_and(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x16)
    }

    fn op_or(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x17)
    }

    fn op_xor(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x18)
    }

    fn op_byte(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x1a)
    }

    fn op_shl(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x1b)
    }

    fn op_shr(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
