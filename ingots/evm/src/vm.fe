    }

    fn op_sar(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 3, op: 0x1d)
    }

    fn op_iszero(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_unary(code, pc, gas, depth, cost: 3, op: 0x15)
    }

    fn op_not(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_unary(code, pc, gas, depth, cost: 3, op: 0x19)
    }

    fn op_clz(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_unary(code, pc, gas, depth, cost: 5, op: 0x1e)
    }

    fn op_div(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 5, op: 0x04)
    }

    fn op_sdiv(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 5, op: 0x05)
    }

    fn op_mod(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 5, op: 0x06)
    }

    fn op_smod(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_binary(code, pc, gas, depth, cost: 5, op: 0x07)
    }

    fn op_addmod(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_modular(code, pc, gas, depth, op: 0x08)
    }

    fn op_mulmod(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_modular(code, pc, gas, depth, op: 0x09)
    }

    // ADDMOD and MULMOD: the top two words' sum or product modulo the third
    // replaces the third.
    #[inline(always)]
    fn op_modular(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, op: i32) {
        if gas < 8 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 3 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 8, depth)
        }
        let third = slot(self.stack.ptr(), depth - 3)
        unsafe {
            let lhs = *offset_bytes(third, 64)
            let rhs = *offset_bytes(third, 32)
            *third = if op == 0x08 { addmod(lhs, rhs, *third) } else { mulmod(lhs, rhs, *third) }
        }
        self.next(code, pc.wrapping_add(1), gas - 8, depth - 2)
    }

    // EXP calls out, but stays in the handlers rather than returning to
    // `run_until_child`.
    fn op_general(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        let op = unsafe { read_code<u8>(code, pc) } as i32
        let cost = base_cost(op)
        if gas < cost {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.gas_remaining = gas - cost
        unsafe { self.stack.set_len(depth) }
        self.binary_arith_general(op)
        let gas = self.gas_remaining
        if !self.ok() {
            return self.stopped_at(pc.wrapping_add(1), gas, self.stack.len())
        }
        self.next(code, pc.wrapping_add(1), gas, self.stack.len())
    }

    fn stopped_at(mut self, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.pc = pc
        self.gas_remaining = gas
        // The handlers kept `depth` words initialized, within the reserved
        // `STACK_LIMIT`.
        unsafe { self.stack.set_len(depth) }
    }

    fn faulted_at(mut self, _ status: i32, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.fault(status)
        self.stopped_at(pc, gas, depth)
    }

    // Pushes `value` and runs the opcode at `pc`, the one after the push.
    #[inline(always)]
    fn push_next(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ value: u256) {
        if depth >= STACK_LIMIT {
            return self.faulted_at(ERR_STACK_OVERFLOW, pc, gas, depth)
        }
        unsafe { *slot(self.stack.ptr(), depth) = value }
        self.next(code, pc, gas, depth + 1)
    }

    fn op_push0(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.push_next(code, pc.wrapping_add(1), gas - 2, depth, 0)
    }

    // The common widths read just their immediate; padding gives every
    // immediate a whole word of code after it.
    fn op_push1(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let value = unsafe { read_code<u8>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(2), gas - 3, depth, value as u256)
    }

    fn op_push2(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let value = unsafe { read_code<u16>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(3), gas - 3, depth, value as u256)
    }

    fn op_push4(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let value = unsafe { read_code<u32>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(5), gas - 3, depth, value as u256)
    }

    fn op_push32(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let value = unsafe { read_code<u256>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(33), gas - 3, depth, value)
    }

    fn op_push_wide(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        let op = unsafe { read_code<u8>(code, pc) }
        let n: usize = (op.wrapping_sub(0x5f) & 0x1f) as usize
        let word = unsafe { read_code<u256>(code, pc.wrapping_add(1)) }
        self.push_next(code, pc.wrapping_add(1 + n), gas - 3, depth, word >> ((32 - n) * 8) as u256)
    }

    fn op_pop(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 1 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 2, depth)
        }
        self.next(code, pc.wrapping_add(1), gas - 2, depth - 1)
    }

    fn op_dup1(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 1)
    }

    fn op_dup2(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 2)
    }

    fn op_dup3(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 3)
    }

    fn op_dup4(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 4)
    }

    fn op_dup5(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 5)
    }

    fn op_dup6(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 6)
    }

    fn op_dup7(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 7)
    }

    fn op_dup8(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
