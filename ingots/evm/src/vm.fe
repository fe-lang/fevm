use core::{Box, MemBuffer, MemVec, Option}
use keccak::Keccak256
use ingot::memory::{MemoryExpansion, SMALL_EXTENT, memory_expansion, copy_expansion, copy_gas, small_growth_cost}
use ingot::gas::base_cost
use ingot::state::{StorageKey, WorldState, address_word}
use swisstable::SwissTable
use core::ops::{WrappingAdd, WrappingMul, WrappingSub}
use ingot::constants::STACK_LIMIT
use ingot::journal::Journal
use ingot::transaction::Transaction
use ingot::trace::Tracer
use ingot::types::{BlockEnv, InputData, CallEnv, ExecutionResult, Program, default_call_env, empty_bytes}
use ingot::status::{ERR_HOST_ALLOCATION, ERR_INVALID_OPCODE, ERR_OUT_OF_GAS, ERR_RETURN_DATA_OOB, ERR_REVERT, ERR_STACK_OVERFLOW, ERR_STACK_UNDERFLOW, ERR_STATIC_WRITE, OK, exceptional}
use frames::Frame
pub use frames::{CALL_DEPTH_LIMIT, begin_create, run_precompile, status_result, transfer}

// Charges `cost` against `gas`, or fails without charging.
fn spend(_ gas: mut u64, _ cost: u64) -> bool {
    if cost > gas {
        return false
    }
    gas -= cost
    true
}

/// Allocations a host lends each transaction and gets back, so that a host
/// that keeps them across transactions allocates them once: memory and
/// stacks of finished frames, which later frames take over with the capacity
/// they grew; the allocations of finished child frames, which later calls fill
/// in place; and the journal. Frames nest, so each call depth tends to get
/// back its last frame's buffers.
pub struct Buffers {
    memories: MemVec<MemBuffer>,
    stacks: MemVec<MemVec<u256>>,
    frames: MemVec<Box<Frame>>,
    // Empty between transactions.
    pub(ingot) journal: Journal,
    // A transaction's tables, empty between transactions, which keep their
    // slots for the next one. `transient` is EIP-1153 transient storage.
    // `marks` holds warm accounts, other than those `always_warm` names;
    // touched accounts, which settlement removes if left empty with the
    // journal's other touches, its balance, nonce and code changes (the
    // specification's modify_state deletion rule); accounts created by this
    // transaction (created_accounts); and the self-destructed ones among
    // those, which settlement deletes.
    pub(ingot) transient: SwissTable<StorageKey, u256>,
    pub(ingot) marks: SwissTable<u256, u8>,
    pub(ingot) warm_storage: SwissTable<StorageKey, bool>,
    pub(ingot) originals: SwissTable<StorageKey, u256>,
}

impl Buffers {
    pub fn new() -> Self {
        Buffers {
            memories: MemVec::new(),
            stacks: MemVec::new(),
            frames: MemVec::new(),
            journal: Journal::new(),
            transient: SwissTable<StorageKey, u256>::empty(),
            marks: SwissTable<u256, u8>::empty(),
            warm_storage: SwissTable<StorageKey, bool>::empty(),
            originals: SwissTable<StorageKey, u256>::empty(),
        }
    }
}

pub struct Vm {
    // EVM memory is the first `memory_size` bytes of `memory`, whose bytes
    // past it stay zero, so most growth only moves the size.
    pub memory: MemBuffer,
    pub memory_size: u64,
    pub output: MemBuffer,
    pub return_data: MemBuffer,
    pub gas_remaining: u64,
    pub refund_delta: i128,
    pub output_valid: bool,
    // On the heap, so moving a frame does not copy it.
    pub stack: MemVec<u256>,
    pub pc: usize,
    pub status: i32,
    pub halted: bool,
    // The running code's JUMPDEST bitmap and the length it covers, and the
    // frame's call depth, which `run_until_child` sets for the opcode handlers.
    jumpdests: *u8,
    jump_limit: usize,
    call_depth: usize,
    // The running code's length and the frame's calldata, for the copy handlers.
    code_len: usize,
    calldata: *u8,
    calldata_len: usize,
    // The frame's call and the block, which the environment handlers push.
    call: CallEnv,
    block: BlockEnv,
    // The transaction's blob hashes, for BLOBHASH.
    blob_hashes: *u256,
    blob_count: usize,
}

impl Vm {
    pub fn new() -> Self {
        Vm {
            memory: MemBuffer::empty(),
            memory_size: 0,
            output: MemBuffer::empty(),
            return_data: MemBuffer::empty(),
            gas_remaining: 0,
            refund_delta: 0,
            output_valid: false,
            stack: MemVec::new(),
            pc: 0,
            status: OK,
            halted: false,
            jumpdests: (0 as usize) as *u8,
            jump_limit: 0,
            call_depth: 0,
            code_len: 0,
            calldata: (0 as usize) as *u8,
            calldata_len: 0,
            call: default_call_env(),
            block: BlockEnv {
                coinbase: 0, timestamp: 0, number: 0, prevrandao: 0, gaslimit: 0, chainid: 0, basefee: 0, blobbasefee: 0,
            },
            blob_hashes: (0 as usize) as *u256,
            blob_count: 0,
        }
    }

    fn ok(self) -> bool {
        self.status == OK
    }

    // A frame that has allocated nothing takes over a finished frame's
    // memory and stack, which hold no bytes or words.
    fn adopt(mut self) uses (buffers: mut Buffers) {
        if self.memory.capacity() == 0 {
            match buffers.memories.pop() {
                Option::Some(memory) => self.memory = memory,
                Option::None => {},
            }
        }
        if self.stack.capacity() == 0 {
            match buffers.stacks.pop() {
                Option::Some(stack) => self.stack = stack,
                Option::None => {},
            }
        }
    }

    // Start a frame with `gas` and empty memory, stack, output and return data.
    fn reset(mut self, gas: u64) {
        self.memory.clear()
        self.memory_size = 0
        self.output.clear()
        self.return_data.clear()
        self.output_valid = false
        self.stack.clear()
        self.pc = 0
        self.status = OK
        self.halted = false
        self.gas_remaining = gas
        self.refund_delta = 0
    }

    fn fault(mut self, _ status: i32) {
        if self.status == OK {
            self.status = status
            if exceptional(status) { self.gas_remaining = 0 }
        }
    }

    fn push(mut self, _ value: u256) {
        if self.stack.len() >= STACK_LIMIT {
            self.fault(ERR_STACK_OVERFLOW)
            return
        }
        // `run_until_child` reserves room for `STACK_LIMIT` words.
        unsafe { self.stack.push_unchecked(value) }
    }

    // `push` for the dispatch loop, which stops when it fails.
    fn pushed(mut self, _ value: u256) -> bool {
        if self.stack.len() >= STACK_LIMIT {
            self.fault(ERR_STACK_OVERFLOW)
            return false
        }
        unsafe { self.stack.push_unchecked(value) }
        true
    }

    fn pop(mut self) -> u256 {
        match self.stack.pop() {
            Option::Some(value) => value,
            Option::None => {
                self.fault(ERR_STACK_UNDERFLOW)
                0
            },
        }
    }

    /// Faults unless the stack holds `count` words, which `take` then pops
    /// with no check of its own: one check for an opcode's operands, where
    /// `pop` checks each and keeps the stack's length in memory across them.
    fn holds(mut self, _ count: usize) -> bool {
        if self.stack.len() < count {
            self.fault(ERR_STACK_UNDERFLOW)
            return false
        }
        true
    }

    /// The top word, popped from a stack `holds` checked.
    fn take(mut self) -> u256 {
        let top = self.stack.len().wrapping_sub(1)
        let word = unsafe { self.stack.get_unchecked(top) }
        unsafe { self.stack.set_len(top) }
        word
    }

    fn push_bool(mut self, _ value: bool) {
        if value { self.push(1) } else { self.push(0) }
    }

    fn charge(mut self, _ amount: u128) -> bool {
        if amount > self.gas_remaining as u128 {
            self.fault(ERR_OUT_OF_GAS)
            return false
        }
        self.gas_remaining -= amount.downcast_unchecked()
        true
    }

    // Plan and charge before converting EVM words or touching host allocation.
    fn plan_memory(mut self, offset: u256, len: u256, copying: bool) -> Option<MemoryExpansion> {
        // A range within active memory grows nothing; only copy gas applies.
        let size = self.memory_size
        let plan = if len <= size as u256 && self.in_memory(offset, len: len.downcast_unchecked()) {
            MemoryExpansion { size, gas: 0 }
        } else {
            match memory_expansion(current: size, offset, len) {
                Option::Some(plan,) => plan,
                Option::None => {
                    self.fault(ERR_OUT_OF_GAS)
                    return Option::None
                },
            }
        }
        if self.charge_expansion(plan, len, copying) { Option::Some(plan) } else { Option::None }
    }

    fn charge_expansion(mut self, _ plan: MemoryExpansion, len: u256, copying: bool) -> bool {
        var gas = plan.gas as u128
        if copying {
            match copy_gas(len) {
                Option::Some(cost,) => gas += cost as u128,
                Option::None => {
                    self.fault(ERR_OUT_OF_GAS)
                    return false
                },
            }
        }
        self.charge(gas)
    }

    // Copies pad past their source with zeros.
    fn zero_memory(mut self, from: u64, to: u64) {
        self.memory.slice(offset: from.downcast_truncate(), len: (to - from).downcast_truncate()).zero()
    }

    // Grows memory to a planned size, at least its current one. A buffer
    // too small doubles, or takes just the size if doubling fails.
    // Expansion plans never shrink memory, so a plan of the current size
    // changes nothing.
    fn expand_memory(mut self, _ size: u64) -> bool {
        size == self.memory_size || self.resize_memory(size)
    }

    fn resize_memory(mut self, _ size: u64) -> bool {
        let len: u64 = self.memory.len().downcast_unchecked()
        if size > len {
            let doubled = 2 * len
            if !(doubled > size && self.memory.try_resize(doubled.downcast_truncate()))
                && !self.memory.try_resize(size.downcast_truncate()) {
                self.fault(ERR_HOST_ALLOCATION)
                return false
            }
        }
        self.memory_size = size
        true
    }

    fn sha3(mut self) {
        if !self.holds(2) { return }
        let offset = self.take()
        let len = self.take()
        // A range within active memory pays only the per-word gas.
        if len <= self.memory_size as u256 && self.in_memory(offset, len: len.downcast_unchecked()) {
            let words: u64 = (len / 32 + if len % 32 == 0 { 0 } else { 1 }).downcast_unchecked()
            if !self.charge(words as u128 * 6) { return }
        } else {
            match memory_expansion(current: self.memory_size, offset, len) {
                Option::Some(plan,) => {
                    // A successful plan bounds every nonempty range below 2^42.
                    // Charge the whole operation before allocating or narrowing offsets.
                    let words: u64 = (len / 32 + if len % 32 == 0 { 0 } else { 1 }).downcast_unchecked()
                    let gas = plan.gas as u128 + words as u128 * 6
                    if !self.charge(gas) || !self.expand_memory(plan.size) { return }
                },
                Option::None => {
                    self.fault(ERR_OUT_OF_GAS)
                    return
                },
            }
        }
        self.push(self.hash_memory(offset, len))
    }

    // The Keccak-256 hash of `len` bytes of memory at `offset`, a range
    // within memory.
    fn hash_memory(self, _ offset: u256, _ len: u256) -> u256 {
        var hash = Keccak256::new()
        if len != 0 {
            hash.update(self.memory, offset: offset.downcast_unchecked(), len: len.downcast_unchecked())
        }
        hash.finish_word()
    }

    // An access within active memory needs no charge or growth.
    fn in_memory(self, _ offset: u256, len: u64) -> bool {
        let size = self.memory_size
        size >= len && offset <= (size - len) as u256
    }

    // The word-rounded size covering a range that `in_memory` rejected, when
    // the buffer already holds it and the offset is below SMALL_EXTENT, or zero.
    fn buffered_growth(self, _ offset: u256, len: u64) -> u64 {
        if offset >= SMALL_EXTENT as u256 {
            return 0
        }
        let start: u64 = offset.downcast_unchecked()
        let size = (start + len + 31) / 32 * 32
        let bytes: usize = size.downcast_truncate()
        if bytes > self.memory.len() { 0 } else { size }
    }

    // Grows memory to cover a range that `in_memory` rejected. Below
    // SMALL_EXTENT the range also ends past active memory, and both sizes'
    // gas needs only u64 arithmetic.
    fn grow_memory(mut self, _ offset: u256, len: u64) -> bool {
        if offset < SMALL_EXTENT as u256 {
            let start: u64 = offset.downcast_unchecked()
            let size = (start + len + 31) / 32 * 32
            let gas = small_growth_cost(current: self.memory_size, size)
            return self.charge(gas as u128) && self.expand_memory(size)
        }
        match self.plan_memory(offset, len: len as u256, copying: false) {
            Option::Some(plan,) => self.expand_memory(plan.size),
            Option::None => false,
        }
    }

    fn mload(mut self) {
        let offset = self.pop()
        if !self.ok() || !self.in_memory(offset, len: 32) && !self.grow_memory(offset, len: 32) {
            return
        }
        let value = self.memory.read_word(offset.downcast_unchecked())
        self.push(value)
    }

    fn mstore(mut self) {
        let offset = self.pop()
        let value = self.pop()
        if !self.ok() || !self.in_memory(offset, len: 32) && !self.grow_memory(offset, len: 32) {
            return
        }
        self.memory.span().write_word(offset: offset.downcast_unchecked(), value)
    }

    fn mstore8(mut self) {
        let offset = self.pop()
        let value = self.pop()
        if !self.ok() || !self.in_memory(offset, len: 1) && !self.grow_memory(offset, len: 1) {
            return
        }
        let start: usize = offset.downcast_unchecked()
        self.memory[start] = (value & 255).downcast_unchecked()
    }

    fn codecopy(mut self, _ program: Program) {
        if !self.holds(3) { return }
        let offset = self.take()
        let source = self.take()
        let len = self.take()
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        if len == 0 { return }
        let dest: u64 = offset.downcast_unchecked()
        let count: u64 = len.downcast_unchecked()
        // Bound the source before narrowing or adding an index to it.
        let available: u256 = if source < program.len() as u256 {
            program.len() as u256 - source
        } else {
            0
        }
        let copied: u64 = if (count as u256) < available { count } else { available.downcast_unchecked() }
        if copied != 0 {
            self.memory.slice(offset: dest.downcast_truncate(), len: copied.downcast_truncate())
                .copy_from(program.bytes().slice(offset: source.downcast_unchecked(), len: copied.downcast_truncate()))
        }
        self.zero_memory(from: dest + copied, to: dest + count)
    }

    fn mcopy(mut self) {
        if !self.holds(3) { return }
        let dest = self.take()
        let source = self.take()
        let len = self.take()
        match copy_expansion(current: self.memory_size, dest, source, len) {
            Option::Some(plan,) => {
                if !self.charge_expansion(plan, len, copying: true)
                    || !self.expand_memory(plan.size) {
                    return
                }
            },
            Option::None => {
                self.fault(ERR_OUT_OF_GAS)
                return
            },
        }
        if len != 0 {
            self.memory.span().copy_within(
                source: source.downcast_unchecked(),
                dest: dest.downcast_unchecked(),
                len: len.downcast_unchecked(),
            )
        }
    }

    fn calldatacopy(mut self, _ calldata: InputData) {
        if !self.holds(3) { return }
        let offset = self.take()
        let source = self.take()
        let len = self.take()
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        if len == 0 { return }
        let dest: u64 = offset.downcast_unchecked()
        let count: u64 = len.downcast_unchecked()
        let available: u256 = if source < calldata.len() as u256 {
            calldata.len() as u256 - source
        } else {
            0
        }
        let copied: u64 = if (count as u256) < available { count } else { available.downcast_unchecked() }
        if copied != 0 {
            self.memory.slice(offset: dest.downcast_truncate(), len: copied.downcast_truncate())
                .copy_from(calldata.bytes().slice(offset: source.downcast_unchecked(), len: copied.downcast_truncate()))
        }
        self.zero_memory(from: dest + copied, to: dest + count)
    }

    fn returndatacopy(mut self) {
        if !self.holds(3) { return }
        let offset = self.take()
        let source = self.take()
        let len = self.take()
        // Charge first, then check bounds even for length zero, then allocate.
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => {
                let available = self.return_data.len() as u256
                if source > available || len > available - source {
                    self.fault(ERR_RETURN_DATA_OOB)
                } else if self.expand_memory(plan.size) && len != 0 {
                    let len: usize = len.downcast_unchecked()
                    self.memory.slice(offset: offset.downcast_unchecked(), len)
                        .copy_from(self.return_data.slice(offset: source.downcast_unchecked(), len))
                }
            },
            Option::None => {},
        }
    }

    fn finish_from_memory(mut self, _ status: i32) {
        if !self.holds(2) { return }
        let offset = self.take()
        let len = self.take()
        match self.plan_memory(offset, len, copying: false) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        let count: usize = len.downcast_unchecked()
        if !self.output.try_resize(count) {
            self.fault(ERR_HOST_ALLOCATION)
            return
        }
        if count != 0 {
            self.output.span().copy_from(self.memory.slice(offset: offset.downcast_unchecked(), len: count))
        }
        self.output_valid = true
        self.status = status
        self.halted = true
    }

    fn exp(mut self, base: u256, exponent: u256) {
        var significant = exponent
        var gas: u128 = 0
        while significant != 0 {
            gas += 50
            significant >>= 8
        }
        if !self.charge(gas) {
            return
        }
        var result: u256 = 1
        var factor = base
        var power = exponent
        while power != 0 {
            if power & 1 == 1 {
                result = result.wrapping_mul(factor)
            }
            factor = factor.wrapping_mul(factor)
            power = power >> 1
        }
        self.push(result)
    }

    fn sload(mut self, _ state: mut Transaction) uses (world: mut WorldState, buffers: mut Buffers) {
        let slot = self.pop()
        if !self.ok() { return }
        // A warm slot needs no journal entry.
        let warm = state.storage_is_warm(address: self.call.address, slot)
        if !self.charge(if warm { 100 } else { 2100 }) { return }
        if !warm {
            self.fault(state.warm_slot(address: self.call.address, slot))
            if !self.ok() { return }
        }
        self.push(world.storage_load(address: self.call.address, slot))
    }

    fn sstore(mut self, _ state: mut Transaction) uses (world: mut WorldState, buffers: mut Buffers) {
        if state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return
        }
        let slot = self.pop()
        let value = self.pop()
        if self.ok() {
            if self.gas_remaining <= 2300 {
                self.fault(ERR_OUT_OF_GAS)
                return
            }
            let charge = state.storage_charge(address: self.call.address, slot, value)
            if self.charge(charge.gas as u128) {
                self.fault(state.warm_slot(address: self.call.address, slot))
                if self.ok() { self.fault(state.storage_store(address: self.call.address, slot, value)) }
            }
        }
    }

    fn tload(mut self, _ state: Transaction) uses (buffers: Buffers) {
        let slot = self.pop()
        if self.ok() {
            self.push(state.transient_load(address: self.call.address, slot))
        }
    }

    fn tstore(mut self, _ state: mut Transaction) uses (world: mut WorldState, buffers: mut Buffers) {
        if state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return
        }
        let slot = self.pop()
        let value = self.pop()
        if self.ok() {
            self.fault(state.transient_store(address: self.call.address, slot, value))
        }
    }

    fn extcodecopy(mut self, _ state: mut Transaction) uses (world: mut WorldState, buffers: mut Buffers) {
        if !self.holds(4) { return }
        let address = address_word(self.take())
        let dest = self.take()
        let source = self.take()
        let len = self.take()
        let warm = state.account_is_warm(address)
        if !self.charge(if warm { 100 } else { 2600 }) { return }
        let plan = match self.plan_memory(offset: dest, len, copying: true) {
            Option::Some(plan) => plan,
            Option::None => return,
        }
        if !warm { self.fault(state.warm_account(address)) }
        if !self.ok() || !self.expand_memory(plan.size) || len == 0 { return }
        let code = world.code(address)
        let size = code.len() as u256
        let available = if source < size { size - source } else { 0 }
        let copied: u64 = (if len < available { len } else { available }).downcast_unchecked()
        let dest: u64 = dest.downcast_unchecked()
        if copied != 0 {
            self.memory.slice(offset: dest.downcast_truncate(), len: copied.downcast_truncate())
                .copy_from(code.slice(offset: source.downcast_unchecked(), len: copied.downcast_truncate()))
        }
        self.zero_memory(from: dest + copied, to: dest + len.downcast_unchecked())
    }

    fn log(mut self, _ topics_count: u64, _ state: mut Transaction) {
        if state.is_static() {
            self.fault(ERR_STATIC_WRITE)
            return
        }
        if !self.holds((2 + topics_count).downcast_unchecked()) { return }
        let offset = self.take()
        let len = self.take()
        let plan = match memory_expansion(current: self.memory_size, offset, len) {
            Option::Some(plan) => plan,
            Option::None => {
                self.fault(ERR_OUT_OF_GAS)
                return
            },
        }
        let length: u64 = len.downcast_unchecked()
        if !self.charge(375 + topics_count as u128 * 375 + length as u128 * 8 + plan.gas as u128) { return }
        var topics: [u256; 4] = [0; 4]
        var topic: u64 = 0
        while topic < topics_count {
            topics[topic.downcast_truncate()] = self.take()
            topic += 1
        }
        if !self.expand_memory(plan.size) { return }
        let start: usize = if length == 0 { 0 } else { offset.downcast_unchecked() }
        self.fault(state.emit_log(address: self.call.address, topics, topic_count: topics_count,
                                  data: self.memory.slice(offset: start, len: length.downcast_truncate())))
    }

    /// BALANCE, EXTCODESIZE and EXTCODEHASH, charging for a cold account.
    fn account_field(mut self, _ op: i32, _ state: mut Transaction) uses (world: mut WorldState, buffers: mut Buffers) {
        let address = address_word(self.pop())
        if self.ok() {
            let warm = state.account_is_warm(address)
            if self.charge(if warm { 100 } else { 2600 }) {
                if !warm { self.fault(state.warm_account(address)) }
                if self.ok() {
                    let value = if op == 0x31 { world.balance(address) }
                        else if op == 0x3b { world.code_size(address) as u256 }
                        else { world.code_hash(address) }
                    self.push(value)
                }
            }
        }
    }

    fn run_until_child<T: Tracer>(mut self, _ program: Program, _ calldata: InputData, _ state: mut Transaction,
                                  depth: usize, _ tracer: mut T) -> Option<Box<Frame>>
    uses (world: mut WorldState, buffers: mut Buffers) {
        // Pushes skip the capacity check, so the stack holds its limit first.
        if !self.stack.try_reserve(STACK_LIMIT - self.stack.len()) {
            self.fault(ERR_HOST_ALLOCATION)
            return Option::None
        }
        // The code cannot change while the frame runs. `pc` and gas live in
        // locals here; `self` holds them only around calls that use them.
        // Every arm that can fault or halt leaves the loop itself, so the
        // loop checks no status per opcode. Padding stops a frame that runs
        // off the end.
        let code = program.padded()
        self.jumpdests = program.jumpdest_map()
        self.jump_limit = program.jump_limit()
        self.call_depth = depth
        self.code_len = program.len()
        self.calldata = calldata.bytes().ptr()
        self.calldata_len = calldata.len()
        self.blob_hashes = state.blob_hash_ptr()
        self.blob_count = state.blob_count()
        var pc = self.pc
        var gas = self.gas_remaining
        if self.ok() {
            while true {
                // Handlers run the common opcodes and stop at any other.
                self.dispatch(self.cursor(code.ptr(), pc, gas), mut tracer)
                pc = self.pc
                gas = self.gas_remaining
                if self.halted || !self.ok() {
                    break
                }
                // `pc` never passes the padding: a PUSH ends at most 32 bytes
                // past the code, and padding reads as STOP.
                let op = unsafe { code.read_be_unchecked<u8>(pc) } as i32
                // `pc` stays within the code and its padding, far from overflow.
                pc = pc.wrapping_add(1)
                match op {
                    // The rest charge their base cost from the table and dispatch
                    // again; those that call out charge more through `self`.
                    _ => {
                        if !spend(mut gas, base_cost(op)) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        match op {
                        0x20 => {
                            self.gas_remaining = gas
                            self.sha3()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x31 | 0x3b | 0x3f => {
                            self.gas_remaining = gas
                            self.account_field(op, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x37 => {
                            self.gas_remaining = gas
                            self.calldatacopy(calldata)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x39 => {
                            self.gas_remaining = gas
                            self.codecopy(program)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x3c => {
                            self.gas_remaining = gas
                            self.extcodecopy(mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x3e => {
                            self.gas_remaining = gas
                            self.returndatacopy()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x40 => {
                            let number = self.pop()
                            if !self.ok() { break }
                            let hash = if number < self.block.number && self.block.number - number <= 256 {
                                world.block_hash(number)
                            } else { 0 }
                            if !self.pushed(hash) { break }
                        },
                        0x47 => if !self.pushed(world.balance(self.call.address)) { break },
                        0x53 => {
                            self.gas_remaining = gas
                            self.mstore8()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x54 => {
                            self.gas_remaining = gas
                            self.sload(mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x55 => {
                            self.gas_remaining = gas
                            self.sstore(mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x5c => {
                            self.tload(state)
                            if !self.ok() { break }
                        },
                        0x5d => {
                            self.tstore(mut state)
                            if !self.ok() { break }
                        },
                        0x5e => {
                            self.gas_remaining = gas
                            self.mcopy()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0xa0 | 0xa1 | 0xa2 | 0xa3 | 0xa4 => {
                            self.gas_remaining = gas
                            self.log((op - 0xa0).downcast_unchecked(), mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0xf3 => {
                            self.gas_remaining = gas
                            self.finish_from_memory(OK)
                            gas = self.gas_remaining
                            break
                        },
                        0xfd => {
                            self.gas_remaining = gas
                            self.finish_from_memory(ERR_REVERT)
                            gas = self.gas_remaining
                            break
                        },
                        0xff => {
                            self.gas_remaining = gas
                            self.selfdestruct(mut state)
                            gas = self.gas_remaining
                            break
                        },
                        0xf0 | 0xf1 | 0xf2 | 0xf4 | 0xf5 | 0xfa => {
                            self.pc = pc
                            self.gas_remaining = gas
                            let child = if op == 0xf0 || op == 0xf5 {
                                self.start_create(op, mut state, depth, mut tracer)
                            } else {
                                self.start_call(op, mut state, depth, mut tracer)
                            }
                            match child {
                                Option::Some(frame) => return Option::Some(frame),
                                Option::None => {},
                            }
                            pc = self.pc
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        // INVALID (0xfe) and every undefined byte are exceptional halts.
                        _ => {
                            self.fault(ERR_INVALID_OPCODE)
                            break
                        },
                        }
                    },
                }
            }
        }
        // A fault that halts exceptionally leaves no gas.
        self.pc = pc
        self.gas_remaining = if exceptional(self.status) { 0 } else { gas }
        Option::None
    }

    pub fn run<T: Tracer>(mut self, _ program: Program, _ calldata: InputData,
                          _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction, _ tracer: mut T)
    uses (world: mut WorldState, buffers: mut Buffers) {
        self.run_root(program, calldata, call, block, mut state, mut tracer, creates: false)
    }

    /// Run initcode at depth zero under its own checkpoint, then deposit its
    /// output as code at `call.address`. Callers open the creation with
    /// `begin_create`, whose checkpoint encloses this one.
    pub fn create<T: Tracer>(mut self, _ program: Program, _ call: CallEnv, _ block: BlockEnv,
                             _ state: mut Transaction, _ tracer: mut T)
    uses (world: mut WorldState, buffers: mut Buffers) {
        self.run_root(program, empty_bytes(), call, block, mut state, mut tracer, creates: true)
    }

    fn run_root<T: Tracer>(mut self, _ program: Program, _ calldata: InputData, _ call: CallEnv,
                           _ block: BlockEnv, _ state: mut Transaction, _ tracer: mut T, creates: bool)
    uses (world: mut WorldState, buffers: mut Buffers) {
        self.adopt()
        self.reset(gas: call.gas_limit)
        if program.status != OK || calldata.status != OK {
            self.fault(if program.status != OK { program.status } else { calldata.status })
            return
        }
        let refund_before = state.refund()
        let checkpoint = state.checkpoint(is_static: call.is_static)
        self.call = call
        self.block = block
        match self.run_until_child(program, calldata, mut state, depth: 0, mut tracer) {
            Option::Some(first) => self.run_children(first, program, calldata, mut state, mut tracer),
            Option::None => {},
        }
        if creates && self.status == OK { self.deposit_code(address: call.address, mut state) }
        if self.status == OK {
            state.commit(checkpoint)
            self.refund_delta = state.refund() - refund_before
        } else {
            state.revert(checkpoint)
        }
    }
    /// The frame's result. Its memory and stack, emptied, go to `buffers`.
    pub fn into_result(var own self) -> ExecutionResult uses (buffers: mut Buffers) {
        self.take_result()
    }

    /// As `into_result`, leaving the VM without output, memory or stack.
    fn take_result(mut self) -> ExecutionResult uses (buffers: mut Buffers) {
        let stack_len = self.stack.len()
        let stack_top: u256 = if stack_len == 0 {
            0
        } else {
            self.stack[stack_len - 1]
        }
        self.memory.clear()
        self.stack.clear()
        // A pool that cannot grow drops them.
        if self.memory.capacity() != 0 {
            let _ = buffers.memories.try_push(core::mem::replace(mut self.memory, MemBuffer::empty()))
        }
        if self.stack.capacity() != 0 {
            let _ = buffers.stacks.try_push(core::mem::replace(mut self.stack, MemVec::new()))
        }
        ExecutionResult {
            status: self.status,
            output: core::mem::replace(mut self.output, MemBuffer::empty()),
            output_valid: self.output_valid,
            stack_top,
            stack_len,
            gas_remaining: self.gas_remaining,
            refund_delta: self.refund_delta,
        }
    }
}

pub fn execute_vm(
    _ program: Program,
    _ calldata: InputData,
    _ call: CallEnv,
    _ block: BlockEnv,
    _ state: mut Transaction,
) -> Vm uses (world: mut WorldState, buffers: mut Buffers) {
    var vm = Vm::new()
    var tracer = ()
    vm.run(program, calldata, call, block, mut state, mut tracer)
    vm
}

pub fn execute(
    _ program: Program,
    _ calldata: InputData,
    _ call: CallEnv,
    _ block: BlockEnv,
    _ state: mut Transaction,
) -> ExecutionResult uses (world: mut WorldState, buffers: mut Buffers) {
    execute_vm(program, calldata, call, block, mut state).into_result()
}
