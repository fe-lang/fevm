use core::Option
use std::native::ByteBuffer
use ingot::memory::{MemoryExpansion, memory_expansion, copy_expansion, copy_gas}
use ingot::gas::base_cost
use core::ops::{WrappingAdd, WrappingMul, WrappingSub}
use std::evm::crypto::{addmod, mulmod}
use ingot::constants::{
    ERR_INVALID_JUMP,
    ERR_INVALID_OPCODE,
    ERR_OUT_OF_GAS,
    ERR_HOST_ALLOCATION,
    ERR_RETURN_DATA_OOB,
    ERR_REVERT,
    ERR_STACK_OVERFLOW,
    ERR_STACK_UNDERFLOW,
    ERR_STATE_LIMIT,
    ERR_TODO_OPCODE,
    ERR_UNSUPPORTED_OPCODE,
    I256_MIN,
    OK,
    STACK_LIMIT,
}
use ingot::opcodes::is_todo_opcode
use ingot::state::WorldState
use ingot::types::{BlockEnv, InputData, CallEnv, ExecutionResult, Program}

pub struct Vm {
    pub memory: ByteBuffer,
    pub output: ByteBuffer,
    pub gas_remaining: u64,
    pub gas_exact: bool,
    pub output_valid: bool,
    pub stack: [u256; STACK_LIMIT],
    pub sp: usize,
    pub pc: usize,
    pub status: i32,
    pub halted: bool,
    pub unsupported_opcode: i32,
}

impl Vm {
    pub fn new() -> Self {
        Vm {
            memory: ByteBuffer::new(),
            output: ByteBuffer::new(),
            gas_remaining: 0,
            gas_exact: true,
            output_valid: false,
            stack: [0; STACK_LIMIT],
            sp: 0,
            pc: 0,
            status: OK,
            halted: false,
            unsupported_opcode: 0,
        }
    }

    fn ok(self) -> bool {
        self.status == OK
    }

    fn fault(mut self, _ status: i32) {
        if self.status == OK {
            self.status = status
            if status == ERR_STACK_UNDERFLOW
                || status == ERR_STACK_OVERFLOW
                || status == ERR_INVALID_JUMP
                || status == ERR_INVALID_OPCODE
                || status == ERR_RETURN_DATA_OOB
                || status == ERR_OUT_OF_GAS {
                self.gas_remaining = 0
            }
        }
    }

    fn push(mut self, _ value: u256) {
        if self.sp >= STACK_LIMIT {
            self.fault(ERR_STACK_OVERFLOW)
            return
        }

        self.stack[self.sp] = value
        self.sp += 1
    }

    fn pop(mut self) -> u256 {
        if self.sp == 0 {
            self.fault(ERR_STACK_UNDERFLOW)
            return 0
        }

        self.sp -= 1
        self.stack[self.sp]
    }

    fn push_bool(mut self, _ value: bool) {
        if value { self.push(1) } else { self.push(0) }
    }

    fn charge(mut self, _ amount: u128) -> bool {
        if amount > self.gas_remaining as u128 {
            self.fault(ERR_OUT_OF_GAS)
            return false
        }
        self.gas_remaining -= amount.downcast_unchecked()
        true
    }

    // Plan and charge before converting EVM words or touching host allocation.
    fn plan_memory(mut self, offset: u256, len: u256, copying: bool) -> Option<MemoryExpansion> {
        match memory_expansion(current: self.memory.len(), offset, len) {
            Option::Some(plan,) => if self.charge_expansion(plan, len, copying) {
                Option::Some(plan)
            } else {
                Option::None
            },
            Option::None => {
                self.fault(ERR_OUT_OF_GAS)
                Option::None
            },
        }
    }

    fn charge_expansion(mut self, _ plan: MemoryExpansion, len: u256, copying: bool) -> bool {
        let mut gas = plan.gas as u128
        if copying {
            match copy_gas(len) {
                Option::Some(cost,) => gas += cost as u128,
                Option::None => {
                    self.fault(ERR_OUT_OF_GAS)
                    return false
                },
            }
        }
        self.charge(gas)
    }

    fn expand_memory(mut self, _ size: u64) -> bool {
        if !self.memory.try_resize(size) {
            self.fault(ERR_HOST_ALLOCATION)
            return false
        }
        true
    }

    fn mload(mut self) {
        let offset = self.pop()
        if !self.ok() { return }
        match self.plan_memory(offset, len: 32, copying: false) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        let start: u64 = offset.downcast_unchecked()
        let mut value: u256 = 0
        let mut i: u64 = 0
        while i < 32 {
            value = (value << 8) | (self.memory.byte_at(start + i) as u256)
            i += 1
        }
        self.push(value)
    }

    fn mstore(mut self, byte_only: bool) {
        let offset = self.pop()
        let value = self.pop()
        if !self.ok() { return }
        let len: u64 = if byte_only { 1 } else { 32 }
        match self.plan_memory(offset, len: len as u256, copying: false) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        let start: u64 = offset.downcast_unchecked()
        let mut i: u64 = 0
        while i < len {
            let shift = ((len - 1 - i) as u256) * 8
            self.memory
                .set_byte(
                    index: start + i,
                    value: ((value >> shift) & 255).downcast_unchecked(),
                )
            i += 1
        }
    }

    fn codecopy(mut self, _ program: Program) {
        let offset = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        if len == 0 { return }
        let dest: u64 = offset.downcast_unchecked()
        let count: u64 = len.downcast_unchecked()
        // Bound the source before narrowing or adding an index to it.
        let available: u256 = if source < program.len() as u256 {
            program.len() as u256 - source
        } else {
            0
        }
        let mut i: u64 = 0
        while i < count {
            let value = if (i as u256) < available {
                let index: usize = (source + i as u256).downcast_unchecked()
                program.byte_at(index)
            } else {
                0
            }
            self.memory.set_byte(index: dest + i, value)
            i += 1
        }
    }

    fn mcopy(mut self) {
        let dest = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        match copy_expansion(current: self.memory.len(), dest, source, len) {
            Option::Some(plan,) => {
                if !self.charge_expansion(plan, len, copying: true)
                    || !self.expand_memory(plan.size) {
                    return
                }
            },
            Option::None => {
                self.fault(ERR_OUT_OF_GAS)
                return
            },
        }
        if len != 0 {
            self.memory
                .copy_within(
                    dest: dest.downcast_unchecked(),
                    source: source.downcast_unchecked(),
                    len: len.downcast_unchecked(),
                )
        }
    }

    fn calldataload(mut self, _ calldata: InputData) {
        let offset = self.pop()
        if !self.ok() { return }
        let available: u256 = if offset < calldata.len as u256 {
            calldata.len as u256 - offset
        } else {
            0
        }
        let mut value: u256 = 0
        let mut i: u256 = 0
        while i < 32 {
            value <<= 8
            if i < available {
                let index: usize = (offset + i).downcast_unchecked()
                value |= calldata.bytes[index] as u256
            }
            i += 1
        }
        self.push(value)
    }

    fn calldatacopy(mut self, _ calldata: InputData) {
        let offset = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        if len == 0 { return }
        let dest: u64 = offset.downcast_unchecked()
        let count: u64 = len.downcast_unchecked()
        let available: u256 = if source < calldata.len as u256 {
            calldata.len as u256 - source
        } else {
            0
        }
        let mut i: u64 = 0
        while i < count {
            let value = if (i as u256) < available {
                let index: usize = (source + i as u256).downcast_unchecked()
                calldata.bytes[index]
            } else {
                0
            }
            self.memory.set_byte(index: dest + i, value)
            i += 1
        }
    }

    fn returndatacopy(mut self) {
        let offset = self.pop()
        let source = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        // The frame currently has no nested calls, hence empty return data.
        // Charge first, then check bounds even for length zero, then allocate.
        match self.plan_memory(offset, len, copying: true) {
            Option::Some(plan,) => {
                if source != 0 || len != 0 {
                    self.fault(ERR_RETURN_DATA_OOB)
                } else {
                    let _ = self.expand_memory(plan.size)
                }
            },
            Option::None => {},
        }
    }

    fn finish_from_memory(mut self, _ status: i32) {
        let offset = self.pop()
        let len = self.pop()
        if !self.ok() { return }
        match self.plan_memory(offset, len, copying: false) {
            Option::Some(plan,) => if !self.expand_memory(plan.size) {
                return
            },
            Option::None => {
                return
            },
        }
        let count: u64 = len.downcast_unchecked()
        if !self.output.try_resize(count) {
            self.fault(ERR_HOST_ALLOCATION)
            return
        }
        if count != 0 {
            let start: u64 = offset.downcast_unchecked()
            let mut i: u64 = 0
            while i < count {
                self.output.set_byte(index: i, value: self.memory.byte_at(start + i))
                i += 1
            }
        }
        self.output_valid = true
        self.status = status
        self.halted = true
    }

    fn exp(mut self, base: u256, exponent: u256) {
        let mut significant = exponent
        let mut gas: u128 = 0
        while significant != 0 {
            gas += 50
            significant >>= 8
        }
        if !self.charge(gas) {
            return
        }
        let mut result: u256 = 1
        let mut factor = base
        let mut power = exponent
        while power != 0 {
            if power & 1 == 1 {
                result = result.wrapping_mul(factor)
            }
            factor = factor.wrapping_mul(factor)
            power = power >> 1
        }
        self.push(result)
    }

    fn signextend(mut self, byte_index: u256, value: u256) {
        if byte_index >= 31 {
            self.push(value)
            return
        }

        let bit_index = (byte_index * 8) + 7
        let mask = (1 << (bit_index + 1)) - 1
        if ((value >> bit_index) & 1) == 1 {
            self.push(value | !mask)
        } else {
            self.push(value & mask)
        }
    }

    fn byte(mut self, index: u256, value: u256) {
        if index >= 32 {
            self.push(0)
            return
        }

        self.push((value >> ((31 - index) * 8)) & 255)
    }

    fn sar(mut self, shift: u256, value: u256) {
        let signed = ((value >> 255) & 1) == 1
        if shift == 0 {
            self.push(value)
        } else if shift >= 256 {
            if signed {
                self.push(!(0 as u256))
            } else {
                self.push(0)
            }
        } else {
            let shifted = value >> shift
            if signed {
                self.push(shifted | !((1 << (256 - shift)) - 1))
            } else {
                self.push(shifted)
            }
        }
    }

    fn binary_arith(mut self, _ op: i32) {
        // The top item is the first EVM operand; some opcodes give it a
        // different role (shift amount, byte index, or sign-extension index).
        let lhs = self.pop()
        let rhs = self.pop()
        if !self.ok() { return }

        match op {
            0x01 => self.push(lhs.wrapping_add(rhs)),
            0x02 => self.push(lhs.wrapping_mul(rhs)),
            0x03 => self.push(lhs.wrapping_sub(rhs)),
            0x04 => if rhs == 0 {
                self.push(0)
            } else {
                self.push(lhs / rhs)
            },
            0x05 => {
                if rhs == 0 {
                    self.push(0)
                } else {
                    let lhs_signed: i256 = lhs.downcast_unchecked()
                    let rhs_signed: i256 = rhs.downcast_unchecked()
                    if lhs_signed == I256_MIN && rhs_signed == -1 {
                        self.push(lhs)
                    } else {
                        let result: u256 = (lhs_signed / rhs_signed).downcast_unchecked()
                        self.push(result)
                    }
                }
            },
            0x06 => if rhs == 0 {
                self.push(0)
            } else {
                self.push(lhs % rhs)
            },
            0x07 => {
                if rhs == 0 {
                    self.push(0)
                } else {
                    let lhs_signed: i256 = lhs.downcast_unchecked()
                    let rhs_signed: i256 = rhs.downcast_unchecked()
                    if rhs_signed == -1 {
                        self.push(0)
                    } else {
                        let result: u256 = (lhs_signed % rhs_signed).downcast_unchecked()
                        self.push(result)
                    }
                }
            },
            0x08 => {
                let modulus = self.pop()
                if self.ok() {
                    self.push(addmod(lhs, rhs, modulus))
                }
            },
            0x09 => {
                let modulus = self.pop()
                if self.ok() {
                    self.push(mulmod(lhs, rhs, modulus))
                }
            },
            0x0a => self.exp(base: lhs, exponent: rhs),
            0x0b => self.signextend(byte_index: lhs, value: rhs),
            0x10 => self.push_bool(lhs < rhs),
            0x11 => self.push_bool(lhs > rhs),
            0x12 => {
                let lhs_signed: i256 = lhs.downcast_unchecked()
                let rhs_signed: i256 = rhs.downcast_unchecked()
                self.push_bool(lhs_signed < rhs_signed)
            },
            0x13 => {
                let lhs_signed: i256 = lhs.downcast_unchecked()
                let rhs_signed: i256 = rhs.downcast_unchecked()
                self.push_bool(lhs_signed > rhs_signed)
            },
            0x14 => self.push_bool(lhs == rhs),
            0x16 => self.push(lhs & rhs),
            0x17 => self.push(lhs | rhs),
            0x18 => self.push(lhs ^ rhs),
            0x1a => self.byte(index: lhs, value: rhs),
            0x1b => if lhs >= 256 {
                self.push(0)
            } else {
                self.push(rhs << lhs)
            },
            0x1c => if lhs >= 256 {
                self.push(0)
            } else {
                self.push(rhs >> lhs)
            },
            0x1d => self.sar(shift: lhs, value: rhs),
            _ => self.fault(ERR_UNSUPPORTED_OPCODE),
        }
    }

    fn unary(mut self, _ op: i32) {
        let value = self.pop()
        if !self.ok() { return }

        match op {
            0x15 => self.push_bool(value == 0),
            0x19 => self.push(!value),
            _ => self.fault(ERR_UNSUPPORTED_OPCODE),
        }
    }

    fn dup(mut self, _ index: usize) {
        if self.sp < index {
            self.fault(ERR_STACK_UNDERFLOW)
            return
        }

        self.push(self.stack[self.sp - index])
    }

    fn swap(mut self, _ index: usize) {
        if self.sp <= index {
            self.fault(ERR_STACK_UNDERFLOW)
            return
        }

        let top = self.sp - 1
        let other = top - index
        let tmp = self.stack[top]
        self.stack[top] = self.stack[other]
        self.stack[other] = tmp
    }

    fn unsupported(mut self, _ op: i32) {
        self.unsupported_opcode = op
        self.fault(ERR_UNSUPPORTED_OPCODE)
    }

    fn todo(mut self, _ op: i32) {
        self.unsupported_opcode = op
        self.fault(ERR_TODO_OPCODE)
    }

    fn invalid(mut self, _ op: i32) {
        self.unsupported_opcode = op
        self.fault(ERR_INVALID_OPCODE)
    }

    fn jump(mut self, _ dest: u256, _ program: Program) {
        if !program.is_jumpdest(dest) {
            self.fault(ERR_INVALID_JUMP)
            return
        }

        self.pc = dest.downcast_unchecked()
    }

    fn sload(mut self, _ call: CallEnv, _ state: WorldState) {
        let slot = self.pop()
        if self.ok() {
            self.push(state.storage_load(call.address, slot))
        }
    }

    fn sstore(mut self, _ call: CallEnv, _ state: mut WorldState) {
        let slot = self.pop()
        let value = self.pop()
        if self.ok() && !state.storage_store(call.address, slot, value) {
            self.fault(ERR_STATE_LIMIT)
        }
    }

    fn tload(mut self, _ call: CallEnv, _ state: WorldState) {
        let slot = self.pop()
        if self.ok() {
            self.push(state.transient_load(call.address, slot))
        }
    }

    fn tstore(mut self, _ call: CallEnv, _ state: mut WorldState) {
        let slot = self.pop()
        let value = self.pop()
        if self.ok() && !state.transient_store(call.address, slot, value) {
            self.fault(ERR_STATE_LIMIT)
        }
    }

    fn step(
        mut self,
        _ op: i32,
        _ program: Program,
        _ calldata: InputData,
        _ call: CallEnv,
        _ block: BlockEnv,
        _ state: mut WorldState,
    ) {
        if op == 0x50 {
            let _ = self.pop()
            return
        }

        if (op >= 0x01 && op <= 0x0b) || (op >= 0x10 && op <= 0x1d) {
            if op == 0x15 || op == 0x19 {
                self.unary(op)
            } else {
                self.binary_arith(op)
            }
            return
        }

        if op == 0x20 {
            self.todo(op)
            return
        }

        if op == 0x30 {
            self.push(call.address)
            return
        }

        if op == 0x31 {
            let address = self.pop()
            if self.ok() {
                self.push(state.balance(address))
            }
            return
        }

        if op == 0x32 {
            self.push(call.origin)
            return
        }

        if op == 0x33 {
            self.push(call.caller)
            return
        }

        if op == 0x34 {
            self.push(call.callvalue)
            return
        }

        if op == 0x35 {
            self.calldataload(calldata)
            return
        }

        if op == 0x36 {
            self.push(calldata.len as u256)
            return
        }

        if op == 0x37 {
            self.calldatacopy(calldata)
            return
        }

        if op == 0x38 {
            self.push(program.len() as u256)
            return
        }

        if op == 0x39 {
            self.codecopy(program)
            return
        }

        if op == 0x3a {
            self.push(call.gasprice)
            return
        }

        if op == 0x3d {
            self.push(0)
            return
        }

        if op == 0x3e {
            self.returndatacopy()
            return
        }

        if op == 0x40 {
            let number = self.pop()
            if self.ok() {
                self.push(state.block_hash(number))
            }
            return
        }

        if op == 0x41 {
            self.push(block.coinbase)
            return
        }

        if op == 0x42 {
            self.push(block.timestamp)
            return
        }

        if op == 0x43 {
            self.push(block.number)
            return
        }

        if op == 0x44 {
            self.push(block.prevrandao)
            return
        }

        if op == 0x45 {
            self.push(block.gaslimit)
            return
        }

        if op == 0x46 {
            self.push(block.chainid)
            return
        }

        if op == 0x47 {
            self.push(state.balance(call.address))
            return
        }

        if op == 0x48 {
            self.push(block.basefee)
            return
        }

        if op == 0x4a {
            self.push(block.blobbasefee)
            return
        }

        if op == 0x51 {
            self.mload()
            return
        }

        if op == 0x52 {
            self.mstore(byte_only: false)
            return
        }

        if op == 0x53 {
            self.mstore(byte_only: true)
            return
        }

        if op == 0x54 {
            self.sload(call, state)
            return
        }

        if op == 0x55 {
            self.sstore(call, mut state)
            return
        }

        if op == 0x56 {
            let dest = self.pop()
            if self.ok() {
                self.jump(dest, program)
            }
            return
        }

        if op == 0x57 {
            let dest = self.pop()
            let condition = self.pop()
            if self.ok() && condition != 0 {
                self.jump(dest, program)
            }
            return
        }

        if op == 0x58 {
            self.push((self.pc - 1) as u256)
            return
        }

        if op == 0x59 {
            self.push(self.memory.len() as u256)
            return
        }

        if op == 0x5a {
            self.push(self.gas_remaining as u256)
            return
        }

        if op == 0x5b { return }

        if op == 0x5c {
            self.tload(call, state)
            return
        }

        if op == 0x5d {
            self.tstore(call, mut state)
            return
        }

        if op == 0x5e {
            self.mcopy()
            return
        }

        if op >= 0x80 && op <= 0x8f {
            self.dup((op - 0x7f).downcast_unchecked())
            return
        }

        if op >= 0x90 && op <= 0x9f {
            self.swap((op - 0x8f).downcast_unchecked())
            return
        }

        if op == 0xf3 {
            self.finish_from_memory(OK)
            return
        }

        if op == 0xfd {
            self.finish_from_memory(ERR_REVERT)
            return
        }

        if is_todo_opcode(op) {
            self.todo(op)
        } else if op == 0xfe {
            self.invalid(op)
        } else {
            self.unsupported(op)
        }
    }
}

fn read_push_value(_ vm: mut Vm, _ program: Program, _ len: usize) -> u256 {
    let mut value: u256 = 0
    let mut i: usize = 0
    while i < len {
        value = value << 8
        if vm.pc < program.len() {
            value |= program.byte_at(vm.pc) as u256
        }
        vm.pc += 1
        i += 1
    }
    value
}

impl Vm {
    pub fn run(
        mut self,
        _ program: Program,
        _ calldata: InputData,
        _ call: CallEnv,
        _ block: BlockEnv,
        _ state: mut WorldState,
    ) {
        self.memory.clear()
        self.output.clear()
        self.output_valid = false
        self.sp = 0
        self.pc = 0
        self.status = OK
        self.halted = false
        self.unsupported_opcode = 0
        self.gas_remaining = call.gas_limit
        self.gas_exact = true
        while self.pc < program.len() && self.ok() && !self.halted {
            let op = program.byte_at(self.pc) as i32
            self.pc += 1
            // Dynamic transaction pricing for these prototype state operations
            // is not implemented. Expose that boundary to callers and the corpus.
            if op == 0x31 || op == 0x54 || op == 0x55 {
                self.gas_exact = false
            }
            if !self.charge(base_cost(op) as u128) {
                return
            }
            if op == 0x00 {
                self.halted = true
            } else if op == 0x5f {
                self.push(0)
            } else if op >= 0x60 && op <= 0x7f {
                let len: usize = (op - 0x5f).downcast_unchecked()
                let value = read_push_value(mut self, program, len)
                self.push(value)
            } else {
                self.step(op, program, calldata, call, block, mut state)
            }
        }
    }
    pub fn release(own self) {
        self.memory.release()
        self.output.release()
    }
    pub fn into_result(own self) -> ExecutionResult {
        let stack_top: u256 = if self.sp == 0 {
            0
        } else {
            self.stack[self.sp - 1]
        }
        self.memory.release()
        ExecutionResult {
            status: self.status,
            output: self.output,
            output_valid: self.output_valid,
            stack_top,
            stack_len: self.sp,
            unsupported_opcode: self.unsupported_opcode,
            gas_remaining: self.gas_remaining,
            gas_exact: self.gas_exact,
        }
    }
}

pub fn execute_vm(
    _ program: Program,
    _ calldata: InputData,
    _ call: CallEnv,
    _ block: BlockEnv,
    _ state: mut WorldState,
) -> Vm {
    let mut vm = Vm::new()
    vm.run(program, calldata, call, block, mut state)
    vm
}

pub fn execute(
    _ program: Program,
    _ calldata: InputData,
    _ call: CallEnv,
    _ block: BlockEnv,
    _ state: mut WorldState,
) -> ExecutionResult {
    execute_vm(program, calldata, call, block, mut state).into_result()
}
