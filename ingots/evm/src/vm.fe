    }

    fn op_swap7(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 7)
    }

    fn op_swap8(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 8)
    }

    fn op_swap9(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 9)
    }

    fn op_swap10(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 10)
    }

    fn op_swap11(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 11)
    }

    fn op_swap12(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 12)
    }

    fn op_swap13(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 13)
    }

    fn op_swap14(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 14)
    }

    fn op_swap15(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 15)
    }

    fn op_swap16(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 16)
    }

    #[inline(always)]
    fn op_swap_n(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, n: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth <= n {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        let base = self.stack.ptr()
        // `depth` exceeds `n`, so neither subtraction wraps. Swapping a
        // 64-bit piece at a time keeps two of them live, not eight.
        let top = cast<u256, u64>(slot(base, depth.wrapping_sub(1)))
        let other = cast<u256, u64>(slot(base, depth.wrapping_sub(1).wrapping_sub(n)))
        unsafe {
            swap_piece(top, other, 0)
            swap_piece(top, other, 1)
            swap_piece(top, other, 2)
            swap_piece(top, other, 3)
        }
        self.next(code, pc.wrapping_add(1), gas - 3, depth)
    }

    #[inline(always)]
    fn op_unary(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, cost: u64, op: i32) {
        if gas < cost {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 1 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - cost, depth)
        }
        let top = slot(self.stack.ptr(), depth - 1)
        match unary_result(op, unsafe { *top }) {
            Option::Some(result) => unsafe { *top = result },
            Option::None => {},
        }
        self.next(code, pc.wrapping_add(1), gas - cost, depth)
    }

    // Each binary and unary opcode has a handler of its own, which inlines
    // its one operation.
    #[inline(always)]
    fn op_binary(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, cost: u64, op: i32) {
        if gas < cost {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 2 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - cost, depth)
        }
        // The top word is the first operand; the result replaces the second.
        let second = slot(self.stack.ptr(), depth - 2)
        unsafe {
            match binary_result(op, *offset_bytes(second, 32), *second) {
                Option::Some(result) => *second = result,
                Option::None => {},
            }
        }
        self.next(code, pc.wrapping_add(1), gas - cost, depth - 1)
    }

    fn op_mload(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 1 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        let top = slot(self.stack.ptr(), depth - 1)
        let offset = unsafe { *top }
        if !self.in_memory(offset, len: 32) {
            return self.op_mload_grow(code, pc, gas - 3, depth)
        }
        unsafe { *top = self.memory.span().read_be_unchecked<u256>(offset.downcast_unchecked()) }
        self.next(code, pc.wrapping_add(1), gas - 3, depth)
    }

    // Growth within the buffer, out of line so the common path keeps fewer
    // values live. `op_mload` checked the stack.
    fn op_mload_grow(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        let top = slot(self.stack.ptr(), depth.wrapping_sub(1))
        let offset = unsafe { *top }
        let size = self.buffered_growth(offset, len: 32)
        if size == 0 {
            return self.op_mload_slow(code, pc, gas, depth)
        }
        var gas = gas
        if !spend(mut gas, small_growth_cost(current: self.memory_size, size)) {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.memory_size = size
        unsafe { *top = self.memory.span().read_be_unchecked<u256>(offset.downcast_unchecked()) }
        self.next(code, pc.wrapping_add(1), gas, depth)
    }

    // Growth past the buffer and offsets past memory, out of line so the
    // common path keeps no frame.
    fn op_mload_slow(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.gas_remaining = gas
        unsafe { self.stack.set_len(depth) }
        self.mload()
        let gas = self.gas_remaining
        if !self.ok() {
            return self.stopped_at(pc.wrapping_add(1), gas, self.stack.len())
        }
        self.next(code, pc.wrapping_add(1), gas, self.stack.len())
    }

    fn op_mstore(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 2 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        let base = self.stack.ptr()
        let offset = unsafe { *slot(base, depth - 1) }
        if !self.in_memory(offset, len: 32) {
            return self.op_mstore_grow(code, pc, gas - 3, depth)
        }
        unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: *slot(base, depth - 2)) }
        self.next(code, pc.wrapping_add(1), gas - 3, depth - 2)
    }

    // Growth within the buffer, out of line so the common path keeps fewer
    // values live. `op_mstore` checked the stack.
    fn op_mstore_grow(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        let base = self.stack.ptr()
        let offset = unsafe { *slot(base, depth.wrapping_sub(1)) }
        let size = self.buffered_growth(offset, len: 32)
        if size == 0 {
            return self.op_mstore_slow(code, pc, gas, depth)
        }
        var gas = gas
        if !spend(mut gas, small_growth_cost(current: self.memory_size, size)) {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.memory_size = size
        unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: *slot(base, depth.wrapping_sub(2))) }
        self.next(code, pc.wrapping_add(1), gas, depth.wrapping_sub(2))
    }

    // Growth past the buffer and offsets past memory, out of line so the
    // common path keeps no frame.
    fn op_mstore_slow(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.gas_remaining = gas
        unsafe { self.stack.set_len(depth) }
        self.mstore()
        let gas = self.gas_remaining
        if !self.ok() {
            return self.stopped_at(pc.wrapping_add(1), gas, self.stack.len())
        }
        self.next(code, pc.wrapping_add(1), gas, self.stack.len())
    }

    fn op_jump(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 8 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 1 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 8, depth)
        }
        let dest = unsafe { *slot(self.stack.ptr(), depth - 1) }
        if !self.jump_ok(dest) {
            return self.faulted_at(ERR_INVALID_JUMP, pc.wrapping_add(1), gas - 8, depth - 1)
        }
        self.next(code, dest.downcast_unchecked(), gas - 8, depth - 1)
    }

    fn op_jumpi(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 10 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 2 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 10, depth)
        }
        let base = self.stack.ptr()
        let dest = unsafe { *slot(base, depth - 1) }
        if unsafe { *slot(base, depth - 2) } == 0 {
            return self.next(code, pc.wrapping_add(1), gas - 10, depth - 2)
        }
        if !self.jump_ok(dest) {
            return self.faulted_at(ERR_INVALID_JUMP, pc.wrapping_add(1), gas - 10, depth - 2)
        }
        self.next(code, dest.downcast_unchecked(), gas - 10, depth - 2)
    }

    fn op_pc(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.push_next(code, pc.wrapping_add(1), gas - 2, depth, pc as u256)
    }

    fn op_msize(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.push_next(code, pc.wrapping_add(1), gas - 2, depth, self.memory_size as u256)
    }

    fn op_gas(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.push_next(code, pc.wrapping_add(1), gas - 2, depth, (gas - 2) as u256)
    }

    fn op_jumpdest(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        if gas < 1 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.next(code, pc.wrapping_add(1), gas - 1, depth)
    }

    // As `Program::is_jumpdest`, from the bitmap `run_until_child` keeps in
    // `self`.
    fn jump_ok(self, _ destination: u256) -> bool {
        if destination >= self.jump_limit as u256 {
            return false
        }
        let pc: usize = destination.downcast_unchecked()
        let bit: u8 = (pc % 8).downcast_unchecked()
        let byte = unsafe { *offset_bytes(self.jumpdests, pc / 8) }
        byte & (1 << bit) != 0
    }

    fn run_until_child(mut self, _ program: Program, _ calldata: InputData,
                       _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction,
                       depth: usize) -> Option<Frame> {
        // Pushes skip the capacity check, so the stack holds its limit first.
        if !self.stack.try_reserve(STACK_LIMIT - self.stack.len()) {
            self.fault(ERR_HOST_ALLOCATION)
            return Option::None
        }
        // The code cannot change while the frame runs. `pc` and gas live in
        // locals here; `self` holds them only around calls that use them.
        // Every arm that can fault or halt leaves the loop itself, so the
        // loop checks no status per opcode. Padding stops a frame that runs
        // off the end.
        let code = program.padded()
        self.jumpdests = program.jumpdest_map()
        self.jump_limit = program.jump_limit()
        var pc = self.pc
        var gas = self.gas_remaining
        if self.ok() {
            while true {
                // Handlers run the common opcodes and stop at any other.
                self.dispatch(code.ptr(), pc, gas)
                pc = self.pc
                gas = self.gas_remaining
                if self.halted || !self.ok() {
                    break
                }
                // `pc` never passes the padding: a PUSH ends at most 32 bytes
                // past the code, and padding reads as STOP.
                let op = unsafe { code.read_be_unchecked<u8>(pc) } as i32
                // `pc` stays within the code and its padding, far from overflow.
                pc = pc.wrapping_add(1)
                match op {
                    0x00 => {
                        self.halted = true
                        break
                    },
                    0x5f => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(0) { break }
                    },
                    // The common widths read just their immediate; padding gives
                    // every immediate a whole word of code after it.
                    0x60 => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let value = unsafe { code.read_be_unchecked<u8>(pc) }
                        pc = pc.wrapping_add(1)
                        if !self.pushed(value as u256) { break }
                    },
                    0x61 => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let value = unsafe { code.read_be_unchecked<u16>(pc) }
                        pc = pc.wrapping_add(2)
                        if !self.pushed(value as u256) { break }
                    },
                    0x63 => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let value = unsafe { code.read_be_unchecked<u32>(pc) }
                        pc = pc.wrapping_add(4)
                        if !self.pushed(value as u256) { break }
                    },
                    0x7f => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let value = unsafe { code.read_be_unchecked<u256>(pc) }
                        pc = pc.wrapping_add(32)
                        if !self.pushed(value) { break }
                    },
                    0x62 | 0x64 | 0x65 | 0x66 | 0x67 | 0x68 | 0x69 | 0x6a | 0x6b | 0x6c | 0x6d | 0x6e | 0x6f | 0x70 | 0x71 | 0x72 | 0x73 | 0x74 | 0x75 | 0x76 | 0x77 | 0x78 | 0x79 | 0x7a | 0x7b | 0x7c | 0x7d | 0x7e => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let n: usize = (op - 0x5f).downcast_unchecked()
                        let word = unsafe { code.read_be_unchecked<u256>(pc) }
                        pc = pc.wrapping_add(n)
                        if !self.pushed(word >> ((32 - n) * 8) as u256) { break }
                    },
                    0x50 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let len = self.stack.len()
                        if len < 1 {
                            self.fault(ERR_STACK_UNDERFLOW)
                            break
                        }
                        self.stack.truncate(len - 1)
                    },
                    0x80 | 0x81 | 0x82 | 0x83 | 0x84 | 0x85 | 0x86 | 0x87 | 0x88 | 0x89 | 0x8a | 0x8b | 0x8c | 0x8d | 0x8e | 0x8f => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.dup((op - 0x7f).downcast_unchecked()) { break }
                    },
                    0x90 | 0x91 | 0x92 | 0x93 | 0x94 | 0x95 | 0x96 | 0x97 | 0x98 | 0x99 | 0x9a | 0x9b | 0x9c | 0x9d | 0x9e | 0x9f => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.swap((op - 0x8f).downcast_unchecked()) { break }
                    },
                    0x15 | 0x19 => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.unary(op) { break }
                    },
                    0x1e => {
                        if !spend(mut gas, 5) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.unary(op) { break }
                    },
                    0x01 | 0x03 | 0x10 | 0x11 | 0x12 | 0x13 | 0x14 | 0x16 | 0x17 | 0x18 | 0x1a | 0x1b | 0x1c | 0x1d => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.binary_arith(op) { break }
                    },
                    0x02 | 0x0b => {
                        if !spend(mut gas, 5) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.binary_arith(op) { break }
                    },
                    0x30 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.address) { break }
                    },
                    0x32 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.origin) { break }
                    },
                    0x33 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.caller) { break }
                    },
                    0x34 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.callvalue) { break }
                    },
                    0x36 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(calldata.len() as u256) { break }
                    },
                    0x38 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(program.len() as u256) { break }
                    },
                    0x3a => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.gasprice) { break }
                    },
                    0x3d => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(self.return_data.len() as u256) { break }
                    },
                    0x41 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.coinbase) { break }
                    },
                    0x42 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.timestamp) { break }
                    },
                    0x43 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.number) { break }
                    },
                    0x44 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.prevrandao) { break }
                    },
                    0x45 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.gaslimit) { break }
                    },
                    0x46 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.chainid) { break }
                    },
                    0x48 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.basefee) { break }
                    },
                    0x4a => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.blobbasefee) { break }
                    },
                    // Accesses within active memory need no growth or extra gas;
                    // the others run out of line.
                    0x51 => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let len = self.stack.len()
                        if len < 1 {
                            self.fault(ERR_STACK_UNDERFLOW)
                            break
                        }
                        let offset = unsafe { self.stack.get_unchecked(len - 1) }
                        var fits = self.in_memory(offset, len: 32)
                        if !fits {
                            let size = self.buffered_growth(offset, len: 32)
                            if size != 0 {
                                if !spend(mut gas, small_growth_cost(current: self.memory_size, size)) {
                                    self.fault(ERR_OUT_OF_GAS)
                                    break
                                }
                                self.memory_size = size
                                fits = true
                            }
                        }
                        if fits {
                            unsafe { self.stack.set_unchecked(len - 1, self.memory.span().read_be_unchecked<u256>(offset.downcast_unchecked())) }
                        } else {
                            self.gas_remaining = gas
                            self.mload()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        }
                    },
                    0x52 => {
                        if !spend(mut gas, 3) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let len = self.stack.len()
                        if len < 2 {
                            self.fault(ERR_STACK_UNDERFLOW)
                            break
                        }
                        let offset = unsafe { self.stack.get_unchecked(len - 1) }
                        var fits = self.in_memory(offset, len: 32)
                        if !fits {
                            let size = self.buffered_growth(offset, len: 32)
                            if size != 0 {
                                if !spend(mut gas, small_growth_cost(current: self.memory_size, size)) {
                                    self.fault(ERR_OUT_OF_GAS)
                                    break
                                }
                                self.memory_size = size
                                fits = true
                            }
                        }
                        if fits {
                            unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: self.stack.get_unchecked(len - 2)) }
                            self.stack.truncate(len - 2)
                        } else {
                            self.gas_remaining = gas
                            self.mstore()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        }
                    },
                    // Jumps check the depth once and drop their operands together.
                    0x56 => {
                        if !spend(mut gas, 8) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let depth = self.stack.len()
                        if depth < 1 {
                            self.fault(ERR_STACK_UNDERFLOW)
                            break
                        }
                        let dest = unsafe { self.stack.get_unchecked(depth - 1) }
                        self.stack.truncate(depth - 1)
                        if !program.is_jumpdest(dest) {
                            self.fault(ERR_INVALID_JUMP)
                            break
                        }
                        pc = dest.downcast_unchecked()
                    },
                    0x57 => {
                        if !spend(mut gas, 10) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        let depth = self.stack.len()
                        if depth < 2 {
                            self.fault(ERR_STACK_UNDERFLOW)
                            break
                        }
                        let dest = unsafe { self.stack.get_unchecked(depth - 1) }
                        let taken = unsafe { self.stack.get_unchecked(depth - 2) } != 0
                        self.stack.truncate(depth - 2)
                        if taken {
                            if !program.is_jumpdest(dest) {
                                self.fault(ERR_INVALID_JUMP)
                                break
                            }
                            pc = dest.downcast_unchecked()
                        }
                    },
                    0x58 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed((pc - 1) as u256) { break }
                    },
                    0x59 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(self.memory_size as u256) { break }
                    },
                    0x5a => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(gas as u256) { break }
                    },
                    0x5b => {
                        if !spend(mut gas, 1) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
},
                    // The rest charge their base cost from the table and dispatch
                    // again; those that call out charge more through `self`.
                    _ => {
                        if !spend(mut gas, base_cost(op)) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        match op {
                        0x04 | 0x05 | 0x06 | 0x07 | 0x08 | 0x09 | 0x0a => {
                            self.gas_remaining = gas
                            self.binary_arith_general(op)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x20 => {
                            self.gas_remaining = gas
                            self.sha3()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x31 | 0x3b | 0x3f => {
                            self.gas_remaining = gas
                            self.account_field(op, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x35 => {
                            self.calldataload(calldata)
                            if !self.ok() { break }
                        },
                        0x37 => {
                            self.gas_remaining = gas
                            self.calldatacopy(calldata)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x39 => {
                            self.gas_remaining = gas
                            self.codecopy(program)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x3c => {
                            self.gas_remaining = gas
                            self.extcodecopy(mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x3e => {
                            self.gas_remaining = gas
                            self.returndatacopy()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x40 => {
                            let number = self.pop()
                            if !self.ok() { break }
                            let hash = if number < block.number && block.number - number <= 256 {
                                state.block_hash(number)
                            } else { 0 }
                            if !self.pushed(hash) { break }
                        },
                        0x47 => if !self.pushed(state.balance(call.address)) { break },
                        0x49 => {
                            let index = self.pop()
                            if !self.ok() || !self.pushed(state.blob_hash(index)) { break }
                        },
                        0x53 => {
                            self.gas_remaining = gas
                            self.mstore8()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x54 => {
                            self.gas_remaining = gas
                            self.sload(call, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x55 => {
                            self.gas_remaining = gas
                            self.sstore(call, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x5c => {
                            self.tload(call, state)
                            if !self.ok() { break }
                        },
                        0x5d => {
                            self.tstore(call, mut state)
                            if !self.ok() { break }
                        },
                        0x5e => {
                            self.gas_remaining = gas
                            self.mcopy()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0xa0 | 0xa1 | 0xa2 | 0xa3 | 0xa4 => {
                            self.gas_remaining = gas
                            self.log((op - 0xa0).downcast_unchecked(), call, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0xf3 => {
                            self.gas_remaining = gas
                            self.finish_from_memory(OK)
                            gas = self.gas_remaining
                            break
                        },
                        0xfd => {
                            self.gas_remaining = gas
                            self.finish_from_memory(ERR_REVERT)
                            gas = self.gas_remaining
                            break
                        },
                        0xff => {
                            self.gas_remaining = gas
                            self.selfdestruct(call, mut state)
                            gas = self.gas_remaining
                            break
                        },
                        0xf0 | 0xf1 | 0xf2 | 0xf4 | 0xf5 | 0xfa => {
                            self.pc = pc
                            self.gas_remaining = gas
                            let child = if op == 0xf0 || op == 0xf5 {
                                self.start_create(op, call, mut state, depth)
                            } else {
                                self.start_call(op, call, mut state, depth)
                            }
                            match child {
                                Option::Some(frame) => return Option::Some(frame),
                                Option::None => {},
                            }
                            pc = self.pc
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        // INVALID (0xfe) and every undefined byte are exceptional halts.
                        _ => {
                            self.invalid(op)
                            break
                        },
                        }
                    },
                }
            }
        }
        // A fault that halts exceptionally leaves no gas.
        self.pc = pc
        self.gas_remaining = if exceptional(self.status) { 0 } else { gas }
        Option::None
    }

    fn run_children(mut self, _ first: own Frame, _ program: Program, _ calldata: InputData,
                    _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction) {
        // The executing children, innermost last. Each is boxed, so frame
        // storage grows with the actual call depth and a frame never moves.
        var frames: MemVec<Box<Frame>> = MemVec::new()
        var next = Option::Some(first)
        while true {
            match next {
                Option::Some(frame) => {
                    var frame = frame
                    frame.vm.adopt(mut state.frame_buffers())
                    let unstored = match Box::try_new(frame) {
                        Result::Ok(boxed) => match frames.try_push(boxed) {
                            Result::Ok(()) => Option::None,
                            Result::Err(boxed) => Option::Some(boxed.into_inner()),
                        },
                        Result::Err(frame) => Option::Some(frame),
                    }
                    // Like other host failures while starting a child, this fails the parent.
                    if let Option::Some(frame) = unstored {
                        frame.abort(mut state)
                        let depth = frames.len()
                        if depth == 0 { self.fault(ERR_HOST_ALLOCATION) }
                        else { frames[depth - 1].get().vm.fault(ERR_HOST_ALLOCATION) }
                    }
                },
                Option::None => {
                    let depth = frames.len()
                    if depth == 0 { break }
                    let result = frames.pop().unwrap().into_inner().finish(mut state)
                    if depth == 1 { self.accept_child(result) }
                    else { frames[depth - 2].get().vm.accept_child(result) }
                },
            }
            let depth = frames.len()
            next = if depth == 0 {
                self.run_until_child(program, calldata, call, block, mut state, depth: 0)
            } else {
                frames[depth - 1].get().resume(block, mut state, depth)
            }
        }
    }

    pub fn run(mut self, _ program: Program, _ calldata: InputData,
               _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction) {
        self.run_root(program, calldata, call, block, mut state, creates: false)
    }

    /// Run initcode at depth zero under its own checkpoint, then deposit its
    /// output as code at `call.address`. Callers open the creation with
    /// `begin_create`, whose checkpoint encloses this one.
    pub fn create(mut self, _ program: Program, _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction) {
        self.run_root(program, empty_bytes(), call, block, mut state, creates: true)
    }

    fn run_root(mut self, _ program: Program, _ calldata: InputData,
                _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction, creates: bool) {
        self.adopt(mut state.frame_buffers())
        self.memory.clear()
        self.memory_size = 0
        self.output.clear()
        self.return_data.clear()
        self.output_valid = false
        self.stack.clear()
        self.pc = 0
        self.status = OK
        self.halted = false
        self.unsupported_opcode = 0
        self.gas_remaining = call.gas_limit
        self.refund_delta = 0
        if program.status != OK || calldata.status != OK {
            self.fault(if program.status != OK { program.status } else { calldata.status })
            return
        }
        let refund_before = state.refund()
        let checkpoint = state.checkpoint(is_static: call.is_static)
        match self.run_until_child(program, calldata, call, block, mut state, depth: 0) {
            Option::Some(first) => self.run_children(first, program, calldata, call, block, mut state),
            Option::None => {},
        }
        if creates && self.status == OK { self.deposit_code(address: call.address, mut state) }
        if self.status == OK {
            state.commit(checkpoint)
            self.refund_delta = state.refund() - refund_before
        } else {
            state.revert(checkpoint)
        }
    }
    /// The frame's result. Its memory and stack, emptied, go to `buffers`.
    pub fn into_result(var own self, _ buffers: mut FrameBuffers) -> ExecutionResult {
        let stack_len = self.stack.len()
        let stack_top: u256 = if stack_len == 0 {
            0
        } else {
            self.stack[stack_len - 1]
        }
        self.memory.clear()
        self.stack.clear()
        // A pool that cannot grow drops them.
        if self.memory.capacity() != 0 {
            let _ = buffers.memories.try_push(core::mem::replace(mut self.memory, MemBuffer::empty()))
        }
        if self.stack.capacity() != 0 {
            let _ = buffers.stacks.try_push(core::mem::replace(mut self.stack, MemVec::new()))
        }
        ExecutionResult {
            status: self.status,
            output: self.output,
            output_valid: self.output_valid,
            stack_top,
            stack_len,
            unsupported_opcode: self.unsupported_opcode,
            gas_remaining: self.gas_remaining,
            refund_delta: self.refund_delta,
        }
    }
}

pub fn execute_vm(
    _ program: Program,
    _ calldata: InputData,
    _ call: CallEnv,
    _ block: BlockEnv,
    _ state: mut Transaction,
) -> Vm {
    var vm = Vm::new()
    vm.run(program, calldata, call, block, mut state)
    vm
}

pub fn execute(
    _ program: Program,
    _ calldata: InputData,
    _ call: CallEnv,
    _ block: BlockEnv,
    _ state: mut Transaction,
) -> ExecutionResult {
    execute_vm(program, calldata, call, block, mut state).into_result(mut state.frame_buffers())
}
