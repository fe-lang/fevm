    }

    fn op_dup9(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 9)
    }

    fn op_dup10(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 10)
    }

    fn op_dup11(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 11)
    }

    fn op_dup12(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 12)
    }

    fn op_dup13(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 13)
    }

    fn op_dup14(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 14)
    }

    fn op_dup15(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 15)
    }

    fn op_dup16(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_dup_n(code, pc, gas, depth, n: 16)
    }

    // Each DUP and SWAP has a handler of its own, so its depth is a constant.
    #[inline(always)]
    fn op_dup_n(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, n: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < n {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        let value = unsafe { *slot(self.stack.ptr(), depth - n) }
        self.push_next(code, pc.wrapping_add(1), gas - 3, depth, value)
    }

    fn op_swap1(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 1)
    }

    fn op_swap2(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 2)
    }

    fn op_swap3(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize) {
        self.op_swap_n(code, pc, gas, depth, n: 3)
    }

