    fn op_dup11<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 11)
    }

    fn op_dup12<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 12)
    }

    fn op_dup13<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 13)
    }

    fn op_dup14<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 14)
    }

    fn op_dup15<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 15)
    }

    fn op_dup16<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_dup_n(code, pc, gas, depth, top, mut tracer, n: 16)
    }

    // Each DUP and SWAP has a handler of its own, so its depth is a constant.
    #[inline(always)]
    fn op_dup_n<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T, n: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < n {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        let value = unsafe { *below(top, n) }
        self.push_next(code, pc.wrapping_add(1), gas - 3, depth, top, mut tracer, value)
    }

    fn op_swap1<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 1)
    }

    fn op_swap2<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 2)
    }

    fn op_swap3<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 3)
    }

    fn op_swap4<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 4)
    }

    fn op_swap5<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 5)
    }

    fn op_swap6<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 6)
    }

    fn op_swap7<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 7)
    }

    fn op_swap8<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 8)
    }

    fn op_swap9<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 9)
    }

    fn op_swap10<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 10)
    }

    fn op_swap11<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 11)
    }

    fn op_swap12<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 12)
    }

    fn op_swap13<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 13)
    }

    fn op_swap14<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 14)
    }

    fn op_swap15<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 15)
    }

    fn op_swap16<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        self.op_swap_n(code, pc, gas, depth, top, mut tracer, n: 16)
    }

    #[inline(always)]
    fn op_swap_n<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T, n: usize) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth <= n {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        // Swapping a 64-bit piece at a time keeps two of them live, not
        // eight.
        let first = cast<u256, u64>(below(top, 1))
        let other = cast<u256, u64>(below(top, n + 1))
        unsafe {
            swap_piece(first, other, 0)
            swap_piece(first, other, 1)
            swap_piece(first, other, 2)
            swap_piece(first, other, 3)
        }
        self.next(code, pc.wrapping_add(1), gas - 3, depth, top, mut tracer)
    }

    #[inline(always)]
    fn op_unary<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T,
                           cost: u64, op: i32) {
        if gas < cost {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 1 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - cost, depth)
        }
        let word = below(top, 1)
        match unary_result(op, unsafe { *word }) {
            Option::Some(result) => unsafe { *word = result },
            Option::None => {},
        }
        self.next(code, pc.wrapping_add(1), gas - cost, depth, top, mut tracer)
    }

    // Each binary and unary opcode has a handler of its own, which inlines
    // its one operation.
    #[inline(always)]
    fn op_binary<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T,
                            cost: u64, op: i32) {
        if gas < cost {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 2 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - cost, depth)
        }
        // The top word is the first operand; the result replaces the second.
        let second = below(top, 2)
        unsafe {
            match binary_result(op, *offset_bytes(second, 32), *second) {
                Option::Some(result) => *second = result,
                Option::None => {},
            }
        }
        self.next(code, pc.wrapping_add(1), gas - cost, depth - 1, below(top, 1), mut tracer)
    }

    fn op_mload<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 1 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        let word = below(top, 1)
        let offset = unsafe { *word }
        if !self.in_memory(offset, len: 32) {
            return self.op_mload_grow(code, pc, gas - 3, depth, top, mut tracer)
        }
        unsafe { *word = self.memory.span().read_be_unchecked<u256>(offset.downcast_unchecked()) }
        self.next(code, pc.wrapping_add(1), gas - 3, depth, top, mut tracer)
    }

    // Growth within the buffer, out of line so the common path keeps fewer
    // values live. `op_mload` checked the stack.
    fn op_mload_grow<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        let word = below(top, 1)
        let offset = unsafe { *word }
        let size = self.buffered_growth(offset, len: 32)
        if size == 0 {
            return self.op_mload_slow(code, pc, gas, depth, mut tracer)
        }
        var gas = gas
        if !spend(mut gas, small_growth_cost(current: self.memory_size, size)) {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.memory_size = size
        unsafe { *word = self.memory.span().read_be_unchecked<u256>(offset.downcast_unchecked()) }
        self.next(code, pc.wrapping_add(1), gas, depth, top, mut tracer)
    }

    // Growth past the buffer and offsets past memory, out of line so the
    // common path keeps no frame.
    fn op_mload_slow<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ tracer: mut T) {
        self.gas_remaining = gas
        unsafe { self.stack.set_len(depth) }
        self.mload()
        let gas = self.gas_remaining
        if !self.ok() {
            return self.stopped_at(pc.wrapping_add(1), gas, self.stack.len())
        }
        self.dispatch(code, pc.wrapping_add(1), gas, mut tracer)
    }

    fn op_mstore<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 2 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        let offset = unsafe { *below(top, 1) }
        if !self.in_memory(offset, len: 32) {
            return self.op_mstore_grow(code, pc, gas - 3, depth, top, mut tracer)
        }
        unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: *below(top, 2)) }
        self.next(code, pc.wrapping_add(1), gas - 3, depth - 2, below(top, 2), mut tracer)
    }

    // Growth within the buffer, out of line so the common path keeps fewer
    // values live. `op_mstore` checked the stack.
    fn op_mstore_grow<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        let offset = unsafe { *below(top, 1) }
        let size = self.buffered_growth(offset, len: 32)
        if size == 0 {
            return self.op_mstore_slow(code, pc, gas, depth, mut tracer)
        }
        var gas = gas
        if !spend(mut gas, small_growth_cost(current: self.memory_size, size)) {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.memory_size = size
        unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: *below(top, 2)) }
        self.next(code, pc.wrapping_add(1), gas, depth.wrapping_sub(2), below(top, 2), mut tracer)
    }

    // Growth past the buffer and offsets past memory, out of line so the
    // common path keeps no frame.
    fn op_mstore_slow<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ tracer: mut T) {
        self.gas_remaining = gas
        unsafe { self.stack.set_len(depth) }
        self.mstore()
        let gas = self.gas_remaining
        if !self.ok() {
            return self.stopped_at(pc.wrapping_add(1), gas, self.stack.len())
        }
        self.dispatch(code, pc.wrapping_add(1), gas, mut tracer)
    }

    fn op_mstore8<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 3 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 2 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 3, depth)
        }
        let offset = unsafe { *below(top, 1) }
        if !self.in_memory(offset, len: 1) {
            return self.op_mstore8_grow(code, pc, gas - 3, depth, top, mut tracer)
        }
        let byte: u8 = unsafe { *below(top, 2) }.downcast_truncate()
        unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: byte) }
        self.next(code, pc.wrapping_add(1), gas - 3, depth - 2, below(top, 2), mut tracer)
    }

    // As `op_mstore_grow`, for one byte.
    fn op_mstore8_grow<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        let offset = unsafe { *below(top, 1) }
        let size = self.buffered_growth(offset, len: 1)
        if size == 0 {
            return self.op_mstore8_slow(code, pc, gas, depth, mut tracer)
        }
        var gas = gas
        if !spend(mut gas, small_growth_cost(current: self.memory_size, size)) {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.memory_size = size
        let byte: u8 = unsafe { *below(top, 2) }.downcast_truncate()
        unsafe { self.memory.span().write_be_unchecked(offset: offset.downcast_unchecked(), value: byte) }
        self.next(code, pc.wrapping_add(1), gas, depth.wrapping_sub(2), below(top, 2), mut tracer)
    }

    // As `op_mstore_slow`, for one byte.
    fn op_mstore8_slow<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ tracer: mut T) {
        self.gas_remaining = gas
        unsafe { self.stack.set_len(depth) }
        self.mstore8()
        let gas = self.gas_remaining
        if !self.ok() {
            return self.stopped_at(pc.wrapping_add(1), gas, self.stack.len())
        }
        self.dispatch(code, pc.wrapping_add(1), gas, mut tracer)
    }

    // The gas of a copy of `len` bytes into memory that holds them, which
    // grows nothing: 3 and 3 per word. An empty copy grows nothing at any
    // offset. Zero when the range is not within memory, which the
    // interpreter loop then handles.
    fn copy_within_cost(self, dest: u256, len: u256) -> u64 {
        if len == 0 { return 3 }
        if len > self.memory_size as u256 { return 0 }
        let count: u64 = len.downcast_unchecked()
        if !self.in_memory(dest, len: count) { return 0 }
        3 + 3 * ((count + 31) / 32)
    }

    // Copy `len` bytes from `size` bytes at `from`, starting at `source`, into
    // memory at `dest`, zero past the end; the range is within memory.
    fn copy_padded(mut self, dest: u256, source: u256, len: u256, from: *u8, size: usize) {
        let start: usize = dest.downcast_unchecked()
        let count: usize = len.downcast_unchecked()
        if count == 0 { return }
        let copied: usize = if source >= size as u256 { 0 }
            else if (size as u256) - source < len { size - source.downcast_unchecked() }
            else { count }
        if copied != 0 {
            unsafe {
                core::ptr::copy_raw(offset_bytes(self.memory.span().ptr(), start), offset_bytes(from, source.downcast_unchecked()), copied)
            }
        }
        if copied < count { self.memory.slice(offset: start + copied, len: count - copied).zero() }
    }

    // CALLDATACOPY within memory; the interpreter loop handles everything else.
    fn op_calldatacopy<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        let cost = if depth < 3 { 0 } else { self.copy_within_cost(dest: unsafe { *below(top, 1) }, len: unsafe { *below(top, 3) }) }
        if cost == 0 || gas < cost {
            return self.op_other(code, pc, gas, depth, top, mut tracer)
        }
        self.copy_padded(dest: unsafe { *below(top, 1) }, source: unsafe { *below(top, 2) }, len: unsafe { *below(top, 3) },
                         from: self.calldata, size: self.calldata_len)
        self.next(code, pc.wrapping_add(1), gas - cost, depth - 3, below(top, 3), mut tracer)
    }

    // CODECOPY within memory; the interpreter loop handles everything else.
    fn op_codecopy<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        let cost = if depth < 3 { 0 } else { self.copy_within_cost(dest: unsafe { *below(top, 1) }, len: unsafe { *below(top, 3) }) }
        if cost == 0 || gas < cost {
            return self.op_other(code, pc, gas, depth, top, mut tracer)
        }
        self.copy_padded(dest: unsafe { *below(top, 1) }, source: unsafe { *below(top, 2) }, len: unsafe { *below(top, 3) },
                         from: code, size: self.code_len)
        self.next(code, pc.wrapping_add(1), gas - cost, depth - 3, below(top, 3), mut tracer)
    }

    // MCOPY with both ranges within memory; the interpreter loop handles
    // everything else.
    fn op_mcopy<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        let dest = if depth < 3 { 0 } else { unsafe { *below(top, 1) } }
        let source = if depth < 3 { 0 } else { unsafe { *below(top, 2) } }
        let len = if depth < 3 { 0 } else { unsafe { *below(top, 3) } }
        let cost = if depth < 3 { 0 } else { self.copy_within_cost(dest, len) }
        if cost == 0 || gas < cost || self.copy_within_cost(dest: source, len) == 0 {
            return self.op_other(code, pc, gas, depth, top, mut tracer)
        }
        if len != 0 { self.move_within(source, dest, len) }
        self.next(code, pc.wrapping_add(1), gas - cost, depth - 3, below(top, 3), mut tracer)
    }

    // Out of line: the memory view it borrows would keep `op_mcopy` from
    // tail-calling the next handler.
    #[inline(never)]
    fn move_within(mut self, _ source: u256, _ dest: u256, _ len: u256) {
        self.memory.span().copy_within(source: source.downcast_unchecked(), dest: dest.downcast_unchecked(), len: len.downcast_unchecked())
    }

    fn op_jump<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 8 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 1 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 8, depth)
        }
        let dest = unsafe { *below(top, 1) }
        if !self.jump_ok(dest) {
            return self.faulted_at(ERR_INVALID_JUMP, pc.wrapping_add(1), gas - 8, depth - 1)
        }
        self.next(code, dest.downcast_unchecked(), gas - 8, depth - 1, below(top, 1), mut tracer)
    }

    fn op_jumpi<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 10 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        if depth < 2 {
            return self.faulted_at(ERR_STACK_UNDERFLOW, pc.wrapping_add(1), gas - 10, depth)
        }
        let dest = unsafe { *below(top, 1) }
        if unsafe { *below(top, 2) } == 0 {
            return self.next(code, pc.wrapping_add(1), gas - 10, depth - 2, below(top, 2), mut tracer)
        }
        if !self.jump_ok(dest) {
            return self.faulted_at(ERR_INVALID_JUMP, pc.wrapping_add(1), gas - 10, depth - 2)
        }
        self.next(code, dest.downcast_unchecked(), gas - 10, depth - 2, below(top, 2), mut tracer)
    }

    fn op_pc<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.push_next(code, pc.wrapping_add(1), gas - 2, depth, top, mut tracer, pc as u256)
    }

    fn op_msize<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.push_next(code, pc.wrapping_add(1), gas - 2, depth, top, mut tracer, self.memory_size as u256)
    }

    fn op_gas<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 2 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.push_next(code, pc.wrapping_add(1), gas - 2, depth, top, mut tracer, (gas - 2) as u256)
    }

    fn op_jumpdest<T: Tracer>(mut self, _ code: *u8, _ pc: usize, _ gas: u64, _ depth: usize, _ top: *u256, _ tracer: mut T) {
        if gas < 1 {
            return self.faulted_at(ERR_OUT_OF_GAS, pc.wrapping_add(1), gas, depth)
        }
        self.next(code, pc.wrapping_add(1), gas - 1, depth, top, mut tracer)
    }

    // As `Program::is_jumpdest`, from the bitmap `run_until_child` keeps in
    // `self`.
    fn jump_ok(self, _ destination: u256) -> bool {
        if destination >= self.jump_limit as u256 {
            return false
        }
        let pc: usize = destination.downcast_unchecked()
        let bit: u8 = (pc % 8).downcast_unchecked()
        let byte = unsafe { *offset_bytes(self.jumpdests, pc / 8) }
        byte & (1 << bit) != 0
    }

    fn run_until_child<T: Tracer>(mut self, _ program: Program, _ calldata: InputData,
                                  _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction,
                                  depth: usize, _ tracer: mut T) -> Option<Box<Frame>> {
        // Pushes skip the capacity check, so the stack holds its limit first.
        if !self.stack.try_reserve(STACK_LIMIT - self.stack.len()) {
            self.fault(ERR_HOST_ALLOCATION)
            return Option::None
        }
        // The code cannot change while the frame runs. `pc` and gas live in
        // locals here; `self` holds them only around calls that use them.
        // Every arm that can fault or halt leaves the loop itself, so the
        // loop checks no status per opcode. Padding stops a frame that runs
        // off the end.
        let code = program.padded()
        self.jumpdests = program.jumpdest_map()
        self.jump_limit = program.jump_limit()
        self.call_depth = depth
        self.code_len = program.len()
        self.calldata = calldata.bytes().ptr()
        self.calldata_len = calldata.len()
        var pc = self.pc
        var gas = self.gas_remaining
        if self.ok() {
            while true {
                // Handlers run the common opcodes and stop at any other.
                self.dispatch(code.ptr(), pc, gas, mut tracer)
                pc = self.pc
                gas = self.gas_remaining
                if self.halted || !self.ok() {
                    break
                }
                // `pc` never passes the padding: a PUSH ends at most 32 bytes
                // past the code, and padding reads as STOP.
                let op = unsafe { code.read_be_unchecked<u8>(pc) } as i32
                // `pc` stays within the code and its padding, far from overflow.
                pc = pc.wrapping_add(1)
                match op {
                    0x30 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.address) { break }
                    },
                    0x32 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.origin) { break }
                    },
                    0x33 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.caller) { break }
                    },
                    0x34 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.callvalue) { break }
                    },
                    0x36 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(calldata.len() as u256) { break }
                    },
                    0x38 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(program.len() as u256) { break }
                    },
                    0x3a => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(call.gasprice) { break }
                    },
                    0x3d => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(self.return_data.len() as u256) { break }
                    },
                    0x41 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.coinbase) { break }
                    },
                    0x42 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.timestamp) { break }
                    },
                    0x43 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.number) { break }
                    },
                    0x44 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.prevrandao) { break }
                    },
                    0x45 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.gaslimit) { break }
                    },
                    0x46 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.chainid) { break }
                    },
                    0x48 => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.basefee) { break }
                    },
                    0x4a => {
                        if !spend(mut gas, 2) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        if !self.pushed(block.blobbasefee) { break }
                    },
                    // The rest charge their base cost from the table and dispatch
                    // again; those that call out charge more through `self`.
                    _ => {
                        if !spend(mut gas, base_cost(op)) {
                            self.fault(ERR_OUT_OF_GAS)
                            break
                        }
                        match op {
                        0x20 => {
                            self.gas_remaining = gas
                            self.sha3()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x31 | 0x3b | 0x3f => {
                            self.gas_remaining = gas
                            self.account_field(op, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x35 => {
                            self.calldataload(calldata)
                            if !self.ok() { break }
                        },
                        0x37 => {
                            self.gas_remaining = gas
                            self.calldatacopy(calldata)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x39 => {
                            self.gas_remaining = gas
                            self.codecopy(program)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x3c => {
                            self.gas_remaining = gas
                            self.extcodecopy(mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x3e => {
                            self.gas_remaining = gas
                            self.returndatacopy()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x40 => {
                            let number = self.pop()
                            if !self.ok() { break }
                            let hash = if number < block.number && block.number - number <= 256 {
                                state.block_hash(number)
                            } else { 0 }
                            if !self.pushed(hash) { break }
                        },
                        0x47 => if !self.pushed(state.balance(call.address)) { break },
                        0x49 => {
                            let index = self.pop()
                            if !self.ok() || !self.pushed(state.blob_hash(index)) { break }
                        },
                        0x53 => {
                            self.gas_remaining = gas
                            self.mstore8()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x54 => {
                            self.gas_remaining = gas
                            self.sload(call, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x55 => {
                            self.gas_remaining = gas
                            self.sstore(call, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0x5c => {
                            self.tload(call, state)
                            if !self.ok() { break }
                        },
                        0x5d => {
                            self.tstore(call, mut state)
                            if !self.ok() { break }
                        },
                        0x5e => {
                            self.gas_remaining = gas
                            self.mcopy()
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0xa0 | 0xa1 | 0xa2 | 0xa3 | 0xa4 => {
                            self.gas_remaining = gas
                            self.log((op - 0xa0).downcast_unchecked(), call, mut state)
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        0xf3 => {
                            self.gas_remaining = gas
                            self.finish_from_memory(OK)
                            gas = self.gas_remaining
                            break
                        },
                        0xfd => {
                            self.gas_remaining = gas
                            self.finish_from_memory(ERR_REVERT)
                            gas = self.gas_remaining
                            break
                        },
                        0xff => {
                            self.gas_remaining = gas
                            self.selfdestruct(call, mut state)
                            gas = self.gas_remaining
                            break
                        },
                        0xf0 | 0xf1 | 0xf2 | 0xf4 | 0xf5 | 0xfa => {
                            self.pc = pc
                            self.gas_remaining = gas
                            let child = if op == 0xf0 || op == 0xf5 {
                                self.start_create(op, call, mut state, depth, mut tracer)
                            } else {
                                self.start_call(op, call, mut state, depth, mut tracer)
                            }
                            match child {
                                Option::Some(frame) => return Option::Some(frame),
                                Option::None => {},
                            }
                            pc = self.pc
                            gas = self.gas_remaining
                            if !self.ok() { break }
                        },
                        // INVALID (0xfe) and every undefined byte are exceptional halts.
                        _ => {
                            self.fault(ERR_INVALID_OPCODE)
                            break
                        },
                        }
                    },
                }
            }
        }
        // A fault that halts exceptionally leaves no gas.
        self.pc = pc
        self.gas_remaining = if exceptional(self.status) { 0 } else { gas }
        Option::None
    }

    fn run_children<T: Tracer>(mut self, _ first: own Box<Frame>, _ program: Program, _ calldata: InputData,
                               _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction, _ tracer: mut T) {
        // The executing children, innermost last. Each is boxed, so frame
        // storage grows with the actual call depth and a frame never moves.
        var frames: MemVec<Box<Frame>> = MemVec::new()
        var next = Option::Some(first)
        while true {
            match next {
                Option::Some(frame) => {
                    var frame = frame
                    frame.get().vm.adopt(mut state.frame_buffers())
                    match frames.try_push(frame) {
                        Result::Ok(()) => {},
                        // Like other host failures while starting a child, this fails the parent.
                        Result::Err(frame) => {
                            var frame = frame
                            frame.get().abort(mut state)
                            let depth = frames.len()
                            if depth == 0 { self.fault(ERR_HOST_ALLOCATION) }
                            else { frames[depth - 1].get().vm.fault(ERR_HOST_ALLOCATION) }
                        },
                    }
                },
                Option::None => {
                    let depth = frames.len()
                    if depth == 0 { break }
                    var frame = frames.pop().unwrap()
                    let result = frame.get().finish(mut state)
                    tracer.leave(CallEnd { depth, status: result.result.status, gas: result.result.gas_remaining },
                                 output: result.result.output.span())
                    // A pool that cannot grow frees it.
                    let _ = state.frame_buffers().frames.try_push(frame)
                    if depth == 1 { self.accept_child(result) }
                    else { frames[depth - 2].get().vm.accept_child(result) }
                },
            }
            let depth = frames.len()
            next = if depth == 0 {
                self.run_until_child(program, calldata, call, block, mut state, depth: 0, mut tracer)
            } else {
                frames[depth - 1].get().resume(block, mut state, depth, mut tracer)
            }
        }
    }

    pub fn run<T: Tracer>(mut self, _ program: Program, _ calldata: InputData,
                          _ call: CallEnv, _ block: BlockEnv, _ state: mut Transaction, _ tracer: mut T) {
        self.run_root(program, calldata, call, block, mut state, mut tracer, creates: false)
    }

    /// Run initcode at depth zero under its own checkpoint, then deposit its
    /// output as code at `call.address`. Callers open the creation with
    /// `begin_create`, whose checkpoint encloses this one.
    pub fn create<T: Tracer>(mut self, _ program: Program, _ call: CallEnv, _ block: BlockEnv,
                             _ state: mut Transaction, _ tracer: mut T) {
        self.run_root(program, empty_bytes(), call, block, mut state, mut tracer, creates: true)
    }

    fn run_root<T: Tracer>(mut self, _ program: Program, _ calldata: InputData, _ call: CallEnv,
                           _ block: BlockEnv, _ state: mut Transaction, _ tracer: mut T, creates: bool) {
        self.adopt(mut state.frame_buffers())
        self.reset(gas: call.gas_limit)
        if program.status != OK || calldata.status != OK {
            self.fault(if program.status != OK { program.status } else { calldata.status })
            return
        }
        let refund_before = state.refund()
        let checkpoint = state.checkpoint(is_static: call.is_static)
        match self.run_until_child(program, calldata, call, block, mut state, depth: 0, mut tracer) {
            Option::Some(first) => self.run_children(first, program, calldata, call, block, mut state, mut tracer),
            Option::None => {},
        }
        if creates && self.status == OK { self.deposit_code(address: call.address, mut state) }
        if self.status == OK {
            state.commit(checkpoint)
            self.refund_delta = state.refund() - refund_before
        } else {
            state.revert(checkpoint)
        }
    }
    /// The frame's result. Its memory and stack, emptied, go to `buffers`.
    pub fn into_result(var own self, _ buffers: mut FrameBuffers) -> ExecutionResult {
        self.take_result(mut buffers)
    }

    /// As `into_result`, leaving the VM without output, memory or stack.
    fn take_result(mut self, _ buffers: mut FrameBuffers) -> ExecutionResult {
        let stack_len = self.stack.len()
        let stack_top: u256 = if stack_len == 0 {
            0
        } else {
            self.stack[stack_len - 1]
        }
        self.memory.clear()
        self.stack.clear()
        // A pool that cannot grow drops them.
        if self.memory.capacity() != 0 {
            let _ = buffers.memories.try_push(core::mem::replace(mut self.memory, MemBuffer::empty()))
        }
        if self.stack.capacity() != 0 {
            let _ = buffers.stacks.try_push(core::mem::replace(mut self.stack, MemVec::new()))
        }
        ExecutionResult {
            status: self.status,
            output: core::mem::replace(mut self.output, MemBuffer::empty()),
            output_valid: self.output_valid,
            stack_top,
            stack_len,
            gas_remaining: self.gas_remaining,
            refund_delta: self.refund_delta,
        }
    }
}

pub fn execute_vm(
    _ program: Program,
    _ calldata: InputData,
    _ call: CallEnv,
    _ block: BlockEnv,
    _ state: mut Transaction,
) -> Vm {
    var vm = Vm::new()
    var tracer = ()
    vm.run(program, calldata, call, block, mut state, mut tracer)
    vm
}

pub fn execute(
    _ program: Program,
    _ calldata: InputData,
    _ call: CallEnv,
    _ block: BlockEnv,
    _ state: mut Transaction,
) -> ExecutionResult {
    execute_vm(program, calldata, call, block, mut state).into_result(mut state.frame_buffers())
}
