use std::native::ByteBuffer

// Internal packed-buffer words use little endian, independently of EVM byte order.
pub fn write_word(_ bytes: mut ByteBuffer, offset: u64, value: u256) {
    let mut i: u64 = 0
    while i < 32 {
        bytes.set_byte(index: offset + i, value: (value >> (i * 8) as u256).downcast_truncate())
        i += 1
    }
}

pub fn read_word(_ bytes: ByteBuffer, offset: u64) -> u256 {
    let mut value: u256 = 0
    let mut i: u64 = 0
    while i < 32 {
        value |= (bytes.byte_at(offset + i) as u256) << (i * 8) as u256
        i += 1
    }
    value
}
