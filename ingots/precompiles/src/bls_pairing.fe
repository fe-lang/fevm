use ingot::bls_curve::{Affine, Point}
use ingot::bls_field::{Field, Fp}
use ingot::bls_tower::{Fp12, Fp2, Fp6}

// |x| for the BLS parameter x = -0xd201000000010000.
const BLS_X: u64 = 0xd201000000010000

struct Line { c0: Fp2, c1: Fp2, c2: Fp2 }

// Evaluate a line at the G1 point and multiply it into f.
fn ell(_ f: Fp12, _ line: Line, _ p: Affine<Fp>) -> Fp12 {
    f.mul_by_014(c0: line.c2, c1: line.c1.mul_fp(p.x), c4: line.c0.mul_fp(p.y))
}

// Doubling step on Jacobian r with its tangent line (Algorithm 26 of
// https://eprint.iacr.org/2010/354, as adapted by the zkcrypto bls12_381 crate).
fn doubling_step(_ r: mut Point<Fp2>) -> Line {
    let tmp0 = r.x.square()
    let tmp1 = r.y.square()
    let tmp2 = tmp1.square()
    let tmp3 = tmp1.add(r.x).square().sub(tmp0).sub(tmp2).double()
    let tmp4 = tmp0.double().add(tmp0)
    let tmp6 = r.x.add(tmp4)
    let tmp5 = tmp4.square()
    let zsquared = r.z.square()
    r.x = tmp5.sub(tmp3).sub(tmp3)
    r.z = r.z.add(r.y).square().sub(tmp1).sub(zsquared)
    r.y = tmp3.sub(r.x).mul(tmp4).sub(tmp2.double().double().double())
    let c1 = tmp4.mul(zsquared).double().neg()
    let c2 = tmp6.square().sub(tmp0).sub(tmp5).sub(tmp1.double().double())
    let c0 = r.z.mul(zsquared).double()
    Line { c0, c1, c2 }
}

// Addition step of Jacobian r and affine q with their chord (Algorithm 27).
fn addition_step(_ r: mut Point<Fp2>, _ q: Affine<Fp2>) -> Line {
    let zsquared = r.z.square()
    let ysquared = q.y.square()
    let t0 = zsquared.mul(q.x)
    let t1 = q.y.add(r.z).square().sub(ysquared).sub(zsquared).mul(zsquared)
    let t2 = t0.sub(r.x)
    let t3 = t2.square()
    let t4 = t3.double().double()
    let t5 = t4.mul(t2)
    let t6 = t1.sub(r.y).sub(r.y)
    let t9 = t6.mul(q.x)
    let t7 = t4.mul(r.x)
    r.x = t6.square().sub(t5).sub(t7).sub(t7)
    r.z = r.z.add(t2).square().sub(zsquared).sub(t3)
    let t8 = t7.sub(r.x).mul(t6)
    r.y = t8.sub(r.y.mul(t5).double())
    let t10 = q.y.add(r.z).square().sub(ysquared).sub(r.z.square())
    Line { c0: r.z.double(), c1: t6.neg().double(), c2: t9.double().sub(t10) }
}

/// The product of two Miller loops; pairs with an identity point contribute one.
pub fn miller_loop(_ p1: Affine<Fp>, _ q1: Affine<Fp2>, _ p2: Affine<Fp>, _ q2: Affine<Fp2>) -> Fp12 {
    let use1 = !p1.infinity && !q1.infinity
    let use2 = !p2.infinity && !q2.infinity
    var r1 = Point::from_affine(q1)
    var r2 = Point::from_affine(q2)
    var f = Fp12::one()
    var found_one = false
    var bit: u64 = 64
    while bit > 0 {
        bit -= 1
        let set = ((BLS_X >> 1) >> bit) & 1 == 1
        if !found_one {
            found_one = set
        } else {
            if use1 { f = ell(f, doubling_step(mut r1), p1) }
            if use2 { f = ell(f, doubling_step(mut r2), p2) }
            if set {
                if use1 { f = ell(f, addition_step(mut r1, q1), p1) }
                if use2 { f = ell(f, addition_step(mut r2, q2), p2) }
            }
            f = f.square()
        }
    }
    if use1 { f = ell(f, doubling_step(mut r1), p1) }
    if use2 { f = ell(f, doubling_step(mut r2), p2) }
    // x is negative.
    f.conjugate()
}

fn fp4_square(_ a: Fp2, _ b: Fp2) -> (Fp2, Fp2) {
    let t0 = a.square()
    let t1 = b.square()
    let c0 = t1.mul_by_nonresidue().add(t0)
    let c1 = a.add(b).square().sub(t0).sub(t1)
    (c0, c1)
}

// Squaring in the cyclotomic subgroup (Granger-Scott, https://eprint.iacr.org/2009/565).
fn cyclotomic_square(_ f: Fp12) -> Fp12 {
    var z0 = f.c0.c0
    var z4 = f.c0.c1
    var z3 = f.c0.c2
    var z2 = f.c1.c0
    var z1 = f.c1.c1
    var z5 = f.c1.c2
    let (t0, t1) = fp4_square(z0, z1)
    z0 = t0.sub(z0)
    z0 = z0.double().add(t0)
    z1 = t1.add(z1)
    z1 = z1.double().add(t1)
    let (u0, u1) = fp4_square(z2, z3)
    let (u2, u3) = fp4_square(z4, z5)
    z4 = u0.sub(z4)
    z4 = z4.double().add(u0)
    z5 = u1.add(z5)
    z5 = z5.double().add(u1)
    let n = u3.mul_by_nonresidue()
    z2 = n.add(z2)
    z2 = z2.double().add(n)
    z3 = u2.sub(z3)
    z3 = z3.double().add(u2)
    Fp12 { c0: Fp6 { c0: z0, c1: z4, c2: z3 }, c1: Fp6 { c0: z2, c1: z1, c2: z5 } }
}

// f^|x| for f in the cyclotomic subgroup, conjugated because x is negative.
fn cyclotomic_exp(_ f: Fp12) -> Fp12 {
    var result = Fp12::one()
    var found_one = false
    var bit: u64 = 64
    while bit > 0 {
        bit -= 1
        let set = (BLS_X >> bit) & 1 == 1
        if found_one { result = cyclotomic_square(result) } else { found_one = set }
        if set { result = result.mul(f) }
    }
    result.conjugate()
}

fn frobenius_times(_ f: Fp12, _ times: u64) -> Fp12 {
    var result = f
    var i: u64 = 0
    while i < times {
        result = result.frobenius()
        i += 1
    }
    result
}

/// Raise a nonzero Miller loop result to (p^12 - 1) / r, following the
/// zkcrypto bls12_381 final exponentiation.
pub fn final_exponentiation(_ f: Fp12) -> Fp12 {
    var t0 = frobenius_times(f, 6)
    var t1 = f.invert()
    var t2 = t0.mul(t1)
    t1 = t2
    t2 = frobenius_times(t2, 2).mul(t1)
    t1 = cyclotomic_square(t2).conjugate()
    var t3 = cyclotomic_exp(t2)
    var t4 = cyclotomic_square(t3)
    var t5 = t1.mul(t3)
    t1 = cyclotomic_exp(t5)
    t0 = cyclotomic_exp(t1)
    var t6 = cyclotomic_exp(t0).mul(t4)
    t4 = cyclotomic_exp(t6)
    t5 = t5.conjugate()
    t4 = t4.mul(t5.mul(t2))
    t5 = t2.conjugate()
    t1 = frobenius_times(t1.mul(t2), 3)
    t6 = t6.mul(t5).frobenius()
    t3 = frobenius_times(t3.mul(t0), 2).mul(t1).mul(t6)
    t3.mul(t4)
}

/// Whether e(p1, q1) * e(p2, q2) is the identity of the target group.
pub fn pairing_product_is_one(_ p1: Affine<Fp>, _ q1: Affine<Fp2>, _ p2: Affine<Fp>, _ q2: Affine<Fp2>) -> bool {
    final_exponentiation(miller_loop(p1, q1, p2, q2)).is_one()
}
