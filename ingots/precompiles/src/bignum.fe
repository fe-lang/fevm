// Little-endian u64 limb arithmetic modulo a fixed-capacity modulus.
//
// std::native offers no typed growable array, and ByteBuffer limbs would cost
// eight byte accesses per limb, so operands live in fixed arrays. MAX_LIMBS
// covers an 8,192-byte significant modulus; the base and exponent are streamed
// from their source and have no size limit.
pub const MAX_LIMBS: u64 = 1024
const WIDE_LIMBS: u64 = 2 * MAX_LIMBS + 1
const LIMB_BASE: u128 = 0x10000000000000000

pub type Limbs = [u64; 1024]
pub type Wide = [u64; 2049]

fn leading_zeros(_ value: u64) -> u64 {
    var count: u64 = 0
    while count < 64 && ((value >> (63 - count)) & 1) == 0 { count += 1 }
    count
}

/// A modulus normalized for Knuth division: shifted left until its top limb's
/// high bit is set. `len` is its significant limb count, at least one.
pub struct Modulus { pub limbs: Limbs, pub len: u64, pub shift: u64 }

impl Modulus {
    pub fn new(_ value: Limbs, len: u64) -> Self {
        core::assert(len > 0 && len <= MAX_LIMBS && value[(len - 1) as usize] != 0)
        let shift = leading_zeros(value[(len - 1) as usize])
        var limbs: Limbs = [0; 1024]
        var i: u64 = 0
        while i < len {
            let high = value[i as usize] << shift
            let low = if shift == 0 || i == 0 { 0 } else { value[(i - 1) as usize] >> (64 - shift) }
            limbs[i as usize] = high | low
            i += 1
        }
        Self { limbs, len, shift }
    }

    /// Reduce the `len`-limb value in `work` (with room for one more limb) in
    /// place; the remainder occupies limbs `0..self.len`, the rest are cleared.
    pub fn reduce(self, _ work: mut Wide, len: u64) {
        core::assert(len < WIDE_LIMBS)
        let n = self.len
        if len < n {
            // Fewer limbs than the modulus: already reduced.
            var i = len
            while i <= n {
                work[i as usize] = 0
                i += 1
            }
            return
        }
        // Normalize the dividend by the divisor's shift, adding a top limb.
        work[len as usize] = 0
        if self.shift != 0 {
            var i = len
            while i > 0 {
                work[i as usize] = work[i as usize] | (work[(i - 1) as usize] >> (64 - self.shift))
                work[(i - 1) as usize] = work[(i - 1) as usize] << self.shift
                i -= 1
            }
        }
        let top = self.limbs[(n - 1) as usize] as u128
        let second = if n > 1 { self.limbs[(n - 2) as usize] as u128 } else { 0 }
        var i: u64 = 0
        var j = len + 1 - n
        while j > 0 {
            j -= 1
            // Estimate this quotient digit from the top two dividend limbs.
            let head = ((work[(j + n) as usize] as u128) << 64) | work[(j + n - 1) as usize] as u128
            var qhat = head / top
            var rhat = head % top
            while qhat >= LIMB_BASE
                || (n > 1 && qhat * second > ((rhat << 64) | work[(j + n - 2) as usize] as u128)) {
                qhat -= 1
                rhat += top
                if rhat >= LIMB_BASE { break }
            }
            // Subtract qhat times the divisor at limb j.
            var carry: u128 = 0
            var borrow: u128 = 0
            i = 0
            while i < n {
                let product = qhat * self.limbs[i as usize] as u128 + carry
                carry = product >> 64
                let subtrahend = (product & 0xffffffffffffffff) + borrow
                let limb = work[(i + j) as usize] as u128
                if limb >= subtrahend {
                    work[(i + j) as usize] = (limb - subtrahend).downcast_unchecked()
                    borrow = 0
                } else {
                    work[(i + j) as usize] = (limb + LIMB_BASE - subtrahend).downcast_unchecked()
                    borrow = 1
                }
                i += 1
            }
            let subtrahend = carry + borrow
            let limb = work[(j + n) as usize] as u128
            if limb >= subtrahend {
                work[(j + n) as usize] = (limb - subtrahend).downcast_unchecked()
            } else {
                // The estimate was one too large: add the divisor back once.
                work[(j + n) as usize] = (limb + LIMB_BASE - subtrahend).downcast_unchecked()
                var add: u128 = 0
                i = 0
                while i < n {
                    let sum = work[(i + j) as usize] as u128 + self.limbs[i as usize] as u128 + add
                    work[(i + j) as usize] = (sum & 0xffffffffffffffff).downcast_unchecked()
                    add = sum >> 64
                    i += 1
                }
                let sum = work[(j + n) as usize] as u128 + add
                work[(j + n) as usize] = (sum & 0xffffffffffffffff).downcast_unchecked()
            }
        }
        // The normalized remainder is below the divisor, so limb n is zero.
        // Undo the normalization and clear the quotient limbs.
        i = 0
        while i < n {
            let low = work[i as usize] >> self.shift
            let high = if self.shift == 0 { 0 } else { work[(i + 1) as usize] << (64 - self.shift) }
            work[i as usize] = low | high
            i += 1
        }
        i = n
        while i <= len {
            work[i as usize] = 0
            i += 1
        }
    }

    /// `a * b mod self` for reduced `a` and `b`, left in limbs `0..self.len` of `work`.
    pub fn mul_mod(self, _ a: Limbs, _ b: Limbs, _ work: mut Wide) {
        let n = self.len
        var i: u64 = 0
        while i < 2 * n {
            work[i as usize] = 0
            i += 1
        }
        i = 0
        while i < n {
            var carry: u128 = 0
            let left = a[i as usize] as u128
            var j: u64 = 0
            while j < n {
                let t = left * b[j as usize] as u128 + work[(i + j) as usize] as u128 + carry
                work[(i + j) as usize] = (t & 0xffffffffffffffff).downcast_unchecked()
                carry = t >> 64
                j += 1
            }
            work[(i + n) as usize] = carry.downcast_unchecked()
            i += 1
        }
        self.reduce(mut work, len: 2 * n)
    }
}
