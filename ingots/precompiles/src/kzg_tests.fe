use core::Option
use ingot::{FAILURE, Output, SUCCESS, run}
use ingot::bls_curve::{ORDER, decompress_g1, g1_generator, g2_generator}
use ingot::bls_field::{Field, Fp}
use ingot::bls_pairing::pairing_product_is_one
use ingot::bls_tower::{Fp12, Fp2, Fp6}
use ingot::kzg::{BLS_MODULUS, decode_kzg_g1}

const P_LIMBS: [u64; 6] = [0xb9feffffffffaaab, 0x1eabfffeb153ffff, 0x6730d2a0f6b0f624, 0x64774b84f38512bf, 0x4b1ba7b6434bacd7, 0x1a0111ea397fe69a]

fn same(_ a: [u64; 6], _ b: [u64; 6]) -> bool {
    a[0] == b[0] && a[1] == b[1] && a[2] == b[2] && a[3] == b[3] && a[4] == b[4] && a[5] == b[5]
}

#[test]
fn bls_base_field_matches_reference_arithmetic() {
    // a = 2^380 + 12345 and b = 3^200 mod p; expectations from Python big integers.
    let a = Fp::from_canonical([0x3039, 0, 0, 0, 0, 0x1000000000000000])
    let b = Fp::from_canonical([0x5bfaff1eaaf8b0a1, 0x83ecf6f6e4a7ae22, 0xfd73d97e447606b6, 0xc21a937a76f3432f, 0x1fd5863c3eb0469e, 0])
    core::assert(same(a.mul(b).to_canonical(), [0xe84ff786a9deb184, 0xa6d85c693890846c, 0x1e958dbd7c478f2c, 0x37eb90d3a5822ce5, 0x1026a62884a5b7c5, 0x15a2fe84df99ff28]))
    core::assert(same(a.sub(b).to_canonical(), [0xa40500e155077f98, 0x7c1309091b5851dd, 0x028c2681bb89f949, 0x3de56c85890cbcd0, 0xe02a79c3c14fb961, 0x0fffffffffffffff]))
    core::assert(same(b.sub(a).to_canonical(), [0x15f9ff1eaaf82b13, 0xa298f6f595fbae22, 0x64a4ac1f3b26fcda, 0x2691deff6a7855ef, 0x6af12df281fbf376, 0x0a0111ea397fe69a]))
    core::assert(same(a.invert().to_canonical(), [0x1f8587ce64f72bd5, 0xc77b597a1c9fa2b9, 0x2dca8a0795c536e6, 0xe5643a95129aa69c, 0x547a6ea163c752b4, 0x0a0c163a304d5b26]))
    core::assert(a.add(b).sub(b).equals(a) && a.add(a.neg()).is_zero() && a.mul(a.invert()).equals(Fp::one()))
    let four = Fp::from_canonical([4, 0, 0, 0, 0, 0])
    match four.sqrt() {
        Option::Some(root) => core::assert(root.square().equals(four)),
        Option::None => core::panic(),
    }
    // 2 is not a square modulo p.
    core::assert(Fp::from_canonical([2, 0, 0, 0, 0, 0]).sqrt().is_none())
}

fn sample() -> Fp12 {
    let step = Fp::from_canonical([0x5bfaff1eaaf8b0a1, 0x83ecf6f6e4a7ae22, 0xfd73d97e447606b6, 0xc21a937a76f3432f, 0x1fd5863c3eb0469e, 0])
    var seed = Fp::from_canonical([7, 0, 0, 0, 0, 0])
    var parts: [Fp2; 6] = [Fp2::zero(); 6]
    var i: u64 = 0
    while i < 6 {
        let c0 = seed
        seed = seed.mul(step).add(Fp::one())
        parts[i as usize] = Fp2::new(c0, c1: seed)
        seed = seed.mul(step).add(Fp::one())
        i += 1
    }
    Fp12 {
        c0: Fp6 { c0: parts[0], c1: parts[1], c2: parts[2] },
        c1: Fp6 { c0: parts[3], c1: parts[4], c2: parts[5] },
    }
}

#[test]
fn bls_tower_frobenius_inverse_and_sparse_products_agree() {
    let f = sample()
    // f^p by square-and-multiply over the bits of p.
    var power = Fp12::one()
    var bit: u64 = 384
    while bit > 0 {
        bit -= 1
        power = power.square()
        if (P_LIMBS[(bit / 64) as usize] >> (bit % 64)) & 1 == 1 { power = power.mul(f) }
    }
    core::assert(f.frobenius().equals(power))
    core::assert(f.mul(f.invert()).is_one())
    let c0 = f.c0.c2
    let c1 = f.c1.c0
    let c4 = f.c0.c1
    let sparse = Fp12 { c0: Fp6 { c0, c1, c2: Fp2::zero() }, c1: Fp6 { c0: Fp2::zero(), c1: c4, c2: Fp2::zero() } }
    core::assert(f.mul_by_014(c0, c1, c4).equals(f.mul(sparse)))
    core::assert(f.square().equals(f.mul(f)))
}

#[test]
fn bls_pairing_is_bilinear_and_nondegenerate() {
    let g1 = g1_generator()
    let g2 = g2_generator()
    let a: u256 = 0x1234567890abcdef
    // e([a]G1, G2) * e(-G1, [a]G2) = 1, while e(G1, G2)^2 != 1.
    core::assert(pairing_product_is_one(g1.multiply(a).to_affine(), g2.to_affine(),
                                        g1.neg().to_affine(), g2.multiply(a).to_affine()))
    core::assert(!pairing_product_is_one(g1.to_affine(), g2.to_affine(), g1.to_affine(), g2.to_affine()))
    core::assert(g1.in_subgroup() && g2.in_subgroup() && g1.multiply(ORDER - 1).add(g1).is_identity())
}

#[test]
fn bls_compressed_g1_points_follow_zcash_encoding() {
    // The generator's compressed encoding, and malformed variants of it.
    var encoded: [u8; 48] = [
        0x97, 0xf1, 0xd3, 0xa7, 0x31, 0x97, 0xd7, 0x94, 0x26, 0x95, 0x63, 0x8c, 0x4f, 0xa9, 0xac, 0x0f,
        0xc3, 0x68, 0x8c, 0x4f, 0x97, 0x74, 0xb9, 0x05, 0xa1, 0x4e, 0x3a, 0x3f, 0x17, 0x1b, 0xac, 0x58,
        0x6c, 0x55, 0xe8, 0x3f, 0xf9, 0x7a, 0x1a, 0xef, 0xfb, 0x3a, 0xf0, 0x0a, 0xdb, 0x22, 0xc6, 0xbb,
    ]
    let generator = g1_generator().to_affine()
    match decode_kzg_g1(encoded, offset: 0) {
        Option::Some(point) => core::assert(point.x.equals(generator.x) && point.y.equals(generator.y)),
        Option::None => core::panic(),
    }
    // The sign flag selects the negated root.
    encoded[0] = 0xb7
    match decompress_g1(encoded, offset: 0) {
        Option::Some(point) => core::assert(point.y.equals(generator.y.neg())),
        Option::None => core::panic(),
    }
    // Missing compression flag; infinity flag with nonzero x.
    encoded[0] = 0x17
    core::assert(decompress_g1(encoded, offset: 0).is_none())
    encoded[0] = 0xd7
    core::assert(decompress_g1(encoded, offset: 0).is_none())
    // Infinity must be exactly 0xc0 followed by zeros.
    var infinity: [u8; 48] = [0; 48]
    infinity[0] = 0xc0
    core::assert(decode_kzg_g1(infinity, offset: 0).is_some())
    infinity[0] = 0xe0
    core::assert(decompress_g1(infinity, offset: 0).is_none())
    infinity[0] = 0x80
    core::assert(decompress_g1(infinity, offset: 0).is_none())
    // x = p is not a field element.
    var big: [u8; 48] = [0; 48]
    var i: u64 = 0
    while i < 48 {
        big[i as usize] = (P_LIMBS[((47 - i) / 8) as usize] >> (((47 - i) % 8) * 8)).downcast_truncate()
        i += 1
    }
    big[0] |= 0x80
    core::assert(decompress_g1(big, offset: 0).is_none())
}

fn assert_output(_ result: own Output) {
    core::assert(result.status == SUCCESS && result.gas_used == 50000 && result.output.len() == 64)
    var value: u256 = 0
    var modulus: u256 = 0
    var i: u64 = 0
    while i < 32 {
        value = (value << 8) | result.output[i as usize] as u256
        modulus = (modulus << 8) | result.output[(32 + i) as usize] as u256
        i += 1
    }
    core::assert(value == 4096 && modulus == BLS_MODULUS)
}

#[test]
fn point_evaluation_verifies_c_kzg_vectors() {
    // verify_kzg_proof vectors from the c-kzg-4844 suite, as used by EEST.
    assert_output(run(address: 10, input: VALID, gas: 60000))
    assert_output(run(address: 10, input: VALID_INFINITY, gas: 50000))
    let incorrect = run(address: 10, input: INCORRECT, gas: 60000)
    core::assert(incorrect.status == FAILURE && incorrect.gas_used == 60000)
    let short_gas = run(address: 10, input: VALID, gas: 49999)
    core::assert(short_gas.status == FAILURE)
    var tampered = VALID
    tampered[31] ^= 1
    let hash_mismatch = run(address: 10, input: tampered, gas: 60000)
    core::assert(hash_mismatch.status == FAILURE)
    let empty: [u8; 0] = []
    let wrong_length = run(address: 10, input: empty, gas: 60000)
    core::assert(wrong_length.status == FAILURE)
}

