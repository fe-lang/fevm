use ingot::{FAILURE, SUCCESS, run}
use ingot::hashes::{ripemd160, sha256}

fn word_at<const N: usize>(_ bytes: [u8; N], offset: usize) -> u256 {
    var value: u256 = 0
    var i: usize = 0
    while i < 32 {
        value = (value << 8) | bytes[offset + i] as u256
        i += 1
    }
    value
}

#[test]
fn sha256_known_answers() {
    let empty: [u8; 0] = []
    core::assert(word_at(sha256(empty), offset: 0)
        == 0xe3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855)
    core::assert(word_at(sha256([0x61 as u8, 0x62, 0x63]), offset: 0)
        == 0xba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad)
    // 56 bytes: the padding spills into a second block.
    var long: [u8; 56] = [0x61; 56]
    core::assert(word_at(sha256(long), offset: 0)
        == 0xb35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a)
}

#[test]
fn ripemd160_known_answers() {
    let empty: [u8; 0] = []
    var padded: [u8; 32] = [0; 32]
    var i: usize = 0
    let digest = ripemd160(empty)
    while i < 20 {
        padded[12 + i] = digest[i]
        i += 1
    }
    core::assert(word_at(padded, offset: 0) == 0x9c1185a5c5e9fc54612808977ee8f548b2258d31)
    let abc = ripemd160([0x61 as u8, 0x62, 0x63])
    i = 0
    while i < 20 {
        padded[12 + i] = abc[i]
        i += 1
    }
    core::assert(word_at(padded, offset: 0) == 0x8eb208f7e05d987a9b044a8e98c6b087f15a0bfc)
}

#[test]
fn hash_precompiles_charge_per_word_and_return_padded_digests() {
    let input = [0x61 as u8, 0x62, 0x63]
    let sha = run(address: 2, input, gas: 72)
    core::assert(sha.status == SUCCESS && sha.gas_used == 72 && sha.output.len() == 32)
    core::assert(sha.output[0 as usize] == 0xba && sha.output[31 as usize] == 0xad)
    let short = run(address: 2, input, gas: 71)
    core::assert(short.status == FAILURE && short.gas_used == 71)
    let ripemd = run(address: 3, input, gas: 720)
    core::assert(ripemd.status == SUCCESS && ripemd.output.len() == 32)
    core::assert(ripemd.output[11 as usize] == 0 && ripemd.output[12 as usize] == 0x8e)
    let identity = run(address: 4, input, gas: 18)
    core::assert(identity.status == SUCCESS && identity.gas_used == 18)
    core::assert(identity.output.len() == 3 && identity.output[2 as usize] == 0x63)
    let empty: [u8; 0] = []
    let none = run(address: 4, input: empty, gas: 15)
    core::assert(none.status == SUCCESS && none.gas_used == 15 && none.output.len() == 0)
}

// EIP-152 test vectors 4 and 5 (12 rounds, final and non-final block).
fn blake2f_input(_ final_block: u8) -> [u8; 213] {
    let prefix: [u8; 68] = [
        0x00, 0x00, 0x00, 0x0c,
        0x48, 0xc9, 0xbd, 0xf2, 0x67, 0xe6, 0x09, 0x6a, 0x3b, 0xa7, 0xca, 0x84, 0x85, 0xae, 0x67, 0xbb,
        0x2b, 0xf8, 0x94, 0xfe, 0x72, 0xf3, 0x6e, 0x3c, 0xf1, 0x36, 0x1d, 0x5f, 0x3a, 0xf5, 0x4f, 0xa5,
        0xd1, 0x82, 0xe6, 0xad, 0x7f, 0x52, 0x0e, 0x51, 0x1f, 0x6c, 0x3e, 0x2b, 0x8c, 0x68, 0x05, 0x9b,
        0x6b, 0xbd, 0x41, 0xfb, 0xab, 0xd9, 0x83, 0x1f, 0x79, 0x21, 0x7e, 0x13, 0x19, 0xcd, 0xe0, 0x5b,
    ]
    var input: [u8; 213] = [0; 213]
    var i: usize = 0
    while i < 68 {
        input[i] = prefix[i]
        i += 1
    }
    input[68] = 0x61
    input[69] = 0x62
    input[70] = 0x63
    input[196] = 3
    input[212] = final_block
    input
}

#[test]
fn blake2f_known_answers_and_validation() {
    let result = run(address: 9, input: blake2f_input(1), gas: 12)
    core::assert(result.status == SUCCESS && result.gas_used == 12 && result.output.len() == 64)
    var expected: [u8; 64] = [
        0xba, 0x80, 0xa5, 0x3f, 0x98, 0x1c, 0x4d, 0x0d, 0x6a, 0x27, 0x97, 0xb6, 0x9f, 0x12, 0xf6, 0xe9,
        0x4c, 0x21, 0x2f, 0x14, 0x68, 0x5a, 0xc4, 0xb7, 0x4b, 0x12, 0xbb, 0x6f, 0xdb, 0xff, 0xa2, 0xd1,
        0x7d, 0x87, 0xc5, 0x39, 0x2a, 0xab, 0x79, 0x2d, 0xc2, 0x52, 0xd5, 0xde, 0x45, 0x33, 0xcc, 0x95,
        0x18, 0xd3, 0x8a, 0xa8, 0xdb, 0xf1, 0x92, 0x5a, 0xb9, 0x23, 0x86, 0xed, 0xd4, 0x00, 0x99, 0x23,
    ]
    var i: u64 = 0
    while i < 64 {
        core::assert(result.output[i as usize] == expected[i as usize])
        i += 1
    }
    let non_final = run(address: 9, input: blake2f_input(0), gas: 12)
    expected = [
        0x75, 0xab, 0x69, 0xd3, 0x19, 0x0a, 0x56, 0x2c, 0x51, 0xae, 0xf8, 0xd8, 0x8f, 0x1c, 0x27, 0x75,
        0x87, 0x69, 0x44, 0x40, 0x72, 0x70, 0xc4, 0x2c, 0x98, 0x44, 0x25, 0x2c, 0x26, 0xd2, 0x87, 0x52,
        0x98, 0x74, 0x3e, 0x7f, 0x6d, 0x5e, 0xa2, 0xf2, 0xd3, 0xe8, 0xd2, 0x26, 0x03, 0x9c, 0xd3, 0x1b,
        0x4e, 0x42, 0x6a, 0xc4, 0xf2, 0xd3, 0xd6, 0x66, 0xa6, 0x10, 0xc2, 0x11, 0x6f, 0xde, 0x47, 0x35,
    ]
    i = 0
    while i < 64 {
        core::assert(non_final.output[i as usize] == expected[i as usize])
        i += 1
    }
    let short_gas = run(address: 9, input: blake2f_input(1), gas: 11)
    core::assert(short_gas.status == FAILURE && short_gas.gas_used == 11)
    let bad_flag = run(address: 9, input: blake2f_input(2), gas: 12)
    core::assert(bad_flag.status == FAILURE)
}

fn signature(hash: u256, v: u256, r: u256, s: u256) -> [u8; 128] {
    var input: [u8; 128] = [0; 128]
    var i: u64 = 0
    while i < 32 {
        let shift = ((31 - i) * 8) as u256
        input[i as usize] = (hash >> shift).downcast_truncate()
        input[(32 + i) as usize] = (v >> shift).downcast_truncate()
        input[(64 + i) as usize] = (r >> shift).downcast_truncate()
        input[(96 + i) as usize] = (s >> shift).downcast_truncate()
        i += 1
    }
    input
}

fn recovered_address(_ input: [u8; 128], gas: u64) -> u256 {
    let result = run(address: 1, input, gas)
    core::assert(result.status == SUCCESS && result.gas_used == 3000 && result.output.len() == 32)
    var value: u256 = 0
    var i: u64 = 0
    while i < 32 {
        value = (value << 8) | result.output[i as usize] as u256
        i += 1
    }
    value
}

fn recovers_nothing(_ input: [u8; 128]) -> bool {
    let result = run(address: 1, input, gas: 3000)
    let empty = result.status == SUCCESS && result.gas_used == 3000 && result.output.len() == 0
    empty
}

#[test]
fn ecrecover_known_signatures_and_rejections() {
    // go-ethereum's precompile vector (v = 28) and a `cast wallet sign` signature (v = 27).
    let geth = signature(
        hash: 0x456e9aea5e197a1f1af7a3e85a3212fa4049a3ba34c2289b4c860fc0b0c64ef3, v: 28,
        r: 0x9242685bf161793cc25603c231bc2f568eb630ea16aa137d2664ac8038825608,
        s: 0x4f8ae3bd7535248d0bd448298cc2e2071e56992d0774dc340c368ae950852ada,
    )
    core::assert(recovered_address(geth, gas: 3000) == 0x7156526fbd7a3c72969b54f64e42c10fbb768c8a)
    let signed = signature(
        hash: 0x1111111111111111111111111111111111111111111111111111111111111111, v: 27,
        r: 0x004375c2180a2a322c6b22b43ca111dadb74ddb0a2f96e427eac82982fd68b4e,
        s: 0x3dfee5991d071b74211a070b6660783820a15fdd5355fabb31702dac53e62c72,
    )
    core::assert(recovered_address(signed, gas: 100000) == 0x2c7536e3605d9c16a7a3d7b1898e529396a65c23)
    let short = run(address: 1, input: signed, gas: 2999)
    core::assert(short.status == FAILURE && short.gas_used == 2999)
    // Wrong v, zero or oversized r and s, and an r with no curve point recover nothing.
    let n = 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141
    core::assert(recovers_nothing(signature(hash: 1, v: 29, r: 1, s: 1)))
    core::assert(recovers_nothing(signature(hash: 1, v: 27, r: 0, s: 1)))
    core::assert(recovers_nothing(signature(hash: 1, v: 27, r: n, s: 1)))
    core::assert(recovers_nothing(signature(hash: 1, v: 27, r: 1, s: n)))
    core::assert(recovers_nothing(signature(hash: 1, v: 27, r: 5, s: 1)))
    // Input shorter than 128 bytes is zero-padded: v reads as zero.
    let truncated: [u8; 40] = [1; 40]
    let padded = run(address: 1, input: truncated, gas: 3000)
    core::assert(padded.status == SUCCESS && padded.output.len() == 0)
}

fn p256_input(hash: u256, r: u256, s: u256, x: u256, y: u256) -> [u8; 160] {
    var input: [u8; 160] = [0; 160]
    var i: u64 = 0
    while i < 32 {
        let shift = ((31 - i) * 8) as u256
        input[i as usize] = (hash >> shift).downcast_truncate()
        input[(32 + i) as usize] = (r >> shift).downcast_truncate()
        input[(64 + i) as usize] = (s >> shift).downcast_truncate()
        input[(96 + i) as usize] = (x >> shift).downcast_truncate()
        input[(128 + i) as usize] = (y >> shift).downcast_truncate()
        i += 1
    }
    input
}

// Verification succeeds with the word 1; any rejection succeeds with nothing.
fn p256_verifies<const N: usize>(_ input: [u8; N]) -> bool {
    let result = run(address: 0x100, input, gas: 6900)
    core::assert(result.status == SUCCESS && result.gas_used == 6900)
    if result.output.len() == 0 { return false }
    core::assert(result.output.len() == 32)
    var value: u256 = 0
    for i in 0..32 { value = (value << 8) | result.output[i] as u256 }
    core::assert(value == 1)
    true
}

#[test]
fn p256verify_known_signature_and_rejections() {
    // Signed by Python's `cryptography` with the SHA-256 digest of "fevm p256verify".
    let hash = 0xecee5c5ea2fc5190cc080e82f5bf1e49cd7aaa8a3590d255f0163ff9e5756afc
    let r = 0xbcb24510422611d27b32d883cc1e49c7c699f3291c93aba133e70e70473a7bd7
    let s = 0x7c7f9023f0bd6745e4b9baeb0c4a80473996dba928440be18659951d75d58c64
    let x = 0x60fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6
    let y = 0x7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299
    let n = 0xffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551
    let p = 0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff
    core::assert(p256_verifies(p256_input(hash, r, s, x, y)))
    // P-256 signatures are malleable: n - s verifies too.
    core::assert(p256_verifies(p256_input(hash, r, s: n - s, x, y)))
    core::assert(!p256_verifies(p256_input(hash: hash + 1, r, s, x, y)))
    core::assert(!p256_verifies(p256_input(hash, r, s, x, y: y + 1)))
    core::assert(!p256_verifies(p256_input(hash, r: 0, s, x, y)))
    core::assert(!p256_verifies(p256_input(hash, r: n, s, x, y)))
    core::assert(!p256_verifies(p256_input(hash, r, s: n, x, y)))
    core::assert(!p256_verifies(p256_input(hash, r, s, x: p, y)))
    core::assert(!p256_verifies(p256_input(hash, r, s, x: 0, y: 0)))
    // Only exactly 160 bytes are an input.
    let short: [u8; 159] = [1; 159]
    core::assert(!p256_verifies(short))
    let out_of_gas = run(address: 0x100, input: p256_input(hash, r, s, x, y), gas: 6899)
    core::assert(out_of_gas.status == FAILURE && out_of_gas.gas_used == 6899)
}
