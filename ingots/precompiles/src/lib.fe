use core::{MemBuffer, Option}
use keccak::{ByteSource, Keccak256}
pub use hashes::{ripemd160, sha256}

/// The call returned output and consumed `gas_used`.
pub const SUCCESS: u8 = 0
/// An exceptional halt: invalid input or insufficient gas consumes all forwarded gas.
pub const FAILURE: u8 = 1
/// The host could not allocate the output or its working memory; this is
/// not an EVM outcome.
pub const HOST_ALLOCATION: u8 = 2

pub struct Output { pub status: u8, pub gas_used: u64, pub output: MemBuffer }

/// Osaka precompiles occupy addresses 0x01 through 0x11, and 0x100.
pub fn is_precompile(_ address: u256) -> bool { (address >= 1 && address <= 0x11) || address == 0x100 }

fn word_count(_ len: usize) -> u128 {
    let len: u128 = len.downcast_unchecked()
    (len + 31) / 32
}

pub(ingot) fn failure(_ gas: u64) -> Output {
    Output { status: FAILURE, gas_used: gas, output: MemBuffer::empty() }
}

// An output of `source`'s bytes.
fn copied<T: ByteSource>(_ source: T, gas_used: u64) -> Output {
    var output = MemBuffer::empty()
    if !output.try_resize(source.len()) { return Output { status: HOST_ALLOCATION, gas_used, output } }
    for i in 0..source.len() { output[i] = source.byte_at(i) }
    Output { status: SUCCESS, gas_used, output }
}

// An output of big-endian words.
fn words<const N: usize>(_ values: [u256; N], gas_used: u64) -> Output {
    var output = MemBuffer::empty()
    if !output.try_resize(N * 32) { return Output { status: HOST_ALLOCATION, gas_used, output } }
    for i in 0..N { output.write_word(offset: i * 32, value: values[i]) }
    Output { status: SUCCESS, gas_used, output }
}

// The big-endian word at `offset`, zero-padded past the input as buffer_read.
fn word_at<T: ByteSource>(_ input: T, offset: usize) -> u256 {
    var value: u256 = 0
    for index in offset..offset + 32 {
        value = (value << 8) | if index < input.len() { input.byte_at(index) as u256 } else { 0 }
    }
    value
}

/// The address whose secp256k1 key signed `hash` as (recovery_id, r, s), for a
/// recovery id of 0 or 1 and 0 < r, s < n; none when no key recovers.
pub fn recover_signer(hash: u256, recovery_id: u256, r: u256, s: u256) -> Option<u256> {
    let Option::Some(key) = secp256k1::recover(hash, recovery_id, r, s) else { return Option::None }
    var digest = Keccak256::new()
    digest.update_word(key.x, len: 32)
    digest.update_word(key.y, len: 32)
    Option::Some(digest.finish_word() & 0xffffffffffffffffffffffffffffffffffffffff)
}

// Recover the signer address of (hash, v, r, s). Malformed or unrecoverable
// signatures succeed with empty output.
fn ecrecover<T: ByteSource>(_ input: T) -> Output {
    let hash = word_at(input, offset: 0)
    let v = word_at(input, offset: 32)
    let r = word_at(input, offset: 64)
    let s = word_at(input, offset: 96)
    let malformed = (v != 27 && v != 28) || r == 0 || r >= secp256k1::N || s == 0 || s >= secp256k1::N
    let signer = if malformed { Option::None } else { recover_signer(hash, recovery_id: v - 27, r, s) }
    match signer {
        Option::Some(address) => words([address], gas_used: 3000),
        Option::None => Output { status: SUCCESS, gas_used: 3000, output: MemBuffer::empty() },
    }
}

/// Execute precompile `address` with `gas` available. Charges are computed and
/// checked before any work or allocation.
pub fn run<T: ByteSource>(address: u256, input: T, gas: u64) -> Output {
    core::assert(is_precompile(address))
    let len = input.len()
    if address == 1 {
        if gas < 3000 { return failure(gas) }
        return ecrecover(input)
    }
    if address == 2 || address == 3 || address == 4 {
        let (base, per_word): (u128, u128) = if address == 2 { (60, 12) }
            else if address == 3 { (600, 120) } else { (15, 3) }
        let cost = base + per_word * word_count(len)
        if cost > gas as u128 { return failure(gas) }
        let used: u64 = cost.downcast_unchecked()
        return if address == 2 { words([sha256(input, offset: 0, len)], gas_used: used) }
            else if address == 3 { words([ripemd160(input)], gas_used: used) }
            else { copied(input, gas_used: used) }
    }
    if address == 5 { return modexp::run(input, gas) }
    if address == 6 || address == 7 {
        // EIP-1108 prices; invalid points are exceptional failures.
        let cost: u64 = if address == 6 { 150 } else { 6000 }
        if cost > gas { return failure(gas) }
        let point = if address == 6 { bn254::add(input) } else { bn254::mul(input) }
        return match point {
            Option::Some(point) => words(point, gas_used: cost),
            Option::None => failure(gas),
        }
    }
    if address == 8 {
        let pairs: u128 = (len / 192).downcast_unchecked()
        let cost = 45000 + 34000 * pairs
        if cost > gas as u128 { return failure(gas) }
        return match bn254::pairing(input) {
            Option::Some(holds) => words([if holds { 1 } else { 0 }], gas_used: cost.downcast_unchecked()),
            Option::None => failure(gas),
        }
    }
    if address == 9 {
        if len != blake2f::INPUT_LEN { return failure(gas) }
        let rounds = blake2f::rounds(input)
        if rounds > gas || input.byte_at(212) > 1 { return failure(gas) }
        let state = blake2f::compress(input)
        var output = MemBuffer::empty()
        if !output.try_resize(64) { return Output { status: HOST_ALLOCATION, gas_used: rounds, output } }
        for i in 0..8 { output.write_le<u64>(offset: i * 8, value: state[i]) }
        return Output { status: SUCCESS, gas_used: rounds, output }
    }
    if address >= 0x0b && address <= 0x11 { return bls::run(address, input, gas) }
    if address == 0x100 {
        // P256VERIFY (EIP-7951): an invalid input or signature returns nothing.
        if gas < 6900 { return failure(gas) }
        let valid = len == 160 && p256::verify(
            hash: word_at(input, offset: 0), r: word_at(input, offset: 32), s: word_at(input, offset: 64),
            x: word_at(input, offset: 96), y: word_at(input, offset: 128),
        )
        if !valid { return Output { status: SUCCESS, gas_used: 6900, output: MemBuffer::empty() } }
        return words([1], gas_used: 6900)
    }
    // Address 10: KZG point evaluation (EIP-4844).
    if len != kzg::INPUT_LEN || kzg::GAS > gas || !kzg::verify(input) { return failure(gas) }
    words([kzg::FIELD_ELEMENTS_PER_BLOB, kzg::BLS_MODULUS], gas_used: kzg::GAS)
}
