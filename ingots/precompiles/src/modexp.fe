use core::{MemArray, MemBuffer, Option}
use keccak::ByteSource
use ingot::{FAILURE, HOST_ALLOCATION, Output, SUCCESS}
use ingot::bignum::Modulus

const MAX_U256: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// Input bytes beyond the calldata read as zero (EIP-198 right padding).
fn input_byte<T: ByteSource>(_ input: T, _ index: u256) -> u8 {
    if index < input.len() as u256 { input.byte_at(index.downcast_unchecked()) } else { 0 }
}

// A big-endian integer of `len` (at most 32) bytes starting at `offset`.
fn input_word<T: ByteSource>(_ input: T, offset: u256, len: u64) -> u256 {
    var value: u256 = 0
    var i: u64 = 0
    while i < len {
        let index = if offset > MAX_U256 - i as u256 { MAX_U256 } else { offset + i as u256 }
        value = (value << 8) | input_byte(input, index) as u256
        i += 1
    }
    value
}

fn bit_length(_ value: u256) -> u64 {
    var bits: u64 = 0
    while bits < 256 && value >> bits as u256 != 0 { bits += 1 }
    bits
}

// EIP-7823 bounds each of the three lengths.
const MAX_LENGTH: u256 = 1024

struct Lengths { base: u256, exponent: u256, modulus: u256 }

fn lengths<T: ByteSource>(_ input: T) -> Lengths {
    Lengths {
        base: input_word(input, offset: 0, len: 32),
        exponent: input_word(input, offset: 32, len: 32),
        modulus: input_word(input, offset: 64, len: 32),
    }
}

// EIP-7883 gas for lengths within the EIP-7823 bounds, which keep it below 2^30.
fn gas_cost<T: ByteSource>(_ input: T, _ sizes: Lengths) -> u64 {
    let longest: u64 = (if sizes.base > sizes.modulus { sizes.base } else { sizes.modulus }).downcast_unchecked()
    let words = (longest + 7) / 8
    let complexity = if longest > 32 { 2 * words * words } else { 16 }
    let exponent: u64 = sizes.exponent.downcast_unchecked()
    let head = input_word(input, offset: 96 + sizes.base, len: if exponent < 32 { exponent } else { 32 })
    let head_bits = bit_length(head)
    let top_bits = if head_bits > 0 { head_bits - 1 } else { 0 }
    let count = if exponent <= 32 { top_bits } else { 16 * (exponent - 32) + top_bits }
    let cost = complexity * if count == 0 { 1 } else { count }
    if cost < 500 { 500 } else { cost }
}

// One limb of a big-endian number of `len` bytes at `offset`; limb 0 is least significant.
fn input_limb<T: ByteSource>(_ input: T, offset: u256, len: u256, limb: u256) -> u64 {
    var value: u64 = 0
    var byte: u256 = 8
    while byte > 0 {
        byte -= 1
        let position = limb * 8 + byte
        value = value << 8
        if position < len { value |= input_byte(input, offset + len - 1 - position) as u64 }
    }
    value
}

fn host_allocation(_ gas_used: u64) -> Output {
    Output { status: HOST_ALLOCATION, gas_used, output: MemBuffer::empty() }
}

/// MODEXP (EIP-198, with EIP-7883 gas and EIP-7823 bounds): `base ** exponent
/// % modulus`, as exactly modulus-length big-endian bytes. A length above
/// 1,024 bytes is an exceptional failure.
pub fn run<T: ByteSource>(_ input: T, gas: u64) -> Output {
    let sizes = lengths(input)
    let bounded = sizes.base <= MAX_LENGTH && sizes.exponent <= MAX_LENGTH && sizes.modulus <= MAX_LENGTH
    let gas_used = if bounded { gas_cost(input, sizes) } else { 0 }
    if !bounded || gas_used > gas { return Output { status: FAILURE, gas_used: gas, output: MemBuffer::empty() } }
    let modulus_len: u64 = sizes.modulus.downcast_unchecked()
    var output = MemBuffer::empty()
    if sizes.base == 0 && sizes.modulus == 0 { return Output { status: SUCCESS, gas_used, output } }
    let exponent_start = 96 + sizes.base
    let modulus_start = exponent_start + sizes.exponent
    // Locate the modulus's most significant nonzero byte.
    var significant = sizes.modulus
    while significant > 0 && input_byte(input, modulus_start + sizes.modulus - significant) == 0 { significant -= 1 }
    if !output.try_resize(modulus_len as usize) { return host_allocation(gas_used) }
    // A zero modulus yields zero bytes.
    if significant == 0 { return Output { status: SUCCESS, gas_used, output } }
    let n: u64 = ((significant + 7) / 8).downcast_unchecked()
    let Option::Some(var value) = MemArray<u64>::try_new_zeroed(n as usize) else { return host_allocation(gas_used) }
    for i in 0..(n as usize) {
        value[i] = input_limb(input, offset: modulus_start, len: sizes.modulus, limb: i as u256)
    }
    let Option::Some(modulus) = Modulus::try_new(value, len: n) else { return host_allocation(gas_used) }
    // A product of two reduced values, and a limb more for normalizing it.
    let Option::Some(var work) = MemArray<u64>::try_new_zeroed((2 * n + 1) as usize) else {
        return host_allocation(gas_used)
    }
    let Option::Some(var base) = MemArray<u64>::try_new_zeroed(n as usize) else { return host_allocation(gas_used) }
    let Option::Some(var result) = MemArray<u64>::try_new_zeroed(n as usize) else { return host_allocation(gas_used) }
    // Reduce the base limb by limb, most significant first.
    var limb = (sizes.base + 7) / 8
    while limb > 0 {
        limb -= 1
        work.as_slice().slice(offset: 1, len: n as usize).copy_from(base.as_slice())
        work[0] = input_limb(input, offset: 96, len: sizes.base, limb)
        modulus.reduce(mut work, len: n + 1)
        base.as_slice().copy_from(work.as_slice().head(n as usize))
    }
    // Left-to-right square and multiply from the exponent's top set bit.
    work[0] = 1
    modulus.reduce(mut work, len: 1)
    result.as_slice().copy_from(work.as_slice().head(n as usize))
    var started = false
    var index: u256 = 0
    while index < sizes.exponent {
        let byte = input_byte(input, exponent_start + index)
        if started || byte != 0 {
            var bit: u8 = 8
            while bit > 0 {
                bit -= 1
                if started {
                    modulus.mul_mod(result, result, mut work)
                    result.as_slice().copy_from(work.as_slice().head(n as usize))
                }
                if ((byte >> bit) & 1) == 1 {
                    if started {
                        modulus.mul_mod(result, base, mut work)
                        result.as_slice().copy_from(work.as_slice().head(n as usize))
                    } else {
                        result.as_slice().copy_from(base.as_slice())
                        started = true
                    }
                }
            }
        }
        index += 1
    }
    var i: u64 = 0
    while i < modulus_len {
        let position = modulus_len - 1 - i
        let limb_index = position / 8
        if limb_index < n {
            output[i as usize] = (result[limb_index as usize] >> ((position % 8) * 8)).downcast_truncate()
        }
        i += 1
    }
    Output { status: SUCCESS, gas_used, output }
}
