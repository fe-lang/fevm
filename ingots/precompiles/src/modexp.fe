use core::{MemArray, MemBuffer, Option}
use keccak::ByteSource
use ingot::{FAILURE, Output, SUCCESS, host_allocation}
use ingot::bignum::{Modulus, Montgomery}

const MAX_U256: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// Input bytes beyond the calldata read as zero (EIP-198 right padding).
fn input_byte<T: ByteSource>(_ input: T, _ index: u256) -> u8 {
    if index < input.len() as u256 { input.byte_at(index.downcast_unchecked()) } else { 0 }
}

// A big-endian integer of `len` (at most 32) bytes starting at `offset`.
fn input_word<T: ByteSource>(_ input: T, offset: u256, len: u64) -> u256 {
    var value: u256 = 0
    var i: u64 = 0
    while i < len {
        let index = if offset > MAX_U256 - i as u256 { MAX_U256 } else { offset + i as u256 }
        value = (value << 8) | input_byte(input, index) as u256
        i += 1
    }
    value
}

fn bit_length(_ value: u256) -> u64 {
    var bits: u64 = 0
    while bits < 256 && value >> bits as u256 != 0 { bits += 1 }
    bits
}

// EIP-7823 bounds each of the three lengths.
const MAX_LENGTH: u256 = 1024

struct Lengths { base: u256, exponent: u256, modulus: u256 }

fn lengths<T: ByteSource>(_ input: T) -> Lengths {
    Lengths {
        base: input_word(input, offset: 0, len: 32),
        exponent: input_word(input, offset: 32, len: 32),
        modulus: input_word(input, offset: 64, len: 32),
    }
}

// EIP-7883 gas for lengths within the EIP-7823 bounds, which keep it below 2^30.
fn gas_cost<T: ByteSource>(_ input: T, _ sizes: Lengths) -> u64 {
    let longest: u64 = (if sizes.base > sizes.modulus { sizes.base } else { sizes.modulus }).downcast_unchecked()
    let words = (longest + 7) / 8
    let complexity = if longest > 32 { 2 * words * words } else { 16 }
    let exponent: u64 = sizes.exponent.downcast_unchecked()
    let head = input_word(input, offset: 96 + sizes.base, len: if exponent < 32 { exponent } else { 32 })
    let head_bits = bit_length(head)
    let top_bits = if head_bits > 0 { head_bits - 1 } else { 0 }
    let count = if exponent <= 32 { top_bits } else { 16 * (exponent - 32) + top_bits }
    let cost = complexity * if count == 0 { 1 } else { count }
    if cost < 500 { 500 } else { cost }
}

// One limb of a big-endian number of `len` bytes at `offset`; limb 0 is least significant.
fn input_limb<T: ByteSource>(_ input: T, offset: u256, len: u256, limb: u256) -> u64 {
    var value: u64 = 0
    var byte: u256 = 8
    while byte > 0 {
        byte -= 1
        let position = limb * 8 + byte
        value = value << 8
        if position < len { value |= input_byte(input, offset + len - 1 - position) as u64 }
    }
    value
}

// Bit `index` of the exponent's `len` big-endian bytes at `start`, from the most significant.
fn exponent_bit<T: ByteSource>(_ input: T, start: u256, index: u256) -> u256 {
    ((input_byte(input, start + index / 8) >> (7 - (index % 8)).downcast_truncate()) & 1) as u256
}

// The sliding window width for an exponent of `bits` bits: 2^(w - 1) table
// products against about bits / (w + 1) window products.
fn window_width(_ bits: u256) -> u256 {
    var best: u256 = 1
    var best_cost = bits / 2
    var w: u256 = 2
    while w <= 7 {
        let cost = (1 << (w - 1)) + bits / (w + 1)
        if cost < best_cost {
            best = w
            best_cost = cost
        }
        w += 1
    }
    best
}

/// MODEXP (EIP-198, with EIP-7883 gas and EIP-7823 bounds): `base ** exponent
/// % modulus`, as exactly modulus-length big-endian bytes. A length above
/// 1,024 bytes is an exceptional failure.
pub fn run<T: ByteSource>(_ input: T, gas: u64) -> Output {
    let sizes = lengths(input)
    let bounded = sizes.base <= MAX_LENGTH && sizes.exponent <= MAX_LENGTH && sizes.modulus <= MAX_LENGTH
    let gas_used = if bounded { gas_cost(input, sizes) } else { 0 }
    if !bounded || gas_used > gas { return Output { status: FAILURE, gas_used: gas, output: MemBuffer::empty() } }
    let modulus_len: u64 = sizes.modulus.downcast_unchecked()
    if sizes.base == 0 && sizes.modulus == 0 { return Output { status: SUCCESS, gas_used, output: MemBuffer::empty() } }
    let exponent_start = 96 + sizes.base
    let modulus_start = exponent_start + sizes.exponent
    // Locate the modulus's most significant nonzero byte.
    var significant = sizes.modulus
    while significant > 0 && input_byte(input, modulus_start + sizes.modulus - significant) == 0 { significant -= 1 }
    let Option::Some(var output) = MemBuffer::try_new(modulus_len.downcast_truncate()) else { return host_allocation(gas_used) }
    // A zero modulus yields zero bytes.
    if significant == 0 { return Output { status: SUCCESS, gas_used, output } }
    let n: u64 = ((significant + 7) / 8).downcast_unchecked()
    let Option::Some(var value) = MemArray<u64>::try_new_zeroed(n.downcast_truncate()) else { return host_allocation(gas_used) }
    for i in 0..n.downcast_truncate() {
        value[i] = input_limb(input, offset: modulus_start, len: sizes.modulus, limb: i as u256)
    }
    let Option::Some(modulus) = Modulus::try_new(value, len: n) else { return host_allocation(gas_used) }
    // A product of two reduced values, and a limb more for normalizing it.
    let Option::Some(var work) = MemArray<u64>::try_new_zeroed((2 * n + 1).downcast_truncate()) else {
        return host_allocation(gas_used)
    }
    let Option::Some(var base) = MemArray<u64>::try_new_zeroed(n.downcast_truncate()) else { return host_allocation(gas_used) }
    let Option::Some(var result) = MemArray<u64>::try_new_zeroed(n.downcast_truncate()) else { return host_allocation(gas_used) }
    // Reduce the base limb by limb, most significant first.
    var limb = (sizes.base + 7) / 8
    while limb > 0 {
        limb -= 1
        work.as_slice().slice(offset: 1, len: n.downcast_truncate()).copy_from(base.as_slice())
        work[0] = input_limb(input, offset: 96, len: sizes.base, limb)
        modulus.reduce(mut work, len: n + 1)
        base.as_slice().copy_from(work.as_slice().head(n.downcast_truncate()))
    }
    if value[0] & 1 == 1 {
        // Odd moduli: Montgomery multiplication over sliding windows.
        let montgomery = Montgomery::new(value, len: n)
        let total = sizes.exponent * 8
        var top: u256 = 0
        while top < total && exponent_bit(input, start: exponent_start, index: top) == 0 { top += 1 }
        var zero = true
        for i in 0..n.downcast_truncate() { zero = zero && base[i] == 0 }
        let unit = n == 1 && montgomery.limbs[0] == 1
        if top == total || zero || unit {
            // x^0 = 1 for m > 1; 0^e = 0 for e > 0; everything is 0 mod 1.
            if top == total && !unit { output[(modulus_len - 1).downcast_truncate()] = 1 }
            return Output { status: SUCCESS, gas_used, output }
        }
        let width = window_width(total - top)
        let entries: usize = (1 << (width - 1)).downcast_truncate()
        let size: usize = n.downcast_truncate()
        let Option::Some(var table) = MemArray<u64>::try_new_zeroed(entries * size) else { return host_allocation(gas_used) }
        // The base in Montgomery form, base R mod m, then its odd powers.
        for i in 0..size {
            work[i] = 0
            work[size + i] = base[i]
        }
        modulus.reduce(mut work, len: 2 * n)
        table.as_slice().head(size).copy_from(work.as_slice().head(size))
        montgomery.mul(table.as_slice().head(size), table.as_slice().head(size), mut work)
        let Option::Some(var squared) = MemArray<u64>::try_new_zeroed(size) else { return host_allocation(gas_used) }
        squared.as_slice().copy_from(work.as_slice().head(size))
        for k in 1..entries {
            montgomery.mul(table.as_slice().slice(offset: (k - 1) * size, len: size), squared.as_slice(), mut work)
            table.as_slice().slice(offset: k * size, len: size).copy_from(work.as_slice().head(size))
        }
        // Left to right, each window of at most `width` bits ending in a set bit.
        var index = top
        var started = false
        while index < total {
            if exponent_bit(input, start: exponent_start, index) == 0 {
                montgomery.mul(result.as_slice(), result.as_slice(), mut work)
                result.as_slice().copy_from(work.as_slice().head(size))
                index += 1
                continue
            }
            var end = if total - index < width { total } else { index + width }
            while exponent_bit(input, start: exponent_start, index: end - 1) == 0 { end -= 1 }
            var digit: u256 = 0
            var bit = index
            while bit < end {
                digit = (digit << 1) | exponent_bit(input, start: exponent_start, index: bit)
                bit += 1
            }
            let entry: usize = ((digit - 1) / 2).downcast_truncate()
            if started {
                var squarings = end - index
                while squarings > 0 {
                    montgomery.mul(result.as_slice(), result.as_slice(), mut work)
                    result.as_slice().copy_from(work.as_slice().head(size))
                    squarings -= 1
                }
                montgomery.mul(result.as_slice(), table.as_slice().slice(offset: entry * size, len: size), mut work)
                result.as_slice().copy_from(work.as_slice().head(size))
            } else {
                result.as_slice().copy_from(table.as_slice().slice(offset: entry * size, len: size))
                started = true
            }
            index = end
        }
        // Out of Montgomery form: result * 1 / R.
        squared.zero()
        squared[0] = 1
        montgomery.mul(result.as_slice(), squared.as_slice(), mut work)
        result.as_slice().copy_from(work.as_slice().head(size))
        return encoded(result, n, modulus_len, output, gas_used)
    }
    // Even moduli: left-to-right square and multiply from the exponent's top
    // set bit, reducing by long division.
    work[0] = 1
    modulus.reduce(mut work, len: 1)
    result.as_slice().copy_from(work.as_slice().head(n.downcast_truncate()))
    var started = false
    var index: u256 = 0
    while index < sizes.exponent {
        let byte = input_byte(input, exponent_start + index)
        if started || byte != 0 {
            var bit: u8 = 8
            while bit > 0 {
                bit -= 1
                if started {
                    modulus.mul_mod(result, result, mut work)
                    result.as_slice().copy_from(work.as_slice().head(n.downcast_truncate()))
                }
                if ((byte >> bit) & 1) == 1 {
                    if started {
                        modulus.mul_mod(result, base, mut work)
                        result.as_slice().copy_from(work.as_slice().head(n.downcast_truncate()))
                    } else {
                        result.as_slice().copy_from(base.as_slice())
                        started = true
                    }
                }
            }
        }
        index += 1
    }
    encoded(result, n, modulus_len, output, gas_used)
}

// The n-limb result as `modulus_len` big-endian bytes.
fn encoded(_ result: MemArray<u64>, _ n: u64, _ modulus_len: u64, _ output: own MemBuffer, _ gas_used: u64) -> Output {
    var output = output
    var i: u64 = 0
    while i < modulus_len {
        let position = modulus_len - 1 - i
        let limb_index = position / 8
        if limb_index < n {
            output[i.downcast_truncate()] = (result[limb_index.downcast_truncate()] >> ((position % 8) * 8)).downcast_truncate()
        }
        i += 1
    }
    Output { status: SUCCESS, gas_used, output }
}
