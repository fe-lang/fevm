use core::{MemArray, MemBuffer, MemSlice, Option}
use keccak::ByteSource
use ingot::{FAILURE, Output, SUCCESS, host_allocation}
use ingot::bignum::{Modulus, Montgomery}
use ingot::inversion::trailing_zeros

// Input bytes beyond the calldata read as zero (EIP-198 right padding).
fn input_byte<T: ByteSource>(_ input: T, _ index: u256) -> u8 {
    if index < input.len() as u256 { input.byte_at(index.downcast_unchecked()) } else { 0 }
}

// A big-endian integer of `len` (at most 32) bytes starting at `offset`.
fn input_word<T: ByteSource>(_ input: T, offset: u256, len: u64) -> u256 {
    // Only the bytes within the input can be nonzero.
    let end = input.len() as u256
    let present: u64 = if offset >= end { 0 } else if end - offset < len as u256 {
        (end - offset).downcast_unchecked()
    } else { len }
    if present == 0 { return 0 }
    let start: usize = offset.downcast_unchecked()
    var value: u256 = 0
    for i in 0..present.downcast_truncate() { value = (value << 8) | input.byte_at(start + i) as u256 }
    value << ((len - present) * 8) as u256
}

fn bit_length(_ value: u256) -> u64 {
    (256 - core::num::leading_zeros(value)).downcast_truncate()
}

// EIP-7823 bounds each of the three lengths.
const MAX_LENGTH: u256 = 1024

struct Lengths { base: u256, exponent: u256, modulus: u256 }

fn lengths<T: ByteSource>(_ input: T) -> Lengths {
    Lengths {
        base: input_word(input, offset: 0, len: 32),
        exponent: input_word(input, offset: 32, len: 32),
        modulus: input_word(input, offset: 64, len: 32),
    }
}

// EIP-7883 gas for lengths within the EIP-7823 bounds, which keep it below 2^30.
fn gas_cost<T: ByteSource>(_ input: T, _ sizes: Lengths) -> u64 {
    let longest: u64 = (if sizes.base > sizes.modulus { sizes.base } else { sizes.modulus }).downcast_unchecked()
    let words = (longest + 7) / 8
    let complexity = if longest > 32 { 2 * words * words } else { 16 }
    let exponent: u64 = sizes.exponent.downcast_unchecked()
    let head = input_word(input, offset: 96 + sizes.base, len: if exponent < 32 { exponent } else { 32 })
    let head_bits = bit_length(head)
    let top_bits = if head_bits > 0 { head_bits - 1 } else { 0 }
    let count = if exponent <= 32 { top_bits } else { 16 * (exponent - 32) + top_bits }
    let cost = complexity * if count == 0 { 1 } else { count }
    if cost < 500 { 500 } else { cost }
}

// One limb of a big-endian number of `len` bytes at `offset`; limb 0 is least significant.
fn input_limb<T: ByteSource>(_ input: T, offset: u256, len: u256, limb: u256) -> u64 {
    var value: u64 = 0
    var byte: u256 = 8
    while byte > 0 {
        byte -= 1
        let position = limb * 8 + byte
        value = value << 8
        if position < len { value |= input_byte(input, offset + len - 1 - position) as u64 }
    }
    value
}

// Bit `index` of the exponent's `len` big-endian bytes at `start`, from the most significant.
fn exponent_bit<T: ByteSource>(_ input: T, start: u256, index: u256) -> u256 {
    ((input_byte(input, start + index / 8) >> (7 - (index % 8)).downcast_truncate()) & 1) as u256
}

// The sliding window width for an exponent of `bits` bits: 2^(w - 1) table
// products against about bits / (w + 1) window products.
fn window_width(_ bits: u256) -> u256 {
    var best: u256 = 1
    var best_cost = bits / 2
    var w: u256 = 2
    while w <= 7 {
        let cost = (1 << (w - 1)) + bits / (w + 1)
        if cost < best_cost {
            best = w
            best_cost = cost
        }
        w += 1
    }
    best
}

/// MODEXP (EIP-198, with EIP-7883 gas and EIP-7823 bounds): `base ** exponent
/// % modulus`, as exactly modulus-length big-endian bytes. A length above
/// 1,024 bytes is an exceptional failure.
pub fn run<T: ByteSource>(_ input: T, gas: u64) -> Output {
    let sizes = lengths(input)
    let bounded = sizes.base <= MAX_LENGTH && sizes.exponent <= MAX_LENGTH && sizes.modulus <= MAX_LENGTH
    let gas_used = if bounded { gas_cost(input, sizes) } else { 0 }
    if !bounded || gas_used > gas { return Output { status: FAILURE, gas_used: gas, output: MemBuffer::empty() } }
    let modulus_len: u64 = sizes.modulus.downcast_unchecked()
    if sizes.base == 0 && sizes.modulus == 0 { return Output { status: SUCCESS, gas_used, output: MemBuffer::empty() } }
    let exponent_start = 96 + sizes.base
    let modulus_start = exponent_start + sizes.exponent
    // Locate the modulus's most significant nonzero byte.
    var significant = sizes.modulus
    while significant > 0 && input_byte(input, modulus_start + sizes.modulus - significant) == 0 { significant -= 1 }
    let Option::Some(var output) = MemBuffer::try_new(modulus_len.downcast_truncate()) else { return host_allocation(gas_used) }
    // A zero modulus yields zero bytes.
    if significant == 0 { return Output { status: SUCCESS, gas_used, output } }
    let n: u64 = ((significant + 7) / 8).downcast_unchecked()
    let Option::Some(var value) = MemArray<u64>::try_new_zeroed(n.downcast_truncate()) else { return host_allocation(gas_used) }
    for i in 0..n.downcast_truncate() {
        value[i] = input_limb(input, offset: modulus_start, len: sizes.modulus, limb: i as u256)
    }
    let Option::Some(modulus) = Modulus::try_new(value, len: n) else { return host_allocation(gas_used) }
    // A product of two reduced values, and a limb more for normalizing it.
    let Option::Some(var work) = MemArray<u64>::try_new_zeroed((2 * n + 1).downcast_truncate()) else {
        return host_allocation(gas_used)
    }
    let Option::Some(var base) = MemArray<u64>::try_new_zeroed(n.downcast_truncate()) else { return host_allocation(gas_used) }
    // Reduce the base limb by limb, most significant first.
    var limb = (sizes.base + 7) / 8
    while limb > 0 {
        limb -= 1
        work.as_slice().slice(offset: 1, len: n.downcast_truncate()).copy_from(base.as_slice())
        work[0] = input_limb(input, offset: 96, len: sizes.base, limb)
        modulus.reduce(mut work, len: n + 1)
        base.as_slice().copy_from(work.as_slice().head(n.downcast_truncate()))
    }
    let total = sizes.exponent * 8
    var top: u256 = 0
    while top < total && exponent_bit(input, start: exponent_start, index: top) == 0 { top += 1 }
    let exponent = Exponent { start: exponent_start, top, total }
    if value[0] & 1 == 1 {
        let Option::Some(result) = odd_power(input, exponent, base, modulus, value, n, mut work) else {
            return host_allocation(gas_used)
        }
        return encoded(result, n, modulus_len, output, gas_used)
    }
    let Option::Some(result) = even_power(input, exponent, base, value, n, mut work) else { return host_allocation(gas_used) }
    encoded(result, n, modulus_len, output, gas_used)
}

// Where the exponent's bits are: its first set bit `top` (`total` if it is
// zero) of `total`, from the most significant, at byte `start` of the input.
struct Exponent { start: u256, top: u256, total: u256 }

impl Copy for Exponent {}

// base^e mod an odd m of `n` limbs, for base < m, by Montgomery
// multiplication over sliding windows; `modulus` is m normalized, and `work`
// holds at least 2n + 1 limbs.
fn odd_power<T: ByteSource>(_ input: T, _ exponent: Exponent, _ base: MemArray<u64>, _ modulus: Modulus,
                            _ value: own MemArray<u64>, _ n: u64, _ work: mut MemArray<u64>) -> Option<MemArray<u64>> {
    let montgomery = Montgomery::new(value, len: n)
    let start = exponent.start
    let total = exponent.total
    let size: usize = n.downcast_truncate()
    var result = MemArray<u64>::try_new_zeroed(size)?
    var zero = true
    for i in 0..size { zero = zero && base[i] == 0 }
    let unit = n == 1 && montgomery.limbs[0] == 1
    if exponent.top == total || zero || unit {
        // x^0 = 1 for m > 1; 0^e = 0 for e > 0; everything is 0 mod 1.
        if exponent.top == total && !unit { result[0] = 1 }
        return Option::Some(result)
    }
    let width = window_width(total - exponent.top)
    let entries: usize = (1 << (width - 1)).downcast_truncate()
    var table = MemArray<u64>::try_new_zeroed(entries * size)?
    // The base in Montgomery form, base R mod m, then its odd powers.
    for i in 0..size {
        work[i] = 0
        work[size + i] = base[i]
    }
    modulus.reduce(mut work, len: 2 * n)
    table.as_slice().head(size).copy_from(work.as_slice().head(size))
    montgomery.mul(table.as_slice().head(size), table.as_slice().head(size), mut work)
    var squared = MemArray<u64>::try_new_zeroed(size)?
    squared.as_slice().copy_from(work.as_slice().head(size))
    for k in 1..entries {
        montgomery.mul(table.as_slice().slice(offset: (k - 1) * size, len: size), squared.as_slice(), mut work)
        table.as_slice().slice(offset: k * size, len: size).copy_from(work.as_slice().head(size))
    }
    // Left to right, each window of at most `width` bits ending in a set bit.
    var index = exponent.top
    var started = false
    while index < total {
        if exponent_bit(input, start: start, index) == 0 {
            montgomery.mul(result.as_slice(), result.as_slice(), mut work)
            result.as_slice().copy_from(work.as_slice().head(size))
            index += 1
            continue
        }
        var end = if total - index < width { total } else { index + width }
        while exponent_bit(input, start: start, index: end - 1) == 0 { end -= 1 }
        var digit: u256 = 0
        var bit = index
        while bit < end {
            digit = (digit << 1) | exponent_bit(input, start: start, index: bit)
            bit += 1
        }
        let entry: usize = ((digit - 1) / 2).downcast_truncate()
        if started {
            var squarings = end - index
            while squarings > 0 {
                montgomery.mul(result.as_slice(), result.as_slice(), mut work)
                result.as_slice().copy_from(work.as_slice().head(size))
                squarings -= 1
            }
            montgomery.mul(result.as_slice(), table.as_slice().slice(offset: entry * size, len: size), mut work)
            result.as_slice().copy_from(work.as_slice().head(size))
        } else {
            result.as_slice().copy_from(table.as_slice().slice(offset: entry * size, len: size))
            started = true
        }
        index = end
    }
    // Out of Montgomery form: result * 1 / R.
    squared.zero()
    squared[0] = 1
    montgomery.mul(result.as_slice(), squared.as_slice(), mut work)
    result.as_slice().copy_from(work.as_slice().head(size))
    Option::Some(result)
}

// base^e mod an even m of `n` limbs, for base < m. With m = 2^k q and q odd,
// x = base^e mod q and y = base^e mod 2^k combine by the Chinese remainder
// theorem as x + q ((y - x) q^-1 mod 2^k), which is below m.
#[arithmetic(unchecked)]
fn even_power<T: ByteSource>(_ input: T, _ exponent: Exponent, _ base: MemArray<u64>, _ value: MemArray<u64>,
                             _ n: u64, _ work: mut MemArray<u64>) -> Option<MemArray<u64>> {
    let size: usize = n.downcast_truncate()
    var zero_limbs: usize = 0
    while value[zero_limbs] == 0 { zero_limbs += 1 }
    let k = zero_limbs * 64 + trailing_zeros(value[zero_limbs]).downcast_truncate()
    let low = (k + 63) / 64
    let bits: u64 = (k % 64).downcast_truncate()
    let mask: u64 = if bits == 0 { 0xffffffffffffffff } else { (1 << bits) - 1 }
    var result = MemArray<u64>::try_new_zeroed(size)?
    let y = low_power(input, exponent, base, low, mask)?
    // q = m >> k, of `q_len` significant limbs.
    var q = MemArray<u64>::try_new_zeroed(size)?
    for i in 0..size - k / 64 {
        let next = if i + k / 64 + 1 < size { value[i + k / 64 + 1] } else { 0 }
        q[i] = if bits == 0 { value[i + k / 64] } else { (value[i + k / 64] >> bits) | (next << (64 - bits)) }
    }
    var q_len = size
    while q[q_len - 1] == 0 { q_len -= 1 }
    if q_len == 1 && q[0] == 1 {
        for i in 0..low { result[i] = y[i] }
        return Option::Some(result)
    }
    // x = base^e mod q, from base mod q.
    let q_modulus = Modulus::try_new(q, len: q_len.downcast_truncate())?
    for i in 0..2 * size + 1 { work[i] = if i < size { base[i] } else { 0 } }
    q_modulus.reduce(mut work, len: n)
    var reduced = MemArray<u64>::try_new_zeroed(q_len)?
    var odd = MemArray<u64>::try_new_zeroed(q_len)?
    for i in 0..q_len {
        reduced[i] = work[i]
        odd[i] = q[i]
    }
    let x = odd_power(input, exponent, reduced, q_modulus, odd, q_len.downcast_truncate(), mut work)?
    // t = (y - x) mod 2^k.
    var t = MemArray<u64>::try_new_zeroed(low)?
    var borrow: u64 = 0
    for i in 0..low {
        let x_limb = if i < q_len { x[i] } else { 0 }
        let difference = y[i] as u128 - x_limb as u128 - borrow as u128
        t[i] = difference.downcast_truncate()
        borrow = (difference >> 127).downcast_truncate()
    }
    t[low - 1] &= mask
    // q^-1 mod 2^k by Newton's iteration, which doubles the correct bits.
    var inverse = MemArray<u64>::try_new_zeroed(low)?
    var guess = q[0]
    for _ in 0..5 { guess = guess * (2 - q[0] * guess) }
    inverse[0] = guess
    var scratch = MemArray<u64>::try_new_zeroed(low)?
    var correction = MemArray<u64>::try_new_zeroed(low)?
    var correct: usize = 1
    while correct < low {
        // inverse (2 - q inverse), modulo 2^(64 low).
        low_product(q.as_slice(), inverse.as_slice(), mut scratch.as_slice())
        var carry: u64 = 1
        for i in 0..low {
            let negated = (~scratch[i]) as u128 + carry as u128
            correction[i] = negated.downcast_truncate()
            carry = (negated >> 64).downcast_truncate()
        }
        // 2 - q inverse = (-(q inverse)) + 2.
        var add: u64 = 2
        for i in 0..low {
            let sum = correction[i] as u128 + add as u128
            correction[i] = sum.downcast_truncate()
            add = (sum >> 64).downcast_truncate()
        }
        low_product(inverse.as_slice(), correction.as_slice(), mut scratch.as_slice())
        inverse.as_slice().copy_from(scratch.as_slice())
        correct *= 2
    }
    // h = t q^-1 mod 2^k, then x + q h.
    var h = MemArray<u64>::try_new_zeroed(low)?
    low_product(t.as_slice(), inverse.as_slice(), mut h.as_slice())
    h[low - 1] &= mask
    for i in 0..2 * size + 1 { work[i] = 0 }
    for i in 0..q_len { work[i] = x[i] }
    for i in 0..q_len {
        var carry: u64 = 0
        for j in 0..low {
            let sum = work[i + j] as u128 + q[i] as u128 * h[j] as u128 + carry as u128
            work[i + j] = sum.downcast_truncate()
            carry = (sum >> 64).downcast_truncate()
        }
        var at = i + low
        while carry != 0 {
            let sum = work[at] as u128 + carry as u128
            work[at] = sum.downcast_truncate()
            carry = (sum >> 64).downcast_truncate()
            at += 1
        }
    }
    for i in 0..size { result[i] = work[i] }
    Option::Some(result)
}

// base^e mod 2^k for 2^k = mask + 1 in its top limb of `low`: products keep
// only their low `low` limbs. A power that reaches zero stays zero.
#[arithmetic(unchecked)]
fn low_power<T: ByteSource>(_ input: T, _ exponent: Exponent, _ base: MemArray<u64>, _ low: usize,
                            _ mask: u64) -> Option<MemArray<u64>> {
    var result = MemArray<u64>::try_new_zeroed(low)?
    var factor = MemArray<u64>::try_new_zeroed(low)?
    var work = MemArray<u64>::try_new_zeroed(low)?
    for i in 0..low { factor[i] = base[i] }
    factor[low - 1] &= mask
    result[0] = 1
    var index = exponent.top
    while index < exponent.total {
        low_product(result.as_slice(), result.as_slice(), mut work.as_slice())
        if exponent_bit(input, start: exponent.start, index) == 1 {
            low_product(work.as_slice(), factor.as_slice(), mut result.as_slice())
        } else {
            result.as_slice().copy_from(work.as_slice())
        }
        result[low - 1] &= mask
        var zero = true
        for i in 0..low { zero = zero && result[i] == 0 }
        if zero { break }
        index += 1
    }
    Option::Some(result)
}

// The low `out.len()` limbs of a b, for a and b of at least that many limbs.
#[arithmetic(unchecked)]
fn low_product(_ a: MemSlice<u64>, _ b: MemSlice<u64>, _ out: mut MemSlice<u64>) {
    let len = out.len()
    for j in 0..len { out[j] = 0 }
    for i in 0..len {
        let factor = a[i] as u128
        var carry: u64 = 0
        for j in 0..len - i {
            let sum = out[i + j] as u128 + factor * b[j] as u128 + carry as u128
            out[i + j] = sum.downcast_truncate()
            carry = (sum >> 64).downcast_truncate()
        }
    }
}

// The n-limb result as `modulus_len` big-endian bytes.
fn encoded(_ result: MemArray<u64>, _ n: u64, _ modulus_len: u64, _ output: own MemBuffer, _ gas_used: u64) -> Output {
    var output = output
    var i: u64 = 0
    while i < modulus_len {
        let position = modulus_len - 1 - i
        let limb_index = position / 8
        if limb_index < n {
            output[i.downcast_truncate()] = (result[limb_index.downcast_truncate()] >> ((position % 8) * 8)).downcast_truncate()
        }
        i += 1
    }
    Output { status: SUCCESS, gas_used, output }
}
