/// The RIPEMD-160 digest of `input`, as a big-endian 160-bit word.
pub fn ripemd160<T: ByteSource>(_ input: T) -> u256 {
    var state = RIPEMD_IV
    let blocks = padded_blocks(input.len())
    for index in 0..blocks {
        ripemd_compress(mut state, padded_block(input, offset: 0, len: input.len(), block_index: index, blocks))
    }
    // Each state word holds its four digest bytes little-endian.
    var digest: u256 = 0
    for word in state { digest = (digest << 32) | swap_bytes(word) as u256 }
    digest
}
