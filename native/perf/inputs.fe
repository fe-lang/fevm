use std::io::{Write, host, writeln}
use core::MemBuffer
use std::native::Args
use ingot::constants::{ERR_HOST_ALLOCATION, OK}
use ingot::hex::{parse_hex_bytes, parse_hex_program}
use ingot::types::{InputData, Program}

fn copies_and_jump_boundaries() {
    var source = MemBuffer::empty()
    core::assert(source.try_resize(9001))
    source[0] = 0x7f
    for index in 1..34 { source[index] = 0x5b }
    source[4095] = 0x60
    source[4096] = 0x5b
    source[4097] = 0x5b
    source[9000] = 0x7f
    let program = Program::copy_from(source, len: 9001)
    let input = InputData::copy_from(source, offset: 4096, len: 4905)
    let copied = InputData::copy_from(input, offset: 1, len: 4097)
    core::assert(program.status == OK && input.status == OK && copied.status == OK)
    source[33] = 0
    source[4097] = 0
    core::assert(program.len() == 9001 && program.byte_at(33) == 0x5b)
    core::assert(program.is_jumpdest(33) && program.is_jumpdest(4097))
    for destination in [0 as u256, 1, 31, 32, 4095, 4096, 9000, 9001, 1 << 64, !(0 as u256)] {
        core::assert(!program.is_jumpdest(destination))
    }
    core::assert(input.len() == 4905 && input.byte_at(1) == 0x5b)
    core::assert(copied.len() == 4097 && copied.byte_at(0) == 0x5b)
    let empty = Program::copy_from([0 as u8; 0], len: 0)
    core::assert(empty.status == OK && empty.len() == 0 && !empty.is_jumpdest(0))
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    // Native main supplies live NUL-terminated arguments for this process.
    let args = unsafe { Args::new(argc, argv) }
    if args.len() == 1 {
        copies_and_jump_boundaries()
    } else {
        if args.len() != 4 { return 2 }
        let encoded = args.get(2)
        let status = args.get(3).byte_at(0)
        let expected = if status == 97 { ERR_HOST_ALLOCATION } else { (status - 48) as i32 }
        let prefixed = encoded.len() >= 2 && encoded.byte_at(0) == 48
            && (encoded.byte_at(1) == 120 || encoded.byte_at(1) == 88)
        let count = (encoded.len() - if prefixed { 2 } else { 0 }) / 2
        if args.get(1).byte_at(0) == 112 {
            let program = parse_hex_program(encoded)
            core::assert(program.status == expected)
            if expected == OK {
                core::assert(program.len() == count && !program.is_jumpdest(count as u256))
                if count != 0 {
                    core::assert(program.byte_at(0) == 0x5b && program.byte_at(count - 1) == 0x5b)
                    core::assert(program.is_jumpdest(0) && program.is_jumpdest((count - 1) as u256))
                }
            }
        } else {
            let input = parse_hex_bytes(encoded)
            core::assert(input.status == expected)
            if expected == OK {
                core::assert(input.len() as u256 == count as u256)
                if count != 0 {
                    core::assert(input.byte_at(0) == 0x5b && input.byte_at((count - 1).downcast_unchecked()) == 0x5b)
                }
            }
        }
    }
    with (Write = host()) { writeln("inputs passed") }
    0
}
