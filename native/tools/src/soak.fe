use core::MemBuffer
use ingot::{Options, named, succeed}
use json::Value
use std::fs::Fs
use std::io::Stdout
use std::process::{Command, Spawn}

const COUNTS: [u64; 3] = [1000, 10000, 40000]
// Leaking even 32 bytes per transaction would add more than a mebibyte.
const MAX_GROWTH: u64 = 1048576

// Runs repeated transactions in one native process and checks that memory stays flat.
pub fn run(_ options: Options) -> Result<MemBuffer, ()>
uses (fs: mut Fs, proc: mut Spawn, out: mut Stdout)
{
    options.create_out()?
    succeed("fe build", options.build().arg("native/soak"))?
    var runs = Value::array()
    var first: u64 = 0
    var last: u64 = 0
    for count in COUNTS {
        let rss = succeed(
            format!(count, " transactions"),
            Command::new(format!(options.out, "/fevm_soak")).arg(count),
        )?
            .usage
            .max_rss
        var row = Value::object()
        row.set("transactions", Value::number(count))
        row.set("peak_rss_bytes", Value::number(rss))
        runs.push(row)
        first = if first == 0 { rss } else { first }
        last = rss
    }
    var report = Value::object()
    report.set("level", Value::string(options.level))
    report.set("runs", runs)
    var text = MemBuffer::empty()
    report.write_pretty(mut text, indent: 2)
    text.push(10)
    let path = format!(options.out, "/results.json")
    named(path, fs.write(path, text.span()))?
    println!(
        "peak RSS after ",
        COUNTS[0],
        " and ",
        COUNTS[2],
        " transactions: ",
        first,
        " and ",
        last,
        " bytes",
    )
    if last > first + MAX_GROWTH {
        return Result::Err(format!("peak RSS grew by ", last - first, " bytes"))
    }
    Result::Ok(())
}
