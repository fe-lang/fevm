use core::{MemBuffer, Option}
use std::env::{Arg, Args}
use std::fs::Fs
use std::io::{Display, Stderr, Stdout}
use std::process::{Command, Output, Spawn}
use std::text
use std::time::{Clock, Duration}

// fevm's checks, run from the repository's root.
pub fn main() -> i32
uses (args: Args, fs: mut Fs, proc: mut Spawn, clock: Clock, out: mut Stdout, err: mut Stderr)
{
    match run() {
        Result::Ok(()) => 0,
        Result::Err(message) => {
            eprintln!(message)
            1
        },
    }
}

fn run() -> Result<MemBuffer, ()>
uses (args: Args, fs: mut Fs, proc: mut Spawn, clock: Clock, out: mut Stdout)
{
    if args.count() < 2 {
        return usage()
    }
    let tool = args.get(1)
    if tool == "soak" {
        soak::run(Options::parse()?)
    } else if tool == "client" {
        client::run(Options::parse()?)
    } else if tool == "accept" {
        accept::run(accept::Options::parse()?)
    } else {
        usage()
    }
}

fn usage() -> Result<MemBuffer, ()> {
    Result::Err(
        format!(
            "usage: fevm_tools soak|client --fe <compiler> --out <directory> ",
            "[--level 0|1|2] [--toolchain <rustup toolchain>] [--build-timeout <seconds>]\n",
            "       fevm_tools accept --build <build.json> --out <directory> [--check-only] ",
            "[--jobs <count>] [--stage-timeout <seconds>] [--build-timeout <seconds>]",
        ),
    )
}

// The options that follow a tool's name.
struct Options { fe: Arg, out: Arg, level: u8, toolchain: Option<Arg>, build_timeout: Duration }

impl Options {
    fn parse() -> Result<MemBuffer, Self> uses (args: Args) {
        var fe: Option<Arg> = Option::None
        var out: Option<Arg> = Option::None
        var level: u8 = 2
        var toolchain: Option<Arg> = Option::None
        var build_timeout = Duration::from_secs(600)
        var i: usize = 2
        while i + 1 < args.count() {
            let name = args.get(i)
            let value = args.get(i + 1)
            if name == "--fe" {
                fe = Option::Some(value)
            } else if name == "--out" {
                out = Option::Some(value)
            } else if name == "--toolchain" {
                toolchain = Option::Some(value)
            } else if name == "--level"
                && value.len() == 1
                && value.span()[0] >= 48
                && value.span()[0] <= 50 {
                level = value.span()[0] - 48
            } else if name == "--build-timeout" {
                match parse_u64(value) {
                    Option::Some(limit) => build_timeout = Duration::from_secs(limit),
                    Option::None => {
                        return Result::Err(format!("bad option: ", name, " ", value))
                    },
                }
            } else {
                return Result::Err(format!("bad option: ", name, " ", value))
            }
            i += 2
        }
        if i != args.count() {
            return Result::Err(format!("option ", args.get(i), " needs a value"))
        }
        match (fe, out) {
            (Option::Some(fe), Option::Some(out)) => Result::Ok(
                Options { fe, out, level, toolchain, build_timeout },
            ),
            _ => Result::Err(format!("fevm_tools needs --fe and --out")),
        }
    }

    // Creates the output directory, which must not exist.
    fn create_out(self) -> Result<MemBuffer, ()> uses (fs: mut Fs) {
        if fs.metadata(self.out).is_ok() {
            return Result::Err(format!(self.out, " already exists"))
        }
        named(self.out, fs.create_dir_all(self.out))
    }

    // `fe build` into the output directory.
    fn build(self) -> Command {
        Command::new(self.fe)
            .arg("build")
            .arg("--backend")
            .arg("native")
            .arg("-O")
            .arg(self.level)
            .arg("--emit")
            .arg("executable")
            .arg("--out-dir")
            .arg(self.out)
            .timeout(self.build_timeout)
    }
}

fn parse_u64(_ value: Arg) -> Option<u64> {
    text::parse_uint(value.span())?.downcast()
}

// `result`, with an error's message naming `what`.
fn named<T, E: Display, W: Display>(_ what: W, _ result: own Result<E, T>) -> Result<MemBuffer, T> {
    match result {
        Result::Ok(value) => Result::Ok(value),
        Result::Err(error) => Result::Err(format!(what, ": ", error)),
    }
}

// Runs `command` to its end, which must be a success.
fn succeed<W: Display>(_ what: W, _ command: Command) -> Result<MemBuffer, Output>
uses (proc: mut Spawn)
{
    let output = named(what, proc.output(command))?
    if !output.status.success() {
        return Result::Err(format!(what, ": ", output.status))
    }
    Result::Ok(output)
}
