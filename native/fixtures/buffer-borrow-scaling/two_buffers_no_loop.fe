use core::MemBuffer

struct Frame { memory: MemBuffer, output: MemBuffer }

impl Frame {
    fn new() -> Self { Self { memory: MemBuffer::empty(), output: MemBuffer::empty() } }

    fn run(mut self, len: u64) {
        core::assert(self.memory.try_resize(len as usize))
        core::assert(self.output.try_resize(len as usize))
        self.memory[0] = 7
        self.output[0] = self.memory[0]
    }
}

pub fn main() -> i32 {
    var frame = Frame::new()
    frame.run(len: 32)
    0
}
