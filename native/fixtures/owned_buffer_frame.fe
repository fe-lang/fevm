use core::MemBuffer

struct Frame {
    memory: MemBuffer,
    output: MemBuffer,
    stack: [u256; 1024],
    sp: usize,
}

impl Frame {
    fn new() -> Self {
        Self { memory: MemBuffer::empty(), output: MemBuffer::empty(), stack: [0; 1024], sp: 0 }
    }

    fn reset(mut self) {
        self.memory.clear()
        self.output.clear()
        self.sp = 0
    }

    fn run(mut self, size: u64, value: u8) {
        self.reset()
        core::assert(self.memory.try_resize(size as usize))
        core::assert(self.memory[(size - 1) as usize] == 0)
        self.memory[(size - 1) as usize] = value
        core::assert(self.output.try_resize(1))
        self.output[0] = self.memory[(size - 1) as usize]
        self.stack[0] = value as u256
        self.sp = 1
    }

    fn into_output(own self) -> MemBuffer {
        self.output
    }
}

fn run() -> MemBuffer {
    var frame = Frame::new()
    frame.run(size: 9000, value: 42)
    let capacity = frame.memory.capacity()
    frame.run(size: 32, value: 7)
    core::assert(frame.memory.capacity() == capacity)
    frame.run(size: 9000, value: 91)
    core::assert(frame.sp == 1 && frame.stack[0] == 91)
    frame.into_output()
}

pub fn main() -> i32 {
    let output = run()
    core::assert(output.len() == 1 && output[0] == 91)
    0
}
