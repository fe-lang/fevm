use std::native::ByteBuffer

struct Frame {
    memory: ByteBuffer,
    output: ByteBuffer,
    stack: [u256; 1024],
    sp: usize,
}

impl Frame {
    fn new() -> Self {
        Self { memory: ByteBuffer::new(), output: ByteBuffer::new(), stack: [0; 1024], sp: 0 }
    }

    fn reset(mut self) {
        self.memory.clear()
        self.output.clear()
        self.sp = 0
    }

    fn run(mut self, size: u64, value: u8) {
        self.reset()
        core::assert(self.memory.try_resize(size))
        core::assert(self.memory.byte_at(size - 1) == 0)
        self.memory.set_byte(index: size - 1, value)
        core::assert(self.output.try_resize(1))
        self.output.set_byte(index: 0, value: self.memory.byte_at(size - 1))
        self.stack[0] = value as u256
        self.sp = 1
    }

    fn into_output(own self) -> ByteBuffer {
        self.memory.release()
        self.output
    }
}

fn run() -> ByteBuffer {
    let mut frame = Frame::new()
    frame.run(size: 9000, value: 42)
    let capacity = frame.memory.capacity()
    frame.run(size: 32, value: 7)
    core::assert(frame.memory.capacity() == capacity)
    frame.run(size: 9000, value: 91)
    core::assert(frame.sp == 1 && frame.stack[0] == 91)
    frame.into_output()
}

pub fn main() -> i32 {
    let output = run()
    core::assert(output.len() == 1 && output.byte_at(0) == 91)
    output.release()
    0
}
