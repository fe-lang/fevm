use core::{MemVec, Option}
use fevm::{AccountBefore, Block, Config, Evm, TxEnv, TxRequest, WorldState, default_block_env, empty_bytes}
use fevm::processor::TX_LEGACY
use fevm::status::{ERR_HOST_ALLOCATION, OK, VALID}

const SENDER: u256 = 0x1000
const BALANCE: u256 = 1_000_000
const EMPTY: u256 = 0xe0
const CALLER: u256 = 0xca11

// Relinked with the controlled allocator watching allocations of 7,168
// bytes: the block's changes growing to 32 accounts of 224 bytes, when
// the 16th transfer, each to a new account, adds the 17th. Failing it fails
// that transaction as a host failure and undoes it; the block's changes
// still undo the 15 before. Without the failure all 20 run, and undoing
// them leaves the world as it was.
pub fn main() -> i32 {
    core::assert(core::size_of<AccountBefore>() == 224)
    var world = WorldState::empty()
    core::assert(world.set_balance(SENDER, BALANCE))
    var env = default_block_env()
    env.gaslimit = 30_000_000
    env.chainid = 1
    var block = Block::begin(Evm::new(world, Config::osaka()), env, parent_hash: 0, parent_beacon_block_root: 0)
    var tracer = ()
    var sent: u256 = 0
    var status = OK
    while sent < 20 && status == OK {
        let tx = TxEnv {
            kind: TX_LEGACY, chain_id: Option::Some(1), sender: SENDER, to: 0x2000 + sent, creates: false,
            nonce: sent, gas_limit: 21_000, gas_price: 0, max_priority_fee_per_gas: 0, max_fee_per_blob_gas: 0,
            value: 1,
        }
        let receipt = block.transact(TxRequest::new(tx, data: empty_bytes()), mut tracer)
        core::assert(receipt.invalid == VALID)
        status = receipt.status
        if status == OK { sent += 1 }
    }
    core::assert((status == OK && sent == 20) || (status == ERR_HOST_ALLOCATION && sent == 15))
    // The failed transfer is undone: its recipient has no account.
    core::assert(block.world().nonce(SENDER) == sent && !block.world().exists(0x2000 + sent))
    core::assert(block.world().balance(SENDER) == BALANCE - sent)
    let world = block.abandon().into_world()
    core::assert(world.account_count() == 1 && world.balance(SENDER) == BALANCE && world.nonce(SENDER) == 0)
    clears()
    0
}

// Then a block's transaction calls a contract that calls an empty account
// with 40 slots without value, a touch, and stores 30 slots of its own.
// Settlement deletes the empty account; the block's changes keep its slots,
// growing to 64 of 96 bytes, 6,144, and then the contract's, growing to
// 128, 12,288. Relinked with the allocator watching either size, failing it
// fails the transaction as a host failure and undoes it: the account stays,
// and its changes do not mark it cleared.
fn clears() {
    var world = WorldState::empty()
    core::assert(world.set_balance(SENDER, BALANCE))
    let stop: [u8; 1] = [0x00]
    for address in [0x00000961ef480eb55e80d19ad83579a64c007002 as u256, 0x0000bbddc7ce488642fb579f8b00f3a590007251] {
        core::assert(world.set_code(address, code: stop) == OK)
    }
    core::assert(world.ensure_account(EMPTY))
    for slot in 0..40 { core::assert(world.storage_store(EMPTY, slot as u256, slot as u256 + 1)) }
    // CALL(GAS, EMPTY, 0, 0, 0, 0, 0); POP; then for i from 30 down to 1,
    // SSTORE(i, i): PUSH1 30; JUMPDEST; DUP1; DUP1; SSTORE; PUSH1 1; SWAP1;
    // SUB; DUP1; PUSH1 12; JUMPI; STOP.
    let code: [u8; 25] = [
        0x5f, 0x5f, 0x5f, 0x5f, 0x5f, 0x60, 0xe0, 0x5a, 0xf1, 0x50, 0x60, 30, 0x5b, 0x80, 0x80, 0x55, 0x60, 1,
        0x90, 0x03, 0x80, 0x60, 12, 0x57, 0x00,
    ]
    core::assert(world.set_code(address: CALLER, code) == OK)
    var env = default_block_env()
    env.gaslimit = 30_000_000
    env.chainid = 1
    var block = Block::begin(Evm::new(world, Config::osaka()), env, parent_hash: 0, parent_beacon_block_root: 0)
    let tx = TxEnv {
        kind: TX_LEGACY, chain_id: Option::Some(1), sender: SENDER, to: CALLER, creates: false, nonce: 0,
        gas_limit: 1_000_000, gas_price: 0, max_priority_fee_per_gas: 0, max_fee_per_blob_gas: 0, value: 0,
    }
    var tracer = ()
    let receipt = block.transact(TxRequest::new(tx, data: empty_bytes()), mut tracer)
    let failed = receipt.status == ERR_HOST_ALLOCATION
    core::assert(receipt.invalid == VALID && (receipt.status == OK || failed))
    core::assert(block.world().exists(EMPTY) == failed)
    core::assert(block.world().storage_load(EMPTY, 1) == if failed { 2 } else { 0 })
    core::assert(block.world().storage_load(CALLER, 30) == if failed { 0 } else { 30 })
    let (_, finished) = block.finish(MemVec::new())
    var listed = false
    for account in finished.unwrap().changes.accounts() {
        if account.address == EMPTY {
            core::assert(account.cleared != failed)
            listed = true
        }
    }
    core::assert(listed)
}
