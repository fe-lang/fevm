use fevm::{Program, Transaction, WorldState, OK, default_block_env, default_call_env, empty_bytes}
use fevm::constants::ERR_HOST_ALLOCATION
use fevm::vm::Vm

// Relinked with the controlled allocator watching allocations of at least
// 32,769 bytes: each boxed child frame. 0xaa calls 0xbb, which stores a
// marker and calls 0xcc, which stores another. Frame storage grows with call
// depth, so success allocates exactly two boxes.
// Failing any of them stops the whole execution as a host failure and rolls
// back every child write.
pub fn main() -> i32 {
    var world = WorldState::empty()
    let relay = [0x60 as u8, 1, 0x5f, 0x55, 0x5f, 0x5f, 0x5f, 0x5f, 0x5f, 0x60, 0xcc, 0x5a, 0xf1]
    core::assert(world.set_code(address: 0xbb, code: relay) == OK)
    core::assert(world.set_code(address: 0xcc, code: [0x60 as u8, 1, 0x5f, 0x55]) == OK)
    var tx = Transaction::new(world, sender: 0, destination: 0xaa, coinbase: 0)
    var call = default_call_env()
    call.address = 0xaa
    let ops = [0x5f as u8, 0x5f, 0x5f, 0x5f, 0x5f, 0x60, 0xbb, 0x5a, 0xf1]
    var vm = Vm::new()
    vm.run(Program::copy_from(ops, len: 9), empty_bytes(), call, default_block_env(), mut tx)
    let completed = vm.status == OK
    core::assert(completed || vm.status == ERR_HOST_ALLOCATION)
    core::assert(!completed || (vm.sp == 1 && vm.stack[0] == 1))
    for address in [0xbb as u256, 0xcc] {
        core::assert(tx.storage_load(address, slot: 0) == if completed { 1 } else { 0 })
    }
    core::assert(tx.depth() == 0)
    let _ = tx.finish(commit: completed, gas_spent: 0)
    0
}
