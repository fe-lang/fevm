use core::Option
use std::native::{Args, ByteBuffer}
use fevm::{Checkpoint, Transaction, WorldState, OK}
use fevm::constants::ERR_HOST_ALLOCATION

fn checkpoint(_ tx: mut Transaction) -> Checkpoint {
    match tx.checkpoint(is_static: false) {
        Option::Some(point) => point,
        Option::None => core::panic(),
    }
}

// WATCH_SIZE=131072 tests log-header growth after a retained first record.
fn headers() {
    let data = ByteBuffer::new()
    let mut tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    core::assert(tx.emit_log(address: 1, topics: [7; 4], topic_count: 1, data, offset: 0, len: 0) == OK)
    let point = checkpoint(mut tx)
    let mut count: u64 = 1
    let mut status = OK
    while count < 350 && status == OK {
        status = tx.emit_log(address: count as u256, topics: [0; 4], topic_count: 0, data, offset: 0, len: 0)
        if status == OK { count += 1 }
    }
    core::assert(tx.logs().len() == count)
    core::assert((status == OK && count == 350) || (status == ERR_HOST_ALLOCATION && count == 341))
    tx.revert(point)
    core::assert(tx.logs().len() == 1 && tx.logs().entry(0).topics[0] == 7)
    core::assert(tx.emit_log(address: 2, topics: [9; 4], topic_count: 4, data, offset: 0, len: 0) == OK)
    let receipt = tx.finish(commit: true, gas_spent: 0)
    core::assert(receipt.logs.len() == 2 && receipt.logs.entry(1).topics[3] == 9)
    receipt.release()
    data.release()
}

// WATCH_SIZE=32 or 64 tests first allocation and subsequent atomic growth.
fn blobs() {
    let mut tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    if tx.add_blob_hash(7) {
        if tx.add_blob_hash(9) {
            core::assert(tx.blob_hash(0) == 7 && tx.blob_hash(1) == 9)
        } else {
            core::assert(tx.blob_hash(0) == 7 && tx.blob_hash(1) == 0)
        }
    } else {
        core::assert(tx.blob_hash(0) == 0)
    }
    tx.finish(commit: true, gas_spent: 0).release()
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    let args = Args::new(argc, argv)
    if args.len() != 2 { return 2 }
    let mode = args.get(1)
    if mode.len() != 1 { return 2 }
    if mode.byte_at(0) == 104 { headers() }
    else if mode.byte_at(0) == 98 { blobs() }
    else { return 2 }
    0
}
