use core::MemBuffer
use std::native::Args
use fevm::{Checkpoint, Transaction, WorldState, OK}
use fevm::constants::ERR_HOST_ALLOCATION

fn checkpoint(_ tx: mut Transaction) -> Checkpoint {
    tx.checkpoint(is_static: false)
}

// WATCH_SIZE=94208 tests log-entry growth to 512 entries of 184 bytes after a
// retained first entry.
fn headers() {
    let data = MemBuffer::empty()
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    core::assert(tx.emit_log(address: 1, topics: [7; 4], topic_count: 1, data: data.slice(offset: 0, len: 0)) == OK)
    let point = checkpoint(mut tx)
    var count: u64 = 1
    var status = OK
    while count < 350 && status == OK {
        status = tx.emit_log(address: count as u256, topics: [0; 4], topic_count: 0, data: data.slice(offset: 0, len: 0))
        if status == OK { count += 1 }
    }
    core::assert(tx.logs().len() == count)
    core::assert((status == OK && count == 350) || (status == ERR_HOST_ALLOCATION && count == 256))
    tx.revert(point)
    core::assert(tx.logs().len() == 1 && tx.logs().entry(0).topics[0] == 7)
    core::assert(tx.emit_log(address: 2, topics: [9; 4], topic_count: 4, data: data.slice(offset: 0, len: 0)) == OK)
    let receipt = tx.finish(commit: true, gas_spent: 0)
    core::assert(receipt.logs.len() == 2 && receipt.logs.entry(1).topics[3] == 9)
}

// WATCH_SIZE=128 or 256 tests the first allocation of four hashes and the
// atomic growth to eight.
fn blobs() {
    var tx = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    var count: u256 = 0
    while count < 5 && tx.add_blob_hash(count + 7) {
        count += 1
    }
    core::assert(count == 0 || count == 4 || count == 5)
    var index: u256 = 0
    while index < 5 {
        core::assert(tx.blob_hash(index) == if index < count { index + 7 } else { 0 })
        index += 1
    }
    tx.finish(commit: true, gas_spent: 0)
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    // Native main supplies live NUL-terminated arguments for this process.
    let args = unsafe { Args::new(argc, argv) }
    if args.len() != 2 { return 2 }
    let mode = args.get(1)
    if mode.len() != 1 { return 2 }
    if mode.byte_at(0) == 104 { headers() }
    else if mode.byte_at(0) == 98 { blobs() }
    else { return 2 }
    0
}
