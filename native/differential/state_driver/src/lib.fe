use core::Option
use std::io::{Write, host, write, writeln}
use std::native::Args
use fevm::{CallEnv, InputData, Program, StorageKey, Transaction, WorldState, default_block_env, default_call_env}
use fevm::hex::{parse_hex_bytes, write_hex_word}
use fevm::vm::execute_vm
use fevm_frame::{write_frame, write_gas}

struct Reader { data: InputData, position: usize }

impl Reader {
    fn word(mut self, bytes: usize) -> u256 {
        core::assert(bytes <= 32 && bytes <= self.data.len - self.position)
        let mut value: u256 = 0
        let end = self.position + bytes
        while self.position < end {
            value = (value << 8) | self.data.bytes[self.position] as u256
            self.position += 1
        }
        value
    }
    fn count(mut self) -> usize { self.word(bytes: 2).downcast_unchecked() }
    fn flag(mut self) -> bool {
        let flag = self.word(bytes: 1)
        core::assert(flag <= 1)
        flag == 1
    }
    fn input(mut self) -> InputData {
        let len = self.count()
        core::assert(len <= 4096)
        let mut bytes: [u8; 4096] = [0; 4096]
        let mut index: usize = 0
        while index < len {
            bytes[index] = self.word(bytes: 1).downcast_unchecked()
            index += 1
        }
        InputData { bytes, len, status: 0 }
    }
}

struct Watch {
    accounts: [u256; 256],
    account_count: usize,
    slots: [StorageKey; 256],
    slot_count: usize,
}

fn read_watch(_ reader: mut Reader) -> Watch {
    let mut accounts: [u256; 256] = [0; 256]
    let account_count = reader.count()
    core::assert(account_count <= 256)
    let mut index: usize = 0
    while index < account_count {
        accounts[index] = reader.word(bytes: 20)
        index += 1
    }
    let mut slots: [StorageKey; 256] = [StorageKey { address: 0, slot: 0 }; 256]
    let slot_count = reader.count()
    core::assert(slot_count <= 256)
    index = 0
    while index < slot_count {
        let address = reader.word(bytes: 20)
        let slot = reader.word(bytes: 32)
        slots[index] = StorageKey { address, slot }
        index += 1
    }
    Watch { accounts, account_count, slots, slot_count }
}

fn write_signed(_ value: i128) uses (w: mut Write) {
    let magnitude = if value < 0 {
        write("-")
        (-value)
    } else { value }
    // Corpus transactions bound aggregate frame gas to u64; individual refund
    // deltas in this harness are also checked to fit the decimal writer.
    core::assert(magnitude <= 0xffffffffffffffff)
    write_gas(magnitude.downcast_unchecked())
}

fn write_snapshot(_ tx: Transaction, _ watch: Watch, refund_delta: i128) uses (w: mut Write) {
    write(",\"refund_delta\":")
    write_signed(refund_delta)
    write(",\"refund_counter\":")
    write_signed(tx.refund())
    write(",\"accounts\":[")
    let mut index: usize = 0
    while index < watch.account_count {
        if index != 0 { write(",") }
        let address = watch.accounts[index]
        write("{\"balance\":\"")
        write_hex_word(tx.balance(address))
        write("\",\"warm\":")
        if tx.account_is_warm(address) { write("true") } else { write("false") }
        write("}")
        index += 1
    }
    write("],\"storage\":[")
    index = 0
    while index < watch.slot_count {
        if index != 0 { write(",") }
        let key = watch.slots[index]
        write("{\"value\":\"")
        write_hex_word(tx.storage_load(address: key.address, slot: key.slot))
        write("\",\"original\":\"")
        write_hex_word(tx.original_storage(address: key.address, slot: key.slot))
        write("\",\"transient\":\"")
        write_hex_word(tx.transient_load(address: key.address, slot: key.slot))
        write("\",\"warm\":")
        if tx.storage_is_warm(address: key.address, slot: key.slot) { write("true") } else { write("false") }
        write("}")
        index += 1
    }
    write("]}")
}

#[inline(never)]
fn run_frame(_ tx: mut Transaction, _ reader: mut Reader, _ watch: Watch, _ call: CallEnv, coinbase: u256) -> u64 uses (w: mut Write) {
    let mut call = call
    call.is_static = reader.flag()
    call.gas_limit = reader.word(bytes: 8).downcast_unchecked()
    let code = reader.input()
    let calldata = reader.input()
    let mut block = default_block_env()
    block.coinbase = coinbase
    let vm = execute_vm(Program::new(code.bytes, len: code.len, status: 0), calldata, call, block, mut tx)
    let supported = vm.status == 0 || (vm.status >= 15 && vm.status <= 19)
        || vm.status == 10 || vm.status == 11 || vm.status == 23
    core::assert(supported)
    let gas_spent = call.gas_limit - vm.gas_remaining
    write("{\"frame\":")
    write_frame(vm)
    write_snapshot(tx, watch, refund_delta: vm.refund_delta)
    vm.release()
    gas_spent
}

fn run_actions(_ tx: mut Transaction, _ reader: mut Reader, _ watch: Watch, _ call: CallEnv, coinbase: u256, _ emitted: mut bool) -> u64 uses (w: mut Write) {
    let count = reader.count()
    let mut index: usize = 0
    let mut gas_spent: u64 = 0
    while index < count {
        let kind = reader.word(bytes: 1)
        if kind == 0 {
            if emitted { write(",") }
            emitted = true
            gas_spent += run_frame(mut tx, mut reader, watch, call, coinbase)
        } else {
            core::assert(kind == 1)
            let is_static = reader.flag()
            let commit = reader.flag()
            let point = match tx.checkpoint(is_static) {
                Option::Some(point) => point,
                Option::None => core::panic(),
            }
            gas_spent += run_actions(mut tx, mut reader, watch, call, coinbase, mut emitted)
            if commit { tx.commit(point) } else { tx.revert(point) }
            if emitted { write(",") }
            emitted = true
            write("{\"frame\":null")
            write_snapshot(tx, watch, refund_delta: 0)
        }
        index += 1
    }
    gas_spent
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    let args = Args::new(argc, argv)
    if args.len() != 2 { return 2 }
    let data = parse_hex_bytes(args.get(1))
    if data.status != 0 { return 2 }
    let mut reader = Reader { data, position: 0 }
    core::assert(reader.word(bytes: 1) == 1)
    let mut world = WorldState::empty()
    let balances = reader.count()
    let mut index: usize = 0
    while index < balances {
        let address = reader.word(bytes: 20)
        let value = reader.word(bytes: 32)
        core::assert(world.set_balance(address, value))
        index += 1
    }
    let storage = reader.count()
    index = 0
    while index < storage {
        let address = reader.word(bytes: 20)
        let slot = reader.word(bytes: 32)
        let value = reader.word(bytes: 32)
        core::assert(world.storage_store(address, slot, value))
        index += 1
    }
    let watch = read_watch(mut reader)
    let transactions = reader.count()
    index = 0
    with (Write = host()) {
        write("[")
        while index < transactions {
            if index != 0 { write(",") }
            let sender = reader.word(bytes: 20)
            let destination = reader.word(bytes: 20)
            let coinbase = reader.word(bytes: 20)
            let commit = reader.flag()
            let mut tx = Transaction::new(world, sender, destination, coinbase)
            let accounts = reader.count()
            let mut entry: usize = 0
            while entry < accounts {
                core::assert(tx.access_list_account(address: reader.word(bytes: 20)))
                entry += 1
            }
            let slots = reader.count()
            entry = 0
            while entry < slots {
                let address = reader.word(bytes: 20)
                let slot = reader.word(bytes: 32)
                core::assert(tx.access_list_slot(address, slot))
                entry += 1
            }
            let mut call = default_call_env()
            call.address = destination
            call.caller = sender
            call.origin = sender
            let mut emitted = false
            write("{\"steps\":[")
            let gas_spent = run_actions(mut tx, mut reader, watch, call, coinbase, mut emitted)
            write("],\"refund_counter\":")
            write_signed(if commit { tx.refund() } else { 0 })
            let settled = tx.finish(commit, gas_spent)
            write(",\"gas_refunded\":")
            write_gas(settled.gas_refunded)
            write(",\"gas_used\":")
            write_gas(settled.gas_used)
            write(",\"balances\":[")
            entry = 0
            while entry < watch.account_count {
                if entry != 0 { write(",") }
                write("\"")
                write_hex_word(settled.state.balance(watch.accounts[entry]))
                write("\"")
                entry += 1
            }
            write("],\"storage\":[")
            entry = 0
            while entry < watch.slot_count {
                if entry != 0 { write(",") }
                let key = watch.slots[entry]
                write("\"")
                write_hex_word(settled.state.storage_load(key.address, key.slot))
                write("\"")
                entry += 1
            }
            write("]}")
            world = settled.state
            index += 1
        }
        writeln("]")
    }
    core::assert(reader.position == reader.data.len)
    0
}
