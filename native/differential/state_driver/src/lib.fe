use core::MemBuffer
use std::env::Args
use std::io::{Display, Stdout}
use fevm::{LogBuffer, BlockEnv, CallEnv, InputData, Program, StorageKey, Transaction, WorldState, default_block_env, default_call_env}
use fevm::hex::{parse_hex_bytes, write_hex_byte, write_hex_bytes, write_hex_word}
use fevm::status::is_evm_outcome
use fevm::vm::execute_vm
use fevm_frame::write_frame

struct Reader { data: InputData, position: usize }

impl Reader {
    fn word(mut self, bytes: usize) -> u256 {
        core::assert(bytes <= 32 && self.position <= self.data.len() && bytes <= self.data.len() - self.position)
        var value: u256 = 0
        let end = self.position + bytes
        while self.position < end {
            value = (value << 8) | self.data.byte_at(self.position) as u256
            self.position += 1
        }
        value
    }
    fn count(mut self) -> usize { self.word(bytes: 2).downcast_unchecked() }
    fn flag(mut self) -> bool {
        let flag = self.word(bytes: 1)
        core::assert(flag <= 1)
        flag == 1
    }
    fn input(mut self) -> InputData {
        let len = self.count()
        let input = InputData::copy_from(self.data, offset: self.position, len)
        core::assert(input.status == 0)
        self.position += len
        input
    }
}

struct Watch {
    accounts: [u256; 256],
    account_count: usize,
    slots: [StorageKey; 256],
    slot_count: usize,
}

fn read_watch(_ reader: mut Reader) -> Watch {
    var accounts: [u256; 256] = [0; 256]
    let account_count = reader.count()
    core::assert(account_count <= 256)
    var index: usize = 0
    while index < account_count {
        accounts[index] = reader.word(bytes: 20)
        index += 1
    }
    var slots: [StorageKey; 256] = [StorageKey { address: 0, slot: 0 }; 256]
    let slot_count = reader.count()
    core::assert(slot_count <= 256)
    index = 0
    while index < slot_count {
        let address = reader.word(bytes: 20)
        let slot = reader.word(bytes: 32)
        slots[index] = StorageKey { address, slot }
        index += 1
    }
    Watch { accounts, account_count, slots, slot_count }
}

fn write_logs(_ logs: LogBuffer) uses (text: mut MemBuffer) {
    "[".fmt(mut text)
    var index: u64 = 0
    while index < logs.len() {
        if index != 0 { ",".fmt(mut text) }
        let entry = logs.entry(index)
        "{\"address\":\"0x".fmt(mut text)
        var byte: u64 = 0
        while byte < 20 {
            write_hex_byte(((entry.address >> ((19 - byte) * 8) as u256) & 255).downcast_unchecked())
            byte += 1
        }
        "\",\"topics\":[".fmt(mut text)
        var topic: u64 = 0
        while topic < entry.topic_count {
            if topic != 0 { ",".fmt(mut text) }
            "\"".fmt(mut text)
            write_hex_word(entry.topics[topic as usize])
            "\"".fmt(mut text)
            topic += 1
        }
        "],\"data\":\"".fmt(mut text)
        write_hex_bytes(logs.payload(index))
        "\"}".fmt(mut text)
        index += 1
    }
    "]".fmt(mut text)
}

fn write_snapshot(_ tx: Transaction, _ watch: Watch, refund_delta: i128) uses (text: mut MemBuffer) {
    ",\"refund_delta\":".fmt(mut text)
    refund_delta.fmt(mut text)
    ",\"refund_counter\":".fmt(mut text)
    tx.refund().fmt(mut text)
    ",\"accounts\":[".fmt(mut text)
    var index: usize = 0
    while index < watch.account_count {
        if index != 0 { ",".fmt(mut text) }
        let address = watch.accounts[index]
        "{\"balance\":\"".fmt(mut text)
        write_hex_word(tx.balance(address))
        "\",\"warm\":".fmt(mut text)
        tx.account_is_warm(address).fmt(mut text)
        "}".fmt(mut text)
        index += 1
    }
    "],\"storage\":[".fmt(mut text)
    index = 0
    while index < watch.slot_count {
        if index != 0 { ",".fmt(mut text) }
        let key = watch.slots[index]
        "{\"value\":\"".fmt(mut text)
        write_hex_word(tx.storage_load(address: key.address, slot: key.slot))
        "\",\"original\":\"".fmt(mut text)
        write_hex_word(tx.original_storage(address: key.address, slot: key.slot))
        "\",\"transient\":\"".fmt(mut text)
        write_hex_word(tx.transient_load(address: key.address, slot: key.slot))
        "\",\"warm\":".fmt(mut text)
        tx.storage_is_warm(address: key.address, slot: key.slot).fmt(mut text)
        "}".fmt(mut text)
        index += 1
    }
    "],\"logs\":".fmt(mut text)
    write_logs(tx.logs())
    "}".fmt(mut text)
}

#[inline(never)]
fn run_frame(_ tx: mut Transaction, _ reader: mut Reader, _ watch: Watch, _ call: CallEnv, _ block: BlockEnv) -> u64 uses (text: mut MemBuffer) {
    var call = call
    call.is_static = reader.flag()
    call.gas_limit = reader.word(bytes: 8).downcast_unchecked()
    let code = reader.input()
    let calldata = reader.input()
    let vm = execute_vm(Program::new(code), calldata, call, block, mut tx)
    core::assert(is_evm_outcome(vm.status))
    let gas_spent = call.gas_limit - vm.gas_remaining
    "{\"frame\":".fmt(mut text)
    write_frame(vm)
    write_snapshot(tx, watch, refund_delta: vm.refund_delta)
    gas_spent
}

fn run_actions(_ tx: mut Transaction, _ reader: mut Reader, _ watch: Watch, _ call: CallEnv, _ block: BlockEnv, _ emitted: mut bool) -> u64 uses (text: mut MemBuffer) {
    let count = reader.count()
    var index: usize = 0
    var gas_spent: u64 = 0
    while index < count {
        let kind = reader.word(bytes: 1)
        if kind == 0 {
            if emitted { ",".fmt(mut text) }
            emitted = true
            gas_spent += run_frame(mut tx, mut reader, watch, call, block)
        } else {
            core::assert(kind == 1)
            let is_static = reader.flag()
            let commit = reader.flag()
            let point = tx.checkpoint(is_static)
            gas_spent += run_actions(mut tx, mut reader, watch, call, block, mut emitted)
            if commit { tx.commit(point) } else { tx.revert(point) }
            if emitted { ",".fmt(mut text) }
            emitted = true
            "{\"frame\":null".fmt(mut text)
            write_snapshot(tx, watch, refund_delta: 0)
        }
        index += 1
    }
    gas_spent
}

pub fn main() -> i32 uses (args: Args, out: mut Stdout) {
    if args.count() != 2 { return 2 }
    let data = parse_hex_bytes(args.get(1))
    if data.status != 0 {
        return 2
    }
    var reader = Reader { data, position: 0 }
    core::assert(reader.word(bytes: 1) == 4)
    var world = WorldState::empty()
    let hashes = reader.count()
    var index: usize = 0
    while index < hashes {
        let number = reader.word(bytes: 32)
        let hash = reader.word(bytes: 32)
        core::assert(world.set_block_hash(number, hash))
        index += 1
    }
    let accounts = reader.count()
    index = 0
    while index < accounts {
        let address = reader.word(bytes: 20)
        let balance = reader.word(bytes: 32)
        let nonce = reader.word(bytes: 8)
        core::assert(world.ensure_account(address))
        core::assert(world.set_balance(address, balance))
        core::assert(world.set_nonce(address, nonce))
        let len: u64 = reader.count().downcast_unchecked()
        var code = MemBuffer::new(len as usize)
        var byte: u64 = 0
        while byte < len {
            code[byte as usize] = reader.word(bytes: 1).downcast_unchecked()
            byte += 1
        }
        core::assert(world.set_code(address, code) == 0)
        index += 1
    }
    let storage = reader.count()
    index = 0
    while index < storage {
        let address = reader.word(bytes: 20)
        let slot = reader.word(bytes: 32)
        let value = reader.word(bytes: 32)
        core::assert(world.storage_store(address, slot, value))
        index += 1
    }
    let watch = read_watch(mut reader)
    let transactions = reader.count()
    index = 0
    var text = MemBuffer::empty()
    with (mut text) {
        "[".fmt(mut text)
        while index < transactions {
            if index != 0 { ",".fmt(mut text) }
            let sender = reader.word(bytes: 20)
            let destination = reader.word(bytes: 20)
            let coinbase = reader.word(bytes: 20)
            let block_number = reader.word(bytes: 32)
            var tx = Transaction::new(world, sender, destination, coinbase)
            let blobs = reader.count()
            var blob: usize = 0
            while blob < blobs {
                core::assert(tx.add_blob_hash(reader.word(bytes: 32)))
                blob += 1
            }
            let commit = reader.flag()
            let accounts = reader.count()
            var entry: usize = 0
            while entry < accounts {
                core::assert(tx.access_list_account(address: reader.word(bytes: 20)))
                entry += 1
            }
            let slots = reader.count()
            entry = 0
            while entry < slots {
                let address = reader.word(bytes: 20)
                let slot = reader.word(bytes: 32)
                core::assert(tx.access_list_slot(address, slot))
                entry += 1
            }
            var call = default_call_env()
            call.address = destination
            call.caller = sender
            call.origin = sender
            var block = default_block_env()
            block.coinbase = coinbase
            block.number = block_number
            var emitted = false
            "{\"steps\":[".fmt(mut text)
            let gas_spent = run_actions(mut tx, mut reader, watch, call, block, mut emitted)
            "],\"refund_counter\":".fmt(mut text)
            let refund: i128 = if commit { tx.refund() } else { 0 }
            refund.fmt(mut text)
            let settled = tx.finish(commit, gas_spent)
            ",\"gas_refunded\":".fmt(mut text)
            settled.gas_refunded.fmt(mut text)
            ",\"gas_used\":".fmt(mut text)
            settled.gas_used.fmt(mut text)
            ",\"balances\":[".fmt(mut text)
            entry = 0
            while entry < watch.account_count {
                if entry != 0 { ",".fmt(mut text) }
                "\"".fmt(mut text)
                write_hex_word(settled.state.balance(watch.accounts[entry]))
                "\"".fmt(mut text)
                entry += 1
            }
            "],\"storage\":[".fmt(mut text)
            entry = 0
            while entry < watch.slot_count {
                if entry != 0 { ",".fmt(mut text) }
                let key = watch.slots[entry]
                "\"".fmt(mut text)
                write_hex_word(settled.state.storage_load(key.address, key.slot))
                "\"".fmt(mut text)
                entry += 1
            }
            "],\"logs\":".fmt(mut text)
            write_logs(settled.logs)
            "}".fmt(mut text)
            world = settled.state
            index += 1
        }
        "]\n".fmt(mut text)
    }
    core::assert(reader.position == reader.data.len())
    print!(text)
    0
}
