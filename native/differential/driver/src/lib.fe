use core::Option
use std::io::{Write, host, write, write_char, writeln}
use std::native::{Arg, Args}
use fevm::{Transaction, WorldState, default_block_env, default_call_env}
use fevm::hex::{parse_hex_bytes, parse_hex_program, write_hex_byte, write_hex_word}
use fevm::vm::{Vm, execute_vm}

fn parse_gas(_ arg: Arg) -> Option<u64> {
    if arg.len() == 0 {
        return Option::None
    }
    var value: u64 = 0
    var i: usize = 0
    while i < arg.len() {
        let byte = arg.byte_at(i)
        if byte < 48 || byte > 57 {
            return Option::None
        }
        let digit = (byte - 48) as u64
        if value > (0xffffffffffffffff - digit) / 10 {
            return Option::None
        }
        value = value * 10 + digit
        i += 1
    }
    Option::Some(value)
}

pub fn write_gas(_ value: u64) uses (w: mut Write) {
    var divisor: u64 = 1
    while value / divisor >= 10 {
        divisor *= 10
    }
    while divisor != 0 {
        write_char((48 + (value / divisor) % 10).downcast_unchecked())
        divisor /= 10
    }
}

pub fn write_frame(_ vm: Vm) uses (w: mut Write) {
    let completed = vm.status == 0 || vm.status == 19
    write("{\"outcome\":\"")
    if vm.status == 0 {
        write("success")
    } else if vm.status == 19 {
        write("revert")
    } else {
        write("exceptional")
    }
    write("\",\"reason\":")
    if completed {
        write("null")
    } else {
        write("\"")
        match vm.status {
            10 => write("stack_underflow"),
            11 => write("stack_overflow"),
            15 => write("out_of_gas"),
            16 => write("invalid_jump"),
            17 => write("invalid_opcode"),
            18 => write("return_data_oob"),
            23 => write("static_write"),
            _ => core::panic(),
        }
        write("\"")
    }
    write(",\"gas_remaining\":")
    write_gas(vm.gas_remaining)
    write(",\"stack\":")
    if completed {
        write("[")
        var i: usize = 0
        while i < vm.stack.len() {
            if i != 0 { write(",") }
            write("\"")
            write_hex_word(vm.stack[i])
            write("\"")
            i += 1
        }
        write("]")
    } else {
        write("null")
    }
    write(",\"memory\":")
    if completed {
        write("\"0x")
        for byte in vm.memory.span() { write_hex_byte(byte as i32) }
        write("\"")
    } else {
        write("null")
    }
    write(",\"output\":\"0x")
    for byte in vm.output.span() { write_hex_byte(byte as i32) }
    writeln("\"}")
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    // Native main supplies live NUL-terminated arguments for this process.
    let args = unsafe { Args::new(argc, argv) }
    if args.len() != 4 {
        return 2
    }
    let program = parse_hex_program(args.get(1))
    let calldata = parse_hex_bytes(args.get(2))
    if program.status != 0 || calldata.status != 0 {
        return 2
    }
    var call = default_call_env()
    match parse_gas(args.get(3)) {
        Option::Some(gas,) => call.gas_limit = gas,
        Option::None => {
            return 2
        },
    }
    var state = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let vm = execute_vm(program, calldata, call, default_block_env(), mut state)
    state.finish(commit: vm.status == 0, gas_spent: call.gas_limit - vm.gas_remaining)
    let supported = vm.status == 0
        || (vm.status >= 15 && vm.status <= 19)
        || vm.status == 10
        || vm.status == 11
        || vm.status == 23
    if !supported {
        return 3
    }
    with (Write = host()) {
        write_frame(vm)
    }
    0
}
