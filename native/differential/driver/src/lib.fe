use core::{MemBuffer, Option}
use std::env::Args
use std::io::{Display, Stdout}
use fevm::{Transaction, WorldState, default_block_env, default_call_env}
use fevm::hex::{parse_decimal, parse_hex_bytes, parse_hex_program, write_hex_bytes, write_hex_word}
use fevm::status::{ERR_REVERT, OK, is_evm_outcome, status_name}
use fevm::vm::{Vm, execute_vm}

pub fn write_frame(_ vm: Vm) uses (text: mut MemBuffer) {
    let completed = vm.status == OK || vm.status == ERR_REVERT
    "{\"outcome\":\"".fmt(mut text)
    if completed {
        status_name(vm.status).fmt(mut text)
    } else {
        "exceptional".fmt(mut text)
    }
    "\",\"reason\":".fmt(mut text)
    if completed {
        "null".fmt(mut text)
    } else {
        "\"".fmt(mut text)
        status_name(vm.status).fmt(mut text)
        "\"".fmt(mut text)
    }
    ",\"gas_remaining\":".fmt(mut text)
    vm.gas_remaining.fmt(mut text)
    ",\"stack\":".fmt(mut text)
    if completed {
        "[".fmt(mut text)
        var i: usize = 0
        while i < vm.stack.len() {
            if i != 0 { ",".fmt(mut text) }
            "\"".fmt(mut text)
            write_hex_word(vm.stack[i])
            "\"".fmt(mut text)
            i += 1
        }
        "]".fmt(mut text)
    } else {
        "null".fmt(mut text)
    }
    ",\"memory\":".fmt(mut text)
    if completed {
        "\"".fmt(mut text)
        write_hex_bytes(vm.memory.slice(offset: 0, len: vm.memory_size as usize))
        "\"".fmt(mut text)
    } else {
        "null".fmt(mut text)
    }
    ",\"output\":\"".fmt(mut text)
    write_hex_bytes(vm.output.span())
    "\"}\n".fmt(mut text)
}

pub fn main() -> i32 uses (args: Args, out: mut Stdout) {
    if args.count() != 4 {
        return 2
    }
    let program = parse_hex_program(args.get(1))
    let calldata = parse_hex_bytes(args.get(2))
    if program.status != 0 || calldata.status != 0 {
        return 2
    }
    var call = default_call_env()
    match parse_decimal(args.get(3)) {
        Option::Some(gas,) => call.gas_limit = gas,
        Option::None => {
            return 2
        },
    }
    var state = Transaction::new(WorldState::empty(), sender: 0, destination: 0, coinbase: 0)
    let vm = execute_vm(program, calldata, call, default_block_env(), mut state)
    state.finish(commit: vm.status == OK, gas_spent: call.gas_limit - vm.gas_remaining)
    if !is_evm_outcome(vm.status) {
        return 3
    }
    var text = MemBuffer::empty()
    with (mut text) {
        write_frame(vm)
    }
    print!(text)
    0
}
