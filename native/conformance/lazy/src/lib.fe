// The driver for runs over a lazy world. A state test runs as
// `fevm_conformance` runs it, then again over a world that reads the
// pre-state from a `WorldSource`; the driver prints `fevm_conformance`'s
// result with `lazy`, each way the second run differs. A blockchain test
// runs as `fevm_conformance` runs it, and one to run statelessly also has
// each block validated from a witness (`stateless`). A witness case is one
// block validated from the witness it carries.
use core::{MemBuffer, MemVec, Option}
use std::io::{Stdin, Stdout}
use fevm::{Evm, Receipt, StorageKey, WorldSource, WorldState}
use fevm::hex::write_hex_word
use fevm_conformance::{Reader, host_error, logs_hash, read_state_test, write_receipt, write_world}
use fevm_conformance::blocks

// Appends to the `lazy` list the problem `what` about `address`, or about
// its slot `slot`.
fn problem<const N: usize>(_ first: mut bool, _ what: String<N>, _ address: u256, slot: Option<u256>)
uses (text: mut MemBuffer)
{
    if !first { ",".fmt(mut text) }
    first = false
    "\"".fmt(mut text)
    what.fmt(mut text)
    " ".fmt(mut text)
    write_hex_word(address)
    if let Option::Some(slot) = slot {
        " ".fmt(mut text)
        write_hex_word(slot)
    }
    "\"".fmt(mut text)
}

// Whether two runs of a transaction give the same receipt.
fn same_receipt(_ a: Receipt, _ b: Receipt) -> bool {
    a.invalid == b.invalid && a.status == b.status && a.gas_used == b.gas_used && a.gas_refunded == b.gas_refunded
        && a.execution_gas_used == b.execution_gas_used && a.state_gas_used == b.state_gas_used
        && a.cumulative_gas_used == b.cumulative_gas_used && a.created == b.created
        && a.output.span() == b.output.span() && logs_hash(a.logs) == logs_hash(b.logs)
}

// Whether `address` is the same account in both worlds: present or absent,
// with the same balance, nonce and code hash, and code or none.
fn same_account(_ a: mut WorldState, _ b: mut WorldState, _ address: u256) -> bool {
    a.exists(address) == b.exists(address) && a.balance(address) == b.balance(address)
        && a.nonce(address) == b.nonce(address) && a.has_code(address) == b.has_code(address)
        && a.code_hash(address) == b.code_hash(address)
}

// The addresses of the accounts of `world`.
fn accounts(_ world: WorldState) -> MemVec<u256> {
    var addresses: MemVec<u256> = MemVec::new()
    for position in 0..world.account_count() { addresses.push(world.account_at(position).address) }
    addresses
}

// Writes `,"lazy":[...]`: each way in which `lazy`, the receipt of the run
// over a lazy world, and `read`, that world after it, disagree with the
// complete run's `receipt` from `pre` to `post`. Each account and slot the
// lazy world holds is one it loaded, and holds what `post` does, its code
// too if read, and storage if `post`'s account has some. Each account and
// slot that `post` changed from `pre` is one it loaded, or a slot of an
// account it loaded and no longer holds.
fn write_differences(_ receipt: Receipt, _ lazy: Receipt, _ pre: mut WorldState, _ post: mut WorldState,
                     _ read: mut WorldState)
uses (text: mut MemBuffer)
{
    ",\"lazy\":[".fmt(mut text)
    var first = true
    if !same_receipt(receipt, lazy) {
        "\"receipt\"".fmt(mut text)
        first = false
    }
    for address in accounts(read) {
        if !read.loaded().contains(address) { problem(mut first, "unloaded account", address, slot: Option::None) }
    }
    // Reading code hashes needs the worlds mutably, so the addresses first.
    var loaded: MemVec<u256> = MemVec::new()
    let addresses = ref read.loaded()
    for at in 0..addresses.capacity() {
        let entry = addresses.entry(at)
        if entry.occupied { loaded.push(entry.key) }
    }
    for address in loaded {
        let same = same_account(mut post, mut read, address)
            && (!read.code_known(address) || post.code(address) == read.code(address))
            && (!post.has_storage(address) || read.has_storage(address))
        if !same { problem(mut first, "account", address, slot: Option::None) }
    }
    for slot in 0..read.storage_slots() {
        let entry = read.storage_at(slot)
        if entry.occupied && !read.loaded_slots().contains(StorageKey { address: entry.address, slot: entry.slot }) {
            problem(mut first, "unloaded slot", entry.address, slot: Option::Some(entry.slot))
        }
    }
    let slots = ref read.loaded_slots()
    for at in 0..slots.capacity() {
        let entry = slots.entry(at)
        if entry.occupied {
            let key = entry.key
            if post.storage_load(key.address, key.slot) != read.storage_load(key.address, key.slot) {
                problem(mut first, "slot", key.address, slot: Option::Some(key.slot))
            }
        }
    }
    var changed = accounts(pre)
    for address in accounts(post) { if !pre.exists(address) { changed.push(address) } }
    for address in changed {
        if !same_account(mut pre, mut post, address) && !read.loaded().contains(address) {
            problem(mut first, "changed account not loaded", address, slot: Option::None)
        }
    }
    changed_slots(mut first, pre, other: post, read)
    changed_slots(mut first, post, other: pre, read)
    "]".fmt(mut text)
}

// Appends a problem for each slot `world` holds with a value `other` does not,
// which `read` has neither resolved nor lost with its account.
fn changed_slots(_ first: mut bool, _ world: WorldState, other: WorldState, _ read: WorldState)
uses (text: mut MemBuffer)
{
    for slot in 0..world.storage_slots() {
        let entry = world.storage_at(slot)
        let key = StorageKey { address: entry.address, slot: entry.slot }
        let gone = read.loaded().contains(key.address) && !read.exists(key.address)
        if entry.occupied && other.storage_load(key.address, key.slot) != entry.value
            && !read.loaded_slots().contains(key) && !gone {
            problem(mut first, "changed slot not loaded", key.address, slot: Option::Some(key.slot))
        }
    }
}

pub fn main() -> i32 uses (input: mut Stdin, out: mut Stdout) {
    var reader = Reader::stdin()
    if reader.witness_test() { return witness::run(mut reader) }
    if reader.stateless_test() { return stateless::run(mut reader) }
    if reader.blockchain_test() { return blocks::run(mut reader) }
    let (block, config, world, request) = match read_state_test(mut reader) {
        Result::Ok(test) => test,
        Result::Err(status) => return status,
    }
    let Option::Some(pre) = world.try_clone() else { return host_error("pre-state allocation failed") }
    var evm = Evm::new(world, config)
    var tracer = ()
    let receipt = evm.transact(request, block, mut tracer)
    var over = Evm<WorldSource>::over(WorldSource::new(pre), config)
    let lazy = over.transact(request, block, mut tracer)
    let (var read, source) = over.into_parts()
    var pre = source.into_world()
    var text = MemBuffer::empty()
    with (mut text) {
        write_receipt(receipt)
        write_world(evm.world())
        write_differences(receipt, lazy, mut pre, mut evm.world_mut(), mut read)
        "}\n".fmt(mut text)
    }
    print!(text)
    0
}
