use core::{MemBuffer, Option}
use std::env::Args
use std::io::{Display, Stdin, Stdout, read_to_end}
use keccak::Keccak256
use fevm::{Authorization, BlockEnv, Config, Evm, Fork, InputData, LogBuffer, OK, TxEnv, TxRequest, WorldState}
use fevm::hex::{parse_decimal, write_hex_bytes, write_hex_word}
use fevm::status::{VALID, invalid_name, is_evm_outcome, status_name}

// Reads one case. Integers and lengths are big endian. A state test (version
// 5) is the fork, the block, the pre-state accounts and the transaction; see
// `encode` in native/tools/src/conformance.fe. A blockchain test (version 7)
// is the chain ID, the fork schedule, the pre-state accounts, the genesis
// header and the blocks' RLP; see native/tools/src/blocks.fe.
struct Reader { data: MemBuffer, position: usize }

impl Reader {
    fn word(mut self, bytes: u64) -> u256 {
        core::assert(bytes <= 32)
        var value: u256 = 0
        for byte in self.data.slice(offset: self.position, len: bytes.downcast_truncate()) {
            value = (value << 8) | byte as u256
        }
        self.position += bytes.downcast_truncate()
        value
    }
    fn count(mut self) -> u64 { self.word(bytes: 4).downcast_unchecked() }
    fn u64(mut self) -> u64 { self.word(bytes: 8).downcast_unchecked() }
    fn input(mut self, len: u64) -> InputData {
        let input = InputData::copy_bytes(self.data.slice(offset: self.position, len: len.downcast_truncate()))
        self.position += len.downcast_truncate()
        input
    }
}

// State tests define BLOCKHASH(n) as keccak256 of n's decimal digits.
fn test_block_hash(_ number: u256) -> u256 {
    var power: u256 = 1
    while power <= number / 10 { power *= 10 }
    var hash = Keccak256::new()
    // The digits, most significant first.
    while power > 0 {
        hash.update_word(48 + number / power % 10, len: 1)
        power /= 10
    }
    hash.finish_word()
}

fn length_of_length(_ len: usize) -> usize {
    var bytes: usize = 0
    while bytes < 8 && len >> (bytes * 8) != 0 { bytes += 1 }
    bytes
}

fn header_len(_ payload: usize) -> usize { if payload <= 55 { 1 } else { 1 + length_of_length(payload) } }

fn update_header(_ hash: mut Keccak256, payload: usize, base: u256) {
    if payload <= 55 { return hash.update_word(base + payload as u256, len: 1) }
    let bytes = length_of_length(payload)
    hash.update_word(((base + 55 + bytes as u256) << (bytes * 8) as u256) | payload as u256, len: 1 + bytes)
}

fn data_len(_ logs: LogBuffer, entry: u64) -> usize {
    let data = logs.payload(entry)
    if data.len() == 1 && data[0] < 0x80 { 1 } else { header_len(data.len()) + data.len() }
}

fn log_payload(_ logs: LogBuffer, entry: u64) -> usize {
    let topics: usize = (logs.entry(entry).topic_count * 33).downcast_unchecked()
    21 + header_len(topics) + topics + data_len(logs, entry)
}

// keccak256(rlp([[address, [topics...], data], ...])), the receipt logs hash.
fn logs_hash(_ logs: LogBuffer) -> u256 {
    var payload: usize = 0
    var entry: u64 = 0
    while entry < logs.len() {
        let item = log_payload(logs, entry)
        payload += header_len(item) + item
        entry += 1
    }
    var hash = Keccak256::new()
    update_header(mut hash, payload, base: 0xc0)
    entry = 0
    while entry < logs.len() {
        let log = logs.entry(entry)
        update_header(mut hash, payload: log_payload(logs, entry), base: 0xc0)
        hash.update_word((0x94 << 160) | log.address, len: 21)
        let topics: usize = (log.topic_count * 33).downcast_unchecked()
        update_header(mut hash, payload: topics, base: 0xc0)
        for topic in 0..log.topic_count.downcast_truncate() {
            hash.update_word(0xa0, len: 1)
            hash.update_word(log.topics[topic], len: 32)
        }
        let data = logs.payload(entry)
        if !(data.len() == 1 && data[0] < 0x80) { update_header(mut hash, payload: data.len(), base: 0x80) }
        hash.update(data, offset: 0, len: data.len())
        entry += 1
    }
    hash.finish_word()
}

fn write_world(_ world: WorldState) uses (text: mut MemBuffer) {
    ",\"accounts\":[".fmt(mut text)
    var first = true
    for position in 0..world.account_count() {
        let account = world.account_at(position)
        if !first { ",".fmt(mut text) }
        first = false
        "[\"".fmt(mut text)
        write_hex_word(account.address)
        "\",\"".fmt(mut text)
        write_hex_word(account.balance)
        "\",\"".fmt(mut text)
        write_hex_word(account.nonce)
        "\",\"".fmt(mut text)
        write_hex_bytes(world.code(account.address))
        "\"]".fmt(mut text)
    }
    "],\"storage\":[".fmt(mut text)
    first = true
    var slot: usize = 0
    while slot < world.storage_slots() {
        let entry = world.storage_at(slot)
        if entry.occupied {
            if !first { ",".fmt(mut text) }
            first = false
            "[\"".fmt(mut text)
            write_hex_word(entry.address)
            "\",\"".fmt(mut text)
            write_hex_word(entry.slot)
            "\",\"".fmt(mut text)
            write_hex_word(entry.value)
            "\"]".fmt(mut text)
        }
        slot += 1
    }
    "]".fmt(mut text)
}

// Reports a host failure, which is no verdict on the case.
fn host_error<D: Display>(_ reason: D) -> i32 uses (out: mut Stdout) {
    println!("{\"host_error\":\"", reason, "\"}")
    3
}

fn read_fork(_ reader: mut Reader) -> Option<Fork> {
    match reader.word(bytes: 1) {
        0 => Option::Some(Fork::Osaka),
        1 => Option::Some(Fork::Amsterdam),
        _ => Option::None,
    }
}

// The pre-state accounts; false if the world cannot hold them.
fn read_accounts(_ reader: mut Reader, _ world: mut WorldState) -> bool {
    var accounts = reader.count()
    while accounts > 0 {
        let address = reader.word(bytes: 20)
        let balance = reader.word(bytes: 32)
        let nonce = reader.word(bytes: 32)
        let code = reader.input(len: reader.count())
        let loaded = world.ensure_account(address) && world.set_balance(address, balance)
            && world.set_nonce(address, nonce) && world.set_code(address, code) == OK
        if !loaded { return false }
        var slots = reader.count()
        while slots > 0 {
            let slot = reader.word(bytes: 32)
            let value = reader.word(bytes: 32)
            if !world.storage_store(address, slot, value) { return false }
            slots -= 1
        }
        accounts -= 1
    }
    true
}

// With arguments `RUNS [TRANSACT]`, the driver first decodes a state test and
// builds its pre-state RUNS more times, applying the transaction to each one
// unless TRANSACT is 0. `fevm_tools bench` times both modes and takes the
// difference as the cost of the transactions.
pub fn main() -> i32 uses (args: Args, input: mut Stdin, out: mut Stdout) {
    if args.count() > 3 {
        return 2
    }
    var runs: u64 = 0
    var execute = true
    if args.count() > 1 {
        match parse_decimal(args.get(1)) {
            Option::Some(count) => runs = count,
            Option::None => {
                return 2
            },
        }
    }
    if args.count() == 3 {
        match parse_decimal(args.get(2)) {
            Option::Some(flag) => execute = flag != 0,
            Option::None => {
                return 2
            },
        }
    }
    var data = MemBuffer::empty()
    read_to_end(mut data)
    var reader = Reader { data, position: 0 }
    if reader.data.len() != 0 && reader.data[0] == 7 {
        return if runs == 0 { blocks::run(mut reader) } else { 2 }
    }
    // Every repeated application must use the gas the reported one does.
    var repeated_gas: u64 = 0
    var repeated = false
    // Repeated applications reuse the frames' memory and stacks.
    var evm = Evm::new(WorldState::empty(), Config::osaka())
    var tracer = ()
    while true {
        reader.position = 0
        core::assert(reader.word(bytes: 1) == 5)
        let Option::Some(fork) = read_fork(mut reader) else { return 2 }
        let block = BlockEnv {
            coinbase: reader.word(bytes: 20),
            number: reader.word(bytes: 32),
            timestamp: reader.word(bytes: 32),
            prevrandao: reader.word(bytes: 32),
            gaslimit: reader.word(bytes: 32),
            basefee: reader.word(bytes: 32),
            blobbasefee: reader.word(bytes: 32),
            chainid: reader.word(bytes: 32),
            slot_number: reader.word(bytes: 32),
        }
        var config = Config::of(fork)
        config.tx_gas_limit_cap = reader.u64()
        var world = WorldState::empty()
        var number = if block.number > 256 { block.number - 256 } else { 0 }
        while number < block.number {
            core::assert(world.set_block_hash(number, test_block_hash(number)))
            number += 1
        }
        if !read_accounts(mut reader, mut world) { return host_error("pre-state allocation failed") }
        let kind: u8 = reader.word(bytes: 1).downcast_unchecked()
        let signed_chain = reader.word(bytes: 1) == 1
        let chain_id = reader.word(bytes: 32)
        let sender = reader.word(bytes: 20)
        let creates = reader.word(bytes: 1) == 1
        let env = TxEnv {
            kind,
            chain_id: if signed_chain { Option::Some(chain_id) } else { Option::None },
            sender,
            creates,
            to: reader.word(bytes: 20),
            nonce: reader.word(bytes: 32),
            gas_limit: reader.u64(),
            gas_price: reader.word(bytes: 32),
            max_priority_fee_per_gas: reader.word(bytes: 32),
            max_fee_per_blob_gas: reader.word(bytes: 32),
            value: reader.word(bytes: 32),
        }
        var request = TxRequest::new(env, data: reader.input(len: reader.count()))
        var entries = reader.count()
        while entries > 0 {
            let address = reader.word(bytes: 20)
            core::assert(request.add_access_account(address))
            var keys = reader.count()
            while keys > 0 {
                core::assert(request.add_access_key(address, slot: reader.word(bytes: 32)))
                keys -= 1
            }
            entries -= 1
        }
        var blobs = reader.count()
        while blobs > 0 {
            core::assert(request.add_blob_hash(reader.word(bytes: 32)))
            blobs -= 1
        }
        var authorizations = reader.count()
        while authorizations > 0 {
            let authorization = Authorization {
                chain_id: reader.word(bytes: 32),
                address: reader.word(bytes: 20),
                nonce: reader.word(bytes: 32),
                y_parity: reader.word(bytes: 32),
                r: reader.word(bytes: 32),
                s: reader.word(bytes: 32),
            }
            core::assert(request.add_authorization(authorization))
            authorizations -= 1
        }
        core::assert(reader.position == reader.data.len())
        evm.set_world(world)
        evm.set_config(config)
        if runs > 0 {
            runs -= 1
            if execute {
                let gas = evm.transact(request, block, mut tracer).gas_used
                core::assert(!repeated || gas == repeated_gas)
                repeated_gas = gas
                repeated = true
            }
            continue
        }
        let receipt = evm.transact(request, block, mut tracer)
        core::assert(!repeated || receipt.gas_used == repeated_gas)
        var text = MemBuffer::empty()
        with (mut text) {
            "{\"invalid\":".fmt(mut text)
            if receipt.invalid == VALID {
                "null".fmt(mut text)
            } else {
                "\"".fmt(mut text)
                invalid_name(receipt.invalid).fmt(mut text)
                "\"".fmt(mut text)
            }
            ",\"status\":\"".fmt(mut text)
            status_name(receipt.status).fmt(mut text)
            "\",\"host_failure\":".fmt(mut text)
            (receipt.invalid == VALID && !is_evm_outcome(receipt.status)).fmt(mut text)
            ",\"gas_used\":".fmt(mut text)
            receipt.gas_used.fmt(mut text)
            ",\"logs_hash\":\"".fmt(mut text)
            write_hex_word(logs_hash(receipt.logs))
            "\"".fmt(mut text)
            write_world(evm.world())
            "}\n".fmt(mut text)
        }
        print!(text)
        return 0
    }
    0
}
