// Protocol: '@', 8-byte round count, 32-byte lhs, 32-byte rhs; little endian.
// Reply: 8-byte CPU clock tick count and 32-byte result; little endian.
use core::MemBuffer
use std::io::{Stdin, Stdout, read_to_end}
use std::native::cpu_clock_ticks
fn read_word(_ bytes: MemBuffer, _ offset: usize) -> Word {
    Word {
        a: bytes.read_le<u64>(offset),
        b: bytes.read_le<u64>(offset + 8),
        c: bytes.read_le<u64>(offset + 16),
        d: bytes.read_le<u64>(offset + 24),
    }
}
fn pack(_ x: Word) -> u256 {
    (x.a as u256) | ((x.b as u256) << 64) | ((x.c as u256) << 128) | ((x.d as u256) << 192)
}
fn unpack(_ x: u256) -> Word {
    Word {
        a: x.downcast_truncate(),
        b: (x >> 64).downcast_truncate(),
        c: (x >> 128).downcast_truncate(),
        d: (x >> 192).downcast_truncate(),
    }
}
pub fn main() -> i32 uses (input: mut Stdin, out: mut Stdout) {
    var requests = MemBuffer::empty()
    read_to_end(mut requests)
    var replies = MemBuffer::empty()
    var offset: usize = 0
    while offset < requests.len() {
        core::assert(requests[offset] == 64)
        let rounds = requests.read_le<u64>(offset + 1)
        core::assert(rounds > 0)
        let lhs = read_word(requests, offset + 9)
        let rhs = read_word(requests, offset + 41)
        offset += 73
        let started = cpu_clock_ticks()
        let result = kernel(lhs, rhs, rounds)
        let ended = cpu_clock_ticks()
        core::assert(started >= 0 && ended >= started)
        let ticks: u64 = (ended - started).downcast_unchecked()
        let reply = replies.len()
        replies.resize(reply + 40)
        replies.write_le(offset: reply, value: ticks)
        replies.write_le(offset: reply + 8, value: result.a)
        replies.write_le(offset: reply + 16, value: result.b)
        replies.write_le(offset: reply + 24, value: result.c)
        replies.write_le(offset: reply + 32, value: result.d)
    }
    print!(replies)
    0
}
