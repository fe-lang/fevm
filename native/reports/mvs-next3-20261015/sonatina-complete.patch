     }
+
+    #[test]
+    fn nested_joins_intersect_definedness_with_sparse_defaults() {
+        let parsed = parse_module(
+            r#"
+target = "evm-ethereum-osaka"
+type @Pair = { i256, i256 };
+type @Nested = { @Pair, @Pair };
+func private %f(v0.@Nested) {
+block0:
