+#[cfg(test)]
+mod tests {
+    use sonatina_ir::{Module, isa::evm::Evm};
+    use sonatina_triple::TargetTriple;
+
+    use super::*;
+    use super::super::views::{Anchor, Guard, View};
+
+    #[test]
+    fn joins_retain_only_common_views_and_update_reference_candidates() {
+        let module = Module::new(&Evm::new(TargetTriple::parse("evm-ethereum-cancun").unwrap()));
+        let ids = [0, 1, 2, 3, 4, 5].map(ValueId::from_u32);
+        let witness = ValueId::from_u32(10);
+        let anchor = ValueId::from_u32(11);
+        let mut left = State::default();
+        for &id in &ids[..4] {
+            let mut references = References::root(Root::Recent(id));
+            references.cache = Some(id);
+            left.views.insert(id, ViewFact {
+                references,
+                value: ValueState::new(Type::I32, true),
+                guards: true,
+            });
+        }
+        left.views.get_mut(&ids[2]).unwrap().references.views = BTreeSet::from([View {
+            place: Place { root: Root::Recent(ids[2]), path: vec![] },
+            guards: BTreeSet::from([Guard {
+                place: Place { root: Root::Summary(ids[0]), path: vec![] },
+                variant: 0,
+                witness: Some(witness),
+                anchor: Some(Anchor { value: anchor, path: vec![] }),
+            }]),
+        }]);
+        for (&id, fact) in &left.views {
+            left.view_index.update(id, &fact.references, true);
+        }
+        let mut right = left.clone();
+        right.views.get_mut(&ids[0]).unwrap().guards = false;
+        let mut moved = References::root(Root::Recent(ids[4]));
+        moved.cache = Some(ids[1]);
+        for (id, references) in [(ids[1], moved), (ids[3], References::root(Root::Recent(ids[3])))] {
+            let fact = right.views.get_mut(&id).unwrap();
+            right.view_index.update(id, &fact.references, false);
+            fact.references = references;
+            right.view_index.update(id, &fact.references, true);
+        }
+        let removed = right.views.remove(&ids[2]).unwrap();
+        right.view_index.update(ids[2], &removed.references, false);
+        let added = ViewFact {
+            references: References::root(Root::Recent(ids[5])),
+            value: ValueState::new(Type::I32, true),
+            guards: true,
+        };
+        right.view_index.update(ids[5], &added.references, true);
+        right.views.insert(ids[5], added);
+
+        let joined = left.join(&module.ctx, &right);
+        assert_eq!(joined.views.keys().copied().collect::<Vec<_>>(), vec![ids[0], ids[1], ids[3]]);
+        assert!(!joined.views[&ids[0]].guards);
+        for (root, expected) in [
+            (Root::Recent(ids[0]), BTreeSet::from([ids[0]])),
+            (Root::Recent(ids[1]), BTreeSet::from([ids[1]])),
+            (Root::Recent(ids[2]), BTreeSet::new()),
+            (Root::Recent(ids[3]), BTreeSet::from([ids[3]])),
+            (Root::Recent(ids[4]), BTreeSet::from([ids[1]])),
+            (Root::Recent(ids[5]), BTreeSet::new()),
+            (Root::Summary(ids[0]), BTreeSet::new()),
+        ] {
+            assert_eq!(joined.view_index.candidates(&References::root(root)), expected, "{root:?}");
+        }
+        for id in [ids[2], ids[3], witness, anchor] {
+            assert!(joined.view_index.binding_candidates(id).is_empty(), "{id:?}");
+            assert_eq!(left.view_index.binding_candidates(id), BTreeSet::from([if id == ids[3] { ids[3] } else { ids[2] }]));
+        }
+        let mut cached = References::root(Root::Recent(ids[5]));
+        cached.cache = Some(ids[3]);
+        assert!(joined.view_index.candidates(&cached).is_empty());
+        assert_eq!(left.view_index.candidates(&cached), BTreeSet::from([ids[3]]));
+        assert_eq!(joined, right.join(&module.ctx, &left));
+    }
+    impl State {
+    fn benchmark_rebuilding_join(&self, ctx: &ModuleCtx, other: &Self) -> Self {
+        let mut result = Self {
+            objects: self.objects.clone(),
+            bound: self.bound.union(&other.bound).copied().collect(),
+            ..Self::default()
+        };
+        // Allocation facts are conditional on that allocation existing. Phi
+        // substitution occurs first, so branch-local values cannot lose their
+        // guarantees merely because the other branch did not allocate them.
+        for (&root, value) in &other.objects {
+            result
+                .objects
+                .entry(root)
+                .and_modify(|a| *a = a.join(ctx, value))
+                .or_insert_with(|| value.clone());
+        }
+        for (&id, a) in &self.values {
+            if let Some(b) = other.values.get(&id) {
+                result.values.insert(id, a.join(ctx, b));
+            }
+        }
+        for (&id, a) in &self.views {
+            if let Some(b) = other.views.get(&id) {
+                result.views.insert(
+                    id,
+                    ViewFact {
+                        references: a.references.join(&b.references),
+                        value: a.value.join(ctx, &b.value),
+                        guards: a.guards && b.guards,
+                    },
+                );
+            }
+        }
+        for (&id, fact) in &result.views {
+            result.view_index.update(id, &fact.references, true);
+        }
+        for (&id, refs) in &self.observations {
+            if let Some(other) = other.observations.get(&id)
+                && (refs == other || refs.same_location(other))
+            {
+                result.observations.insert(id, refs.join(other));
+            }
+        }
+        for (&id, relation) in &self.value_observations {
+            if other.value_observations.get(&id) == Some(relation) {
+                result.value_observations.insert(id, *relation);
+            }
+        }
+        result.exposed = self.exposed.union(&other.exposed).copied().collect();
+        result.close_exposure(ctx);
+        result
+    }
+
+    }
+
+    #[test]
+    #[ignore]
+    fn benchmark_state_index_joins() {
+        use std::{hint::black_box, time::Instant};
+        let module = Module::new(&Evm::new(TargetTriple::parse("evm-ethereum-cancun").unwrap()));
+        for count in [128, 512, 2048] {
+            let mut left = State::default();
+            for i in 0..count {
+                let id = ValueId::from_u32(i);
+                let mut references = References::root(Root::Recent(ValueId::from_u32(i / 64)));
+                references.views = references.views.into_iter().map(|mut view| {
+                    view.place.path = vec![Step::Index(Index::Constant(i as usize % 64))];
+                    view
+                }).collect();
+                references.cache = Some(id);
+                left.view_index.update(id, &references, true);
+                left.views.insert(id, ViewFact { references, value: ValueState::new(Type::I32, true), guards: true });
+            }
+            for changed in [false, true] {
+                let mut right = left.clone();
+                if changed {
+                    let id = ValueId::from_u32(0);
+                    let fact = right.views.get_mut(&id).unwrap();
+                    right.view_index.update(id, &fact.references, false);
+                    fact.references = References::root(Root::Recent(ValueId::from_u32(count)));
+                    fact.references.cache = Some(id);
+                    right.view_index.update(id, &fact.references, true);
+                }
+                assert_eq!(left.benchmark_rebuilding_join(&module.ctx, &right), left.join(&module.ctx, &right));
+                for pair in 0..6 {
+                    for name in if pair % 2 == 0 { ["baseline", "candidate"] } else { ["candidate", "baseline"] } {
+                        let start = Instant::now();
+                        for _ in 0..64 {
+                            let joined = if name == "baseline" { left.benchmark_rebuilding_join(&module.ctx, black_box(&right)) } else { left.join(&module.ctx, black_box(&right)) };
+                            black_box(joined);
+                        }
+                        println!("JOIN_PROBE count={count} changed={changed} pair={pair} compiler={name} iterations=64 seconds={:.9}",start.elapsed().as_secs_f64());
+                    }
+                }
+            }
+        }
+    }
+
