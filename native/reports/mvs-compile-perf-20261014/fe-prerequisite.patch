+    let listing = Command::new("tar")
+        .arg("-tzf")
+        .arg(&report)
+        .output()
+        .unwrap();
+    assert!(listing.status.success(), "{listing:?}");
+    let listing = String::from_utf8(listing.stdout).unwrap();
+    let objects: Vec<_> = listing
