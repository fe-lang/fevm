diff --git a/crates/fe/tests/fixtures/native/fixed_stack.fe b/crates/fe/tests/fixtures/native/fixed_stack.fe
new file mode 100644
index 000000000..946b0b5b4
--- /dev/null
+++ b/crates/fe/tests/fixtures/native/fixed_stack.fe
@@ -0,0 +1,66 @@
+use core::{Option, Result}
+use std::native::{Args, FixedStack, ByteBuffer}
+struct Frame { value: u64, words: [u256; 4], memory: ByteBuffer }
+
+pub fn main(argc: i32, argv: **u8) -> i32 {
+    core::assert(core::size_of<[Option<Frame>; 3]>() == 558)
+    let args = unsafe { Args::new(argc, argv) }
+    let mode = if args.len() == 1 { 0 } else { args.get(1).byte_at(0) - 48 }
+    var stack: FixedStack<Frame, 3> = match FixedStack::try_new() {
+        Option::Some(stack) => stack,
+        Option::None => {
+            core::assert(mode == 1)
+            return 0
+        },
+    }
+    core::assert(mode != 1)
+    var count: u64 = 0
+    var failed = false
+    while count < 4 {
+        var memory = ByteBuffer::new()
+        if !memory.try_resize(8192) {
+            memory.release()
+            failed = true
+            break
+        }
+        memory.set_byte(index: 8191, value: (count + 41).downcast_unchecked())
+        let frame = Frame { value: count, words: [count as u256; 4], memory }
+        match stack.try_push(frame) {
+            Result::Ok(()) => {
+                core::assert(count < 3)
+                count += 1
+            },
+            Result::Err(frame) => {
+                core::assert(count == 3 && stack.len() == 3)
+                core::assert(frame.value == 3 && frame.words[3] == 3)
+                core::assert(frame.memory.byte_at(8191) == 44)
+                frame.memory.release()
+                break
+            },
+        }
+    }
+    while stack.len() > 0 {
+        count -= 1
+        let frame = stack.top_mut()
+        core::assert(frame.value == count)
+        core::assert(frame.words[3] == count as u256)
+        core::assert(frame.memory.byte_at(8191) == (count + 41).downcast_unchecked())
+        frame.memory.set_byte(index: 0, value: 97)
+        let frame = stack.pop()
+        core::assert(frame.value == count && frame.memory.byte_at(0) == 97)
+        frame.memory.release()
+    }
+    core::assert(count == 0 && failed == (mode == 2))
+    stack.release()
+    var empty: FixedStack<ByteBuffer, 0> = match FixedStack::try_new() {
+        Option::Some(stack) => stack,
+        Option::None => core::panic(),
+    }
+    core::assert(empty.len() == 0)
+    match empty.try_push(ByteBuffer::new()) {
+        Result::Err(buffer) => buffer.release(),
+        Result::Ok(()) => core::panic(),
+    }
+    empty.release()
+    0
+}
diff --git a/crates/fe/tests/fixtures/native/stack_allocator.c b/crates/fe/tests/fixtures/native/stack_allocator.c
new file mode 100644
index 000000000..f0d1d3827
--- /dev/null
+++ b/crates/fe/tests/fixtures/native/stack_allocator.c
@@ -0,0 +1,58 @@
+// Track explicit stack slots and owned buffer allocations, including failures.
+#define _DEFAULT_SOURCE
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#ifndef FAIL_STACK
+#define FAIL_STACK 0
+#endif
+#ifndef FAIL_BUFFER
+#define FAIL_BUFFER 0
+#endif
+static unsigned stacks, stack_frees, buffers, buffer_frees, units, unit_frees;
+static unsigned stack_attempts, buffer_attempts, failures;
+typedef union {
+    max_align_t alignment;
+    struct { size_t extent, size; } info;
+} Header;
+void *malloc(size_t size) {
+    if (size == 558 && ++stack_attempts == FAIL_STACK) { failures++; return NULL; }
+    if (size == 8192 && ++buffer_attempts == FAIL_BUFFER) { failures++; return NULL; }
+    if (size > SIZE_MAX - sizeof(Header)) return NULL;
+    size_t extent = sizeof(Header) + size;
+    Header *header = mmap(NULL, extent, PROT_READ | PROT_WRITE,
+                          MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (header == MAP_FAILED) return NULL;
+    header->info.extent = extent;
+    header->info.size = size;
+    stacks += size == 558;
+    buffers += size == 8192;
+    units += size == 1;
+    memset(header + 1, 0xa5, size);
+    return header + 1;
+}
+void free(void *pointer) {
+    if (!pointer) return;
+    Header *header = (Header *)pointer - 1;
+    stack_frees += header->info.size == 558;
+    buffer_frees += header->info.size == 8192;
+    unit_frees += header->info.size == 1;
+    munmap(header, header->info.extent);
+}
+__attribute__((destructor)) static void check_releases(void) {
+    unsigned expected_stack = FAIL_STACK ? 0 : 1;
+    unsigned expected_buffers = FAIL_STACK ? 0 : (FAIL_BUFFER ? FAIL_BUFFER - 1 : 4);
+    unsigned expected_attempts = FAIL_STACK ? 0 : (FAIL_BUFFER ? FAIL_BUFFER : 4);
+    unsigned expected_failures = FAIL_STACK || FAIL_BUFFER ? 1 : 0;
+    fprintf(stderr, "stacks=%u/%u buffers=%u/%u units=%u/%u attempts=%u/%u failures=%u\n",
+            stacks, stack_frees, buffers, buffer_frees, units, unit_frees,
+            stack_attempts, buffer_attempts, failures);
+    if (stacks != expected_stack || stack_frees != expected_stack ||
+        buffers != expected_buffers || buffer_frees != expected_buffers ||
+        units != expected_stack || unit_frees != expected_stack ||
+        stack_attempts != 1 || buffer_attempts != expected_attempts ||
+        failures != expected_failures) _Exit(101);
+}
