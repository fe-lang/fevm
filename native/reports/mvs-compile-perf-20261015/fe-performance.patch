+sonatina-triple = { git = "https://github.com/fe-lang/sonatina", rev = "498ce58134505992ccd1146dcbdb94a11483fcf0" }
+sonatina-codegen = { git = "https://github.com/fe-lang/sonatina", rev = "498ce58134505992ccd1146dcbdb94a11483fcf0" }
+sonatina-verifier = { git = "https://github.com/fe-lang/sonatina", rev = "498ce58134505992ccd1146dcbdb94a11483fcf0" }
 
 [profile.dev]
 # Set to 0 to make the build faster and debugging more difficult.
diff --git a/newsfragments/+native-initialization-joins.performance.md b/newsfragments/+native-initialization-joins.performance.md
new file mode 100644
index 000000000..cad0d4fdc
--- /dev/null
+++ b/newsfragments/+native-initialization-joins.performance.md
@@ -0,0 +1 @@
+Reduce native compilation time by reusing unchanged aggregate initialization facts and avoiding repeated child joins.
-- 
2.43.0

