--- a/crates/codegen/tests/opt_pipeline.rs
+++ b/crates/codegen/tests/opt_pipeline.rs
@@ -76,6 +76,70 @@ func public %entry(v3.i256, v4.i256) -> i256 {
     }
 }
 
+#[test]
+fn loop_enum_extract_keeps_its_variant_proof() {
+    let source = r#"
+target = "evm-ethereum-osaka"
+
+type @OptionI64 = enum {
+    #None,
+    #Some(i64),
+};
+
+func inline(never) private %sum(v0.@OptionI64, v1.i64) -> i64 {
+    block0:
+        jump block1;
+
+    block1:
+        v2.i64 = phi (0.i64 block0) (v8 block3);
+        v3.i64 = phi (0.i64 block0) (v7 block3);
+        v4.i1 = lt v2 v1;
+        br v4 block2 block5;
+
+    block2:
+        v5.i1 = enum.is_variant v0 #Some;
+        br v5 block3 block4;
+
+    block3:
+        enum.assert_variant v0 #Some;
+        v6.i64 = enum.extract v0 #Some 0.i8;
+        v7.i64 = add v3 v6;
+        v8.i64 = add v2 1.i64;
+        jump block1;
+
+    block4:
+        return v3;
+
+    block5:
+        return v3;
+}
+
+func public %entry(v0.i1, v1.i64, v2.i64) -> i64 {
+    block0:
+        br v0 block1 block2;
+    block1:
+        v3.@OptionI64 = enum.make @OptionI64 #Some (v1);
+        jump block3;
+    block2:
+        v4.@OptionI64 = enum.make @OptionI64 #None;
+        jump block3;
+    block3:
+        v5.@OptionI64 = phi (v3 block1) (v4 block2);
+        v6.i64 = call %sum v5 v2;
+        return v6;
+}
+"#;
+    let config = VerifierConfig::for_level(VerificationLevel::Full);
+    let mut licm = Pipeline::new();
+    licm.add_step(Step::FuncPasses(vec![Pass::Licm]));
+    for pipeline in [licm, Pipeline::size(), Pipeline::speed()] {
+        let mut parsed = parse_module(source).unwrap();
+        verify_module_or_panic(&parsed.module, &config);
+        pipeline.run(&mut parsed.module);
+        verify_module_or_panic(&parsed.module, &config);
+    }
+}
+
 #[test]
 fn sccp_folds_constant_uaddo_results() {
     let (module, func_ref) = parse_test_module(
diff --git a/crates/ir/src/dfg.rs b/crates/ir/src/dfg.rs
index 98d51adc..2a9ad1a5 100644
--- a/crates/ir/src/dfg.rs
+++ b/crates/ir/src/dfg.rs
@@ -15,6 +15,8 @@ use crate::{
     inst::{
         InstId,
         control_flow::{self, BranchInfo, CallInfo, Jump, Phi},
+        data::EnumExtract,
+        downcast,
     },
     ir_writer::{FuncWriteCtx, IrWrite},
     module::ModuleCtx,
@@ -731,7 +733,10 @@ impl DataFlowGraph {
     }
 
     pub fn can_speculate(&self, inst_id: InstId) -> bool {
+        // Payload extraction is pure, but requires an active-variant proof at
+        // its use site. Moving it across control flow can discard that proof.
         self.has_value_semantics(inst_id)
+            && downcast::<&EnumExtract>(self.inst_set(), self.inst(inst_id)).is_none()
     }
 
     pub fn effect_cost_class(&self, inst_id: InstId) -> EffectCostClass {
diff --git a/docs/enum-object-verification.md b/docs/enum-object-verification.md
index 908f4c50..b41c8a60 100644
--- a/docs/enum-object-verification.md
+++ b/docs/enum-object-verification.md
@@ -55,6 +55,11 @@ the variants of its ancestors.
 a snapshot when its source object changes; references within the snapshot still
 refer to mutable objects and retain their own guards.
 
+`enum.extract` has pure value semantics, but its active-variant proof must hold
+at the use site. It is not unconditionally speculatable: moving an extraction
+above a branch or assumption can invalidate that proof. Pure-value elimination
+and unused-result removal remain permitted.
+
 An incoming `objref<T>` has no encoded parent-enum obligation. It predates fresh
 allocations in this invocation. Incoming references may alias each other; a
 reference recovered later from a holder or opaque call may alias a fresh local
